#!/bin/sh
# Separate settings; upstream owns all vault IO, secrets, prompts and browser permissions.
set -eu
umask 077
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}/monet/passwords-preview"
mkdir -p "$config"
exec "$here/keepassxc" --config "$config/settings.ini" --localconfig "$config/local.ini" "$@"
