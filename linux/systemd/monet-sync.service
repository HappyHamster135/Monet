[Unit]
Description=Monet: sync the list of Windows games
# ESP readers must wait for bootupd's writable mount during an OS upgrade.
After=local-fs.target bootloader-update.service

[Service]
Type=oneshot
# First: if a trip to Windows just came back without Windows, find out why.
ExecStart=-@BINDIR@/monet helper check-switch
ExecStart=@BINDIR@/monet helper sync
StateDirectory=monet
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
