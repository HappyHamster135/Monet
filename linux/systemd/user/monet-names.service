[Unit]
Description=Monet: plain names for the apps that just arrived
# Run on each change of what it watches, which often come several at once: never
# turned away for running often (systemd's limit would stop it for the session).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A burst of changes becomes one run.
ExecStartPre=/usr/bin/sleep 2
ExecStart=@LIBEXECDIR@/monet-look --names
