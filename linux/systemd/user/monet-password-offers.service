[Unit]
Description=Monet optional app login save prompts
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.monet.PasswordOffers1
ExecCondition=@LIBEXECDIR@/monet-passwords --app-login-enabled
ExecStart=@LIBEXECDIR@/monet-passwords --watch-app-logins
Restart=no
TimeoutStartSec=10
TimeoutStopSec=3
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=graphical-session.target
