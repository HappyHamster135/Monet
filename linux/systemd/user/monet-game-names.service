[Unit]
Description=Monet: each Steam game by its own name in Task Manager
# Run on each change of what it watches, which often come several at once: never
# turned away for running often (systemd's limit would stop it for the session).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A burst of changes becomes one run. It only writes what changed.
ExecStartPre=/usr/bin/sleep 5
ExecStart=@LIBEXECDIR@/monet-quick game-names
Nice=19
IOSchedulingClass=idle
