[Unit]
Description=Monet: Zen in Monet's look, as it arrives and makes its profile

[Path]
# Zen arriving from the Store (for the whole PC or this account), Zen making
# its profile on its first start, and bookmarks kept from Windows' browsers
# (monet-windows-drive), which a Zen that hasn't started yet takes in.
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=%h/.local/share/flatpak/exports/share/applications
PathChanged=%h/.var/app/app.zen_browser.zen/.zen
PathChanged=%h/.local/share/monet/windows-bookmarks.html

[Install]
WantedBy=default.target
