[Unit]
Description=Monet: a painted canvas for each app Monet hasn't painted, as apps arrive

[Path]
# Where the Store's apps show up, for the whole PC and for this account.
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=%h/.local/share/flatpak/exports/share/applications
# Native packages, AppImages and shortcuts created with Add to apps.
PathChanged=%h/.local/share/applications
PathChanged=/usr/local/share/applications
PathChanged=/usr/share/applications

[Install]
WantedBy=default.target
