[Unit]
Description=Monet: games first and shader processing at background priority
# With the desktop, and gone with it: what it lowered is put back as it stops. The Monet Work
# KWin script tells it which windows are in front; Steam's shader processes are looked for only
# while Steam runs.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@LIBEXECDIR@/monet-priority
Restart=on-failure
RestartSec=10
Slice=background.slice
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
