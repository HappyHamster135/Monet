[Unit]
Description=Windows' keyboard shortcuts for Monet, before KWin reads them (once per account)
Before=plasma-kwin_wayland.service plasma-kwin_x11.service plasma-plasmashell.service plasma-kded6.service

[Service]
Type=oneshot
ExecStart=@LIBEXECDIR@/monet-look --keys

[Install]
WantedBy=plasma-workspace.target
