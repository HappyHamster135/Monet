[Unit]
Description=Monet: prepare Windows so Monet Bridge installs itself
# Avoid racing bootupd's writable ESP mount with Monet's read-only probes.
After=local-fs.target bootloader-update.service

[Service]
Type=oneshot
# A BitLocker drive whose recovery key was typed in Settings opens first, so Windows' setup finds it.
ExecStartPre=-@LIBEXECDIR@/monet-windows-drive unlock-saved
ExecStart=@BINDIR@/monet helper stage-windows
StateDirectory=monet
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
