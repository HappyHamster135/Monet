[Unit]
Description=Monet: the encrypted disk's key goes into the PC's security chip (at the first start)
ConditionPathExists=|/boot/monet-firstboot.key
ConditionPathExists=|/var/lib/monet/firstboot-seal.json
After=local-fs.target
# Bazzite can update the kernel arguments and reboot during its first start.
Before=bazzite-hardware-setup.service
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=@LIBEXECDIR@/monet-seal first-start

[Install]
WantedBy=multi-user.target
