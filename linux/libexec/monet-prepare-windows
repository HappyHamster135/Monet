#!/usr/bin/env python3
"""Gets a fresh Windows 11 ready to install itself, for "Install Monet and Windows".

Runs once at the end of the Monet installer, inside the new system. If it
can't finish (no internet, Microsoft blocks the download), Monet still
works, and choosing Windows in the app menu runs it again.

1. Splits the free space the installer left at the end of the disk into a
   Windows partition and a small setup partition.
2. Downloads Windows 11 from Microsoft, in the same language as Monet.
3. Copies Windows Setup to the setup partition, with Monet's own install
   script in place of the Setup wizard and an answer file that skips all of
   Windows' first-start questions and installs Monet Bridge.
4. Starts the setup partition once, at the next restart.

    monet-prepare-windows [--iso FILE]
    monet-prepare-windows --windows-zone     Monet's time zone as Windows names it (for a trip)
"""

import argparse
import fcntl
import hashlib
import json
import os
import re
import resource
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path
from xml.sax.saxutils import escape

STATE = Path("/var/lib/monet")
STATUS = STATE / "windows-setup"
PROGRESS = Path("/run/monet/windows-progress")
WORK = Path("/var/tmp/monet-windows")
LOG = Path("/var/log/monet-windows.log")
MOUNT = Path("/run/monet")

WINDOWS_LABEL = "Monet Windows"
SETUP_LABEL = "Monet Setup"
BOOT_ENTRY = "Monet Windows Setup"
BASIC_DATA = "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7"
EFI_SYSTEM = "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
SETUP_MIB = 8 * 1024
MIN_WINDOWS_MIB = 64 * 1024

MS_PAGE = "https://www.microsoft.com/en-us/software-download/windows11"
MS_API = "https://www.microsoft.com/software-download-connector/api"
MS_PROFILE = "606624d44113"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

SHARE = next(
    (p for p in (Path(sys.argv[0]).resolve().parent.parent / "share/monet", Path("/usr/share/monet"),
                 Path("/usr/local/share/monet")) if (p / "winpe").is_dir()),
    Path("/usr/share/monet"),
)


class Stop(Exception):
    """A problem with a status code and a message for the user."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def log(message):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + message
    print(line, flush=True)
    try:
        with LOG.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def set_status(code):
    STATE.mkdir(parents=True, exist_ok=True)
    STATUS.write_text(code)


def progress(percent, text, *values):
    """How far it is, for the person's progress dialog: "PERCENT<tab>TEXT<tab>VALUE...". The dialog says
    TEXT in their language (it's in Monet's catalog) and fills its %1, %2... with the values."""
    try:
        PROGRESS.parent.mkdir(parents=True, exist_ok=True)
        PROGRESS.write_text("\t".join([str(int(percent)), text, *map(str, values)]) + "\n")
    except OSError:
        pass
    said = text
    for i, value in reversed(list(enumerate(values, 1))):
        said = said.replace(f"%{i}", str(value))
    log(f"[{int(percent)}%] {said}")


def run(*cmd, check=True, capture=False, stdin=None, timeout=None):
    log("$ " + " ".join(str(c) for c in cmd))
    try:
        result = subprocess.run([str(c) for c in cmd], input=stdin, text=True, timeout=timeout,
                                stdout=subprocess.PIPE if capture else None, stderr=subprocess.PIPE)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Stop("failed", f"{cmd[0]} could not finish: {error}") from error
    if check and result.returncode != 0:
        raise Stop("failed", f"{cmd[0]} failed: {result.stderr.strip()[:300]}")
    return result.stdout if capture else result.returncode == 0


# ----------------------------------------------------------------- this PC

def lsblk(*args):
    return json.loads(run("lsblk", "-J", "-b", *args, capture=True, timeout=5))["blockdevices"]


def root_disk():
    """The disk Monet is installed on."""
    source = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True).stdout.strip()
    source = re.sub(r"\[.*\]$", "", source)
    if not source.startswith("/dev/"):
        # Inside the installer, / may not show up as a mount; the installer
        # labels Monet's file system "monet".
        source = run("blkid", "-L", "monet", capture=True).strip()
    disk = run("lsblk", "-no", "PKNAME", source, capture=True).strip().splitlines()
    if not disk or not disk[-1]:
        raise Stop("failed", f"couldn't find the disk of {source}")
    return "/dev/" + disk[-1].strip()


def partitions(disk):
    # Without NAME, lsblk's JSON is flat unless --tree is explicit. Assuming
    # children then hides every existing partition and incorrectly reports that
    # previously allocated Windows space is unavailable.
    devices = lsblk("--tree", "-o", "PATH,TYPE,PARTLABEL,PARTN,SIZE,FSTYPE,PARTUUID,MOUNTPOINTS", disk)
    if not isinstance(devices, list):
        raise Stop("failed", "the disk's partition list could not be read")
    roots = [item for item in devices if isinstance(item, dict) and isinstance(item.get("path"), str)
             and os.path.realpath(item["path"]) == os.path.realpath(disk)]
    if len(roots) != 1 or not isinstance(roots[0].get("children", []), list):
        raise Stop("failed", "the disk's partition list could not be read")
    return [part for part in roots[0].get("children", []) if isinstance(part, dict) and part.get("type") == "part"]


def find_partition(disk, label):
    return next((p for p in partitions(disk) if p.get("partlabel") == label), None)


def sector_size(disk):
    return int(run("blockdev", "--getss", disk, capture=True, timeout=5))


def largest_free(disk):
    """(start, sectors) of the largest free area, from `sfdisk -F`."""
    best = (0, 0)
    for line in run("sfdisk", "-F", "-q", disk, capture=True, timeout=10).splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[0].isdigit():
            start, end = int(fields[0]), int(fields[1])
            if end - start + 1 > best[1]:
                best = (start, end - start + 1)
    return best


def has_windows(path):
    """True if a whole Windows is on the NTFS partition at path."""
    out = subprocess.run(["ntfsls", "-p", "/Windows/System32", path], capture_output=True, text=True, timeout=30)
    return out.returncode == 0 and "winload.efi" in out.stdout.lower()


def partition_table(disk):
    table = json.loads(run("sfdisk", "--json", disk, capture=True, timeout=10)).get("partitiontable", {})
    if table.get("label") != "gpt" or table.get("unit") != "sectors" or not table.get("id"):
        raise Stop("failed", "Windows preparation needs a readable GPT partition table")
    return table


def part_identity(part):
    return {key: str(part.get(key, "")).lower() if key in ("uuid", "type") else part.get(key)
            for key in ("uuid", "start", "size", "type", "name")}


def save_state(name, plan):
    """A root-owned receipt precedes partition creation and every filesystem transition."""
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=".windows-partitions-", dir=STATE)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(plan, output, sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, STATE / name)
        for directory in (STATE, STATE.parent):
            fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
    finally:
        Path(temporary).unlink(missing_ok=True)


def save_partition_plan(plan):
    save_state("windows-partitions.json", plan)


def new_partition_plan(disk, table):
    """Do not adopt old partitions based on a friendly name or a missing signature."""
    before = [part_identity(p) for p in table.get("partitions", [])]
    if any(p["name"] in (WINDOWS_LABEL, SETUP_LABEL) for p in before):
        raise Stop("failed", "existing Windows setup partitions have no ownership record; recovery must verify them before formatting")

    mib = 1024 * 1024 // sector_size(disk)
    free_start, free_sectors = largest_free(disk)
    start = -(-free_start // mib) * mib
    usable = (free_start + free_sectors - start) // mib * mib
    setup_sectors = SETUP_MIB * mib
    win_sectors = usable - setup_sectors - mib
    if win_sectors < MIN_WINDOWS_MIB * mib:
        raise Stop("no-space", "there isn't enough free space on the disk for Windows")

    owned = [dict(uuid=str(uuid.uuid4()), start=start, size=win_sectors, type=BASIC_DATA.lower(),
                  name=WINDOWS_LABEL, fstype="ntfs", fslabel="MONETWIN", phase="planned"),
             dict(uuid=str(uuid.uuid4()), start=start + win_sectors, size=setup_sectors, type=BASIC_DATA.lower(),
                  name=SETUP_LABEL, fstype="vfat", fslabel="MONETSETUP", phase="planned")]
    return dict(version=1, disk_id=table["id"].lower(), sector_size=1024 * 1024 // mib, before=before, owned=owned)


def check_partition_plan(table, plan):
    if (not isinstance(plan, dict) or plan.get("version") != 1 or plan.get("disk_id") != table["id"].lower()
            or plan.get("sector_size") != table.get("sectorsize", 512)
            or not isinstance(plan.get("before"), list) or not isinstance(plan.get("owned"), list)
            or len(plan["owned"]) != 2):
        raise Stop("failed", "the saved Windows partition plan does not match this disk")
    for part, name, fstype, label in zip(plan["owned"], (WINDOWS_LABEL, SETUP_LABEL), ("ntfs", "vfat"), ("MONETWIN", "MONETSETUP")):
        if (not isinstance(part, dict) or part.get("name") != name or part.get("fstype") != fstype
                or part.get("fslabel") != label or part.get("type") != BASIC_DATA.lower()
                or part.get("phase") not in ("planned", "formatting", "formatted")
                or not isinstance(part.get("uuid"), str) or not re.fullmatch(r"[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}", part["uuid"])
                or type(part.get("start")) is not int or type(part.get("size")) is not int
                or part["start"] <= 0 or part["size"] <= 0):
            raise Stop("failed", "the saved Windows partition identity is invalid")
    wanted = {p["uuid"]: p for p in plan["owned"]}
    win, setup = plan["owned"]
    if (win["start"] < table.get("firstlba", 34)
            or win["start"] + win["size"] != setup["start"] or win["size"] * plan["sector_size"] < MIN_WINDOWS_MIB * 1024**2
            or setup["size"] * plan["sector_size"] != SETUP_MIB * 1024**2
            or setup["start"] + setup["size"] - 1 > table.get("lastlba", 0)):
        raise Stop("failed", "the saved Windows partition sizes or boundaries are invalid")
    actual = [part_identity(p) for p in table.get("partitions", [])]
    if len(wanted) != 2 or len({p["uuid"] for p in actual}) != len(actual):
        raise Stop("failed", "duplicate partition identities prevent safe Windows preparation")
    other = [p for p in actual if p["uuid"] not in wanted]
    if sorted(other, key=lambda p: p["start"]) != sorted(plan["before"], key=lambda p: p["start"]):
        raise Stop("failed", "the disk layout changed since Windows preparation; no partitions were formatted")
    for part in actual:
        if part["uuid"] in wanted and part != part_identity(wanted[part["uuid"]]):
            raise Stop("failed", "a Windows setup partition changed; refusing to format it")
    # A missing owned partition may only be recreated while its exact planned area remains free.
    missing = [p for p in plan["owned"] if p["uuid"] not in {a["uuid"] for a in actual}]
    for part in missing:
        if part["phase"] != "planned" or any(part["start"] < a["start"] + a["size"]
                                              and a["start"] < part["start"] + part["size"] for a in actual):
            raise Stop("failed", "a saved Windows partition is missing or its space is now occupied")
    return missing


def mapped_partitions(disk, plan):
    table = partition_table(disk)
    if check_partition_plan(table, plan):
        raise Stop("failed", "a Windows partition disappeared before formatting; nothing more was formatted")
    nodes = {p["uuid"].lower(): p.get("node") for p in table["partitions"]}
    found = []
    rows = partitions(disk)
    for wanted in plan["owned"]:
        matches = [p for p in rows if (p.get("partuuid") or "").lower() == wanted["uuid"]]
        if len(matches) > 1:
            raise Stop("failed", "duplicate Windows partition devices were reported")
        if matches:
            part = matches[0]
            if (part.get("size") != wanted["size"] * plan["sector_size"] or not part.get("path")
                    or not part.get("partn") or part.get("partlabel") != wanted["name"]
                    or not nodes.get(wanted["uuid"])
                    or os.path.realpath(part["path"]) != os.path.realpath(nodes[wanted["uuid"]])):
                raise Stop("failed", "the kernel's Windows partition identity does not match the saved plan")
            if any(part.get("mountpoints") or []) or part.get("children"):
                raise Stop("failed", "a Windows setup partition is in use; close it before trying again")
            found.append(part)
    return found


def discover_partitions(disk, plan, attempts=6):
    """Bounded kernel/udev discovery; never append again just because a node is late."""
    for command in (("partx", "-a", disk), ("udevadm", "settle", "--timeout=5")):
        run(*command, check=False, timeout=7)
    for attempt in range(attempts):
        found = mapped_partitions(disk, plan)
        if len(found) == 2:
            return found
        if attempt + 1 < attempts:
            time.sleep(1)
    raise Stop("failed", "the new Windows partition devices did not appear; the saved plan will be reused on retry")


def filesystem(path):
    # Probe directly, not lsblk's possibly stale udev filesystem cache. A failed
    # read must never be confused with an unformatted partition.
    try:
        with open(path, "rb") as disk:
            if len(disk.read(4096)) != 4096:
                raise OSError("short partition read")
        out = subprocess.run(["blkid", "--probe", "--no-part-details", "--output", "export", str(path)],
                             capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Stop("failed", f"could not inspect the Windows partition: {error}") from error
    if out.returncode == 2 and not out.stderr.strip() and not out.stdout.strip():
        return {}
    if out.returncode != 0:
        raise Stop("failed", "the Windows partition has unreadable or conflicting filesystem signatures")
    return dict(line.split("=", 1) for line in out.stdout.splitlines() if "=" in line)


def check_filesystem(found, wanted):
    if found:
        if (found.get("TYPE") != wanted["fstype"] or found.get("LABEL") != wanted["fslabel"]
                or not found.get("UUID") or (wanted.get("fs_uuid") and wanted["fs_uuid"] != found["UUID"])
                or (wanted["phase"] == "formatted" and not wanted.get("fs_uuid"))
                or wanted["phase"] == "planned"):
            raise Stop("failed", "a Windows setup partition contains an unexpected filesystem; it was not formatted")
    elif wanted["phase"] == "formatted" or wanted.get("fs_uuid"):
        raise Stop("failed", "a previously prepared Windows filesystem is missing; refusing to format it again")


def recover_partition_plan(disk, plan, *, adopt=False):
    """Explicit recovery of legacy, unformatted partitions against a reviewed full-disk plan.

    Labels alone never select targets. Inspection is read-only; adoption records
    ownership only, leaving all formatting to the normal, resumable preparation.
    """
    table = partition_table(disk)
    if check_partition_plan(table, plan):
        raise Stop("failed", "recovery requires both reserved partitions to exist already")
    if any(p["phase"] != "planned" or p.get("fs_uuid") for p in plan["owned"]):
        raise Stop("failed", "recovery requires an unformatted partition plan")
    receipt = STATE / "windows-partitions.json"
    if receipt.exists():
        saved = json.loads(receipt.read_text())
        check_partition_plan(table, saved)
        if (saved.get("before") != plan["before"]
                or [part_identity(p) for p in saved["owned"]] != [part_identity(p) for p in plan["owned"]]):
            raise Stop("failed", "a different Windows preparation already owns these partitions")
        return "The matching Windows preparation is already recorded; retry can resume it."
    if (STATE / "windows-staging.json").exists():
        raise Stop("failed", "a previous Windows deployment exists without its partition record")
    targets = mapped_partitions(disk, plan)
    if len(targets) != 2:
        raise Stop("failed", "both reserved Windows partition devices must be available")
    for target in targets:
        # blkid checks filesystem contents directly; wipefs additionally detects
        # partition-table/RAID signatures that are never safe to adopt as empty.
        if filesystem(target["path"]):
            raise Stop("failed", "a reserved partition contains data; recovery will not format it")
        signatures = json.loads(run("wipefs", "--no-act", "--json", target["path"], capture=True, timeout=15))
        if not isinstance(signatures, dict) or signatures.get("signatures") != []:
            raise Stop("failed", "a reserved partition has signatures or could not be inspected safely")
    if adopt:
        # Recheck disk and kernel identities immediately before publishing the
        # receipt. make_partitions repeats these and both filesystem checks.
        if len(mapped_partitions(disk, plan)) != 2:
            raise Stop("failed", "the reserved Windows devices changed during recovery")
        save_partition_plan(plan)
    return "Verified the two reserved Windows partitions; existing Monet partitions are preserved."


def prepare_filesystem(part, wanted, plan):
    found = filesystem(part["path"])
    check_filesystem(found, wanted)
    if not found:
        wanted["phase"] = "formatting"
        save_partition_plan(plan)
        if wanted["fstype"] == "ntfs":
            run("mkfs.ntfs", "-Q", "-L", wanted["fslabel"], part["path"], capture=True)
        else:
            run("mkfs.vfat", "-F", "32", "-n", wanted["fslabel"], part["path"], capture=True)
        found = filesystem(part["path"])
        if found.get("TYPE") != wanted["fstype"] or found.get("LABEL") != wanted["fslabel"] or not found.get("UUID"):
            raise Stop("failed", "the Windows filesystem could not be verified after formatting")
    wanted.update(phase="formatted", fs_uuid=found["UUID"])
    save_partition_plan(plan)


def make_partitions(disk):
    """Resume only the exact GPT partitions created by this recorded operation."""
    table = partition_table(disk)
    receipt = STATE / "windows-partitions.json"
    if receipt.exists():
        plan = json.loads(receipt.read_text())
    else:
        plan = new_partition_plan(disk, table)
        check_partition_plan(table, plan)
        save_partition_plan(plan)
    missing = check_partition_plan(table, plan)
    if missing:
        layout = "".join(f'start={p["start"]}, size={p["size"]}, type={p["type"]}, uuid={p["uuid"]}, name="{p["name"]}"\n'
                         for p in missing)
        progress(2, "Making room for Windows")
        run("sfdisk", "--append", "--lock=yes", "--no-reread", "--no-tell-kernel", disk, stdin=layout, timeout=30)
    if check_partition_plan(partition_table(disk), plan):
        raise Stop("failed", "the Windows partition table is incomplete; the saved plan will be reused on retry")
    win, setup = discover_partitions(disk, plan)
    # Validate both before the first format, so an unexpected second filesystem
    # cannot cause a needless first-partition mutation.
    for part, wanted in zip((win, setup), plan["owned"]):
        check_filesystem(filesystem(part["path"]), wanted)
    if plan["owned"][0]["phase"] != "planned" and has_windows(win["path"]):
        raise Stop("failed", "Windows already exists on this partition; refusing an automatic reinstall")
    for index, wanted in enumerate(plan["owned"]):
        current = mapped_partitions(disk, plan)
        if len(current) != 2:
            raise Stop("failed", "a Windows partition device disappeared before formatting")
        win, setup = current
        prepare_filesystem(current[index], wanted, plan)
    return win["path"], setup["path"], setup["partn"]


def deployment_manifest(disk):
    """Read-only handoff for native WinPE identity checks; no letter or label selects a disk."""
    plan = json.loads((STATE / "windows-partitions.json").read_text())
    table = partition_table(disk)
    if check_partition_plan(table, plan) or any(p["phase"] != "formatted" for p in plan["owned"]):
        raise Stop("failed", "Windows partitions are not ready for a verified deployment")
    devices = mapped_partitions(disk, plan)
    if len(devices) != 2:
        raise Stop("failed", "the prepared Windows partition devices are unavailable")
    efi = [p for p in table["partitions"] if (p.get("type") or "").upper() == EFI_SYSTEM]
    if len(efi) != 1 or not efi[0].get("node"):
        raise Stop("failed", "the shared EFI partition cannot be identified uniquely")
    candidates = [p for p in partitions(disk) if (p.get("partuuid") or "").lower() == efi[0]["uuid"].lower()]
    if (len(candidates) != 1 or not candidates[0].get("path")
            or candidates[0].get("size") != efi[0]["size"] * plan["sector_size"]
            or os.path.realpath(candidates[0]["path"]) != os.path.realpath(efi[0]["node"])):
        raise Stop("failed", "the kernel's shared EFI identity does not match the partition table")
    esp = filesystem(efi[0]["node"])
    if esp.get("TYPE") != "vfat" or esp.get("VERSION") != "FAT32" or not esp.get("UUID"):
        raise Stop("failed", "the shared EFI partition has no verified FAT32 filesystem")

    def entry(part, kind, serial):
        pattern = r"[a-fA-F0-9]{16}" if kind == "ntfs" else r"[a-fA-F0-9]{4}-?[a-fA-F0-9]{4}"
        if not isinstance(serial, str) or not re.fullmatch(pattern, serial):
            raise Stop("failed", "a prepared filesystem has an invalid identity")
        return dict(guid=part["uuid"].lower(), offset=part["start"] * plan["sector_size"],
                    length=part["size"] * plan["sector_size"], filesystem=kind, filesystem_id=serial)

    manifest = dict(version=1, disk_guid=plan["disk_id"], efi=entry(efi[0], "vfat", esp["UUID"]))
    for name, part, wanted in zip(("windows", "setup"), devices, plan["owned"]):
        found = filesystem(part["path"])
        check_filesystem(found, wanted)
        if wanted["fstype"] == "vfat" and found.get("VERSION") != "FAT32":
            raise Stop("failed", "the Windows setup partition has no verified FAT32 filesystem")
        manifest[name] = entry(wanted, wanted["fstype"], found["UUID"])
    return manifest


def first_user():
    """(name, full name) of the person who set up Monet."""
    for line in Path("/etc/passwd").read_text().splitlines():
        fields = line.split(":")
        if len(fields) >= 7 and fields[2].isdigit() and 1000 <= int(fields[2]) < 60000:
            full = fields[4].split(",")[0] or fields[0]
            return fields[0], full
    return "Player", "Player"


def windows_name(name):
    """Windows user names: at most 20 characters, no special characters."""
    clean = re.sub(r'["/\\\[\]:;|=,+*?<>@ ]', "", name)[:20]
    return clean or "Player"


def windows_computer_name(user):
    """Keep the local account distinct from Windows' account-domain name."""
    return "MONET-PLAY" if windows_name(user).casefold() == "monet-games" else "MONET-GAMES"


