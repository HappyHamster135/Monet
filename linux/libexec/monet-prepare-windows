#!/usr/bin/env python3
"""Gets a fresh Windows 11 ready to install itself, for "Install Monet and Windows".

Runs once at the end of the Monet installer, inside the new system. If it
can't finish (no internet, Microsoft blocks the download), Monet still
works, and choosing Windows in the app menu runs it again.

1. Splits the free space the installer left at the end of the disk into a
   Windows partition and a small setup partition.
2. Downloads Windows 11 from Microsoft, in the same language as Monet.
3. Copies Windows Setup to the setup partition, with Monet's own install
   script in place of the Setup wizard and an answer file that skips all of
   Windows' first-start questions and installs Monet Bridge.
4. Starts the setup partition once, at the next restart.

    monet-prepare-windows [--iso FILE]
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path
from xml.sax.saxutils import escape

STATE = Path("/var/lib/monet")
STATUS = STATE / "windows-setup"
PROGRESS = Path("/run/monet/windows-progress")
WORK = Path("/var/tmp/monet-windows")
LOG = Path("/var/log/monet-windows.log")
MOUNT = Path("/run/monet")

WINDOWS_LABEL = "Monet Windows"
SETUP_LABEL = "Monet Setup"
BOOT_ENTRY = "Monet Windows Setup"
BASIC_DATA = "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7"
SETUP_MIB = 8 * 1024
MIN_WINDOWS_MIB = 64 * 1024

MS_PAGE = "https://www.microsoft.com/en-us/software-download/windows11"
MS_API = "https://www.microsoft.com/software-download-connector/api"
MS_PROFILE = "606624d44113"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

SHARE = next(
    (p for p in (Path(sys.argv[0]).resolve().parent.parent / "share/monet", Path("/usr/share/monet"),
                 Path("/usr/local/share/monet")) if (p / "winpe").is_dir()),
    Path("/usr/share/monet"),
)


class Stop(Exception):
    """A problem with a status code and a message for the user."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def log(message):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + message
    print(line, flush=True)
    try:
        with LOG.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def set_status(code):
    STATE.mkdir(parents=True, exist_ok=True)
    STATUS.write_text(code)


def progress(percent, text):
    try:
        PROGRESS.parent.mkdir(parents=True, exist_ok=True)
        PROGRESS.write_text(f"{int(percent)}\t{text}\n")
    except OSError:
        pass
    log(f"[{int(percent)}%] {text}")


def run(*cmd, check=True, capture=False, stdin=None):
    log("$ " + " ".join(str(c) for c in cmd))
    result = subprocess.run([str(c) for c in cmd], input=stdin, text=True,
                            stdout=subprocess.PIPE if capture else None, stderr=subprocess.PIPE)
    if check and result.returncode != 0:
        raise Stop("failed", f"{cmd[0]} failed: {result.stderr.strip()[:300]}")
    return result.stdout if capture else result.returncode == 0


# ----------------------------------------------------------------- this PC

def lsblk(*args):
    return json.loads(run("lsblk", "-J", "-b", *args, capture=True))["blockdevices"]


def root_disk():
    """The disk Monet is installed on."""
    source = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True).stdout.strip()
    source = re.sub(r"\[.*\]$", "", source)
    if not source.startswith("/dev/"):
        # Inside the installer, / may not show up as a mount; the installer
        # labels Monet's file system "monet".
        source = run("blkid", "-L", "monet", capture=True).strip()
    disk = run("lsblk", "-no", "PKNAME", source, capture=True).strip().splitlines()
    if not disk or not disk[-1]:
        raise Stop("failed", f"couldn't find the disk of {source}")
    return "/dev/" + disk[-1].strip()


def partitions(disk):
    return lsblk("-o", "PATH,PARTLABEL,PARTN,SIZE,FSTYPE", disk)[0].get("children", [])


def find_partition(disk, label):
    return next((p for p in partitions(disk) if p.get("partlabel") == label), None)


def sector_size(disk):
    return int(run("blockdev", "--getss", disk, capture=True))


def largest_free(disk):
    """(start, sectors) of the largest free area, from `sfdisk -F`."""
    best = (0, 0)
    for line in run("sfdisk", "-F", "-q", disk, capture=True).splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[0].isdigit():
            start, end = int(fields[0]), int(fields[1])
            if end - start + 1 > best[1]:
                best = (start, end - start + 1)
    return best


def make_partitions(disk):
    """Creates the Windows and setup partitions in the free space at the end."""
    win, setup = find_partition(disk, WINDOWS_LABEL), find_partition(disk, SETUP_LABEL)
    if win and setup:
        return win["path"], setup["path"], setup["partn"]

    mib = 1024 * 1024 // sector_size(disk)
    free_start, free_sectors = largest_free(disk)
    start = -(-free_start // mib) * mib
    usable = (free_start + free_sectors - start) // mib * mib
    setup_sectors = SETUP_MIB * mib
    win_sectors = usable - setup_sectors - mib
    if win_sectors < MIN_WINDOWS_MIB * mib:
        raise Stop("no-space", "there isn't enough free space on the disk for Windows")

    layout = (
        f'start={start}, size={win_sectors}, type={BASIC_DATA}, name="{WINDOWS_LABEL}"\n'
        f'start={start + win_sectors}, size={setup_sectors}, type={BASIC_DATA}, name="{SETUP_LABEL}"\n'
    )
    progress(2, "Making room for Windows")
    run("sfdisk", "--append", "--no-reread", "--no-tell-kernel", disk, stdin=layout)
    run("partx", "-a", disk, check=False)
    run("udevadm", "settle", check=False)
    time.sleep(1)

    win, setup = find_partition(disk, WINDOWS_LABEL), find_partition(disk, SETUP_LABEL)
    if not (win and setup):
        raise Stop("failed", "the new partitions didn't show up")
    run("mkfs.ntfs", "-Q", "-F", "-L", "MONETWIN", win["path"], capture=True)
    run("mkfs.vfat", "-F", "32", "-n", "MONETSETUP", setup["path"], capture=True)
    return win["path"], setup["path"], setup["partn"]


def first_user():
    """(name, full name) of the person who set up Monet."""
    for line in Path("/etc/passwd").read_text().splitlines():
        fields = line.split(":")
        if len(fields) >= 7 and fields[2].isdigit() and 1000 <= int(fields[2]) < 60000:
            full = fields[4].split(",")[0] or fields[0]
            return fields[0], full
    return "Player", "Player"


def windows_name(name):
    """Windows user names: at most 20 characters, no special characters."""
    clean = re.sub(r'["/\\\[\]:;|=,+*?<>@ ]', "", name)[:20]
    return clean or "Player"


