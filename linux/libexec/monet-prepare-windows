def read_conf(path, key):
    try:
        for line in Path(path).read_text().splitlines():
            if line.strip().startswith(key + "="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def windows_zone():
    """Monet's time zone as Windows names it, or "" for one this list doesn't know."""
    try:
        zone = os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return ""
    return TIMEZONES.get(zone, "")


def region():
    """Language, keyboard and time zone, taken from Monet's settings."""
    lang = read_conf("/etc/locale.conf", "LANG").split(".")[0] or "en_US"
    ms_lang, ui = LANGUAGES.get(lang) or LANGUAGES.get(lang.split("_")[0]) or LANGUAGES["en_US"]
    locale = lang.replace("_", "-") if "_" in lang else ui

    layout = ""
    try:
        text = Path("/etc/X11/xorg.conf.d/00-keyboard.conf").read_text()
        match = re.search(r'XkbLayout"\s+"([^",]+)', text)
        layout = match.group(1) if match else ""
    except OSError:
        pass
    layout = layout or read_conf("/etc/vconsole.conf", "KEYMAP").split("-")[0]
    keyboard = KEYBOARDS.get(layout, locale)

    try:
        zone = os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        zone = "UTC"
    return ms_lang, ui, locale, keyboard, TIMEZONES.get(zone, "UTC")


# ------------------------------------------------------- downloading Windows

def http(url, method="GET", referer=None, limit=200_000):
    headers = {"User-Agent": USER_AGENT, "Accept": "*/*"}
    if referer:
        headers["Referer"] = referer
    data = b"" if method == "POST" else None
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read(limit).decode("utf-8", "replace")


def windows_download_link(ms_lang):
    """Asks Microsoft's download page for a Windows 11 ISO link, the same way
    a web browser does."""
    page = http(MS_PAGE, limit=1_000_000)
    edition = re.search(r'<option value="(\d+)">Windows', page)
    if not edition:
        raise Stop("download-failed", "Microsoft's download page has changed")
    session = str(uuid.uuid4())
    http(f"https://vlscppe.microsoft.com/tags?org_id=y6jn8c31&session_id={session}")

    def api(name, query):
        url = f"{MS_API}/{name}?profile={MS_PROFILE}&{query}&friendlyFileName=undefined&Locale=en-US&sessionID={session}"
        for method in ("GET", "POST"):
            try:
                return json.loads(http(url, method=method, referer=MS_PAGE))
            except urllib.error.HTTPError as e:
                if e.code not in (405, 411):
                    raise
        raise Stop("download-failed", "Microsoft's download service didn't answer")

    skus = api("getskuinformationbyproductedition", f"ProductEditionId={edition.group(1)}&SKU=undefined").get("Skus", [])
    pick = next((s for s in skus if s.get("Language", "").lower() == ms_lang.lower()), None)
    pick = pick or next((s for s in skus if s.get("Language", "").lower() == "english"), None)
    if not pick:
        raise Stop("download-failed", "Microsoft didn't offer a Windows language")

    links = api("GetProductDownloadLinksBySku", f"productEditionId=undefined&SKU={pick['Id']}")
    if "Sentinel" in json.dumps(links) or links.get("Errors"):
        raise Stop("download-failed", "Microsoft blocked the automatic download")
    uris = [o.get("Uri", "") for o in links.get("ProductDownloadOptions", [])]
    uri = next((u for u in uris if "x64" in u), None)
    if not uri:
        raise Stop("download-failed", "Microsoft didn't offer a 64-bit Windows")
    return uri, pick.get("Language", "English")


def download(url, target):
    """Downloads with progress, resuming after dropped connections."""
    target.parent.mkdir(parents=True, exist_ok=True)
    for attempt in range(8):
        have = target.stat().st_size if target.exists() else 0
        headers = {"User-Agent": USER_AGENT}
        if have:
            headers["Range"] = f"bytes={have}-"
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r:
                total = have + int(r.headers.get("Content-Length", 0))
                if have and r.status != 206:
                    have, total = 0, int(r.headers.get("Content-Length", 0))
                with target.open("ab" if have else "wb") as f:
                    done, last = have, 0
                    while chunk := r.read(4 * 1024 * 1024):
                        f.write(chunk)
                        done += len(chunk)
                        if total and time.time() - last > 5:
                            last = time.time()
                            progress(5 + 60 * done / total, "Downloading Windows (%1 of %2 GB)", done >> 30, total >> 30)
            if not total or done >= total:
                return
            log("download ended early, resuming")
        except urllib.error.HTTPError as e:
            if e.code == 416:  # already complete
                return
            log(f"download interrupted: {e}")
            time.sleep(5 * (attempt + 1))
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            log(f"download interrupted: {e}")
            time.sleep(5 * (attempt + 1))
    raise Stop("download-failed", "the Windows download kept failing")


# ------------------------------------------------------- staging Windows Setup

def wim_images(path):
    """[(index, name)] of the editions in a WIM/ESD file."""
    images, index = [], None
    for line in run("wimlib-imagex", "info", path, capture=True).splitlines():
        if line.startswith("Index:"):
            index = int(line.split(":", 1)[1])
        elif line.startswith("Name:") and index is not None:
            images.append((index, line.split(":", 1)[1].strip()))
    return images


def pick_edition(images):
    """Home if the PC came with Windows (its key is in the firmware and most
    laptops ship Home, so it activates by itself), else Pro."""
    want = "Home" if Path("/sys/firmware/acpi/tables/MSDM").exists() else "Pro"
    for wanted in (f"Windows 11 {want}", "Windows 11 Pro", "Windows 11 Home"):
        for index, name in images:
            if name == wanted:
                return index, name
    return images[0]


WIFI_DIRS = (Path("/etc/NetworkManager/system-connections"), STATE / "wifi")


def wifi_profiles():
    """Wi-Fi networks Monet knows (from the installer or NetworkManager), as
    Windows WLAN profiles, so Windows is online without asking."""
    import configparser

    profiles = {}
    for folder in WIFI_DIRS:
        for path in sorted(folder.glob("*.nmconnection")) if folder.is_dir() else []:
            conf = configparser.ConfigParser(interpolation=None)
            try:
                conf.read(path)
            except configparser.Error:
                continue
            if conf.get("connection", "type", fallback="") not in ("wifi", "802-11-wireless"):
                continue
            ssid = conf.get("wifi", "ssid", fallback="")
            if not ssid or ssid in profiles:
                continue
            mgmt = conf.get("wifi-security", "key-mgmt", fallback="")
            psk = conf.get("wifi-security", "psk", fallback="")
            if mgmt in ("wpa-psk", "sae") and psk:
                auth = "WPA3SAE" if mgmt == "sae" else "WPA2PSK"
                security = (f"<authEncryption><authentication>{auth}</authentication><encryption>AES</encryption>"
                            f"<useOneX>false</useOneX></authEncryption><sharedKey><keyType>passPhrase</keyType>"
                            f"<protected>false</protected><keyMaterial>{escape(psk)}</keyMaterial></sharedKey>")
            elif not mgmt:
                security = ("<authEncryption><authentication>open</authentication><encryption>none</encryption>"
                            "<useOneX>false</useOneX></authEncryption>")
            else:
                continue  # enterprise networks need more than a password
            hidden = "<nonBroadcast>true</nonBroadcast>" if conf.getboolean("wifi", "hidden", fallback=False) else ""
            profiles[ssid] = (
                '<?xml version="1.0"?>\n'
                '<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">'
                f"<name>{escape(ssid)}</name><SSIDConfig><SSID><name>{escape(ssid)}</name></SSID>{hidden}</SSIDConfig>"
                "<connectionType>ESS</connectionType><connectionMode>auto</connectionMode>"
                f"<MSM><security>{security}</security></MSM></WLANProfile>\n"
            )
    return list(profiles.values())


def fill(template, values):
    text = template
    for key, value in values.items():
        text = text.replace(f"@{key}@", escape(value))
    return text


def require_setup_payload():
    for path in (SHARE / "winpe/monet-setup-check.exe", SHARE / "windows/monet-bridge.exe",
                 SHARE / "windows/Install-Monet.ps1"):
        if not path.is_file():
            raise Stop("no-payload", "this copy of Monet does not include the verified Windows setup files")


def file_digest(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def write_setup_handoff(setup_dir, identities):
    """Seal the exact payload and run only the copy embedded in the RAM boot image."""
    files = sorted([*setup_dir.glob("sources/install*.swm"), setup_dir / "monet/unattend.xml",
                    *(p for p in (setup_dir / "monet/bridge").rglob("*") if p.is_file())])
    job = dict(version=1, id=str(uuid.uuid4()), partitions=identities, files=[
        dict(path=p.relative_to(setup_dir).as_posix(), size=p.stat().st_size, sha256=file_digest(p)) for p in files])
    data = json.dumps(job, sort_keys=True, separators=(",", ":"))
    (setup_dir / "monet/deployment.json").write_text(data)
    with tempfile.TemporaryDirectory(prefix="monet-winpe-", dir=WORK) as tmp:
        trusted = Path(tmp)
        (trusted / "deployment.json").write_text(data)
        for name in ("deploy.cmd", "monet-setup-check.exe"):
            shutil.copyfile(SHARE / "winpe" / name, trusted / name)
        # wimlib's script has its own quoting rules; controlled paths must not inject commands.
        def quoted(path):
            value = str(path)
            if any(c in value for c in ('"', '\n', '\r')):
                raise Stop("failed", "the Windows setup work path cannot be quoted safely")
            return '"' + value + '"'
        commands = ("delete --force /Windows/System32/winpeshl.ini\n"
                    f"add {quoted(SHARE / 'winpe/winpeshl.ini')} /Windows/System32/winpeshl.ini\n"
                    f"add {quoted(SHARE / 'winpe/monet-start.cmd')} /monet-start.cmd\n"
                    "delete --force --recursive /monet\n"
                    f"add {quoted(trusted)} /monet\n")
        boot = setup_dir / "sources/boot.wim"
        run("wimlib-imagex", "update", boot, "2", stdin=commands, capture=True)
        run("wimlib-imagex", "verify", boot, capture=True)
        embedded = run("wimlib-imagex", "extract", boot, "2", "/monet/deployment.json", "--to-stdout", capture=True)
        if embedded != data:
            raise Stop("failed", "the Windows boot image did not preserve its installation record")
        # Root-owned Linux receipt is published last; a torn staging attempt is never booted.
        save_state("windows-staging.json", dict(version=1, job=job,
                   manifest_sha256=hashlib.sha256(data.encode()).hexdigest(), boot_sha256=file_digest(boot)))


def resume_staged_setup(disk):
    """Resume the same immutable payload; never erase/re-stage an in-progress installation."""
    receipt = STATE / "windows-staging.json"
    if not receipt.exists():
        return None
    if receipt.stat().st_size > 1024 * 1024:
        raise Stop("failed", "the saved Windows staging record is too large")
    saved = json.loads(receipt.read_text())
    identities = deployment_manifest(disk)
    job = saved.get("job", {})
    if saved.get("version") != 1 or job.get("partitions") != identities:
        raise Stop("failed", "the staged Windows installation no longer matches this disk")
    plan = json.loads((STATE / "windows-partitions.json").read_text())
    win, setup = mapped_partitions(disk, plan)
    mount = MOUNT / "setup-resume"
    mount.mkdir(parents=True, exist_ok=True)
    run("mount", "-o", "ro", setup["path"], mount)
    try:
        manifest = mount / "monet/deployment.json"
        if manifest.stat().st_size > 1024 * 1024:
            raise Stop("failed", "the staged Windows installation record is too large")
        data = manifest.read_bytes()
        if (hashlib.sha256(data).hexdigest() != saved.get("manifest_sha256") or json.loads(data) != job
                or file_digest(mount / "sources/boot.wim") != saved.get("boot_sha256")):
            raise Stop("failed", "the staged Windows boot image or installation record changed")
        for item in job.get("files", []):
            name = item.get("path", "")
            if (not name or not name.isascii() or any(c in name for c in ('\\', ':', '\n', '\r'))
                    or any(p in ("", ".", "..") for p in name.split("/"))):
                raise Stop("failed", "the Windows staging record contains an unsafe file path")
            path = mount / name
            if not path.is_file() or path.stat().st_size != item["size"] or file_digest(path) != item["sha256"]:
                raise Stop("failed", "a staged Windows installation file changed; refusing to resume it")
    finally:
        run("umount", mount)
    listing = subprocess.run(["ntfsls", "-a", "-p", "/", win["path"]], capture_output=True, text=True, timeout=30)
    if listing.returncode:
        raise Stop("failed", "the prepared Windows filesystem could not be inspected")
    names = {n.strip().lower() for n in listing.stdout.splitlines()} - {"", ".", ".."}
    phase = "applying"
    if ".monet-setup.json" in names:
        # A damaged/foreign file must not turn a tiny checkpoint read into an
        # unbounded RAM allocation. Limit the child output file before reading.
        def limit_record():
            resource.setrlimit(resource.RLIMIT_FSIZE, (4097, 4097))
            resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        with tempfile.TemporaryFile() as output:
            out = subprocess.run(["ntfscat", win["path"], "/.monet-setup.json"], stdout=output,
                                 stderr=subprocess.PIPE, timeout=30, preexec_fn=limit_record)
            output.seek(0)
            data = output.read(4097)
        if out.returncode or len(data) > 4096:
            raise Stop("failed", "the Windows installation checkpoint could not be read")
        checkpoint = json.loads(data)
        if (checkpoint.get("version") != 1 or checkpoint.get("job_id") != job["id"]
                or checkpoint.get("manifest_sha256") != saved["manifest_sha256"]
                or checkpoint.get("phase") not in ("applying", "applied", "complete")):
            raise Stop("failed", "the Windows installation checkpoint belongs to another preparation")
        phase = checkpoint["phase"]
    elif names - {"system volume information", "$recycle.bin", ".monet-setup.next"}:
        raise Stop("failed", "the Windows target contains unrecorded files; refusing to resume it")
    if phase == "complete" and not has_windows(win["path"]):
        raise Stop("failed", "the completed Windows installation is missing its boot loader")
    return setup["partn"], phase


def stage(iso, setup_dev, ui_lang, locale, keyboard, timezone, identities):
    require_setup_payload()
    WORK.mkdir(parents=True, exist_ok=True)
    iso_dir, setup_dir = MOUNT / "iso", MOUNT / "setup"
    for d in (iso_dir, setup_dir):
        d.mkdir(parents=True, exist_ok=True)
        run("umount", d, check=False, capture=True)
    run("mount", "-o", "loop,ro", iso, iso_dir)
    try:
        # "quiet": FAT has no permissions; don't fail when copying them.
        run("mount", "-o", "quiet", setup_dev, setup_dir)
        try:
            progress(68, "Copying Windows Setup")
            for item in setup_dir.iterdir():
                shutil.rmtree(item) if item.is_dir() else item.unlink()
            skip = {"install.wim", "install.esd", "install.swm"}
            shutil.copytree(iso_dir, setup_dir, dirs_exist_ok=True, copy_function=shutil.copyfile,
                            ignore=lambda d, names: [n for n in names if n.lower() in skip])

            source = next((iso_dir / "sources" / n for n in ("install.wim", "install.esd")
                           if (iso_dir / "sources" / n).exists()), None)
            if not source:
                raise Stop("failed", "the Windows download has no install image")
            index, name = pick_edition(wim_images(source))
            progress(72, "Preparing %1", name)
            single = WORK / "windows.wim"
            single.unlink(missing_ok=True)
            run("wimlib-imagex", "export", source, index, single, "--compress=LZX", capture=True)
            progress(85, "Preparing Windows Setup")
            run("wimlib-imagex", "split", single, setup_dir / "sources" / "install.swm", "3800", capture=True)
            single.unlink(missing_ok=True)

            winpe = SHARE / "winpe"
            monet = setup_dir / "monet"
            monet.mkdir(exist_ok=True)
            user, full = first_user()
            values = {
                "USER": windows_name(user), "FULLNAME": full[:64], "COMPUTER": windows_computer_name(user),
                "TIMEZONE": timezone, "UILANG": ui_lang, "LOCALE": locale, "INPUT": keyboard,
            }
            (monet / "unattend.xml").write_text(fill((winpe / "unattend.xml").read_text(), values))
            shutil.copytree(SHARE / "windows", monet / "bridge", dirs_exist_ok=True, copy_function=shutil.copyfile)
            profiles = wifi_profiles()
            if profiles:
                (monet / "bridge" / "wifi").mkdir(exist_ok=True)
                for i, xml in enumerate(profiles):
                    (monet / "bridge" / "wifi" / f"wifi{i}.xml").write_text(xml)
                log(f"carried {len(profiles)} Wi-Fi network(s) over to Windows")
            write_setup_handoff(setup_dir, identities)
            log(f"staged {name} for {values['USER']} ({ui_lang}, {keyboard}, {timezone})")
        finally:
            run("sync", check=False)
            run("umount", setup_dir, check=False)
    finally:
        run("umount", iso_dir, check=False)


def boot_setup_once(disk, partn):
    """Adds a boot entry for the setup partition, last in the boot order, and
    starts it on the next restart only."""
    def entries():
        out = run("efibootmgr", capture=True)
        found = re.findall(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*?)(?:\t|\s{2,}|$)", out, re.M)
        order = re.search(r"^BootOrder:\s*(\S+)", out, re.M)
        return found, (order.group(1).split(",") if order else [])

    found, _ = entries()
    for number, label in found:
        if label.strip() == BOOT_ENTRY:
            run("efibootmgr", "-q", "-b", number, "-B", check=False)

    run("efibootmgr", "-q", "-c", "-d", disk, "-p", partn, "-L", BOOT_ENTRY, "-l", "\\EFI\\BOOT\\BOOTX64.EFI")
    found, order = entries()
    number = next((n for n, label in found if label.strip() == BOOT_ENTRY), None)
    if not number:
        raise Stop("failed", "the setup boot entry wasn't created")
    order = [n for n in order if n.upper() != number.upper()] + [number]
    run("efibootmgr", "-q", "-o", ",".join(order))
    run("efibootmgr", "-q", "-n", number)


# ----------------------------------------------------------------- main

def prepare_main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--iso", type=Path)
    parser.add_argument("--windows-zone", action="store_true")
    recovery = parser.add_mutually_exclusive_group()
    recovery.add_argument("--inspect-recovery", type=Path, metavar="PLAN", help="check a reviewed legacy partition plan without changing storage")
    recovery.add_argument("--recover-plan", type=Path, metavar="PLAN", help="adopt verified unformatted legacy partitions and prepare Windows")
    args = parser.parse_args()
    if args.windows_zone:
        # For a trip: Windows' clock in Monet's time zone (monet's request carries it).
        print(windows_zone())
        return 0
    iso = args.iso
    if os.geteuid() != 0:
        print("monet-prepare-windows needs to run as root.", file=sys.stderr)
        return 1
    if not Path("/sys/firmware/efi").is_dir():
        print("This PC didn't start in UEFI mode.", file=sys.stderr)
        return 1

    if args.inspect_recovery:
        try:
            print(recover_partition_plan(root_disk(), json.loads(args.inspect_recovery.read_text())))
            return 0
        except (Stop, OSError, ValueError) as error:
            print(f"Recovery inspection stopped: {error}", file=sys.stderr)
            return 2

    set_status("preparing")
    progress(0, "Getting Windows ready")
    downloaded = False
    try:
        disk = root_disk()
        require_setup_payload()
        recovery_plan = json.loads(args.recover_plan.read_text()) if args.recover_plan else None
        if recovery_plan is not None:
            log(recover_partition_plan(disk, recovery_plan))
        resume = resume_staged_setup(disk)
        if resume:
            partn, phase = resume
            if phase == "complete":
                set_status("staged")
                progress(100, "Windows is ready to start")
                return 0
            boot_setup_once(disk, partn)
            set_status("pending")
            progress(100, "Windows setup continues at the next restart")
            return 0
        ms_lang, ui, locale, keyboard, timezone = region()

        if iso is None:
            if shutil.disk_usage("/var/tmp").free < 16 * 1024**3:
                raise Stop("no-space", "there isn't enough free space to download Windows")
            progress(4, "Asking Microsoft for Windows 11")
            url, got = windows_download_link(ms_lang)
            if got.lower() != ms_lang.lower():
                ui = "en-US"
            iso = WORK / "windows.iso"
            downloaded = True
            download(url, iso)
        # Obtain the media before creating or formatting anything. Microsoft can
        # reject automatic downloads; that failure must leave storage untouched.
        if not iso.is_file() or iso.stat().st_size == 0:
            raise Stop("download-failed", "the Windows ISO file is missing or empty")
        if recovery_plan is not None:
            log(recover_partition_plan(disk, recovery_plan, adopt=True))
        win_dev, setup_dev, partn = make_partitions(disk)
        identities = deployment_manifest(disk)
        stage(iso, setup_dev, ui, locale, keyboard, timezone, identities)
        if deployment_manifest(disk) != identities:
            raise Stop("failed", "the prepared Windows disk changed while copying setup")
        progress(97, "Getting ready to restart")
        boot_setup_once(disk, partn)
        set_status("pending")
        progress(100, "Windows installs itself at the next restart")
        return 0
    except Stop as e:
        log(f"stopped: {e}")
        set_status(e.status)
        progress(0, str(e))
        return 2
    except Exception as e:  # never break the Monet install
        log(f"failed: {e!r}")
        set_status("failed")
        return 3
    finally:
        if downloaded and iso and iso.exists() and STATUS.read_text() == "pending":
            iso.unlink(missing_ok=True)
        shutil.rmtree(STATE / "wifi", ignore_errors=True)


def main():
    if "--windows-zone" in sys.argv[1:] or os.geteuid() != 0:
        return prepare_main()
    MOUNT.mkdir(parents=True, exist_ok=True)
    with (MOUNT / "windows-setup.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Windows preparation is already running.", file=sys.stderr)
            return 2
        return prepare_main()


if __name__ == "__main__":
    sys.exit(main())
