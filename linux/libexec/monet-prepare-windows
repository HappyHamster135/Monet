KEYBOARDS = {
    "us": "en-US", "gb": "en-GB", "uk": "en-GB", "ie": "en-IE", "se": "sv-SE", "de": "de-DE",
    "fr": "fr-FR", "es": "es-ES", "latam": "es-MX", "it": "it-IT", "no": "nb-NO", "dk": "da-DK",
    "fi": "fi-FI", "nl": "nl-NL", "be": "fr-BE", "ch": "de-CH", "pl": "pl-PL", "pt": "pt-PT",
    "br": "pt-BR", "ca": "fr-CA", "jp": "ja-JP", "kr": "ko-KR", "cz": "cs-CZ", "hu": "hu-HU",
