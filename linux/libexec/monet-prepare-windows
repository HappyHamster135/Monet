def read_conf(path, key):
    try:
        for line in Path(path).read_text().splitlines():
            if line.strip().startswith(key + "="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def region():
    """Language, keyboard and time zone, taken from Monet's settings."""
    lang = read_conf("/etc/locale.conf", "LANG").split(".")[0] or "en_US"
    ms_lang, ui = LANGUAGES.get(lang) or LANGUAGES.get(lang.split("_")[0]) or LANGUAGES["en_US"]
    locale = lang.replace("_", "-") if "_" in lang else ui

    layout = ""
    try:
        text = Path("/etc/X11/xorg.conf.d/00-keyboard.conf").read_text()
        match = re.search(r'XkbLayout"\s+"([^",]+)', text)
        layout = match.group(1) if match else ""
    except OSError:
        pass
    layout = layout or read_conf("/etc/vconsole.conf", "KEYMAP").split("-")[0]
    keyboard = KEYBOARDS.get(layout, locale)

    try:
        zone = os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        zone = "UTC"
    return ms_lang, ui, locale, keyboard, TIMEZONES.get(zone, "UTC")


# ------------------------------------------------------- downloading Windows

def http(url, method="GET", referer=None, limit=200_000):
    headers = {"User-Agent": USER_AGENT, "Accept": "*/*"}
    if referer:
        headers["Referer"] = referer
    data = b"" if method == "POST" else None
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read(limit).decode("utf-8", "replace")


def windows_download_link(ms_lang):
    """Asks Microsoft's download page for a Windows 11 ISO link, the same way
    a web browser does."""
    page = http(MS_PAGE, limit=1_000_000)
    edition = re.search(r'<option value="(\d+)">Windows', page)
    if not edition:
        raise Stop("download-failed", "Microsoft's download page has changed")
    session = str(uuid.uuid4())
    http(f"https://vlscppe.microsoft.com/tags?org_id=y6jn8c31&session_id={session}")

    def api(name, query):
        url = f"{MS_API}/{name}?profile={MS_PROFILE}&{query}&friendlyFileName=undefined&Locale=en-US&sessionID={session}"
        for method in ("GET", "POST"):
            try:
                return json.loads(http(url, method=method, referer=MS_PAGE))
            except urllib.error.HTTPError as e:
                if e.code not in (405, 411):
                    raise
        raise Stop("download-failed", "Microsoft's download service didn't answer")

    skus = api("getskuinformationbyproductedition", f"ProductEditionId={edition.group(1)}&SKU=undefined").get("Skus", [])
    pick = next((s for s in skus if s.get("Language", "").lower() == ms_lang.lower()), None)
    pick = pick or next((s for s in skus if s.get("Language", "").lower() == "english"), None)
    if not pick:
        raise Stop("download-failed", "Microsoft didn't offer a Windows language")

    links = api("GetProductDownloadLinksBySku", f"productEditionId=undefined&SKU={pick['Id']}")
    if "Sentinel" in json.dumps(links) or links.get("Errors"):
        raise Stop("download-failed", "Microsoft blocked the automatic download")
    uris = [o.get("Uri", "") for o in links.get("ProductDownloadOptions", [])]
    uri = next((u for u in uris if "x64" in u), None)
    if not uri:
        raise Stop("download-failed", "Microsoft didn't offer a 64-bit Windows")
    return uri, pick.get("Language", "English")


def download(url, target):
    """Downloads with progress, resuming after dropped connections."""
    target.parent.mkdir(parents=True, exist_ok=True)
    for attempt in range(8):
        have = target.stat().st_size if target.exists() else 0
        headers = {"User-Agent": USER_AGENT}
        if have:
            headers["Range"] = f"bytes={have}-"
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r:
                total = have + int(r.headers.get("Content-Length", 0))
                if have and r.status != 206:
                    have, total = 0, int(r.headers.get("Content-Length", 0))
                with target.open("ab" if have else "wb") as f:
                    done, last = have, 0
                    while chunk := r.read(4 * 1024 * 1024):
                        f.write(chunk)
                        done += len(chunk)
                        if total and time.time() - last > 5:
                            last = time.time()
                            progress(5 + 60 * done / total, f"Downloading Windows ({done >> 30} of {total >> 30} GB)")
            if not total or done >= total:
                return
            log("download ended early, resuming")
        except urllib.error.HTTPError as e:
            if e.code == 416:  # already complete
                return
            log(f"download interrupted: {e}")
            time.sleep(5 * (attempt + 1))
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            log(f"download interrupted: {e}")
            time.sleep(5 * (attempt + 1))
    raise Stop("download-failed", "the Windows download kept failing")


# ------------------------------------------------------- staging Windows Setup

def wim_images(path):
    """[(index, name)] of the editions in a WIM/ESD file."""
    images, index = [], None
    for line in run("wimlib-imagex", "info", path, capture=True).splitlines():
        if line.startswith("Index:"):
            index = int(line.split(":", 1)[1])
        elif line.startswith("Name:") and index is not None:
            images.append((index, line.split(":", 1)[1].strip()))
    return images


def pick_edition(images):
    """Home if the PC came with Windows (its key is in the firmware and most
    laptops ship Home, so it activates by itself), else Pro."""
    want = "Home" if Path("/sys/firmware/acpi/tables/MSDM").exists() else "Pro"
    for wanted in (f"Windows 11 {want}", "Windows 11 Pro", "Windows 11 Home"):
        for index, name in images:
            if name == wanted:
                return index, name
    return images[0]


WIFI_DIRS = (Path("/etc/NetworkManager/system-connections"), STATE / "wifi")


def wifi_profiles():
    """Wi-Fi networks Monet knows (from the installer or NetworkManager), as
    Windows WLAN profiles, so Windows is online without asking."""
    import configparser

    profiles = {}
    for folder in WIFI_DIRS:
        for path in sorted(folder.glob("*.nmconnection")) if folder.is_dir() else []:
            conf = configparser.ConfigParser(interpolation=None)
            try:
                conf.read(path)
            except configparser.Error:
                continue
            if conf.get("connection", "type", fallback="") not in ("wifi", "802-11-wireless"):
                continue
            ssid = conf.get("wifi", "ssid", fallback="")
            if not ssid or ssid in profiles:
                continue
            mgmt = conf.get("wifi-security", "key-mgmt", fallback="")
            psk = conf.get("wifi-security", "psk", fallback="")
            if mgmt in ("wpa-psk", "sae") and psk:
                auth = "WPA3SAE" if mgmt == "sae" else "WPA2PSK"
                security = (f"<authEncryption><authentication>{auth}</authentication><encryption>AES</encryption>"
                            f"<useOneX>false</useOneX></authEncryption><sharedKey><keyType>passPhrase</keyType>"
                            f"<protected>false</protected><keyMaterial>{escape(psk)}</keyMaterial></sharedKey>")
            elif not mgmt:
                security = ("<authEncryption><authentication>open</authentication><encryption>none</encryption>"
                            "<useOneX>false</useOneX></authEncryption>")
            else:
                continue  # enterprise networks need more than a password
            hidden = "<nonBroadcast>true</nonBroadcast>" if conf.getboolean("wifi", "hidden", fallback=False) else ""
            profiles[ssid] = (
                '<?xml version="1.0"?>\n'
                '<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">'
                f"<name>{escape(ssid)}</name><SSIDConfig><SSID><name>{escape(ssid)}</name></SSID>{hidden}</SSIDConfig>"
                "<connectionType>ESS</connectionType><connectionMode>auto</connectionMode>"
                f"<MSM><security>{security}</security></MSM></WLANProfile>\n"
            )
    return list(profiles.values())


def fill(template, values):
    text = template
    for key, value in values.items():
        text = text.replace(f"@{key}@", escape(value))
    return text


def stage(iso, setup_dev, ui_lang, locale, keyboard, timezone):
    iso_dir, setup_dir = MOUNT / "iso", MOUNT / "setup"
    for d in (iso_dir, setup_dir):
        d.mkdir(parents=True, exist_ok=True)
        run("umount", d, check=False, capture=True)
    run("mount", "-o", "loop,ro", iso, iso_dir)
    try:
        # "quiet": FAT has no permissions; don't fail when copying them.
        run("mount", "-o", "quiet", setup_dev, setup_dir)
        try:
            progress(68, "Copying Windows Setup")
            for item in setup_dir.iterdir():
                shutil.rmtree(item) if item.is_dir() else item.unlink()
            skip = {"install.wim", "install.esd", "install.swm"}
            shutil.copytree(iso_dir, setup_dir, dirs_exist_ok=True, copy_function=shutil.copyfile,
                            ignore=lambda d, names: [n for n in names if n.lower() in skip])

            source = next((iso_dir / "sources" / n for n in ("install.wim", "install.esd")
                           if (iso_dir / "sources" / n).exists()), None)
            if not source:
                raise Stop("failed", "the Windows download has no install image")
            index, name = pick_edition(wim_images(source))
            progress(72, f"Preparing {name}")
            single = WORK / "windows.wim"
            single.unlink(missing_ok=True)
            run("wimlib-imagex", "export", source, index, single, "--compress=LZX", capture=True)
            progress(85, "Preparing Windows Setup")
            run("wimlib-imagex", "split", single, setup_dir / "sources" / "install.swm", "3800", capture=True)
            single.unlink(missing_ok=True)

            # Run Monet's install script instead of the Setup wizard.
            winpe = SHARE / "winpe"
            commands = (
                "delete --force /Windows/System32/winpeshl.ini\n"
                f"add {winpe / 'winpeshl.ini'} /Windows/System32/winpeshl.ini\n"
                f"add {winpe / 'monet-start.cmd'} /monet-start.cmd\n"
            )
            run("wimlib-imagex", "update", setup_dir / "sources" / "boot.wim", "2", stdin=commands, capture=True)

            monet = setup_dir / "monet"
            monet.mkdir(exist_ok=True)
            shutil.copyfile(winpe / "deploy.cmd", monet / "deploy.cmd")
            user, full = first_user()
            values = {
                "USER": windows_name(user), "FULLNAME": full[:64], "COMPUTER": "MONET-GAMES",
                "TIMEZONE": timezone, "UILANG": ui_lang, "LOCALE": locale, "INPUT": keyboard,
            }
            (monet / "unattend.xml").write_text(fill((winpe / "unattend.xml").read_text(), values))
            shutil.copytree(SHARE / "windows", monet / "bridge", dirs_exist_ok=True, copy_function=shutil.copyfile)
            profiles = wifi_profiles()
            if profiles:
                (monet / "bridge" / "wifi").mkdir(exist_ok=True)
                for i, xml in enumerate(profiles):
                    (monet / "bridge" / "wifi" / f"wifi{i}.xml").write_text(xml)
                log(f"carried {len(profiles)} Wi-Fi network(s) over to Windows")
            log(f"staged {name} for {values['USER']} ({ui_lang}, {keyboard}, {timezone})")
        finally:
            run("sync", check=False)
            run("umount", setup_dir, check=False)
    finally:
        run("umount", iso_dir, check=False)


def boot_setup_once(disk, partn):
    """Adds a boot entry for the setup partition, last in the boot order, and
    starts it on the next restart only."""
    def entries():
        out = run("efibootmgr", capture=True)
        found = re.findall(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*?)(?:\t|\s{2,}|$)", out, re.M)
        order = re.search(r"^BootOrder:\s*(\S+)", out, re.M)
        return found, (order.group(1).split(",") if order else [])

    found, _ = entries()
    for number, label in found:
        if label.strip() == BOOT_ENTRY:
            run("efibootmgr", "-q", "-b", number, "-B", check=False)

    run("efibootmgr", "-q", "-c", "-d", disk, "-p", partn, "-L", BOOT_ENTRY, "-l", "\\EFI\\BOOT\\BOOTX64.EFI")
    found, order = entries()
    number = next((n for n, label in found if label.strip() == BOOT_ENTRY), None)
    if not number:
        raise Stop("failed", "the setup boot entry wasn't created")
    order = [n for n in order if n.upper() != number.upper()] + [number]
    run("efibootmgr", "-q", "-o", ",".join(order))
    run("efibootmgr", "-q", "-n", number)


# ----------------------------------------------------------------- main

def main():
    args = sys.argv[1:]
    iso = Path(args[args.index("--iso") + 1]) if "--iso" in args else None
    if os.geteuid() != 0:
        print("monet-prepare-windows needs to run as root.", file=sys.stderr)
        return 1
    if not Path("/sys/firmware/efi").is_dir():
        print("This PC didn't start in UEFI mode.", file=sys.stderr)
        return 1

    set_status("preparing")
    progress(0, "Getting Windows ready")
    downloaded = False
    try:
        disk = root_disk()
        win_dev, setup_dev, partn = make_partitions(disk)
        ms_lang, ui, locale, keyboard, timezone = region()

        if iso is None:
            if shutil.disk_usage("/var/tmp").free < 16 * 1024**3:
                raise Stop("no-space", "there isn't enough free space to download Windows")
            progress(4, "Asking Microsoft for Windows 11")
            url, got = windows_download_link(ms_lang)
            if got.lower() != ms_lang.lower():
                ui = "en-US"
            iso = WORK / "windows.iso"
            downloaded = True
            download(url, iso)
        stage(iso, setup_dev, ui, locale, keyboard, timezone)
        progress(97, "Getting ready to restart")
        boot_setup_once(disk, partn)
        set_status("pending")
        progress(100, "Windows installs itself at the next restart")
        return 0
    except Stop as e:
        log(f"stopped: {e}")
        set_status(e.status)
        progress(0, str(e))
        return 2
    except Exception as e:  # never break the Monet install
        log(f"failed: {e!r}")
        set_status("failed")
        return 3
    finally:
        if downloaded and iso and iso.exists() and STATUS.read_text() == "pending":
            iso.unlink(missing_ok=True)
        shutil.rmtree(STATE / "wifi", ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
