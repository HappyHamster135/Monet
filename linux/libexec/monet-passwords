#!/usr/bin/python3
"""Monet Passwords: a readable native manager for the encrypted desktop vault."""
from pathlib import Path
import sys
DATADIR = '@DATADIR@'
LIBEXECDIR = '@LIBEXECDIR@'
sys.path[:0] = [str(Path(DATADIR) / 'monet/passwords'), str(Path(DATADIR) / 'monet/passwords/vendor')]


def metadata_command(command):
    """Non-secret CLI for Settings. Never accepts or returns credential values."""
    import json
    from vault import NativeWallet
    transport = None
    try:
        transport = NativeWallet()
        wallet = str(transport.call('localWallet'))
        if command == '--lock':
            transport.lock_wallet(wallet)
            result = {'ok': True}
        else:
            locked = transport.wallet_locked(wallet)
            result = {'unlocked': not locked if locked is not None else None}
        print(json.dumps(result))
        return 0
    except Exception:
        print(json.dumps({'ok': False, 'unlocked': None}))
        return 1
    finally:
        if transport:
            transport.close_connection()


if __name__ == '__main__':
    if len(sys.argv) == 2 and sys.argv[1] == '--app-support':
        from app_support_ui import main
        sys.exit(main())
    if len(sys.argv) >= 2 and sys.argv[1] in ('--app-login-status', '--app-login-policy', '--app-login-enabled', '--watch-app-logins', '--app-login-prompt', '--app-login-fill'):
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        import json
        from app_logins import policy
        from app_offers import status, configure, main
        option = sys.argv[1]
        if option == '--app-login-enabled':
            sys.exit(0 if policy()['enabled'] else 1)
        if option == '--app-login-status':
            print(json.dumps(status())); sys.exit(0)
        if option == '--app-login-policy':
            result = configure(sys.argv[2] if len(sys.argv) == 3 else '')
            print(json.dumps(result)); sys.exit(0 if result['ok'] else 1)
        if option == '--app-login-prompt':
            from app_prompt import main
            sys.exit(main())
        if option == '--app-login-fill':
            from app_fill import main
            sys.exit(main())
        sys.exit(main(str(Path(__file__).resolve())))
    if len(sys.argv) == 2 and sys.argv[1] in ('--lock', '--status'):
        sys.exit(metadata_command(sys.argv[1]))
    if len(sys.argv) == 2 and sys.argv[1] == '--browser-prompt':
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        from browser_prompt import main
        sys.exit(main())
    from app import main
    sys.exit(main(DATADIR, str(Path(LIBEXECDIR) / 'monet-quick')))
