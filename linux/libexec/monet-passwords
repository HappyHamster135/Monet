#!/usr/bin/python3
"""Monet Passwords: a readable native manager for the encrypted desktop vault."""
from pathlib import Path
import sys
DATADIR = '@DATADIR@'
LIBEXECDIR = '@LIBEXECDIR@'
sys.path[:0] = [str(Path(DATADIR) / 'monet/passwords'), str(Path(DATADIR) / 'monet/passwords/vendor')]


def metadata_command(command):
    """Non-secret CLI for Settings. Never accepts or returns credential values."""
    import json
    from vault import NativeWallet
    transport = None
    try:
        transport = NativeWallet()
        wallet = str(transport.call('localWallet'))
        if command == '--lock':
            transport.lock_wallet(wallet)
            result = {'ok': True}
        else:
            locked = transport.wallet_locked(wallet)
            result = {'unlocked': not locked if locked is not None else None}
        print(json.dumps(result))
        return 0
    except Exception:
        print(json.dumps({'ok': False, 'unlocked': None}))
        return 1
    finally:
        if transport:
            transport.close_connection()


if __name__ == '__main__':
    if len(sys.argv) == 2 and sys.argv[1] in ('--lock', '--status'):
        sys.exit(metadata_command(sys.argv[1]))
    if len(sys.argv) == 2 and sys.argv[1] == '--connect-zen':
        from browser_setup import main
        sys.exit(main(str(Path(LIBEXECDIR) / 'monet-passwords-browser')))
    if len(sys.argv) == 2 and sys.argv[1] == '--browser-prompt':
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        from browser_prompt import main
        sys.exit(main())
    from app import main
    sys.exit(main(DATADIR, str(Path(LIBEXECDIR) / 'monet-quick')))
