#!/usr/bin/env bash
# Runs at sign-in, before KWin and Plasma start, for what Plasma only reads as
# it starts. When Monet has changed, it forgets what KDE measured in Monet's
# pictures before: KDE keeps those measurements by file and modification time,
# and on Monet's image every file keeps the same time from one version to the
# next, so a new version would be drawn with the old one's sizes (window
# buttons missing, glass out of line, new icons not found).
set -u

BINDIR="@BINDIR@"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
stamp="$CACHE/monet-version"
version="$("$BINDIR/monet" --version 2>/dev/null)"

# The desktop's right-click menu offers Add or Manage Widgets, which KDE hides
# there: once per account, here because Plasma reads it only as it starts.
# Without any mouse settings yet (a new account), KDE's own come first.
if [ ! -e "$CONFIG/monet/menu-add-widgets" ] && command -v kwriteconfig6 >/dev/null; then
    rc=plasma-org.kde.plasma.desktop-appletsrc
    if [ -z "$(kreadconfig6 --file "$rc" --group ActionPlugins --group 0 --key "RightButton;NoModifier" 2>/dev/null)" ]; then
        kwriteconfig6 --file "$rc" --group ActionPlugins --group 0 --key "RightButton;NoModifier" org.kde.contextmenu
        kwriteconfig6 --file "$rc" --group ActionPlugins --group 0 --key "MiddleButton;NoModifier" org.kde.paste
    fi
    kwriteconfig6 --file "$rc" --group ActionPlugins --group 0 --group "RightButton;NoModifier" --key "add widgets" true
    mkdir -p "$CONFIG/monet" && touch "$CONFIG/monet/menu-add-widgets"
fi

# Brightness and Night Light are in Quick Settings, beside Mist and Smoke: KDE's
# own panel for them, with its Dark Mode switch, leaves the bar. Once per
# account with a bar (a new one gets it from Monet's layout), here because
# Plasma reads its tray only as it starts. Known but not chosen, or the tray
# would add it back as new. Plasma 6 keeps the tray's items in the tray's own
# settings, [Containments][bar][Applets][tray][General]; until a bar has a tray,
# it's tried again at the next sign-in.
rc=plasma-org.kde.plasma.desktop-appletsrc
if [ ! -e "$CONFIG/monet/tray-brightness-6" ] && [ -e "$CONFIG/$rc" ] && command -v kwriteconfig6 >/dev/null; then
    trays="$(awk '/^\[/ { tray = ""; if ($0 ~ /^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/) { tray = $0; gsub(/\]\[Applets\]\[/, " ", tray); gsub(/[^0-9 ]/, "", tray) } }
                  /^plugin=org\.kde\.plasma\.systemtray$/ && tray != "" { print tray }' "$CONFIG/$rc")"
    while read -r bar tray; do
        [ -n "$tray" ] || continue
        general=(--file "$rc" --group Containments --group "$bar" --group Applets --group "$tray" --group General)
        extra="$(kreadconfig6 "${general[@]}" --key extraItems | tr ',' '\n' | grep -vx org.kde.plasma.brightness | paste -sd, -)"
        known="$(kreadconfig6 "${general[@]}" --key knownItems)"
        case ",$known," in
            *,org.kde.plasma.brightness,*) ;;
            *) known="${known:+$known,}org.kde.plasma.brightness" ;;
        esac
        kwriteconfig6 "${general[@]}" --key extraItems "$extra"
        kwriteconfig6 "${general[@]}" --key knownItems "$known"
    done <<< "$trays"
    [ -n "$trays" ] && mkdir -p "$CONFIG/monet" && touch "$CONFIG/monet/tray-brightness-6"
fi

[ -z "$version" ] || [ "$(cat "$stamp" 2>/dev/null)" = "$version" ] && exit 0
rm -f "$CACHE/ksvg-elements" "$CACHE"/plasma_theme_*.kcache "$CACHE"/plasma-svgelements* "$CACHE/icon-cache.kcache"
mkdir -p "$CACHE" && printf '%s\n' "$version" > "$stamp"
exit 0
