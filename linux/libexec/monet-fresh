#!/usr/bin/env bash
# Runs at sign-in, before KWin and Plasma start. When Monet has changed, it
# forgets what KDE measured in Monet's pictures before: KDE keeps those
# measurements by file and modification time, and on Monet's image every file
# keeps the same time from one version to the next, so a new version would be
# drawn with the old one's sizes (window buttons missing, glass out of line,
# new icons not found).
set -u

BINDIR="@BINDIR@"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
stamp="$CACHE/monet-version"
version="$("$BINDIR/monet" --version 2>/dev/null)"

[ -z "$version" ] || [ "$(cat "$stamp" 2>/dev/null)" = "$version" ] && exit 0
rm -f "$CACHE/ksvg-elements" "$CACHE"/plasma_theme_*.kcache "$CACHE"/plasma-svgelements* "$CACHE/icon-cache.kcache"
mkdir -p "$CACHE" && printf '%s\n' "$version" > "$stamp"
exit 0
