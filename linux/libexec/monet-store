#!/usr/bin/python3
"""Store: apps for Monet from Flathub, in Monet's own window, and the apps you have in Windows.

    monet-store [WHAT]            open the Store (or bring the open one forward) at WHAT: an
                                  app's id (appstream://ID too), search:WORDS, or a section
    monet-store --worker          drain the saved download queue, outside the Store window
    monet-store --do install|remove REF
                                  one app in or out, saying how far it
                                  is as lines of JSON: {"done": 0.42}, then {"ok": true} or
                                  {"error": "..."}

The catalog is Flathub's own, which Flatpak keeps on the PC and up to date: names, words and
pictures in the session's language, read here in under a second. Monet's picks (store/
content.yaml) make the front page, Flathub's monthly installs put the apps people use first,
and Bazzite's blocklist keeps out what doesn't belong in a store. A search also finds the apps
in your Windows (monet-windows-drive lists them), and suggests apps for familiar tasks from
other systems. Installing goes through Flatpak's own
library, which asks polkit (an administrator installs without a password, as in any store).
"""
import json
import math
import os
import re
import sys
import threading
import time
import unicodedata
import urllib.request
import xml.etree.ElementTree as ET
from importlib.machinery import SourceFileLoader
