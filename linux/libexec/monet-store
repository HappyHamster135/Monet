# ---------------------------------------------------------------- reading the catalog

def fold(text):
    """Without accents or capitals: "etretat" finds "Étretat"."""
    return "".join(c for c in unicodedata.normalize("NFKD", text or "") if not unicodedata.combining(c)).lower()


def languages(env=None):
    """The session's language as AppStream names it, nearest first: ["pt-BR", "pt_BR", "pt"]."""
    env = os.environ if env is None else env
    lang = next(filter(None, (env.get(k) for k in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"))), "")
    lang = re.split(r"[.@:]", lang)[0]
    if not lang or lang in ("C", "POSIX"):
        return []
    base = lang.split("_")[0]
    found = [lang.replace("_", "-"), lang]
    found += {"zh_CN": ["zh-Hans"], "zh_TW": ["zh-Hant"], "nb": ["nb-NO", "no"]}.get(lang, [])
    return list(dict.fromkeys(found + [base]))


def localized(element, tag, langs):
    """The text of the child `tag` in the nearest language, else the untranslated one."""
    plain, found = None, {}
    for child in element.findall(tag):
        lang = child.get(LANG)
        if lang is None:
            plain = plain if plain is not None else child.text
        else:
            found.setdefault(lang, child.text)
    for lang in langs:
        if found.get(lang):
            return found[lang].strip()
    return (plain or "").strip()


def nearest(elements, langs):
    """Of an element given once per language, the one in the nearest language, else the
    untranslated one (or None)."""
    by_lang = {e.get(LANG): e for e in elements}
    return next((by_lang[l] for l in langs if l in by_lang), by_lang.get(None))


def html(text):
    return (text or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def description(element, langs):
    """An AppStream description (paragraphs and lists) as the plain HTML QML's Text shows, in
    the nearest language it's written in (a catalog gives a description per language, or one
    with its paragraphs per language)."""
    if element is None:
        return ""
    present = {e.get(LANG) for e in element.iter() if e.get(LANG) and e is not element}
    lang = next((l for l in langs if l in present), None)

    def words(e):
        inside = html(e.text)
        for c in e:
            tag = {"em": "i", "code": "code"}.get(c.tag)
            inside += f"<{tag}>{html(c.text)}</{tag}>" if tag else html(c.text)
            inside += html(c.tail)
        return " ".join(inside.split())

    out = []
    for child in element:
        if child.tag == "p" and child.get(LANG) == lang:
            out.append(f"<p>{words(child)}</p>")
        elif child.tag in ("ul", "ol"):
            items = [f"<li>{words(li)}</li>" for li in child.findall("li") if li.get(LANG) == lang]
            if items:
                out.append(f"<{child.tag}>{''.join(items)}</{child.tag}>")
    return "".join(out)


def screenshots(element, langs=()):
    """[{image (for the page), thumb, caption}], the default one first."""
    shots = []
    for shot in element.findall("screenshot") if element is not None else []:
        images = []
        for image in shot.findall("image"):
            try:
                width = int(image.get("width") or 0)
            except ValueError:
                width = 0
            if image.text and image.text.startswith("https://"):
                images.append((width, image.get("type") or "", image.text.strip()))
        if not images:
            continue
        thumbs = sorted(i for i in images if i[1] == "thumbnail")
        source = next((i for i in images if i[1] == "source"), images[-1])
        big = next((i for i in thumbs if i[0] >= 1200), source)
        small = next((i for i in thumbs if i[0] >= 600), big)
        entry = {"image": big[2], "thumb": small[2], "caption": localized(shot, "caption", langs)}
        if shot.get("type") == "default":
            shots.insert(0, entry)
        else:
            shots.append(entry)
    return shots[:8]


def icon_of(component, folder):
    """The cached icon's file (128, else 64 pixels), or Flathub's own picture of it."""
    remote = ""
    for icon in component.findall("icon"):
        kind, name = icon.get("type"), (icon.text or "").strip()
        if kind == "cached" and name and "/" not in name and icon.get("scale") in (None, "1"):
            for size in ("128x128", "64x64"):
                path = folder / "icons" / size / name
                if path.is_file():
                    return path.as_uri()
        elif kind == "remote" and name.startswith("https://") and not remote:
            remote = name
    return remote


def read_catalog(folder, langs, blocked=frozenset()):
    """{id: app} of the desktop apps in a Flathub catalog folder (appstream.xml there)."""
    path = folder / "appstream.xml"
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return {}
    apps = {}
    for c in root:
        if c.get("type") not in ("desktop-application", "desktop"):
            continue
        app_id = (c.findtext("id") or "").strip()
        bundle = next((b.text.strip() for b in c.findall("bundle") if b.get("type") == "flatpak" and b.text), "")
        if not APP_ID.fullmatch(app_id.removesuffix(".desktop")) or not REF.fullmatch(bundle):
            continue
        app_id = bundle.split("/")[1]
        if app_id in blocked:
            continue
        developer = c.find("developer")
        custom = {v.get("key"): (v.text or "") for v in c.iter("value")}
        release = c.find("releases/release")
        license_ = (c.findtext("project_license") or "").strip()
        apps[app_id] = {
            "id": app_id,
            "name": localized(c, "name", langs) or app_id,
            "summary": localized(c, "summary", langs),
            "description": description(nearest(c.findall("description"), langs), langs),
            "developer": (localized(developer, "name", langs) if developer is not None else "")
                         or (c.findtext("developer_name") or "").strip(),
            "verified": custom.get("flathub::verification::verified") == "true",
            "license": license_,
            "free": bool(license_) and "LicenseRef-proprietary" not in license_,
            "categories": [x.text for x in c.findall("categories/category") if x.text],
            "keywords": sorted({fold(k.text) for group in c.findall("keywords") for k in group.findall("keyword")
                                if k.text and (group.get(LANG) or k.get(LANG)) in (None, *langs)}),
            "icon": icon_of(c, folder),
            "screenshots": screenshots(c.find("screenshots"), langs),
            "version": release.get("version", "") if release is not None else "",
            "released": int(release.get("timestamp") or 0) if release is not None and (release.get("timestamp") or "").isdigit() else 0,
            "homepage": next((u.text.strip() for u in c.findall("url") if u.get("type") == "homepage" and u.text), ""),
            "launch": next((x.text.strip() for x in c.findall("launchable") if x.get("type") == "desktop-id" and x.text),
                           f"{app_id}.desktop"),
            "ref": bundle,
        }
    return apps


def blocklist(path=BLOCKLIST, desktop="KDE"):
    """The ids Bazzite keeps out of its store: each block without conditions, or one for this
    desktop (the file is simple YAML: read as lines, no YAML library needed)."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return frozenset()
    blocked, current, applies, in_block = set(), [], True, False
    for line in lines + ["  - priority: end"]:
        stripped = line.strip()
        if stripped.startswith("- priority:"):
            if applies:
                blocked |= set(current)
            current, applies, in_block = [], True, False
        elif stripped.startswith("regex:"):
            applies = desktop in stripped
        elif stripped == "block:":
            in_block = True
        elif in_block and stripped.startswith("- "):
            current.append(stripped[2:].strip())
        elif stripped.endswith(":"):
            in_block = False
    return frozenset(blocked)


def picks(path=PICKS):
    """Monet's picks: [(section id, [app ids])] from the front page's file, in order."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return []
    found, current = [], None
    for line in lines:
        title = re.match(r'\s*title:\s*"([^"]+)"', line)
        if title:
            current = (title.group(1), [])
            found.append(current)
        app = re.match(r"\s*-\s+([A-Za-z0-9_.-]+\.[A-Za-z0-9_-]+)\s*$", line)
        if app and current is not None:
            current[1].append(app.group(1))
    ids = {"Play": "play", "Talk & stream": "talk", "Music & film": "watch", "Work & make": "work", "Everyday": "everyday"}
    return [(ids.get(t, fold(t).replace(" ", "-")), apps) for t, apps in found if apps]


# ---------------------------------------------------------------- finding and ordering

def score(app, words, popular):
    """How well an app answers the words (all of them must be in it somewhere): its name
    first, then its keywords (GIMP's include "photoshop"), its id and its summary; then how
    many people use it. 0 when it doesn't."""
    name, total = fold(app["name"]), 0.0
    phrase = " ".join(words)
    if name == phrase:
        total += 120
    for w in words:
        parts = re.split(r"[\s\-_.:]+", name)
        if name.startswith(w):
            total += 60
        elif any(p.startswith(w) for p in parts):
            total += 45
        elif w in name:
            total += 25
        elif w in app["keywords"]:
            total += 40
        elif any(k.startswith(w) for k in app["keywords"]):
            total += 25
        elif w in fold(app["id"]):
            total += 15
        elif w in fold(app["summary"]):
            total += 8
        else:
            return 0.0
    return total + 7 * math.log10(1 + popular.get(app["id"], 0)) + (5 if app["verified"] else 0)


def search(apps, query, popular, limit=60):
    words = fold(query).split()
    if not words:
        return []
    scored = ((score(a, words, popular), a["id"]) for a in apps.values())
    return [i for s, i in sorted((x for x in scored if x[0] > 0), key=lambda x: (-x[0], x[1]))[:limit]]


def instead(query, apps):
    """Suggestions for a familiar name, limited to apps in the available catalog."""
    words = fold(query).strip()
    for names, name, others in FAMILIAR_APPS:
        if any(words == n or (len(words) >= 4 and n.startswith(words)) for n in names):
            return {"name": name, "apps": [o for o in others if o in apps]}
    return None


def in_section(app, section):
    return bool(SECTIONS.get(section, set()) & set(app["categories"]))


def section_of(app):
    """The section an app is mostly for (its page is painted with that section's picture)."""
    return next((s for s in SECTIONS if in_section(app, s)), "tools")


def of_kind(app, section, kind):
    return any(k == kind and categories & set(app["categories"]) for k, categories in KINDS.get(section, []))


def kinds_in(apps, section, least=3):
    """The kinds of app a section has enough of to filter by: [(kind, how many)]."""
    inside = [set(a["categories"]) for a in apps.values() if in_section(a, section)]
    found = [(kind, sum(1 for c in inside if categories & c)) for kind, categories in KINDS.get(section, [])]
    return [(kind, n) for kind, n in found if n >= least]


def shelf(apps, section, order="popular", kind="", checked=False, popular=None, installed=()):
    """A section's apps, or "installed" (yours), of one kind or all, only the ones Flathub checked
    if asked, in an order (ORDERS): [ids]."""
    popular = popular or {}
    if section == "installed":
        ids = [i for i in installed if i in apps]
    else:
        ids = [i for i, a in apps.items() if in_section(a, section) and (not kind or of_kind(a, section, kind))]
    if checked:
        ids = [i for i in ids if apps[i]["verified"]]
    if order == "name":
        return sorted(ids, key=lambda i: (fold(apps[i]["name"]), i))
    if order == "updated":
        return sorted(ids, key=lambda i: (-apps[i]["released"], fold(apps[i]["name"])))
    return sorted(ids, key=lambda i: (-popular.get(i, 0), fold(apps[i]["name"])))


def top(apps, popular, limit=10):
    """The apps installed most from Flathub last month."""
    return [i for i in sorted(popular, key=lambda i: (-popular[i], i)) if i in apps][:limit]


def fresh(apps, popular, now, days=30, among=300, limit=8):
    """Apps people use (the `among` most installed) with a release in the last `days`, the newest
    first: the front page's Fresh paint. None until Flathub's installs are known."""
    recent = [i for i in top(apps, popular, among) if 0 < now - apps[i]["released"] < days * 86400]
    return sorted(recent, key=lambda i: -apps[i]["released"])[:limit]


def today(rows, apps, day):
    """The front page's pick for the day: one of Monet's picks, another each day."""
    import random
    ids = [i for _, row in rows for i in row if i in apps and apps[i]["screenshots"]]
    return random.Random(day).choice(ids) if ids else ""


def similar(apps, app_id, popular, limit=6):
    """Apps for the same things as this one: the most in common (a kind of app counts more than a
    section), then the most installed."""
    main = set().union(*SECTIONS.values())
    mine = set(apps[app_id]["categories"]) - TOOLKITS
    scored = []
    for i, a in apps.items():
        weight = sum(1 if c in main else 3 for c in mine & set(a["categories"]))
        if i != app_id and weight:
            scored.append((-weight, -popular.get(i, 0), fold(a["name"]), i))
    return [i for *_, i in sorted(scored)[:limit]]


# ---------------------------------------------------------------- what's on the PC

def installed_apps(run=None):
    """{id: "system" | "user"} of the Flatpak apps installed."""
    import subprocess
    run = run or (lambda args: subprocess.run(args, capture_output=True, text=True, timeout=30).stdout)
    try:
        out = run(["flatpak", "list", "--app", "--columns=application,installation"])
    except (OSError, subprocess.TimeoutExpired):
        return {}
    found = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and APP_ID.fullmatch(parts[0]):
            found[parts[0]] = parts[1]
    return found


def built_in(app, folder=SYSTEM_APPS):
    """Whether Monet has this app already, not from Flathub (Documents, Photos...)."""
    return (folder / app["launch"]).is_file()


def windows_apps(path=WINDOWS_APPS):
    """[{id, name, icon}] of the apps in your Windows (monet-windows-drive lists them)."""
    try:
        found = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return [{"id": a["id"], "name": str(a.get("name") or ""),
             "icon": "monet-windows-app-" + a["id"][4:] if a.get("icon") is True else "monet-windows"}
            for a in found if isinstance(a, dict) and re.fullmatch(r"app:[a-z0-9-]{1,64}", str(a.get("id")))]


def popular(cache=CACHE / "popular.json", fetch=None, now=None):
    """{id: installs last month}: Flathub's, kept a day."""
    now = now or time.time()
    try:
        kept = json.loads(cache.read_text())
        if now - kept.get("time", 0) < 86400 and isinstance(kept.get("installs"), dict):
            return kept["installs"]
    except (OSError, ValueError, AttributeError):
        kept = {}

    def get(url):
        with urllib.request.urlopen(url, timeout=15) as answer:
            return json.loads(answer.read(4 << 20))
    fetch = fetch or get
    installs = {}
    try:
        for page in range(1, POPULAR_PAGES + 1):
            for hit in fetch(POPULAR.format(page)).get("hits", []):
                if isinstance(hit, dict) and isinstance(hit.get("installs_last_month"), int):
                    installs[str(hit.get("app_id"))] = hit["installs_last_month"]
    except Exception:  # offline: what was kept, however old
        return kept.get("installs") if isinstance(kept.get("installs"), dict) else {}
    try:
        cache.parent.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps({"time": now, "installs": installs}))
    except OSError:
        pass
    return installs


def trouble(message):
    """What went wrong, for the window's words: "not-allowed" (polkit said no: not an
    administrator), "offline" (Flathub out of reach), or "failed"."""
    said = (message or "").lower()
    if "not allowed" in said or "not authorized" in said or "authentication" in said:
        return "not-allowed"
    if any(w in said for w in ("no space", "disk full", "not enough space", "min-free-space", "minimum free space", "disk quota")):
        return "no-space"
    if any(w in said for w in ("resolve host", "couldn't connect", "could not connect", "network", "timed out",
                               "while fetching", "unable to connect")):
        return "offline"
    return "failed"


def reach(metadata):
    """What an app can reach outside its own box, from its Flatpak metadata: a list of
    "network", "all-files", "home", "folders", "devices", "programs" (the window says them)."""
    found, section = set(), ""
    for line in metadata.splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line
            continue
        key, _, value = line.partition("=")
        items = [v for v in value.split(";") if v and not v.startswith("!")]
        if section == "[Context]":
            if key == "shared" and "network" in items:
                found.add("network")
            if key == "devices" and "all" in items:
                found.add("devices")
            if key == "filesystems":
                if any(i.split(":")[0] in ("host", "host-os", "/") for i in items):
                    found.add("all-files")
                elif any(i.split(":")[0] in ("home", "~") for i in items):
                    found.add("home")
                elif items:
                    found.add("folders")
        elif section == "[Session Bus Policy]" and key == "org.freedesktop.Flatpak" and value == "talk":
            found.add("programs")
    if "all-files" in found:
        found -= {"home", "folders"}
    elif "home" in found:
        found.discard("folders")
    order = ["programs", "all-files", "home", "devices", "network", "folders"]
    return [r for r in order if r in found]


# ---------------------------------------------------------------- one app in or out

def transact(action, ref, progress=lambda value: None, cancelled=lambda: False, scope="system"):
    """Cooperative cancellation through Gio; Flatpak owns partial downloads/deployments."""
    if action not in ("install", "remove") or not REF.fullmatch(ref):
        return {"error": "failed"}
    import gi
    gi.require_version("Flatpak", "1.0")
    from gi.repository import Flatpak, GLib, Gio
    kind, name, arch, branch = ref.split("/")
    cancel = Gio.Cancellable()
    stopped = threading.Event()

    def watch():
        while not stopped.wait(0.2):
            if cancelled():
                cancel.cancel()
                return

    def present(installation):
        try:
            installation.get_installed_ref(Flatpak.RefKind.APP, name, arch, branch, None)
            return True
        except GLib.Error as error:
            if error.matches(Flatpak.error_quark(), Flatpak.Error.NOT_INSTALLED):
                return False
            raise

    state = {"ops": 1, "done": 0, "error": ""}

    def ready(t):
        state["ops"] = max(1, len(t.get_operations()))
        return not cancelled()

    def new_operation(t, operation, meter):
        meter.set_update_frequency(250)
        meter.connect("changed", lambda p: progress(round((state["done"] + p.get_progress() / 100) / state["ops"], 3)))

    def operation_done(t, operation, commit, result):
        state["done"] += 1
        progress(round(state["done"] / state["ops"], 3))

    def operation_error(t, operation, error, details):
        state["error"] = trouble(error.message)
        return False

    watcher = threading.Thread(target=watch, daemon=True)
    watcher.start()
    try:
        if cancelled():
            return {"cancelled": True}
        installation = Flatpak.Installation.new_user(cancel) if scope == "user" else Flatpak.Installation.new_system(cancel)
        if present(installation) == (action == "install"):
            return {"ok": True}  # Idempotent retry after a commit whose receipt was lost.
        transaction = Flatpak.Transaction.new_for_installation(installation, cancel)
        transaction.set_no_interaction(True)
        transaction.connect("ready", ready)
        transaction.connect("new-operation", new_operation)
        transaction.connect("operation-done", operation_done)
        transaction.connect("operation-error", operation_error)
        if action == "install":
            transaction.add_install("flathub", ref, None)
        else:
            transaction.add_uninstall(ref)
        if not transaction.run(cancel):
            return {"cancelled": True} if cancelled() else {"error": state["error"] or "failed"}
        if present(installation) != (action == "install"):
            return {"error": "failed"}
        return {"ok": True}
    except GLib.Error as e:
        if e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED) or cancel.is_cancelled() or cancelled():
            return {"cancelled": True}
        return {"error": state["error"] or trouble(e.message)}
    finally:
        stopped.set()
        watcher.join(timeout=1)


def do(action, ref):
    if action not in ("install", "remove") or not REF.fullmatch(ref):
        print(json.dumps({"error": "not an app"}), flush=True)
        return 2
    scope = installed_apps().get(ref.split("/")[1], "system") if REF.fullmatch(ref) else "system"
    result = transact(action, ref, lambda value: print(json.dumps({"done": value}), flush=True), scope=scope)
    print(json.dumps(result), flush=True)
    return 0 if result.get("ok") else 1


def jobs_module():
    import importlib.util
    loader = SourceFileLoader("monet_store_jobs", str(Path(__file__).with_name("monet-store-jobs")))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


# ---------------------------------------------------------------- the window

def main():
    from PySide6.QtCore import QObject, QTimer, QUrl, Signal, Slot
    from PySide6.QtGui import QGuiApplication, QIcon
    from PySide6.QtNetwork import QLocalServer, QNetworkAccessManager, QNetworkDiskCache
    from PySide6.QtQml import QQmlApplicationEngine, QQmlNetworkAccessManagerFactory

    loader = SourceFileLoader("monet_games", f"{LIBEXECDIR}/monet-games")
    import importlib.util
    games = importlib.util.module_from_spec(importlib.util.spec_from_loader("monet_games", loader))
    loader.exec_module(games)

    class Shop(QObject):
        """The catalog, the PC's apps and Windows', for the window; and what the window asks of them."""

        loaded = Signal()
        facts = Signal(str, "QVariant")  # app, {reach: [...], download, installed}
        wanted = Signal(str)
        jobsChanged = Signal("QVariant")
        queueProblem = Signal(str)

        def __init__(self, helper):
            super().__init__()
            self.helper = helper
            self.apps, self.popular, self.installed, self.ready = {}, {}, {}, False
            self.jobs = jobs_module()
            self.queue = self.jobs.Queue()
            self.downloads = []
            self.loading = False
            self.timer = QTimer(self)
            self.timer.setInterval(750)
            self.timer.timeout.connect(self.poll)
            self.timer.start()
            QTimer.singleShot(0, self.poll)

        @Slot()
        def poll(self):
            try:
                self.queue.recover()
                jobs = self.queue.read()
                if jobs != self.downloads:
                    before = {j["token"]: j["state"] for j in self.downloads}
                    self.downloads = jobs
                    # Refresh installed apps after terminal transitions, not each progress tick.
                    if any(j["state"] not in self.jobs.ACTIVE and before.get(j["token"]) != j["state"] for j in jobs):
                        self.installed = installed_apps()
                    self.jobsChanged.emit(jobs)
            except OSError:
                self.queueProblem.emit("storage")

        @Slot()
        def reload(self):
            if not self.loading:
                self.loading = True
                threading.Thread(target=lambda: self.load(True), daemon=True).start()

        def load(self, refresh=False):
            langs = languages()
            blocked = blocklist()
            # A new Monet may not have Flathub's catalog yet (Flatpak refreshes it with its updates).
            if refresh or not any((folder / "appstream.xml").is_file() for folder in CATALOGS):
                import subprocess
                try:
                    subprocess.run(["flatpak", "update", "--appstream", "--noninteractive", "flathub"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=180)
                except (OSError, subprocess.TimeoutExpired):
                    pass
            apps = {}
            for folder in CATALOGS:
                for app_id, app in read_catalog(folder, langs, blocked).items():
                    apps.setdefault(app_id, app)
            self.apps, self.installed = apps, installed_apps()
            self.ready = True
            self.loading = False
            self.loaded.emit()
            self.popular = popular()
            self.loaded.emit()

        def card(self, app_id):
            app = self.apps.get(app_id)
            if app is None:
                return None
            shots = app["screenshots"]
            return {"id": app_id, "name": app["name"], "summary": app["summary"], "icon": app["icon"],
                    "verified": app["verified"], "state": self.state(app_id), "released": app["released"],
                    "shot": shots[0]["thumb"] if shots else "", "picture": shots[0]["image"] if shots else "",
                    "section": section_of(app)}

        def cards(self, ids):
            return [c for c in (self.card(i) for i in ids) if c]

        def state(self, app_id):
            app = self.apps.get(app_id)
            return ("working" if any(j["id"] == app_id and j["state"] in self.jobs.ACTIVE for j in self.downloads) else "installed" if app_id in self.installed
                    else "built-in" if app and built_in(app) else "get")

        @Slot(result="QVariant")
        def home(self):
            """Monet's picks by row, the pick for today, the most installed, and what's freshly updated."""
            rows = picks()
            pick = today(rows, self.apps, int(time.time() // 86400))
            return {"rows": [{"id": row, "apps": self.cards(ids)} for row, ids in rows],
                    "today": dict(self.card(pick), row=next(r for r, ids in rows if pick in ids)) if pick else None,
                    "top": self.cards(top(self.apps, self.popular)),
                    "fresh": self.cards(fresh(self.apps, self.popular, time.time()))}

        @Slot(str, str, str, bool, result="QVariant")
        def section(self, which, order, kind, checked):
            """A section's apps as asked (ORDERS, one kind or "", only checked ones), with its kinds."""
            ids = shelf(self.apps, which, order, kind, checked, self.popular, self.installed)
            return {"apps": self.cards(ids), "kinds": [list(k) for k in kinds_in(self.apps, which)]}

        @Slot(result="QVariant")
        def windows(self):
            return windows_apps()

        @Slot(str, result="QVariant")
        def find(self, query):
            words = fold(query).split()
            mine = [w for w in windows_apps() if words and all(x in fold(w["name"]) for x in words)]
            other = instead(query, self.apps)
            shown = set(other["apps"]) if other else set()
            if other:
                other = {"name": other["name"], "apps": [self.card(i) for i in other["apps"]]}
            return {"apps": [self.card(i) for i in search(self.apps, query, self.popular) if i not in shown],
                    "windows": mine, "instead": other}

        @Slot(str, result="QVariant")
        def app(self, app_id):
            app = self.apps.get(app_id)
            if app is None:
                return None
            return dict(app, state=self.state(app_id), section=section_of(app),
                        similar=self.cards(similar(self.apps, app_id, self.popular)))

        @Slot(result="QVariant")
        def counts(self):
            return {s: sum(1 for a in self.apps.values() if in_section(a, s)) for s in SECTIONS} | {"installed": len(self.installed)}

        @Slot(str)
        def install(self, app_id):
            self.work(app_id, "install")

        @Slot(str)
        def remove(self, app_id):
            self.work(app_id, "remove")

        def work(self, app_id, action):
            app = self.apps.get(app_id)
            if app is None:
                return
            try:
                job = self.queue.submit(app, action, self.installed.get(app_id, "system"))
                self.start(job)
            except (OSError, ValueError):
                self.queueProblem.emit("storage")
            self.poll()

        def start(self, job):
            if not job:
                return
            try:
                self.jobs.start_worker(__file__)
            except Exception:
                # Leave an active worker alone if it already picked up this request.
                with self.queue.lock():
                    jobs = self.queue.read()
                    for current in jobs:
                        if current["token"] == job["token"] and current["state"] == "queued":
                            current.update(state="failed", error="worker", updated=time.time())
                    self.queue.write(jobs)

        @Slot(str, str)
        def downloadAction(self, app_id, command):
            try:
                job = self.queue.change(app_id, command)
                if command == "retry":
                    self.start(job)
            except OSError:
                self.queueProblem.emit("storage")
            self.poll()

        @Slot(str)
        def open(self, app_id):
            app = self.apps.get(app_id)
            if app or APP_ID.fullmatch(app_id):
                entry = app["launch"] if app else app_id + ".desktop"
                self.helper.run(["helper", "launch", entry.encode().hex()])

        @Slot(str)
        def openWindows(self, app_id):
            self.helper.run(["helper", "windows-app", app_id])

        @Slot(str)
        def learn(self, app_id):
            """What an app can reach and how big it is, from Flatpak (for Flathub's, its remote's
            summary): facts(id, {...}) once known."""
            app = self.apps.get(app_id)
            if app is None:
                return

            def work():
                import subprocess
                here = app_id in self.installed
                info = ["flatpak", "info", app_id] if here else ["flatpak", "remote-info", "flathub", app["ref"]]
                try:
                    meta = subprocess.run(info + ["--show-metadata"], capture_output=True, text=True, timeout=40).stdout
                    sizes = subprocess.run(info, capture_output=True, text=True, timeout=40).stdout
                except (OSError, subprocess.TimeoutExpired):
                    meta = sizes = ""
                found = {"reach": reach(meta), "known": bool(meta)}
                for line in sizes.splitlines():
                    key, _, value = line.strip().partition(":")
                    if key.strip().lower() in ("download", "installed", "installed size", "download size"):
                        found["installed" if "installed" in key.lower() else "download"] = value.strip()
                self.facts.emit(app_id, found)
            threading.Thread(target=work, daemon=True).start()

    class KeptPictures(QQmlNetworkAccessManagerFactory):
        def create(self, parent):
            manager = QNetworkAccessManager(parent)
            cache = QNetworkDiskCache(manager)
            cache.setCacheDirectory(str(CACHE / "pictures"))
            cache.setMaximumCacheSize(300 * 1024 * 1024)
            manager.setCache(cache)
            return manager

    asked = sys.argv[1] if len(sys.argv) > 1 else ""
    app = QGuiApplication(sys.argv)
    app.setDesktopFileName("monet-store")
    app.setApplicationName("store")
    app.setOrganizationName("monet")
    words = games.Words()
    app.setApplicationDisplayName(words.i18n("Store"))
    app.setWindowIcon(QIcon.fromTheme("monet-store"))
    name = f"monet-store-{os.getuid()}"
    if games.already_open(name, asked):
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.setSocketOptions(QLocalServer.UserAccessOption)
    server.listen(name)
    helper = games.Helper()
    games.answer(server, helper)
    shop = Shop(helper)
    helper.wanted.connect(shop.wanted)
    engine = QQmlApplicationEngine()
    pictures = KeptPictures()
    engine.setNetworkAccessManagerFactory(pictures)
    engine.rootContext().setContextObject(words)
    engine.rootContext().setContextProperty("helper", helper)
    engine.rootContext().setContextProperty("shop", shop)
    engine.rootContext().setContextProperty("firstPage", asked)
    engine.rootContext().setContextProperty("banners", QUrl.fromLocalFile(f"{DATADIR}/monet/store/").toString())
    engine.rootContext().setContextProperty("art", QUrl.fromLocalFile(f"{DATADIR}/monet/settings/").toString())
    engine.rootContext().setContextProperty("brush", QUrl.fromLocalFile(f"{DATADIR}/monet/textures/brush.png").toString())
    engine.rootContext().setContextProperty("blurBehind", False)
    engine.load(QUrl.fromLocalFile(f"{DATADIR}/monet/store-app/Store.qml"))
    if not engine.rootObjects():
        return 1
    games.glaze(engine.rootObjects()[0], engine.rootContext())
    shop.loading = True
    threading.Thread(target=shop.load, daemon=True).start()
    return app.exec()


if __name__ == "__main__":
    if sys.argv[1:] == ["--worker"]:
        jobs_module().Queue().run(lambda job, progress, cancelled:
                                transact(job["action"], job["ref"], progress, cancelled, job["installation"]))
        sys.exit(0)
    if sys.argv[1:2] == ["--do"] and len(sys.argv) == 4:
        sys.exit(do(sys.argv[2], sys.argv[3]))
    sys.exit(main())
