#!/usr/bin/python3
"""Reconnect trusted Bluetooth mice and keyboards while the desktop starts.

Run with Bluetooth, before a desktop agent is available. Observe BlueZ events
for up to a minute without polling, discovery, pairing or powering radios on.
Allow one retry when a low-energy input misses its first advertising window. --inspect makes no connection.
"""
import argparse
import json

ADAPTER = 'org.bluez.Adapter1'
DEVICE = 'org.bluez.Device1'
INPUT_UUIDS = {'00001124-0000-1000-8000-00805f9b34fb',
               '00001812-0000-1000-8000-00805f9b34fb'}
INPUT_PROPERTIES = {'Paired', 'Trusted', 'Blocked', 'Connected', 'Adapter', 'UUIDs', 'Icon'}


def known_input(properties):
    return (properties.get('Paired') is True
        and properties.get('Trusted') is True
        and properties.get('Blocked') is False
        and properties.get('Icon') in ('input-mouse', 'input-keyboard')
        and bool(INPUT_UUIDS.intersection(str(uuid).lower() for uuid in properties.get('UUIDs', []))))


def eligible(objects):
    for path, interfaces in objects.items():
        device = interfaces.get(DEVICE, {})
        adapter = objects.get(device.get('Adapter'), {}).get(ADAPTER, {})
        if (known_input(device) and device.get('Connected') is False
                and adapter.get('Powered') is True):
            yield path


class Reconnect:
    def __init__(self, loop, inspect=False):
        from gi.repository import Gio, GLib
        self.loop = loop
        self.inspect = inspect
        self.manager = None
        self.handled = set()
        self.retried = set()
        self.seen_connected = set()
        self.scheduled = False
        self.pending = 0
        GLib.timeout_add_seconds(60, self.finish)
        Gio.DBusObjectManagerClient.new_for_bus(Gio.BusType.SYSTEM,
            Gio.DBusObjectManagerClientFlags.DO_NOT_AUTO_START,
            'org.bluez', '/', None, None, None, self.ready, None)

    def finish(self):
        self.loop.quit()
        return False

    def ready(self, source, result, data):
        from gi.repository import Gio, GLib
        try:
            self.manager = Gio.DBusObjectManagerClient.new_for_bus_finish(result)
        except GLib.Error:
            self.finish()
            return
        if not self.manager.get_name_owner():
            self.finish()
            return
        for signal in ('object-added', 'interface-added'):
            self.manager.connect(signal, self.object_added)
        self.manager.connect('interface-proxy-properties-changed', self.properties_changed)
        self.manager.connect('notify::name-owner', self.changed)
        self.changed()

    def object_added(self, manager, obj, *args):
        if obj.get_interface(ADAPTER) or obj.get_interface(DEVICE):
            self.changed()

    def properties_changed(self, manager, obj, proxy, changed, invalidated):
        name = proxy.get_interface_name()
        if name not in (ADAPTER, DEVICE):
            return
        relevant = {'Powered'} if name == ADAPTER else INPUT_PROPERTIES
        values = changed.unpack()
        if name == DEVICE and values.get('Connected') is True:
            self.seen_connected.add(obj.get_object_path())
        if relevant.intersection(values) or relevant.intersection(invalidated):
            self.changed()

    def snapshot(self):
        objects = {}
        for obj in self.manager.get_objects():
            interfaces = {}
            for name in (ADAPTER, DEVICE):
                proxy = obj.get_interface(name)
                if proxy is not None:
                    interfaces[name] = {key: value.unpack()
                        for key in proxy.get_cached_property_names() or []
                        if (value := proxy.get_cached_property(key)) is not None}
            objects[obj.get_object_path()] = interfaces
        return objects

    def changed(self, *args):
        from gi.repository import GLib
        if not self.scheduled:
            self.scheduled = True
            GLib.idle_add(self.reconcile)

    def reconcile(self):
        from gi.repository import Gio
        self.scheduled = False
        if not self.manager.get_name_owner():
            self.finish()
            return False
        objects = self.snapshot()
        devices = [o[DEVICE] for o in objects.values() if known_input(o.get(DEVICE, {}))]
        if self.inspect:
            print(json.dumps(dict(known_inputs=len(devices),
                connected_inputs=sum(d.get('Connected') is True for d in devices),
                eligible_inputs=len(list(eligible(objects))))))
            self.finish()
            return False
        if devices and not self.pending and all(d.get('Connected') is True for d in devices):
            self.finish()
            return False
        # Remember already connected devices too: a later user disconnect during
        # this short boot window must not cause us to connect it again.
        self.seen_connected.update(path for path, obj in objects.items()
            if obj.get(DEVICE, {}).get('Connected') is True)
        for path in eligible(objects):
            if path in self.handled or path in self.seen_connected:
                continue
            self.handled.add(path)
            proxy = self.manager.get_object(path).get_interface(DEVICE)
            self.pending += 1
            print('Retrying Bluetooth input connection' if path in self.retried else
                  'Requesting early Bluetooth input connection', flush=True)
            proxy.call('Connect', None, Gio.DBusCallFlags.NO_AUTO_START,
                       45000, None, self.connected, None)
        return False

    def connected(self, proxy, result, data):
        from gi.repository import Gio, GLib
        try:
            proxy.call_finish(result)
        except GLib.Error as error:
            path = proxy.get_object_path()
            remote = Gio.DBusError.get_remote_error(error)
            transient = remote == 'org.bluez.Error.Failed' and any(reason in error.message
                for reason in ('le-connection-abort-by-local', 'le-connection-timeout',
                               'le-connection-failed-to-be-established'))
            if transient and path not in self.retried and path not in self.seen_connected:
                self.retried.add(path)
                GLib.timeout_add(750, self.retry, proxy)
            elif remote != 'org.bluez.Error.InProgress':
                print('Bluetooth input connect:', remote or 'request timed out or ended', flush=True)
        self.pending -= 1
        self.changed()

    def retry(self, proxy):
        path = proxy.get_object_path()
        obj = self.manager.get_object(path)
        if (path not in self.seen_connected and obj and obj.get_interface(DEVICE) == proxy
                and path in eligible(self.snapshot())):
            self.handled.discard(path)
            self.changed()
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inspect', action='store_true')
    args = parser.parse_args()
    from gi.repository import GLib
    loop = GLib.MainLoop()
    reconnect = Reconnect(loop, args.inspect)
    loop.run()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
