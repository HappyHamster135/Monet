#!/usr/bin/env bash
# Runs at every sign-in. Keeps Windows games in the app menu, keeps the light
# in step with the time, and gives the desktop the Monet look the first time.

BINDIR="@BINDIR@"
LIBEXECDIR="@LIBEXECDIR@"

"$BINDIR/monet" shortcuts 2>/dev/null

# If Monet couldn't prepare Windows by itself, say once what to do.
notice="$("$BINDIR/monet" setup-notice 2>/dev/null)"
if [ -n "$notice" ] && command -v notify-send >/dev/null; then
    seen="${XDG_CONFIG_HOME:-$HOME/.config}/monet/notice-$(printf '%s' "$notice" | cksum | cut -d' ' -f1)"
    if [ ! -e "$seen" ]; then
        notify-send --app-name=Monet --icon=monet "Finish setting up Windows" "$notice"
        mkdir -p "$(dirname "$seen")" && touch "$seen"
    fi
fi

# "Monet and Windows": Windows downloads after the first sign-in, with its
# progress showing, then Monet asks before restarting to install it. In its
# own unit, so it keeps going after this script ends.
if [ "$(cat /var/lib/monet/windows-setup 2>/dev/null)" = waiting ] && command -v systemd-run >/dev/null; then
    systemd-run --user --quiet --collect --unit=monet-windows-first-run --on-active=30 \
        "$BINDIR/monet" windows --first-run >/dev/null 2>&1 || true
fi

# Mist or smoke, for the time it is now.
"$LIBEXECDIR/monet-light" apply 2>/dev/null

# Monet's look, once per account (and again when the look changes).
looks="${XDG_CONFIG_HOME:-$HOME/.config}/monet"
current="$looks/look-0.8.3"
if [ ! -e "$current" ]; then
    # Plasma needs a moment after sign-in before it accepts changes.
    sleep 4
    if ls "$looks"/look-* >/dev/null 2>&1; then
        # A newer look on an account that has Monet's already: freshen it (and
        # mend anything a Breeze theme put back), but keep the panels.
        "$LIBEXECDIR/monet-look" --keep
    else
        "$LIBEXECDIR/monet-look"
    fi
    mkdir -p "$looks" && touch "$current"
fi

# The apps chosen in Monet Setup (or the everyday ones) arrive in the background
# (monet-apps.timer): said once, so they're expected in the menu.
if [ ! -e /var/lib/monet/apps-done ] && [ ! -e "$looks/apps-notice" ] && command -v notify-send >/dev/null; then
    notify-send --app-name=Monet --icon=monet "Adding your apps" \
        "Your apps download in the background and show up in the menu as they arrive."
    mkdir -p "$looks" && touch "$looks/apps-notice"
fi
# Apps that arrived while signed out get their plain names now (monet-names.path
# does it as they arrive).
if [ /var/lib/monet/apps-done -nt "$looks/names" ]; then
    "$LIBEXECDIR/monet-look" --names
fi

# A new Monet since this account last signed in: say once what's new, and
# open Settings → Updates (which lists it) if asked. A brand-new account has
# nothing to compare with; one from before this note has an older look's stamp.
version="$("$BINDIR/monet" version 2>/dev/null | awk '{print $NF}')"
if [ -n "$version" ] && [ "$(cat "$looks/seen-version" 2>/dev/null)" != "$version" ]; then
    if { [ -e "$looks/seen-version" ] || [ "$(ls -d "$looks"/look-* 2>/dev/null | wc -l)" -gt 1 ]; } \
        && command -v notify-send >/dev/null; then
        (
            answer="$(notify-send --app-name=Monet --icon=monet --action=open="See what's new" --wait \
                "Monet $version is here" "$("$LIBEXECDIR/monet-quick" whats-new headline 2>/dev/null)")"
            [ "$answer" = open ] && "$LIBEXECDIR/monet-quick" open updates
        ) >/dev/null 2>&1 &
    fi
    mkdir -p "$looks" && printf '%s\n' "$version" > "$looks/seen-version"
fi

# Apps Monet hasn't painted get its canvas under their own icons, so every app
# fits in (monet-frames.path does it as apps arrive). In the background: it
# looks through every icon theme.
"$LIBEXECDIR/monet-quick" frames >/dev/null 2>&1 &
# Zen, the browser, in Monet's look, freshened from this Monet's copy
# (monet-zen.path does it as Zen arrives).
"$LIBEXECDIR/monet-quick" zen >/dev/null 2>&1 &

# Monet's widgets on the desktop, once, after the look (which may lay the
# desktop out afresh); until Plasma had a desktop for them, at every sign-in.
"$LIBEXECDIR/monet-widgets"
