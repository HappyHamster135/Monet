#!/usr/bin/env bash
# Runs at every sign-in. Keeps Windows games in the app menu, keeps the light
# in step with the time, and gives the desktop the Monet look the first time.

BINDIR="@BINDIR@"
LIBEXECDIR="@LIBEXECDIR@"

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
# A guest (monet-guest) sees nothing of Windows: no games from it, no notes about it.
GUEST=""
[ "$(id -un)" = guest ] && GUEST=1
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"

# Monet's words in your language (monet-quick says them), English if it can't.
say() {
    "$LIBEXECDIR/monet-quick" say "$@" 2>/dev/null || printf '%s' "$1"
}

# What the jobs that can wait look at: this Monet, the menu's apps and Zen's profiles.
# Anything new there and they run again (while signed in, their .path units see to it).
apps_now() {
    { "$BINDIR/monet" --version
      stat -c '%n %Y' /var/lib/flatpak/exports/share/applications "$DATA/flatpak/exports/share/applications" \
          "$DATA/applications" "$HOME/.var/app/app.zen_browser.zen/.zen"
    } 2>/dev/null | cksum
}
apps_seen="$CACHE/monet/apps-seen"

# The jobs that can wait, run a minute after sign-in at the lowest priority (below) so the
# desktop starts without them: apps Monet hasn't painted get its canvas under their icons
# (it looks through every icon theme), games start on a laptop's NVIDIA chip, and Zen
# wears Monet's look.
if [ "${1:-}" = --later ]; then
    "$LIBEXECDIR/monet-quick" frames >/dev/null 2>&1
    "$LIBEXECDIR/monet-look" --games-gpu >/dev/null 2>&1
    "$LIBEXECDIR/monet-quick" zen >/dev/null 2>&1
    mkdir -p "$(dirname "$apps_seen")" && apps_now > "$apps_seen"
    exit 0
fi

# Windows' Games folder, shared at this start when Windows' drive was safe to write
# (monet-windows-drive): a library of Steam here while Steam is still closed, Heroic's Epic
# games there made ready for Epic's launcher in Windows, the screenshots and clips that
# came over from Windows said once, and the apps in Windows' Start menu in the app menu.
if grep -q '"state": "open"' /run/monet/windows-drive.json 2>/dev/null; then
    "$LIBEXECDIR/monet-quick" steam-share >/dev/null 2>&1
    # Then, in the background: drive W: for Wine's launchers (and Ubisoft's games noted), the
    # installers of launchers Windows will need, fetched now rather than in Windows.
    ("$LIBEXECDIR/monet-quick" epic-share; "$LIBEXECDIR/monet-quick" windows-files; "$LIBEXECDIR/monet-quick" windows-apps
     "$LIBEXECDIR/monet-quick" wine-share; "$LIBEXECDIR/monet-quick" launchers) >/dev/null 2>&1 &
fi
# Files' place for the folder shared with Windows: there while the folder is.
[ -z "$GUEST" ] && "$LIBEXECDIR/monet-quick" files-place >/dev/null 2>&1

[ -z "$GUEST" ] && "$BINDIR/monet" shortcuts 2>/dev/null

# If Monet couldn't prepare Windows by itself, say once what to do.
notice="$("$BINDIR/monet" setup-notice 2>/dev/null)"
if [ -z "$GUEST" ] && [ -n "$notice" ] && command -v notify-send >/dev/null; then
    seen="${XDG_CONFIG_HOME:-$HOME/.config}/monet/notice-$(printf '%s' "$notice" | cksum | cut -d' ' -f1)"
    if [ ! -e "$seen" ]; then
        notify-send --app-name=Monet --icon=monet "$(say "Finish setting up Windows")" "$(say "$notice")"
        mkdir -p "$(dirname "$seen")" && touch "$seen"
    fi
fi

# "Monet and Windows": Windows downloads after the first sign-in, with its
# progress showing, then Monet asks before restarting to install it. In its
# own unit, so it keeps going after this script ends.
if [ -z "$GUEST" ] && [ "$(cat /var/lib/monet/windows-setup 2>/dev/null)" = waiting ] && command -v systemd-run >/dev/null; then
    systemd-run --user --quiet --collect --unit=monet-windows-first-run --on-active=30 \
        "$BINDIR/monet" windows --first-run >/dev/null 2>&1 || true
fi

# Back from Windows: the apps that were open before the trip start again (monet-quick
# remembered them just before it), once the desktop is up.
if [ -e "${XDG_STATE_HOME:-$HOME/.local/state}/monet/trip-apps.json" ]; then
    (sleep 5; "$LIBEXECDIR/monet-quick" trip-apps-again) >/dev/null 2>&1 &
fi

# Mist or smoke, for the time it is now.
"$LIBEXECDIR/monet-light" apply 2>/dev/null

# Monet's look, once per account (and again when the look changes).
looks="${XDG_CONFIG_HOME:-$HOME/.config}/monet"
current="$looks/look-0.9.4"
# Repair old Store shortcuts even when this look version was already applied. An image can
# gain the custom Store without another look stamp or another initial app download.
# Content-based receipt: a changed migration runs once, including on images with
# the same marketing version. A failed run stays retryable; an older image's
# already-applied migration cannot replay over preferences from a newer one.
if "$LIBEXECDIR/monet-profile" run "$LIBEXECDIR/monet-look" --keep; then
    mkdir -p "$looks" && touch "$current"
fi
# Always repair old entry points, even when the content receipt already exists.
"$LIBEXECDIR/monet-look" --store
# Windows+A for Quick Settings and Windows+G for Games, once (the other Windows keys are
# set before KWin starts, by monet-keys.service).
[ -e "$looks/widget-keys" ] || "$LIBEXECDIR/monet-look" --widget-keys

# Files Monet Setup brought from Windows: into this account's folders, once.
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/monet/from-windows" ]; then
    (sleep 6; "$LIBEXECDIR/monet-quick" bring-files) >/dev/null 2>&1 &
fi

# An older PC (8 GB of memory or less, or a spinning disk): Monet goes easier on
# it. The widgets' glass leaves out its lens, Files searches names but not what's
# inside files (unless that's been chosen), and Steam starts a little after the
# desktop instead of with it.
steam_later="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/steam.desktop"
# Worked out once per Monet and amount of memory, not at every sign-in: monet-quick takes
# a moment to start, and an older PC is the one that feels it.
older="$CACHE/monet/older-pc"
older_key="$("$BINDIR/monet" --version 2>/dev/null) $(grep -m1 '^MemTotal' /proc/meminfo 2>/dev/null)"
if [ "$(head -1 "$older" 2>/dev/null)" = "$older_key" ]; then
    older_pc="$(sed -n 2p "$older")"
else
    older_pc="$("$LIBEXECDIR/monet-quick" older-pc 2>/dev/null)"
    [ -n "$older_pc" ] && mkdir -p "$(dirname "$older")" && printf '%s\n%s\n' "$older_key" "$older_pc" > "$older"
fi
if [ "$older_pc" = yes ]; then
    mkdir -p "$looks" && : > "$looks/glass-lite"
    if [ ! -e "$looks/files-names" ]; then
        "$LIBEXECDIR/monet-profile" put --default-only --file baloofilerc --group General --key 'only basic indexing' true &&
            touch "$looks/files-names"
    fi
    # Your own Steam autostart (or none) is left alone; Monet's copy says X-Monet.
    steam=/etc/xdg/autostart/steam.desktop
    if [ -e "$steam" ] && ! grep -q '^Hidden=true' "$steam" \
        && { [ ! -e "$steam_later" ] || grep -q '^X-Monet=true' "$steam_later"; }; then
        mkdir -p "$(dirname "$steam_later")"
        temporary="$(mktemp "$looks/steam-autostart-XXXXXX")"
        printf '[Desktop Entry]\nType=Application\nName=Steam\nHidden=true\nX-Monet=true\n' > "$temporary"
        "$LIBEXECDIR/monet-profile" file "$steam_later" "$temporary"
        launch=""
        # An edited autostart entry controls its own timing and command.
        cmp -s "$temporary" "$steam_later" && launch="$(sed -n 's/^Exec=//p' "$steam" | head -1 | sed 's/ %[A-Za-z]//g')"
        rm -f "$temporary"
        if [ -n "$launch" ] && ! pgrep -x steam >/dev/null; then
            systemd-run --user --quiet --collect --unit=monet-steam-later --on-active=45 \
                /bin/sh -c "$launch" >/dev/null 2>&1 || true
        fi
    fi
else
    rm -f "$looks/glass-lite"
    if printf '[Desktop Entry]\nType=Application\nName=Steam\nHidden=true\nX-Monet=true\n' | cmp -s - "$steam_later"; then
        rm -f "$steam_later"
    fi
fi

# The apps chosen in Monet Setup (or the everyday ones) arrive in the background
# (monet-apps.timer): said once, so they're expected in the menu.
if [ ! -e /var/lib/monet/apps-done ] && [ ! -e "$looks/apps-notice" ] && command -v notify-send >/dev/null; then
    notify-send --app-name=Monet --icon=monet "$(say "Adding your apps")" \
        "$(say "Your apps download in the background and show up in the menu as they arrive.")"
    mkdir -p "$looks" && touch "$looks/apps-notice"
fi
# Apps that arrived while signed out get their plain names now (monet-names.path
# does it as they arrive).
if [ /var/lib/monet/apps-done -nt "$looks/names" ]; then
    "$LIBEXECDIR/monet-look" --names
fi

# A brand-new account (nothing seen yet): Monet's welcome, once, in Settings,
# when the bar is up to open it. Not for a guest, who is brand-new every time.
if [ ! -e "$looks/seen-version" ] && [ ! -e "$looks/welcomed" ] && [ -z "$GUEST" ] \
    && [ "$(ls -d "$looks"/look-* 2>/dev/null | wc -l)" -le 1 ]; then
    mkdir -p "$looks" && touch "$looks/welcomed"
    (sleep 8; "$LIBEXECDIR/monet-quick" open welcome) >/dev/null 2>&1 &
fi

# A new Monet since this account last signed in: say once what's new, and
# open Settings → Updates (which lists it) if asked. A brand-new account has
# nothing to compare with; one from before this note has an older look's stamp.
version="$("$BINDIR/monet" version 2>/dev/null | awk '{print $NF}')"
if [ -n "$version" ] && [ "$(cat "$looks/seen-version" 2>/dev/null)" != "$version" ]; then
    if { [ -e "$looks/seen-version" ] || [ "$(ls -d "$looks"/look-* 2>/dev/null | wc -l)" -gt 1 ]; } \
        && command -v notify-send >/dev/null; then
        (
            answer="$(notify-send --app-name=Monet --icon=monet --action=open="$(say "See what's new")" --wait \
                "$(say "Monet %1 is here" "$version")" "$("$LIBEXECDIR/monet-quick" whats-new headline 2>/dev/null)")"
            [ "$answer" = open ] && "$LIBEXECDIR/monet-quick" open updates
        ) >/dev/null 2>&1 &
    fi
    mkdir -p "$looks" && printf '%s\n' "$version" > "$looks/seen-version"
fi

# A new Monet that didn't start went back by itself (monet-boot): said once to each account that
# was here before.
went=/var/lib/monet/went-back.json
if [ -e "$went" ] && [ -e "$looks/seen-version" ] && [ "$went" -nt "$looks/went-back-seen" ] \
    && command -v notify-send >/dev/null; then
    bad="$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$went")"
    good="$(sed -n 's/.*"to": "\([^"]*\)".*/\1/p' "$went")"
    if [ -n "$good" ]; then title="$(say "Monet went back to %1" "$good")"; else title="$(say "Monet went back")"; fi
    if [ -n "$bad" ]; then
        body="$(say "Monet %1 didn't start properly on this PC, so it went back by itself. Your files are as they were, and the daily update waits for the next one." "$bad")"
    else
        body="$(say "The new Monet didn't start properly on this PC, so it went back by itself. Your files are as they were, and the daily update waits for the next one.")"
    fi
    notify-send --app-name=Monet --icon=monet "$title" "$body"
    touch "$looks/went-back-seen"
fi

# After Reset this PC (monet-reset), each account that had settings to reset hears it once.
if [ -e /var/lib/monet/reset-done ] && [ -d "$DATA/monet/before-reset" ] \
    && [ /var/lib/monet/reset-done -nt "$looks/reset-seen" ] && command -v notify-send >/dev/null; then
    notify-send --app-name=Monet --icon=monet "$(say "Monet is as it came")" \
        "$(say "Your files, games and apps are all here. Your settings from before are kept, in case you want one back.")"
    mkdir -p "$looks" && touch "$looks/reset-seen"
fi

# The jobs that can wait (--later, above), only when something they look at changed
# since they last ran: a new Monet, apps that arrived while signed out, a new Zen profile.
if [ "$(apps_now)" != "$(cat "$apps_seen" 2>/dev/null)" ]; then
    if ! systemd-run --user --quiet --collect --unit=monet-after-sign-in --on-active=60 --nice=19 \
        --property=IOSchedulingClass=idle "$LIBEXECDIR/monet-session" --later >/dev/null 2>&1; then
        (sleep 60; nice -n 19 ionice -c 3 "$LIBEXECDIR/monet-session" --later) >/dev/null 2>&1 &
    fi
fi

# Monet's widgets on the desktop, once, after the look (which may lay the
# desktop out afresh); until Plasma had a desktop for them, at every sign-in.
"$LIBEXECDIR/monet-widgets"
