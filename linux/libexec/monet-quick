         N_("reduce motion; stop animations; less movement; disable animation"), "accessibility#motion", "preferences-desktop-accessibility"),
        ("headphones", tr("Headphones and speakers"), tr("Sound · Choose where sound plays"),
         N_("headphones; earphones; earbuds; speakers; no sound; change audio output; play sound through"), "sound#output", "audio-headphones"),
        ("microphone", tr("Microphone"), tr("Sound · Microphone volume"),
         N_("microphone; mic; people cannot hear me; input volume; recording sound"), "sound#microphone", "audio-input-microphone"),
        ("bluetooth", tr("Connect a Bluetooth device"), tr("Bluetooth · Pair headphones, a mouse or a controller"),
         N_("bluetooth; pair headphones; connect wireless headphones; pair controller; wireless mouse"), "bluetooth", "preferences-system-bluetooth"),
        ("wifi", tr("Connect to Wi-Fi"), tr("Wi-Fi · Networks and internet access"),
         N_("wifi; wi-fi; wireless internet; connect internet; no internet; network connection"), "wifi", "network-wireless"),
        ("calendar", tr("Birthdays and repeating notes"), tr("Calendar · Notes that repeat every year, month, week or day"),
         N_("birthday; birthdays; anniversary; anniversaries; calendar; repeat a note; repeating notes; yearly reminder; monthly reminder; weekly reminder; daily reminder"), "calendar", "x-office-calendar"),
        ("windows-files", tr("Windows files"), tr("Storage · Your shared folder and access to Windows files"),
         N_("windows files; files from windows; shared with windows; shared folder; windows documents"), "storage#shared-files", "folder-publicshare"),
        ("quiet", tr("Quiet notifications"), tr("Notifications · Do Not Disturb and app popups"),
         N_("do not disturb; quiet notifications; stop notifications; mute app; popups; focus time"), "notifications", "notifications-disabled"),
        ("backups", tr("Back up or restore files"), tr("Backups · Copies and earlier versions"),
         N_("backup; back up; restore files; lost file; deleted document; earlier version; undo file changes; file history; time machine; deja dup"), "backups", "document-revert"),
        ("updates", tr("Check for updates"), tr("Updates · New versions and recovery"),
         N_("update; updates; upgrade; new version; system rollback; previous working version"), "updates", "system-software-update"),
        ("restore-work", tr("Restore work after Windows"), tr("Play on Windows · Reopen apps when you return"),
         N_("restore browser tabs; reopen documents; remember windows; restore session; return from windows; switching systems"), "windows#return", "view-restore"),
        ("default-apps", tr("Choose default apps"), tr("Default Apps · Browser, email and files"),
         N_("default apps; change default browser; open with; email app; pdf app"), "apps", "preferences-desktop-default-applications"),
        ("settings", tr("Settings"), tr("Personalize Monet and manage your devices"),
         N_("control panel; system preferences; system settings; gnome settings; kde settings"), "welcome", "preferences-system"),
    ]
    # Offer the installed app, respecting a person's hidden or removed launcher.
    applications = [
        ("files", tr("Files"), tr("Browse folders and connected drives"),
         N_("file explorer; windows explorer; finder; file manager; dolphin; nautilus; nemo; thunar"), "org.kde.dolphin.desktop", "system-file-manager"),
        ("text-editor", tr("Text Editor"), tr("Edit plain text and code"),
         N_("notepad; notepad++; textedit; text editor; kate; gedit; gnome text editor; mousepad"), "org.kde.kate.desktop", "accessories-text-editor"),
        ("system-monitor", tr("Task Manager"), tr("See running apps, CPU, graphics, memory, network and temperatures"),
         N_("task manager; activity monitor; system monitor; running apps; cpu usage; memory usage; processes; performance; graphics; gpu; temperature; fans; network; disk activity"), "org.kde.plasma-systemmonitor.desktop", "utilities-system-monitor"),
        ("screenshot", tr("Screenshot"), tr("Capture your screen or a selected area"),
         N_("snipping tool; snip and sketch; screenshot; screen capture; spectacle; gnome screenshot"), "org.kde.spectacle.desktop", "spectacle"),
        ("archives", tr("Archives"), tr("Open and extract compressed files"),
         N_("7-zip; 7zip; winrar; archive utility; archive manager; file roller; extract zip; unzip"), "org.kde.ark.desktop", "utilities-file-archiver"),
        ("documents", tr("Documents"), tr("Read PDFs and annotate documents"),
         N_("preview; adobe reader; acrobat reader; pdf reader; document viewer; okular; evince"), "org.kde.okular.desktop", "okular"),
        ("store", tr("Store"), tr("Find and install apps for Monet"),
         N_("app store; microsoft store; software center; software centre; gnome software; discover; bazaar"), "monet-store.desktop", "monet-store"),
