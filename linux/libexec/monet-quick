    elif cmd == "anticheat-refresh":
        anticheat(fetch=True)
    elif cmd == "protondb-refresh":
        protondb_refresh([a for a in args if a.isdigit()])
    elif cmd == "steam-share":
        emit({"done": steam_share(now=args[:1] == ["now"]), **shared_info()})
    elif cmd == "shared":
        emit(shared_info())
    elif cmd == "windows-program":
        if args and not windows_program(args[0]):
            return 1
    elif cmd == "program-info":
        emit(program_info())
    elif cmd == "program-here":
        # The sheet's program, or one from Files' menu (Run in Monet).
        found = Path(args[0]).absolute() if args else None
        if found is not None and (not found.is_file() or found.suffix.lower() not in PROGRAM_TYPES):
            return 1
        info = {"path": str(found)} if found else program_info()
        if info:
            program_here(info["path"])
    elif cmd == "program-proton":
        return program_proton(unhex(args[0]))
    elif cmd == "program-start":
        # An app menu entry of a Windows program that an installer put in the Start menu.
        program_here(unhex(args[0]))
    elif cmd == "windows-apps":
        windows_apps_menu()
    elif cmd == "windows-app":
        if not args or not windows_app(args[0]):
            return 1
    elif cmd == "program-windows":
        # Open in Windows: into the shared folder, then the restart (`monet play`); a Windows
        # app from the app menu is in Windows already.
        info = program_info()
        game = info["app"] if info.get("app") else program_windows(info["path"]) if info else None
        if not game:
            print(tr("Windows can't get this program this time."), file=sys.stderr)
            return 1
        result = subprocess.run([f"{BINDIR}/monet", "play", game], capture_output=True, text=True)
        if result.returncode != 0:
            print(result.stderr.strip() or tr("Monet couldn't switch to Windows."), file=sys.stderr)
            return 1
    elif cmd == "get-tools":
        emit({"done": get_flatpak(TOOLS_APP)})
    elif cmd == "get-heroic":
        emit({"done": get_heroic(), **shared_info()})
    elif cmd == "favorite":
        if len(args) != 2 or args[1] not in ("on", "off"):
            raise SystemExit("usage: monet-quick favorite GAME on|off")
        favorite(args[0], args[1] == "on")
    elif cmd == "shared-hint-off":
        SHARED_HINT_OFF.parent.mkdir(parents=True, exist_ok=True)
        SHARED_HINT_OFF.write_text("")
    elif cmd == "epic-share":
        if shared_here():
            emit(epic_share())
    elif cmd == "launchers":
        # (At sign-in, in the background) the installers of launchers Windows will need.
        if shared_here():
            fetch_launchers(set(shared_state().get("launchers") or []), needed_launchers(), SHARED / ".monet/installers")
    elif cmd == "get-launcher":
        if args[:1] and args[0] in LUTRIS_SLUGS:
            emit({"done": get_launcher(args[0]), **shared_info()})
    elif cmd == "wine-watch":
        wine_watch()
    elif cmd == "wine-share":
        # (At sign-in) drive W: in Wine's prefixes, and Ubisoft's games there noted for Windows.
        if shared_here():
            flatpaks_see_shared()
            prefixes = wine_prefixes()
            for prefix in prefixes:
                map_wine_drive(prefix)
            ubisoft_share(prefixes)
    elif cmd == "files-place":
        files_place(shared_here() and os.path.ismount(FILES))
        hide_system_root()
    elif cmd == "native-shortcut" and len(args) == 1:
        return 0 if native_shortcut_dialog(args[0]) else 1
    elif cmd == "native-run" and len(args) == 1 and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        return 0 if native_run(args[0]) else 1
    elif cmd == "windows-files":
        windows_files_note()
    elif cmd == "played":
        emit(played())
    elif cmd == "play" and args and PLAYABLE.fullmatch(args[0]):
        play(args[0])
    elif cmd == "steam-page" and args and args[0].isdigit():
        steam_page(args[0])
    elif cmd == "steam-uninstall" and args and args[0].isdigit():
        steam_page(args[0], "uninstall")
    elif cmd == "ring" and len(args) == 2 and all(re.fullmatch(r"(?:[0-9a-f]{2})+", a) for a in args):
        ring(unhex(args[0]), unhex(args[1]))
    elif cmd == "crash" and len(args) == 2 and re.fullmatch(r"[\w-]+", args[0]) and re.fullmatch(r"[0-9a-f]{32}", args[1]):
        crash(args[0], args[1])
    elif cmd == "crashed" and args and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        crashed(unhex(args[0]))
    elif cmd == "frames":
        frames()
    elif cmd == "zen":
        zen()
    elif cmd == "bitlocker" and len(args) == 1 and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        emit(unlock_windows(args[0]))
    elif cmd == "onedrive":
        emit(onedrive_state())
    elif cmd == "onedrive-connect":
        emit({"ok": onedrive_connect(), **onedrive_state()})
    elif cmd == "onedrive-cancel":
        emit({"ok": onedrive_cancel()})
    elif cmd == "onedrive-disconnect":
        emit({"ok": onedrive_disconnect(), **onedrive_state()})
    elif cmd == "windows-browsers":
        emit(windows_browsers())
    elif cmd == "bookmarks-to-zen":
        emit(bookmarks_to_zen())
    elif cmd in ("bookmarks-preview", "bookmarks-prepare", "bookmarks-verify") and len(args) == 1 \
            and len(args[0]) <= 40000 and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        emit(bookmarks_action(cmd.removeprefix("bookmarks-"), args[0]))
    elif cmd == "launch" and args and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        launch(unhex(args[0]))
    elif cmd == "widgets":
        # Plasma's widget gallery, as the desktop's Add Widgets opens it.
        run("busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "toggleWidgetExplorer")
    elif cmd == "search" and len(args) == 1 and len(args[0]) <= 2048 and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]):
        emit({"results": everyday_search(unhex(args[0]))})
    elif cmd == "search-open" and len(args) == 1:
        try:
            opened = open_search_result(args[0])
        except OSError:
            opened = False
        emit({"ok": opened})
        return 0 if opened else 1
    elif cmd == "shared-files":
        emit(shared_files_status())
    elif cmd == "kde" and args and args[0] in KDE_PAGES:
        page = KDE_PAGES[args[0]]
        command, env = kde_settings_command(page)
        subprocess.Popen(command, env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # And the welcome, which isn't in the list of pages (monet-session opens it for a new account).
    elif cmd == "open" and (not args or args[0] in PAGES or args[0] == "welcome"):
        open_settings(args[0] if args else "")
    elif cmd == "say" and args:
        print(tr(*args))
    elif cmd == "listen":
        listen()
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
