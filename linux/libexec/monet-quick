    return [dict(id=ident, name=name, detail=detail, terms=terms, target=target, icon=icon)
            for ident, name, detail, terms, target, icon in rows]


def search_fold(text):
    text = "".join(c for c in unicodedata.normalize("NFKD", text.casefold()) if not unicodedata.combining(c))
    return " ".join(re.findall(r"[^\W_]+", text, re.UNICODE))


def everyday_search(query):
    query = search_fold(query[:256])
    if len(query) < 2:
        return []
    # These are optional question words, not intent words such as "not" or "off".
    filler = "how can i do please my the a an to where is are find open"
    ignored = set(search_fold(filler + " " + tr("how can i do please my the a an to where is are find open")).split())
    tokens = [word for word in query.split() if word not in ignored]
    if not tokens:
        return []
    ranked = []
    for entry in search_catalog():
        aliases = [search_fold(value) for value in (entry["terms"] + ";" + tr(entry["terms"])).split(";")]
        title = search_fold(entry["name"])
        text = " ".join([title, *aliases])
        words = text.split()
        if query == title or query in aliases:
            score = 100
        elif title.startswith(query):
            score = 85
        elif all(any(word == token or (len(token) >= 3 and word.startswith(token)) for word in words)
                 or (len(token) >= 2 and token in text and not token.isascii()) for token in tokens):
            score = 60 + sum(token in title.split() for token in tokens)
        else:
            continue
        ranked.append((score, entry))
    ranked.sort(key=lambda item: (-item[0], item[1]["name"].casefold()))
    return [{key: value for key, value in entry.items() if key != "terms"} for _, entry in ranked[:6]]


def open_search_result(ident):
    entry = next((entry for entry in search_catalog() if entry["id"] == ident), None)
    if entry is None:
        return False
    if entry["target"].endswith(".desktop"):
        return launch(entry["target"])
    if entry["target"] == "calendar":
        subprocess.Popen(["plasmawindowed", "org.monet.calendar"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        open_settings(entry["target"])
    return True


def shared_files_status():
    state = shared_state()
    available = state.get("state") == "open" and FILES.is_dir() and os.access(FILES, os.R_OK | os.X_OK)
    return {"state": state.get("state", ""), "available": available,
            "path": str(FILES) if available else ""}


UPOWER_CHARGING, UPOWER_DISCHARGING = 1, 2


# Ready when you come back (monet-ready does the root part) ------------------

READY_USER = Path("/var/lib/monet/ready-user")
READY_FLAG = Path("/run/monet/ready-auto")


def me():
    import pwd  # here, not at the top: Linux has it, and the tests also run on Windows
    return pwd.getpwuid(os.getuid()).pw_name


def ready_state():
    try:
        on = READY_USER.read_text().strip() == me()
    except (OSError, KeyError):
        on = False
    return {"on": on, "apps": not TRIP_APPS_OFF.exists()}


# Your apps again after Windows: a trip restarts the PC, so open apps close. Just before
# it, `monet` asks this to remember which apps were running (Plasma starts each in a
# systemd unit named after its menu entry, app-[LAUNCHER-]ID@RANDOM.service or
# app-[LAUNCHER-]ID-RANDOM.scope), and at the next sign-in they start again. Steam and
# the apps that start with every sign-in anyway are left to themselves.

TRIP_APPS = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "monet/trip-apps.json"
TRIP_APPS_OFF = CONFIG / "monet/trip-apps-off"
TRIP_APPS_FRESH = 12 * 3600
PLAYED_WINDOWS = TRIP_APPS.parent / "played-windows.json"  # {windows game id: when Monet sent it there}
NOT_AGAIN = {"steam.desktop", "com.valvesoftware.Steam.desktop", "monet-settings.desktop", "monet-windows.desktop",
             "org.kde.plasmashell.desktop", "org.kde.krunner.desktop", "org.kde.spectacle.desktop",
             "org.kde.kdeconnect.daemon.desktop", "org.kde.polkit-kde-authentication-agent-1.desktop"}


def app_from_unit(unit):
    """The menu entry's file name of an app Plasma started in that systemd unit, or None."""
    if not unit.startswith("app-") or "@autostart" in unit:
        return None
    body = unit[4:]
    if body.endswith(".service"):
        body = body[:-len(".service")].split("@", 1)[0]
    elif body.endswith(".scope"):
        body = body[:-len(".scope")].rpartition("-")[0]
    else:
        return None
    # The launcher's name comes first when there is one; the app's own dashes are escaped.
    app = body.split("-")[-1].replace("\\x2d", "-")
    return f"{app}.desktop" if re.fullmatch(r"[\w.+-]+", app) else None


def running_apps():
    """The menu entries of the apps running now, in the order they started (or so)."""
    out = run("systemctl", "--user", "list-units", "--type=service,scope", "--state=running",
              "--no-legend", "--plain", "app-*") or ""
    found = []
    for line in out.splitlines():
        app = app_from_unit(line.split(" ", 1)[0])
        if app and app not in found:
            found.append(app)
    return found


def starts_anyway(app):
    """Whether the app starts by itself at sign-in (an autostart entry that isn't hidden)."""
    for folder in (CONFIG / "autostart", Path("/etc/xdg/autostart")):
        try:
            entry = desktop_entry((folder / app).read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
        return entry.get("Hidden") != "true"
    return False


def resume_helper():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader("monet_resume", str(Path(__file__).with_name("monet-resume")))
    module = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def remember_apps(apps=None, game=None):
    """Just before a trip to Windows: the apps to start again when Monet's back, and the game
    the trip is for, as played now (Recently played shows it)."""
    if game and WINDOWS_ID.fullmatch(game):
        trips = read_json(PLAYED_WINDOWS)
        trips = trips if isinstance(trips, dict) else {}
        trips[game] = int(time.time())
        PLAYED_WINDOWS.parent.mkdir(parents=True, exist_ok=True)
        PLAYED_WINDOWS.write_text(json.dumps(dict(sorted(trips.items(), key=lambda kv: -kv[1])[:50])) + "\n")
    if TRIP_APPS_OFF.exists():
        return []
    resume = resume_helper()
    live = apps is None
    desktop = resume.desktop_snapshot() if live else {}
    windows = desktop.get("windows", [])
    apps = list(dict.fromkeys(running_apps() + [w["app"] for w in windows])) if live else apps
    keep = []
    for app in apps:
        entry = entry_by_id(app)
        if (app not in NOT_AGAIN and entry and entry.get("Type") == "Application" and entry.get("NoDisplay") != "true"
                and not starts_anyway(app)):
            if app not in keep:
                keep.append(app)
    # Live capture must succeed before replacing the previous work checkpoint.
    keep = keep[:resume.MAX_APPS]
    saved = resume.checkpoint(keep, windows, desktop.get("scene")) if live else {"time": int(time.time()), "apps": keep}
    if TRIP_APPS_OFF.exists():
        return []
    resume.atomic_write(TRIP_APPS, saved)
    if live:
        print(saved["id"])
    return keep


def trip_apps_again(selected=None, request=None):
    """At the sign-in after a trip: the apps that were open start again, once."""
    resume = resume_helper()
    saved = resume.read_state(TRIP_APPS)
    if not saved:
        return []
    if saved.get("version") in (2, 3):
        return resume.restore(TRIP_APPS, TRIP_APPS_OFF, running_apps, entry_by_id, launch, TRIP_APPS_FRESH,
                              selected=selected, request=request)
    if request is not None:  # A stale UI action cannot replay an older checkpoint format.
        return []
    TRIP_APPS.unlink(missing_ok=True)
    if TRIP_APPS_OFF.exists() or not isinstance(saved, dict) or time.time() - saved.get("time", 0) > TRIP_APPS_FRESH:
        return []
    running = set(running_apps())
    started = []
    for app in saved.get("apps") or []:
        if isinstance(app, str) and app not in running and entry_by_id(app):
            launch(app)
            started.append(app)
            time.sleep(0.4)
    return started


def set_trip_apps(on):
    if on:
        TRIP_APPS_OFF.unlink(missing_ok=True)
    else:
        TRIP_APPS_OFF.parent.mkdir(parents=True, exist_ok=True)
        TRIP_APPS_OFF.write_text("")
        resume = resume_helper()
        resume.discard(TRIP_APPS, resume.read_state(TRIP_APPS))
        resume.return_path(TRIP_APPS).unlink(missing_ok=True)


def return_status():
    state = resume_helper().return_status(TRIP_APPS, TRIP_APPS_OFF, TRIP_APPS_FRESH)
    state["busy"] = state["busy"] or return_worker_active()
    descriptions = {
        "waiting": tr("Waiting to reopen."),
        "trip-unconfirmed": tr("The Windows trip hasn't been confirmed. Your saved recovery checkpoint is still available."),
        "opening": tr("Opening and checking its window…"),
        "opened": tr("Opened a window. The app controls its own tabs and documents."),
        "already-running": tr("Already running; left as it was. Its saved work was not opened again."),
        "unconfirmed": tr("Opening wasn't confirmed. Retry checks an existing launch before opening another."),
        "missing-app": tr("This app is no longer installed. Install it again, then retry."),
        "folders-restored": tr("Saved folder tabs and split views reopened."),
        "folders-unavailable": tr("Folder tabs could not be confirmed. Reconnect any missing drives, then retry."),
        "browser-restored": tr("The browser reopened its saved normal tabs. Private tabs stay closed."),
        "browser-opened": tr("Browser opened normally, following its own tab-restore preference."),
        "browser-unavailable": tr("The saved browser session is no longer available. You can open the browser normally."),
        "browser-skipped": tr("Private or unsupported browser session left closed. You can open the browser normally."),
        "partly-restored": tr("Some windows or browser profiles reopened. Others are unavailable or still waiting to be confirmed."),
        "documents-opened": tr("The app opened with requests for its saved documents. Check the app for any unsaved changes."),
        "documents-missing": tr("Some saved documents are unavailable. Reconnect their drive, then choose Retry documents, or check Backups."),
        "documents-unconfirmed": tr("The editor's final document list could not be confirmed. Files saved under new names during switching may need to be opened from the editor's recent files."),
        "expired": tr("This recovery checkpoint has expired. You can open the app normally."),
    }
    for item in state["items"]:
        item["retry"] = item["retry"] and not state["busy"]
        entry = entry_by_id(item["app"])
        item["name"] = local_name(entry) if entry else item["app"].removesuffix(".desktop")
        item["detail"] = descriptions.get(item["status"], descriptions["unconfirmed"])
        item["canOpen"] = bool(entry)
        item["needsAttention"] = item["status"] in {"unconfirmed", "missing-app", "folders-unavailable",
            "browser-unavailable", "browser-skipped", "documents-missing", "documents-unconfirmed", "partly-restored", "expired", "trip-unconfirmed"}
    state["retry"] = any(item["retry"] for item in state["items"])
    return state


def return_worker_active():
    return (run("systemctl", "--user", "show", "monet-return.service", "--property=ActiveState", "--value") or "").strip() \
        in ("active", "activating", "reloading")


def queue_return_notice():
    """One quiet entry point per trip, independent of the restore worker's lifetime."""
    resume = resume_helper()
    try:
        with resume.restore_lock(TRIP_APPS):
            if TRIP_APPS_OFF.exists():
                return False
            saved = resume.read_state(TRIP_APPS)
            if saved.get("boot") == resume.boot_id():
                return False
            report = resume.read_return(TRIP_APPS, saved)
            if not report.get("items"):
                return False
            marker = TRIP_APPS.with_suffix(".notice.json")
            if resume.read_state(marker).get("id") == report["id"]:
                return True
            accepted = ok("systemd-run", "--user", "--quiet", "--collect",
                "--unit=monet-return-notice-" + report["id"],
                "--setenv=XDG_STATE_HOME=" + str(TRIP_APPS.parent.parent.resolve()),
                sys.executable, str(Path(__file__).resolve()),
                "return-notice", report["id"])
            if accepted:
                resume.atomic_write(marker, {"id": report["id"]})
            return accepted
    except (BlockingIOError, OSError):
        return False


def show_return_notice(ident):
    state = return_status()
    if state.get("id") != ident or not state.get("available"):
        return
    attention = any(item["needsAttention"] for item in state["items"])
    body = tr("Some work needs attention. Review what opened and what you can retry.") if attention else \
        tr("Review which apps reopened and how they handled your saved work.")
    answer = run("notify-send", "--app-name=Monet", "--icon=monet", "--hint=string:desktop-entry:monet-settings",
        f"--action=open={tr('Review return')}", "--wait", tr("Back in Monet"), body, timeout=3600)
    if (answer or "").strip() == "open":
        open_settings("windows#return")


def retry_return(ident, app=None):
    state = return_status()
    if state.get("id") != ident or not re.fullmatch(r"[0-9a-f]{32}", ident):
        return False
    if state["busy"] or return_worker_active():
        return True
    eligible = [item["app"] for item in state["items"] if item["retry"]]
    if not eligible or (app is not None and app not in eligible):
        return False
    # A fixed unit prevents duplicate workers during the gap before it takes the
    # checkpoint lock; it also survives closing Settings.
    return ok("systemd-run", "--user", "--quiet", "--collect", "--unit=monet-return",
              "--setenv=XDG_STATE_HOME=" + str(TRIP_APPS.parent.parent.resolve()),
              sys.executable, str(Path(__file__).resolve()), "return-run", ident, *([app] if app else []))


def open_return_app(ident, app):
    resume = resume_helper()
    if return_worker_active():
        return False
    try:
        with resume.restore_lock(TRIP_APPS):
            state = return_status()
            item = next((item for item in state["items"] if item["app"] == app), None)
            if state.get("id") != ident or not item or not item["canOpen"]:
                return False
            # This explicit action opens the app normally, never a private browser
            # checkpoint. An existing window is raised instead of launching again.
            found = resume.kwin_script("const w = windows().find(w => appId(w) === " + json.dumps(app)
                                      + "); if (w) { w.minimized = false; workspace.activeWindow = w; } reply(!!w);")
            if not found and app not in running_apps():
                launch(app)
            return True
    except (BlockingIOError, ImportError, OSError, RuntimeError):
        return False


def ready_lock():
    """A start that signed in by itself after Windows: lock before the desktop shows (KWin's screen
    locker, else logind). Signed in by hand (the automatic sign-in didn't happen), nothing to lock.
    The next start asks for the password again: monet-ready clears it before every sign-in screen."""
    try:
        if READY_FLAG.read_text().strip() != me():
            return
    except (OSError, KeyError):
        return
    session = os.environ.get("XDG_SESSION_ID") or (run("loginctl", "show-user", str(os.getuid()), "-p", "Display",
                                                        "--value") or "").strip()
    service = (run("loginctl", "show-session", session, "-p", "Service", "--value") or "").strip() if session else ""
    if service in ("", "plasmalogin-autologin") or "autologin" in service:
        for _ in range(60):  # up to 15 s for the screen locker to be on the bus
            if run("busctl", "--user", "call", "org.freedesktop.ScreenSaver", "/ScreenSaver",
                   "org.freedesktop.ScreenSaver", "Lock", timeout=5) is not None:
                break
            time.sleep(0.25)
        else:
            if session:
                run("loginctl", "lock-session", session)


def seconds(text):
    """A systemd duration ("1min 2.345s", "820ms", "3.008s") in seconds."""
    total = 0.0
    for amount, unit in re.findall(r"([\d.]+)(min|ms|s)\b", text):
        total += float(amount) * {"min": 60, "s": 1, "ms": 0.001}[unit]
    return total


def startup(analyze, session_start=None, desktop_ready=None):
    """How long the last start took, from `systemd-analyze` ("Startup finished in 7.2s (firmware) +
    3.0s (loader) + ..."), and signing in until the desktop was there (monotonic µs): {pc, monet,
    desktop, total} in seconds, or {} while it's still starting."""
    parts = {name: seconds(time_) for time_, name in re.findall(r"((?:\d+min )?[\d.]+m?s) \((\w+)\)", analyze or "")}
    if "userspace" not in parts:
        return {}
    found = {"pc": round(parts.get("firmware", 0), 1),
             "monet": round(sum(parts.get(p, 0) for p in ("loader", "kernel", "initrd", "userspace")), 1)}
    if session_start and desktop_ready and desktop_ready > session_start:
        found["desktop"] = round((desktop_ready - session_start) / 1e6, 1)
    found["total"] = round(sum(found.values()), 1)
    return found


def startup_now():
    session = os.environ.get("XDG_SESSION_ID", "")
    start = (run("loginctl", "show-session", session, "-p", "TimestampMonotonic", "--value") or "").strip() if session else ""
    ready = (run("systemctl", "--user", "show", "plasma-plasmashell.service", "-p", "ActiveEnterTimestampMonotonic",
                 "--value") or "").strip()
    return startup(run("systemd-analyze", timeout=15), int(start) if start.isdigit() else None,
                   int(ready) if ready.isdigit() else None)


def older_pc(meminfo=Path("/proc/meminfo"), spinning=None):
    """An older PC, which Monet goes easier on: 8 GB of memory or less (which shows as about 7.7),
    or Monet on a spinning disk."""
    try:
        kb = int(re.search(r"^MemTotal:\s+(\d+)", meminfo.read_text(), re.M).group(1))
    except (OSError, AttributeError):
        kb = None
    if kb is not None and kb < 9 * 1024 ** 2:
        return True
    if spinning is None:
        # /sysroot is the disk itself on Monet (/ is the system image); -v leaves out a btrfs subvolume.
        source = next((s for s in (run("findmnt", "-nvo", "SOURCE", m) for m in ("/sysroot", "/")) if s), "").strip()
        spinning = bool(source) and (run("lsblk", "-dno", "ROTA", source) or "").strip() == "1"
    return spinning


# Files from Windows ------------------------------------------------------------
# Monet Setup copies Windows' Desktop, Documents and so on into the new account
# (~/.local/share/monet/from-windows); at the first sign-in they go into its own
# folders, which have their names in its language by then (xdg-user-dirs).

XDG_FOLDERS = {"Desktop": "DESKTOP", "Documents": "DOCUMENTS", "Downloads": "DOWNLOAD", "Music": "MUSIC",
               "Pictures": "PICTURES", "Videos": "VIDEOS"}


def user_folder(home, dirs_text, key):
    """A folder as user-dirs.dirs names it (XDG_DOCUMENTS_DIR="$HOME/Dokument"), or None."""
    for line in dirs_text.splitlines():
        name, _, value = line.strip().partition("=")
        if name == f"XDG_{key}_DIR":
            path = Path(value.strip('"').replace("$HOME", str(home)))
            return path if path.is_absolute() and path != home else None
    return None


def free_name(path):
    """path, or "name (Windows).ext" beside it when that's taken."""
    if not path.exists():
        return path
    for n in range(1, 1000):
        mark = tr("Windows") if n == 1 else f"{tr('Windows')} {n}"
        other = path.with_name(f"{path.stem} ({mark}){path.suffix}")
        if not other.exists():
            return other
    return path


def bring_files(home=None):
    """Moves the files Monet Setup brought from Windows into this account's folders;
    how many were moved (renamed, never over a file of the same name)."""
    config = CONFIG if home is None else Path(home) / ".config"
    home = Path(home or Path.home())
    staged = home / ".local/share/monet/from-windows"
    if not staged.is_dir():
        return 0
    run("xdg-user-dirs-update")
    try:
        dirs = (config / "user-dirs.dirs").read_text()
    except OSError:
        dirs = ""
    moved = 0
    for folder in sorted(p for p in staged.iterdir() if p.is_dir()):
        target = user_folder(home, dirs, XDG_FOLDERS.get(folder.name, "")) or home / folder.name
        target.mkdir(parents=True, exist_ok=True)
        for item in sorted(folder.iterdir()):
            try:
                item.rename(free_name(target / item.name))
                moved += 1
            except OSError:
                continue
        if not any(folder.iterdir()):
            folder.rmdir()
    if not any(staged.iterdir()):
        staged.rmdir()
    return moved


WINDOWS_FILES = Path("/var/lib/monet/windows-files.json")


def windows_files_note(brought=WINDOWS_FILES, seen=CONFIG / "monet/windows-files-seen"):
    """At sign-in: once monet-windows-files.service has moved Windows' screenshots and clips
    here (it may still be at it), says so once, with Show."""
    for _ in range(100):
        if (run("systemctl", "is-active", "monet-windows-files.service") or "").strip() != "activating":
            break
        time.sleep(3)
    try:
        found = json.loads(brought.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    try:
        said = seen.read_text().strip()
    except OSError:
        said = ""
    if not isinstance(found, dict) or found.get("user") != getpass.getuser() or str(found.get("time")) == said:
        return
    pictures, videos = int(found.get("pictures") or 0), int(found.get("videos") or 0)
    if not (pictures or videos):
        return
    seen.parent.mkdir(parents=True, exist_ok=True)
    seen.write_text(f"{found.get('time')}\n")
    if pictures and videos:
        text = tr("Your screenshots and clips from Windows are in Pictures and Videos.")
    elif pictures:
        text = tr("Your screenshots from Windows are in Pictures › Screenshots.")
    else:
        text = tr("Your clips from Windows are in Videos.")
    pictures_dir = Path((run("xdg-user-dir", "PICTURES") or "").strip() or Path.home() / "Pictures")
    answer = run("notify-send", "--app-name=Monet", "--icon=monet-windows", f"--action=open={tr('Show')}", "--wait",
                 tr("From Windows"), text, timeout=600)
    if (answer or "").strip() == "open":
        show_in_files(pictures_dir / "Screenshots" if pictures else videos_folder())


# Backups ---------------------------------------------------------------------
# Earlier versions: monet-keep (root) snapshots the homes every hour into
# SNAPSHOTS/"2026-10-23 14.00"/<person>, read-only. A copy on a drive: the person
# picks a USB drive once, and their files go to "Monet Backup/<person>" on it
# whenever it's plugged in, at most once a day; what a copy replaces or deletes is
# kept beside it by date ("Monet Backup/<person> earlier/<date>") for three months.

SNAPSHOTS = Path("/var/lib/monet/snapshots")
KEEP_OFF = Path("/var/lib/monet/keep-off")
HOMES = "/var/home"
SNAP_STAMP = "%Y-%m-%d %H.%M"
BACKUP = CONFIG / "monet" / "backup.json"
EARLIER = RUNTIME / "monet-earlier"  # the file Files asked about
# Not copied: what comes back by itself, and games (their stores download them again).
NOT_COPIED = ("/.cache/", "/.local/share/Trash/", "/.local/share/baloo/", "/.local/share/flatpak/",
              "/.local/share/Steam/steamapps/", "/.var/app/*/cache/",
              "/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/", "/.local/share/monet/from-windows/")
BACKUP_FILESYSTEMS = {"ext4", "btrfs", "xfs", "f2fs", "vfat", "exfat", "ntfs", "ntfs3"}
LINKS_OK = {"ext4", "btrfs", "xfs", "f2fs"}
COPY_EVERY = 20 * 3600
KEEP_EARLIER_DAYS = 90


def snapshot_time(name):
    try:
        return int(time.mktime(time.strptime(name, SNAP_STAMP)))
    except ValueError:
        return None


def snapshot_names(root=SNAPSHOTS):
    """The snapshots, newest first."""
    try:
        return sorted((p.name for p in root.iterdir() if snapshot_time(p.name)), reverse=True)
    except OSError:
        return []


def in_snapshot(path, name, root=SNAPSHOTS, homes=HOMES):
    """Where path (under the homes) is in a snapshot, or None."""
    real, homes = os.path.realpath(path), os.path.realpath(homes)
    if not real.startswith(homes + os.sep):
        return None
    return Path(root) / name / os.path.relpath(real, homes)


def versions(path, root=SNAPSHOTS, homes=HOMES):
    """Earlier versions of a file or folder, newest first, each one different from the
    one after it (and from now): [{name, time, path, size, folder}]."""
    try:
        st = os.stat(path)
        last = (st.st_size, int(st.st_mtime))
    except OSError:
        last = None  # gone now: its last version counts
    found = []
    for name in snapshot_names(root):
        there = in_snapshot(path, name, root, homes)
        try:
            st = there.stat() if there else None
        except OSError:
            st = None
        if st is None or (st.st_size, int(st.st_mtime)) == last:
            continue
        last = (st.st_size, int(st.st_mtime))
        found.append({"name": name, "time": snapshot_time(name), "path": str(there), "size": st.st_size,
                      "folder": there.is_dir()})
    return found


def put_back(version, original):
    """A copy of an earlier version beside the file as it is: "letter (2026-10-23 14.00).txt"."""
    source, original = Path(version["path"]), Path(original)
    target = free_name(original.with_name(f"{original.stem} ({version['name']}){original.suffix}"))
    if source.is_dir():
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)
    return target


def look_back(names, now=None):
    """The snapshots closest to an hour, a day and a week ago (at or before then)."""
    now = now or time.time()
    out = {}
    for key, ago in (("hour", 3600), ("day", 86400), ("week", 7 * 86400)):
        then = now - ago
        name = next((n for n in names if snapshot_time(n) <= then), None)
        out[key] = {"name": name, "time": snapshot_time(name)} if name else None
    return out


def backup_drives(listing=None):
    """Plugged-in USB drives a copy can go on: [{uuid, label, size, fstype, mount}]."""
    if listing is None:
        listing = json.loads(run("lsblk", "-J", "-b", "-o", "PATH,UUID,LABEL,FSTYPE,SIZE,HOTPLUG,TRAN,TYPE,MOUNTPOINTS")
                             or "{}").get("blockdevices", [])
    found = []

    def walk(devices, removable):
        for d in devices:
            here = removable or d.get("tran") == "usb" or d.get("hotplug") in (True, "1")
            label = d.get("label") or ""
            # Not Monet's own USB stick.
            if here and d.get("uuid") and d.get("fstype") in BACKUP_FILESYSTEMS and not label.startswith("Monet-") \
                    and label != "MONETEFI":
                mount = next((m for m in d.get("mountpoints") or [] if m), "")
                found.append({"uuid": d["uuid"], "label": label, "size": int(d.get("size") or 0),
                              "fstype": d["fstype"], "mount": mount})
            walk(d.get("children") or [], here)

    walk(listing, False)
    return found


def backup_prefs():
    try:
        return json.loads(BACKUP.read_text())
    except (OSError, ValueError):
        return {}


def save_backup(**changes):
    found = backup_prefs()
    found.update(changes)
    BACKUP.parent.mkdir(parents=True, exist_ok=True)
    BACKUP.write_text(json.dumps(found))


def copying(prefs):
    pid = prefs.get("pid")
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def backup_state():
    prefs, names = backup_prefs(), snapshot_names()
    drives = backup_drives()
    chosen = prefs.get("drive")
    return {"versions": not KEEP_OFF.exists(), "kept": len(names), "lookBack": look_back(names),
            "drives": [d for d in drives if d["uuid"] != chosen], "drive": chosen, "label": prefs.get("label", ""),
            "plugged": any(d["uuid"] == chosen for d in drives), "last": prefs.get("last"),
            "copying": copying(prefs), "percent": prefs.get("percent", 0), "error": prefs.get("error", "")}


def backup_run():
    """Copies this person's files to the drive they chose, if it's plugged in."""
    prefs = backup_prefs()
    drive = next((d for d in backup_drives() if d["uuid"] == prefs.get("drive")), None)
    if not drive or copying(prefs):
        return
    where, mounted = drive["mount"], False
    if not where:
        said = run("udisksctl", "mount", "-b", f"/dev/disk/by-uuid/{drive['uuid']}", "--no-user-interaction",
                   timeout=60) or ""
        found = re.search(r" at (.+?)\.?\s*$", said.strip())
        where, mounted = (found.group(1), True) if found else ("", False)
    if not where:
        save_backup(error=tr("The drive couldn't be opened. Try plugging it in again."))
        return
    me_name, today = Path.home().name, time.strftime("%Y-%m-%d")
    top = Path(where) / "Monet Backup"
    dest, earlier = top / me_name, top / f"{me_name} {tr('earlier')}"
    try:
        dest.mkdir(parents=True, exist_ok=True)
    except OSError:
        save_backup(error=tr("Monet can't write on this drive."))
        return
    args = ["rsync", "-rlt" if drive["fstype"] in LINKS_OK else "-rt", "--delete", "--backup",
            f"--backup-dir={earlier / today}", "--modify-window=2", "--info=progress2", "--no-inc-recursive"]
    args += [f"--exclude={x}" for x in NOT_COPIED] + [f"{Path.home()}/", f"{dest}/"]
    try:
        proc = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        save_backup(error=tr("The copy didn't finish. Monet tries again the next time the drive is plugged in."))
        return
    save_backup(pid=proc.pid, percent=0, error="")
    shown = 0.0
    for line in proc.stdout:  # rsync's \r-separated progress reads as lines
        found = re.search(r"(\d+)%", line)
        if found and time.time() - shown > 2:
            shown = time.time()
            save_backup(percent=int(found.group(1)))
    code = proc.wait()
    # What copies replaced or deleted, kept for three months.
    try:
        for old in earlier.iterdir():
            if old.is_dir() and snapshot_time(old.name + " 00.00") and \
                    time.time() - snapshot_time(old.name + " 00.00") > KEEP_EARLIER_DAYS * 86400:
                shutil.rmtree(old, ignore_errors=True)
    except OSError:
        pass
    if mounted:
        run("udisksctl", "unmount", "-b", f"/dev/disk/by-uuid/{drive['uuid']}", "--no-user-interaction", timeout=120)
    # 23 and 24: a few files couldn't be read, or went away while copying.
    if code in (0, 23, 24):
        save_backup(pid=None, percent=100, last=int(time.time()), error="")
    else:
        save_backup(pid=None, error=tr("The copy didn't finish. Monet tries again the next time the drive is plugged in."))


def backup_auto():
    """Every quarter of an hour: a copy when the drive is in and the last is a day old;
    a word when it's been out for a week."""
    prefs = backup_prefs()
    if not prefs.get("drive"):
        return
    now, last = time.time(), prefs.get("last") or 0
    if any(d["uuid"] == prefs["drive"] for d in backup_drives()):
        if now - last > COPY_EVERY:
            backup_run()
    elif last and now - last > 7 * 86400 and now - prefs.get("reminded", 0) > 7 * 86400 and shutil.which("notify-send"):
        save_backup(reminded=int(now))
        run("notify-send", "--app-name=Monet", "--icon=drive-removable-media", tr("Your files haven't been copied for a week"),
            tr("Plug in %1 and Monet copies them.", prefs.get("label") or tr("your backup drive")))


def show_in_files(path):
    path = Path(path)
    if shutil.which("dolphin") and not path.is_dir():
        command = ["dolphin", "--select", str(path)]
    else:
        command = ["xdg-open", str(path)]
    subprocess.Popen(command, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def files_arrived():
    """bring_files(), then says so, with Files a click away."""
    if bring_files() and shutil.which("notify-send"):
        answer = run("notify-send", "--app-name=Monet", "--icon=system-file-manager", f"--action=open={tr('Open Files')}",
                     "--wait", tr("Your files from Windows are here"),
                     tr("In Documents, Pictures, Music, Videos, Downloads and on the desktop."), timeout=3600)
        if (answer or "").strip() == "open":
            subprocess.Popen(["xdg-open", str(Path.home())], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# What each kind of UPower device is, for the Batteries widget's signs.
UPOWER_KINDS = {5: "mouse", 6: "keyboard", 8: "phone", 10: "tablet", 12: "controller", 13: "pen", 14: "touchpad",
                17: "headset", 18: "speaker", 19: "headphones", 26: "watch"}


def battery_list(devices):
    """Everything with a battery, from UPower's devices' properties: this laptop's first, then the
    mouse, the keyboard, controllers, headphones... [{kind, name, level, charging}]."""
    found = []
    for props in devices:
        level, kind = props.get("Percentage"), props.get("Type")
        if not isinstance(level, (int, float)):
            continue
        if kind == 2 and props.get("PowerSupply"):
            if not props.get("IsPresent"):
                continue  # a ThinkPad's empty second battery bay
            kind = "laptop"
        elif kind in UPOWER_KINDS:
            kind = UPOWER_KINDS[kind]
        elif kind == 2:
            kind = "other"
        else:
            continue  # the mains, a UPS, the display device...
        found.append({"kind": kind, "name": props.get("Model") or "", "level": round(level),
                      "charging": props.get("State") == UPOWER_CHARGING})
    return sorted(found, key=lambda b: b["kind"] != "laptop")


def batteries():
    paths = busjson("--system", "call", "org.freedesktop.UPower", "/org/freedesktop/UPower",
                    "org.freedesktop.UPower", "EnumerateDevices")
    devices = []
    for path in (paths[0] if paths else []):
        props = busjson("--system", "call", "org.freedesktop.UPower", path, "org.freedesktop.DBus.Properties",
                        "GetAll", "s", "org.freedesktop.UPower.Device")
        devices.append({k: v.get("data") for k, v in (props[0] if props else {}).items() if isinstance(v, dict)})
    return battery_list(devices)


def battery_care(supplies=Path("/sys/class/power_supply")):
    """Whether the battery can stop charging early (charge_control_end_threshold, as on ThinkPads
    and many other laptops), and where it stops now."""
    for bat in sorted(supplies.glob("BAT*")):
        try:
            return {"supported": True, "limit": int((bat / "charge_control_end_threshold").read_text().strip())}
        except (OSError, ValueError):
            continue
    return {"supported": False, "limit": 100}


def battery_state(upower):
    """The battery, from UPower's display device (every battery together, as KDE shows it):
    {battery: percent, charging, plugged (charging, full or held at a charge limit), minutes
    (left on battery, or until full)}, or the first battery the kernel lists, or no battery."""
    props = {k: v.get("data") for k, v in (upower or {}).items() if isinstance(v, dict)}
    if props.get("IsPresent") and props.get("Type") == 2 and isinstance(props.get("Percentage"), (int, float)):
        state = props.get("State")
        seconds = props.get("TimeToEmpty") if state == UPOWER_DISCHARGING else props.get("TimeToFull") if state == UPOWER_CHARGING else 0
        return {"battery": round(props["Percentage"]), "charging": state == UPOWER_CHARGING,
                "plugged": state != UPOWER_DISCHARGING, "minutes": round(seconds / 60) if seconds else None}
    for bat in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            level, text = int((bat / "capacity").read_text()), (bat / "status").read_text().strip()
        except (OSError, ValueError):
            continue
        return {"battery": level, "charging": text == "Charging", "plugged": text != "Discharging", "minutes": None}
    return {"battery": None, "charging": False, "plugged": True, "minutes": None}


def status(scope="all"):
    """Quick Settings needs the whole snapshot; Settings only reads its open page."""
    result = {}
    if scope in ("all", "wifi"):
        result.update(wifi=wifi_state(), network=wifi_name())
    if scope in ("all", "bluetooth"):
        result["bluetooth"] = bluetooth_state()
    if scope in ("all", "display"):
        result.update(night=kread("kwinrc", "NightColor", "Active", "false") == "true", brightness=brightness_state())
    if scope == "all":
        result.update(quiet_state())
        result["keyboard"] = keyboard_light()
    if scope in ("all", "sound"):
        result.update(volume=volume("@DEFAULT_AUDIO_SINK@"), mic=volume("@DEFAULT_AUDIO_SOURCE@"))
    if scope in ("all", "power", "updates"):
        upower = busjson("--system", "call", "org.freedesktop.UPower", "/org/freedesktop/UPower/devices/DisplayDevice",
                        "org.freedesktop.DBus.Properties", "GetAll", "s", "org.freedesktop.UPower.Device")
        result.update(battery_state(upower[0] if upower else None))
    if scope in ("all", "light"):
        result["light"] = light_state()
    return result


def main(argv):
    cmd, args = (argv[0] if argv else "status"), argv[1:]
    on = bool(args) and args[0] == "on"
    if cmd == "status":
        emit(status(args[0] if args else "all"))
    elif cmd == "wifi":
        run("nmcli", "radio", "wifi", "on" if on else "off")
    elif cmd == "wifi-list":
        emit(wifi_list(run("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list") or "", saved_wifi()))
    elif cmd == "wifi-join" and args:
        command = ["nmcli", "device", "wifi", "connect", unhex(args[0])]
        if len(args) > 1 and args[1]:
            command += ["password", unhex(args[1])]
        result = subprocess.run(command, capture_output=True, text=True, timeout=60)
        emit({"ok": result.returncode == 0, "message": (result.stdout or result.stderr).strip()})
    elif cmd == "hotspot":
        emit(hotspot())
