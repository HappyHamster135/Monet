    ("Crashes in the last week", ("coredumpctl", "list", "--since=-7d", "--no-pager"), ("tail", 40)),
    ("Trips to Windows", Path("/var/lib/monet/switch.log"), ("tail", 60)),
    ("Windows' drive at this start", Path("/run/monet/windows-drive.json"), None),
    ("Went back by itself", Path("/var/lib/monet/went-back.json"), None),
    ("On trial", Path("/var/lib/monet/trial.json"), None),
    ("Setting Windows up", Path("/var/log/monet-windows.log"), ("tail", 80)),
)
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def said(source, timeout=30):
    """A command's output (what it printed and any errors), or a file's text: whatever there is."""
    if isinstance(source, Path):
        try:
            return source.read_text(errors="replace")
        except OSError as e:
            return f"({e.strerror})"
    if not shutil.which(source[0]):
        return f"({source[0]} isn't here)"
    try:
        done = subprocess.run(source, capture_output=True, text=True, errors="replace", timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"({type(e).__name__})"
    text = done.stdout + (done.stderr if done.stderr.strip() else "")
    if source[:2] == ("busctl", "--user"):   # {"type":"s","data":["..."]}: the text inside
        try:
            text = json.loads(text)["data"][0]
        except (ValueError, KeyError, IndexError, TypeError):
            pass
    return text


def report_text(parts=REPORT_PARTS, now=None):
    now = now or time.localtime()
    out = [f"Monet report, {time.strftime('%Y-%m-%d %H:%M', now)}", ""]
    machine = [read_text(DMI / name) for name in ("sys_vendor", "product_name", "product_version", "board_name",
                                                 "bios_version", "bios_date")]
    out += ["== The PC", " · ".join(m for m in machine if m and m.lower() not in ("default string", "to be filled by o.e.m.")), ""]
    for heading, source, cut in parts:
        lines = ANSI.sub("", said(source)).rstrip().splitlines()
        if cut:
            lines = lines[:cut[1]] if cut[0] == "head" else lines[-cut[1]:]
        out += [f"== {heading}", *(lines or ["(nothing)"]), ""]
    return "\n".join(out)


def save_report(folder=None, now=None):
    """Writes the report into Documents and gives its path."""
    now = now or time.localtime()
    folder = Path(folder or (run("xdg-user-dir", "DOCUMENTS") or "").strip() or Path.home() / "Documents")
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"Monet report {time.strftime('%Y-%m-%d %H.%M', now)}.txt"
    path.write_text(report_text(now=now), encoding="utf-8")
    return path


def report_saved(path):
    """Says the report is there, with Files a click away."""
    if shutil.which("notify-send"):
        answer = run("notify-send", "--app-name=Monet", "--icon=document-save", f"--action=open={tr('Show')}", "--wait",
                     tr("Saved a report"), tr("In Documents, as %1.", Path(path).name), timeout=3600)
        if (answer or "").strip() == "open":
            show_in_files(path)


# Opening Monet Settings ----------------------------------------------------

def listen():
    """Waits (up to an hour) for `monet-quick windows-program`, then prints what was asked.

    Quick Settings runs this and asks about the program when it returns. If
    Quick Settings goes away (Plasma restarts), this stops listening too.
    """
    if not FIFO.is_fifo():
        FIFO.unlink(missing_ok=True)
        os.mkfifo(FIFO, 0o600)
    parent = os.getppid()
    fd = os.open(FIFO, os.O_RDONLY | os.O_NONBLOCK)
    try:
        for _ in range(3600):
            ready, _, _ = select.select([fd], [], [], 1)
            if os.getppid() != parent:
                return
            if not ready:
                continue
            words = os.read(fd, 256).decode("utf-8", "replace").split()
            if words:
                print(" ".join(words[:2]))
                return
            # Someone opened the doorbell and left without a word: listen afresh.
            os.close(fd)
            fd = os.open(FIFO, os.O_RDONLY | os.O_NONBLOCK)
    finally:
        os.close(fd)


def kde_settings_command(page):
    """Keep the native modules inside More Settings' scrollable page."""
    command, env = ["systemsettings"], os.environ.copy()
    plugins = Path(LIBEXECDIR).parent / "lib/monet/qt"
    if (plugins / "styles/libmonetsettings.so").is_file():
        env["QT_PLUGIN_PATH"] = str(plugins) + (os.pathsep + env["QT_PLUGIN_PATH"] if env.get("QT_PLUGIN_PATH") else "")
        command += ["-style", "MonetSettings"]
    return [*command, page], env


def open_settings(page):
    """Opens Monet Settings (its own app, monet-settings) at a page, or brings the open one
    there; KDE's System Settings where it isn't installed."""
    app = f"{LIBEXECDIR}/monet-settings"
    if os.access(app, os.X_OK):
        command = [app, *([page] if page else [])]
        if shutil.which("systemd-run"):
            # In a scope of its own, as the menu starts an app: not one of the bar's processes,
            # so a bar restart doesn't close it (Settings was the bar's own sheet until 0.9.4).
            command = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "--slice=app.slice", *command]
        subprocess.Popen(command, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    page = KDE_PAGES.get(page, KDE_PAGES["all"])
    command, env = kde_settings_command(page)
    os.execvpe(command[0], command, env)


# Everyday searches use a small, translated catalog of navigation destinations.
# A result only opens a page/app; search text can never become a command.
def search_catalog():
    N_ = lambda text: text  # Extract aliases now, translate them when matching.
    rows = [
        ("text-size", tr("Make text and windows bigger"), tr("Accessibility · Size of everything"),
