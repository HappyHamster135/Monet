DATADIR = "@DATADIR@"
# Monet's words in the language of the session (tools/make-translations.py), English where there are none.
_ = gettext.translation("monet", localedir=f"{DATADIR}/locale", fallback=True).gettext


def tr(text, *values):
    """text in the session's language, with %1, %2, ... filled in (one convention for every translator)."""
    said = _(text)
    for i, value in reversed(list(enumerate(values, 1))):
        said = said.replace(f"%{i}", str(value))
    return said
