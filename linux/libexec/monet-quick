    for row in applications:
        entry = entry_by_id(row[4]) or {}
        if (entry.get("Type") == "Application" and entry.get("Exec")
                and entry.get("Hidden") != "true" and entry.get("NoDisplay") != "true"
                and (not entry.get("TryExec") or shutil.which(entry["TryExec"]))):
