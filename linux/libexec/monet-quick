def run(*args, timeout=10):
    """Runs a program and returns what it printed, or None if it couldn't run."""
    if not shutil.which(args[0]):
        return None
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def ok(*args, timeout=30):
    return run(*args, timeout=timeout) is not None


def emit(value):
    print(json.dumps(value))


def unhex(text):
    return bytes.fromhex(text).decode("utf-8", "replace")


# Wi-Fi ---------------------------------------------------------------------

def nmcli_fields(line):
    """Splits a line of `nmcli -t` output, where a literal ':' is written '\\:'."""
    fields, cur, escaped = [], "", False
    for ch in line:
        if escaped:
            cur += ch
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += ch
    fields.append(cur)
    return fields


def wifi_state():
    """True or False as Wi-Fi is on or off, or None on a PC without Wi-Fi: NetworkManager's switch
    says enabled even then (found by the test bench, in a VM on a cable)."""
    devices = run("nmcli", "-t", "-f", "TYPE", "device") or ""
    if "wifi" not in devices.split():
        return None
    out = run("nmcli", "radio", "wifi")
    return {"enabled": True, "disabled": False}.get((out or "").strip())


def wifi_name():
    out = run("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active") or ""
    for line in out.splitlines():
        fields = nmcli_fields(line)
        if len(fields) >= 2 and fields[1] == "802-11-wireless":
            return fields[0]
    return ""


def hotspot():
    """This PC's own Wi-Fi network for phones and tablets: whether it's on, its name and password,
    or whether there's a Wi-Fi card to make one."""
    out = run("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active") or ""
    for fields in map(nmcli_fields, out.splitlines()):
        if len(fields) >= 2 and fields[1] == "802-11-wireless":
            name = fields[0]
            if (run("nmcli", "-g", "802-11-wireless.mode", "connection", "show", name) or "").strip() == "ap":
                return {"on": True, "connection": name,
                        "name": (run("nmcli", "-g", "802-11-wireless.ssid", "connection", "show", name) or "").strip(),
                        "password": (run("nmcli", "-s", "-g", "802-11-wireless-security.psk", "connection", "show", name)
                                     or "").strip()}
    devices = run("nmcli", "-t", "-f", "DEVICE,TYPE", "device") or ""
    return {"on": False, "possible": any(f[1:2] == ["wifi"] for f in map(nmcli_fields, devices.splitlines()))}


def saved_wifi():
    """The Wi-Fi networks NetworkManager keeps a profile for (it names them after the network)."""
    out = run("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show") or ""
    return {f[0] for f in map(nmcli_fields, out.splitlines()) if len(f) >= 2 and f[1] == "802-11-wireless"}


def wifi_list(listing, saved=()):
    """Networks from `nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list`, strongest first:
    known ones (saved) join without asking again; work and school ones (802.1X) want a name too."""
    nets = {}
    for line in listing.splitlines():
        fields = nmcli_fields(line)
        if len(fields) < 4 or not fields[1]:
            continue
        active, ssid, signal, security = fields[0] == "*", fields[1], fields[2], fields[3]
        strength = int(signal) if signal.isdigit() else 0
        old = nets.get(ssid)
        if old is None or active or strength > old["signal"]:
            nets[ssid] = {"name": ssid, "signal": strength, "secure": security not in ("", "--"),
                          "active": active or bool(old and old["active"]), "known": ssid in saved,
                          "enterprise": "802.1X" in security}
    return sorted(nets.values(), key=lambda n: (not n["active"], -n["signal"]))


# Bluetooth -----------------------------------------------------------------

def bluetooth_here(adapters=Path("/sys/class/bluetooth")):
    """Whether the PC has a Bluetooth adapter: without one, bluetoothctl waits for one forever
    (found by the test bench: each Quick Settings refresh took 3 s, its sliders empty till then)."""
    return any(adapters.glob("hci*"))


def bluetooth_state():
    if not bluetooth_here():
        return None
    out = run("bluetoothctl", "show", timeout=3)
    if out is None or "Powered:" not in out:
        return None
    return "Powered: yes" in out


def bt_list():
    out = (run("bluetoothctl", "devices", "Paired", timeout=5) if bluetooth_here() else None) or ""
    devices = []
    for line in out.splitlines():
        parts = line.split(" ", 2)
        if len(parts) == 3 and parts[0] == "Device":
            info = run("bluetoothctl", "info", parts[1], timeout=3) or ""
            devices.append({"address": parts[1], "name": parts[2], "connected": "Connected: yes" in info,
                            "icon": bt_kind(info)})
    return devices


def bt_kind(info):
    """What the device is, as BlueZ names it (audio-headset, input-gaming, ...)."""
    match = re.search(r"^\s*Icon:\s*(\S+)", info, re.M)
    return match.group(1) if match else ""


# Sound ---------------------------------------------------------------------

def volume(target):
    out = run("wpctl", "get-volume", target)
    match = re.search(r"Volume:\s*([0-9.]+)", out or "")
    return round(float(match.group(1)) * 100) if match else None


def sinks(status):
    """Speakers and headphones from `wpctl status`: id, name, and which one plays."""
    found, inside = [], False
    for raw in status.splitlines():
        line = raw.strip(" │├└─\t")
        if line.endswith("Sinks:"):
            inside = True
            continue
        if inside:
            if not line or line.endswith(":"):
                break
            match = re.match(r"(\*)?\s*(\d+)\.\s+(.+?)\s*(\[vol:.*\])?$", line)
            if match:
                found.append({"id": int(match.group(2)), "name": match.group(3), "default": bool(match.group(1))})
    return found


def outputs():
    """Playable outputs, excluding ports explicitly reported as disconnected.

    Pulse indexes are object serials, not wpctl IDs. Match object.id instead.
    Unknown availability is normal for built-in speakers and virtual outputs.
    One JSON snapshot replaces a separate inspect process for every output.
    """
    found = sinks(run("wpctl", "status") or "")
    try:
        raw = json.loads(run("pactl", "--format=json", "list", "sinks") or "null")
    except (ValueError, TypeError):
        raw = None
    metadata = {}
    if isinstance(raw, list):
        for item in raw:
            if not isinstance(item, dict) or not isinstance(item.get("properties"), dict):
                continue
            ident = str(item["properties"].get("object.id", ""))
            if ident.isdigit():
                metadata[int(ident)] = item
    playable = []
    for sink in found:
        item = metadata.get(sink["id"])
        if item is not None:
            ports = item.get("ports", [])
            port = next((p for p in ports if isinstance(p, dict) and p.get("name") == item.get("active_port")), {}) \
                if isinstance(ports, list) else {}
            if port.get("availability") in ("not available", "no"):
                continue
            sink["none"] = item["properties"].get("node.name") == "auto_null"
        else:
            sink["none"] = 'node.name = "auto_null"' in (run("wpctl", "inspect", str(sink["id"])) or "")
        playable.append(sink)
    return playable


def output_action(ident):
    """Only select a current playback device, and acknowledge the observed default."""
    before = outputs()
    if not any(o["id"] == ident and not o["none"] for o in before):
        return {"ok": False, "outputs": before}
    changed = ok("wpctl", "set-default", str(ident))
    after = outputs()
    return {"ok": bool(changed and any(o["id"] == ident and o["default"] for o in after)), "outputs": after}


def app_streams(status):
    """The apps playing sound, from `wpctl status`'s Audio streams: (id, name) of each stream
    with a port that plays out ("output_FL > ..."), not ones that record."""
    found, section, inside, current = [], "", False, None
    for raw in status.splitlines():
        if raw and not raw[0].isspace():
            section, inside = raw.strip(), False
            continue
        line = raw.strip(" │├└─\t")
        if section != "Audio" or not line:
            continue
        if line.endswith(":"):
            inside = line == "Streams:"
            continue
        match = re.match(r"(\d+)\.\s+(.+?)\s*$", line)
        if not inside or not match:
            continue
        if ">" in line or "<" in line:
            if current and "output_" in line and current not in found:
                found.append(current)
        else:
            current = (int(match.group(1)), match.group(2))
    return found


def apps_sound():
    out = []
    for ident, name in app_streams(run("wpctl", "status") or ""):
        level = volume(str(ident))
        if level is not None:
            out.append({"id": ident, "name": name[:1].upper() + name[1:], "volume": level})
    return out


def bar_sound():
    """The bar's Sound (org.monet.sound): where the sound can play, PipeWire's stand-in left
    out, and the apps playing. How loud it reads from wpctl itself, often."""
    inputs = microphones(run("wpctl", "status") or "")
    microphone = next((source for source in inputs if source["default"]), None)
    if microphone:
        level = run("wpctl", "get-volume", str(microphone["id"])) or ""
        match = re.search(r"Volume:\s*([0-9.]+)", level)
        microphone = dict(microphone, volume=round(float(match[1]) * 100), muted="[MUTED]" in level) if match else None
    return {"outputs": [o for o in outputs() if not o["none"]], "apps": apps_sound(),
            "inputs": inputs, "microphone": microphone}


def microphones(status):
    """Audio capture devices only; video sources belong to a separate section."""
    found, audio, section = [], False, ""
    for raw in status.splitlines():
        if raw and not raw[0].isspace():
            audio, section = raw.strip() == "Audio", ""
        line = raw.strip(" │├└─\t")
        if line.endswith(":"):
            section = line if audio else ""
            continue
        if section not in ("Sources:", "Filters:"):
            continue
        match = re.match(r"(\*)?\s*(\d+)\.\s+(.+?)\s+\[Audio/Source(?:/Virtual)?\]$", line) if section == "Filters:" \
            else re.match(r"(\*)?\s*(\d+)\.\s+(.+?)\s*(\[vol:.*\])?$", line)
        if match:
            found.append({"id": int(match[2]), "name": match[3], "default": bool(match[1])})
    return found


def microphone_action(action, value, source_id=None):
    """Acknowledge capture changes only after WirePlumber reports the actual result."""
    if action == "mute" and value in ("on", "off"):
        # Use the selected source's id, so an unplug/default change cannot unmute
        # a different microphone between displaying the control and verification.
        current = bar_sound().get("microphone")
        if not current or current["id"] != source_id:
            return {"ok": False, "sound": bar_sound()}
        ident = current["id"]
        changed = ok("wpctl", "set-mute", str(ident), "1" if value == "on" else "0")
        state = bar_sound()
        mic = state.get("microphone")
        return {"ok": bool(changed and mic and mic["id"] == ident and mic["muted"] == (value == "on")), "sound": state}
    if action == "input" and value.isdigit():
        ident = int(value)
        if not any(source["id"] == ident for source in microphones(run("wpctl", "status") or "")):
            return {"ok": False, "sound": bar_sound()}
        changed = ok("wpctl", "set-default", str(ident))
        state = bar_sound()
        return {"ok": bool(changed and state.get("microphone") and state["microphone"]["id"] == ident), "sound": state}
    return {"ok": False}


# Screen --------------------------------------------------------------------

def busctl(*args):
    return run("busctl", "--user", *args, timeout=5)


SCREENS = ("org.kde.ScreenBrightness", "/org/kde/ScreenBrightness", "org.kde.ScreenBrightness")
DISPLAY = "org.kde.ScreenBrightness.Display"
OLD_BRIGHTNESS = ("org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                  "org.kde.Solid.PowerManagement.Actions.BrightnessControl")
KEYBOARD_LIGHT = ("org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement/Actions/KeyboardBrightnessControl",
                  "org.kde.Solid.PowerManagement.Actions.KeyboardBrightnessControl")


def brightness_display():
    """The built-in screen's brightness object, else the first screen's, else None. PowerDevil
    numbers screens as they come and go: docked, display0 can be the monitor."""
    names = busjson("--user", "get-property", *SCREENS, "DisplaysDBusNames") or []
    paths = [f"/org/kde/ScreenBrightness/{n}" for n in names if isinstance(n, str) and re.fullmatch(r"\w+", n)]
    inside = [p for p in paths if busjson("--user", "get-property", SCREENS[0], p, DISPLAY, "IsInternal") is True]
    return (inside + paths + [None])[0]


def brightness_state():
    path = brightness_display()
    now = busctl("get-property", SCREENS[0], path, DISPLAY, "Brightness") if path else None
    top = busctl("get-property", SCREENS[0], path, DISPLAY, "MaxBrightness") if path else None
    if not now or not top:
        now = busctl("call", *OLD_BRIGHTNESS, "brightness")
        top = busctl("call", *OLD_BRIGHTNESS, "brightnessMax")
    try:
        now, top = int(now.split()[1]), int(top.split()[1])
    except (AttributeError, IndexError, ValueError):
        return None
    return round(now * 100 / top) if top > 0 else None


def set_brightness(percent):
    path = brightness_display()
    top = busctl("get-property", SCREENS[0], path, DISPLAY, "MaxBrightness") if path else None
    if top:
        value = int(top.split()[1]) * percent // 100
        # 1: no on-screen sign (KDE's SuppressIndicator); the slider being dragged shows it.
        if busctl("call", SCREENS[0], path, DISPLAY, "SetBrightness", "iu", str(value), "1") is not None:
            return
    top = busctl("call", *OLD_BRIGHTNESS, "brightnessMax")
    if top:
        busctl("call", *OLD_BRIGHTNESS, "setBrightnessSilent", "i", str(int(top.split()[1]) * percent // 100))


def keyboard_light():
    """The keyboard's backlight: {"level", "levels"} (a few steps), or None without one."""
    top, now = busctl("call", *KEYBOARD_LIGHT, "keyboardBrightnessMax"), busctl("call", *KEYBOARD_LIGHT, "keyboardBrightness")
    try:
        top, now = int(top.split()[1]), int(now.split()[1])
    except (AttributeError, IndexError, ValueError):
        return None
    return {"level": now, "levels": top} if top > 0 else None


def set_keyboard_light(level):
    busctl("call", *KEYBOARD_LIGHT, "setKeyboardBrightnessSilent", "i", str(level))


# Monet's own switches ------------------------------------------------------

def kread(file, group, key, default=""):
    """A key from a KDE config file; group is a name, or the names of nested groups."""
    args = ["kreadconfig6", "--file", file]
    for name in (group,) if isinstance(group, str) else group:
        args += ["--group", name]
    out = run(*args, "--key", key, "--default", default)
    return (out or default).strip()


def kwrite(file, group, key, value):
    """Writes a key and tells whoever watches the file (Plasma, KWin) at once."""
    args = ["kwriteconfig6", "--notify", "--file", file]
    for name in (group,) if isinstance(group, str) else group:
        args += ["--group", name]
    return run(*args, "--key", key, str(value)) is not None


def light_state():
    try:
        mode = (CONFIG / "monet" / "light").read_text().strip()
    except OSError:
        mode = ""
    return mode if mode in ("mist", "smoke") else "hours"


def drawn_by_processor():
    """Nothing but the processor draws the screen (a virtual machine, or no graphics driver)."""
    info = busctl("call", "org.kde.KWin", "/KWin", "org.kde.KWin", "supportInformation") or ""
    return bool(re.search(r"OpenGL renderer string: (llvmpipe|softpipe)|Compositing Type: QPainter", info))


# Settings' Glass slider, from none to clear (monet-light dresses the desktop in each).
GLASS = ("solid", "matte", "frosted", "clear")


def glass_level(chosen):
    """The glass someone chose (0.9.3 kept true or false), or until they have, solid where
    blurring would make everything lag (as monet-light does)."""
    if chosen in GLASS:
        return chosen
    if isinstance(chosen, bool):
        return "clear" if chosen else "solid"
    return "solid" if drawn_by_processor() else "clear"


def prefs():
    try:
        saved = json.loads(PREFS.read_text())
    except (OSError, ValueError):
        saved = {}
    glass = glass_level(saved.get("glass"))
    series = saved.get("series") if saved.get("series") in SERIES else "hours"
    return {"hours": saved.get("hours", True), "placard": saved.get("placard", True), "glass": glass, "series": series,
            "weather": saved.get("weather", True), "dodge": saved.get("dodge", True), "snap": saved.get("snap", True)}


# Monet's paintings, each in four lights (wallpapers/Monet/contents/), one for each season (monet-light),
# or a photo of yours painted in the same four lights (monet-paint).
SERIES = ("hours", "lilies", "haystacks", "magpie", "seasons", "photo")

# Your photo, painted: monet-paint paints it in its own unit (it takes a minute), into
# photo-new beside the last one, which it replaces only once all four lights are done.
PAINTINGS = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "monet/paintings"
PAINT_UNIT = "monet-paint"
PHOTOS = (".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff", ".bmp")


def screen_size():
    """The painting's size: 3840 x 2160 for a 4K screen (or wider), else 2560 x 1440."""
    widest = 0
    for modes in Path("/sys/class/drm").glob("card*-*/modes"):
        first = modes.read_text(errors="replace").split("\n", 1)[0] if modes.is_file() else ""
        if re.fullmatch(r"\d+x\d+\w*", first):
            widest = max(widest, int(first.split("x")[0]))
    return "3840x2160" if widest >= 3200 else "2560x1440"


def paint_photo(path):
    """Starts painting the photo (Settings' Choose a photo…), in the background. False when it
    isn't a picture Monet paints."""
    photo = Path(path)
    try:
        if not photo.is_file() or photo.suffix.lower() not in PHOTOS or photo.stat().st_size > 300 << 20:
            return False
    except OSError:
        return False
    run("systemctl", "--user", "stop", f"{PAINT_UNIT}.service")
    (PAINTINGS / "failed").unlink(missing_ok=True)
    return ok("systemd-run", "--user", "--quiet", "--collect", f"--unit={PAINT_UNIT}", "--nice=10",
              "--property=IOSchedulingClass=idle", f"{LIBEXECDIR}/monet-quick", "paint-run", photo.as_posix().encode().hex())


def paint_run(path):
    """(monet-paint.service) Paints it, then puts it on the wall in place of the last one."""
    new, now, old = PAINTINGS / "photo-new", PAINTINGS / "photo", PAINTINGS / "photo-old"
    shutil.rmtree(new, ignore_errors=True)
    done = subprocess.run([f"{LIBEXECDIR}/monet-paint", path, str(new), screen_size()]).returncode == 0
    if not done or not all((new / f"{light}.jpg").is_file() for light in ("dawn", "day", "dusk", "night")):
        shutil.rmtree(new, ignore_errors=True)
        PAINTINGS.mkdir(parents=True, exist_ok=True)
        (PAINTINGS / "failed").write_text("")
        return False
    shutil.rmtree(old, ignore_errors=True)
    if now.exists():
        now.rename(old)
    new.rename(now)
    shutil.rmtree(old, ignore_errors=True)
    save_pref("series", "photo")
    run(f"{LIBEXECDIR}/monet-light", "paint", timeout=60)
    return True


def paint_state():
    """{"state": "painting" (with "percent"), "ready" (with "preview", a file URL) or "", and
    "failed" when the last photo couldn't be painted}."""
    painting = (run("systemctl", "--user", "is-active", f"{PAINT_UNIT}.service") or "").strip() in ("active", "activating")
    found = {"failed": (PAINTINGS / "failed").exists() and not painting}
    if painting:
        try:
            percent = int((PAINTINGS / "photo-new/progress").read_text().strip() or 0)
        except (OSError, ValueError):
            percent = 0
        return {**found, "state": "painting", "percent": percent}
    preview = PAINTINGS / "photo/preview.png"
    if preview.is_file() and (PAINTINGS / "photo/night.jpg").is_file():
        # The time it was made, so a new painting isn't the cached old one.
        return {**found, "state": "ready", "preview": f"{preview.as_uri()}?{int(preview.stat().st_mtime)}"}
    return {**found, "state": ""}


def save_pref(key, value):
    """Keeps what was just chosen, and only that: the rest stays unchosen and keeps following its
    default (glass, which is off where the processor draws the screen, found by test bench: saving a
    series kept glass on for good in a VM)."""
    try:
        chosen = json.loads(PREFS.read_text())
    except (OSError, ValueError):
        chosen = {}
    chosen = chosen if isinstance(chosen, dict) else {}
    chosen[key] = value
    PREFS.parent.mkdir(parents=True, exist_ok=True)
    PREFS.write_text(json.dumps(chosen))


def set_light(mode):
    """Saves the choice at once; the colors and the painting change a moment
    later, in the background, so the switch's own animation stays smooth while
    every window repaints (monet-light makes quick taps take turns)."""
    path = CONFIG / "monet" / "light"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(mode + "\n")
    subprocess.Popen(["sh", "-c", 'sleep 0.3; exec nice -n 5 "$0" paint', f"{LIBEXECDIR}/monet-light"],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def previous_monet(status):
    """From `rpm-ostree status --json`: the Monet to go back to ({version, date}, or {} if
    there's none), and whether it's already chosen for the next restart ("pending")."""
    deployments = status.get("deployments", [])
    earlier = next((d for d in deployments if not d.get("booted") and not d.get("staged")), None)
    if not earlier:
        return {}
    stamp = earlier.get("timestamp")
    date = time.strftime("%Y-%m-%d", time.localtime(stamp)) if isinstance(stamp, (int, float)) else ""
    first = deployments[0] if deployments else {}
    return {"version": earlier.get("version") or "", "date": date,
            "pending": first is earlier}


# An update that didn't start on this PC, so Monet went back by itself (monet-boot notes it),
# and Reset this PC waiting for the next restart (monet-reset).
WENT_BACK = Path("/var/lib/monet/went-back.json")
RESET_PENDING = Path("/var/lib/monet/reset")


def went_back(path=WENT_BACK):
    """{version, to}: the Monet that didn't start and the one it went back to, or {}."""
    try:
        found = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(found, dict):
        return {}
    return {"version": str(found.get("version") or ""), "to": str(found.get("to") or "")}


def update_check():
    """What `monet update --check --json` found, plus whether it worked."""
    result = subprocess.run([f"{BINDIR}/monet", "update", "--check", "--json"],
                            capture_output=True, text=True, timeout=300)
    for line in reversed(result.stdout.splitlines()):
        try:
            found = json.loads(line)
        except ValueError:
            continue
        if isinstance(found, dict):
            return dict(found, ok=True)
    message = (result.stderr or result.stdout).strip().splitlines()
    return {"ok": False, "message": message[-1] if message else ""}


# Firmware: the PC's own parts (its UEFI, disks, docks), from LVFS through
# fwupd, like Monet itself: only when asked.

# fwupd's names for what stops an update, as a sentence.
FIRMWARE_PROBLEMS = {
    "require-ac-power": "Plug in the charger first.",
    "system-power-too-low": "Charge the battery a little first.",
    "power-too-low": "The device's battery is too low.",
    "lid-is-closed": "Open the lid first.",
    "display-required": "Connect a screen first.",
    "update-in-progress": "An update is already running.",
    "in-use": "It's in use right now.",
    "unreachable": "It can't be reached right now.",
}
# fwupdmgr asks questions on its own otherwise (old update lists, unsent reports).
FWUPD_QUIET = ("--no-metadata-check", "--no-unreported-check")


def firmware_updates(report):
    """Each device's newest update in `fwupdmgr get-updates --json`."""
    found = []
    for device in (report or {}).get("Devices") or []:
        releases = device.get("Releases") or []
        if not releases:
            continue
        flags = set(device.get("Flags") or [])
        problems = [FIRMWARE_PROBLEMS[p] for p in device.get("Problems") or [] if p in FIRMWARE_PROBLEMS]
        found.append({
            "device": device.get("Name", ""),
            "vendor": device.get("Vendor", ""),
            "current": device.get("Version", ""),
            "version": releases[0].get("Version", ""),
            "summary": releases[0].get("Summary", ""),
            "restart": bool(flags & {"needs-reboot", "needs-shutdown"}),
            "blocked": problems[0] if problems else device.get("UpdateError", ""),
        })
    return found


def last_line(text):
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


def firmware_check():
    if not shutil.which("fwupdmgr"):
        return {"ok": True, "updates": []}
    try:
        result = subprocess.run(["fwupdmgr", "get-updates", "--json", *FWUPD_QUIET],
                                capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return {"ok": False, "message": "Monet couldn't ask about firmware updates."}
    try:
        report = json.loads(result.stdout)
    except ValueError:
        report = None
    if isinstance(report, dict):
        return {"ok": True, "updates": firmware_updates(report)}
    # 2 is fwupd's "nothing to do": no updates, or no part it can update.
    if result.returncode == 2:
        return {"ok": True, "updates": []}
    return {"ok": False, "message": last_line(result.stderr or result.stdout)}


def firmware_update():
    """Installs them. fwupd asks for the password itself; nothing restarts."""
    try:
        result = subprocess.run(["fwupdmgr", "update", "--assume-yes", "--no-reboot-check", *FWUPD_QUIET],
                                capture_output=True, text=True, timeout=3600)
    except (OSError, subprocess.TimeoutExpired):
        return {"ok": False, "message": "The firmware update didn't finish."}
    return {"ok": result.returncode == 0, "message": last_line(result.stderr or result.stdout)}


def restart():
    """KDE's own restart question, so open apps can save first."""
    if busctl("call", "org.kde.LogoutPrompt", "/LogoutPrompt", "org.kde.LogoutPrompt", "promptReboot") is None:
        run("systemctl", "reboot")


# Security: what keeps this PC safe, at a glance (Settings → Security). It only looks, here and
# now; firmware updates are their own question (firmware-check), as they take a while.

EFIVARS = Path("/sys/firmware/efi/efivars")
# UEFI's own variables (EFI_GLOBAL_VARIABLE, as monet-core's GLOBAL_GUID; a test keeps them the same).
EFI_GLOBAL = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
SECURE_BOOT_VAR = f"SecureBoot-{EFI_GLOBAL}"
# Monet's kernel and NVIDIA's driver are signed with Universal Blue's key.
MONET_KEY = Path("/etc/pki/akmods/certs/akmods-ublue.der")


def secure_boot(efivars=EFIVARS):
    """"on" or "off", or "" when the PC didn't start in UEFI mode (then it can't be on)."""
    if not efivars.is_dir():
        return ""
    try:
        data = (efivars / SECURE_BOOT_VAR).read_bytes()
    except OSError:
        return "off"
    # Four bytes of attributes, then the value.
    return "on" if len(data) > 4 and data[4] == 1 else "off"


def key_trusted(key=MONET_KEY):
    """Whether the firmware trusts Monet's key: it has to before Secure Boot goes on, or Monet
    won't start. None when it can't tell."""
    if not key.exists() or not shutil.which("mokutil"):
        return None
    out = said(("mokutil", "--test-key", str(key)))
    return True if "already enrolled" in out else False if "not enrolled" in out else None


def encrypted():
    """Whether Monet's disk is encrypted: the disk it runs from sits inside a LUKS container.
    None when it can't tell."""
    source = (run("findmnt", "-n", "-o", "SOURCE", "/sysroot") or run("findmnt", "-n", "-o", "SOURCE", "/") or "").strip()
    device = source.split("[", 1)[0]
    if not device.startswith("/dev/"):
        return None
    chain = run("lsblk", "-s", "-n", "-o", "TYPE", device)
    return None if chain is None else "crypt" in chain.split()


def firewall():
    """"on" or "off", or "" when this Monet has no firewall. Asked of systemd, which never needs a
    password (firewall-cmd --state may: outside the desktop's own session it said no)."""
    if not shutil.which("firewall-cmd"):
        return ""
    return "on" if (run("systemctl", "is-active", "firewalld") or "").strip() == "active" else "off"


# Settings → Security → Apps that can accept connections (monet-secure's APPS, ports and all).
FIREWALL_APPS = ("games", "localsend", "syncthing", "sunshine", "deskflow")
FIREWALL_ALLOWED = Path("/var/lib/monet/firewall-allowed.json")


def firewall_allowed(path=FIREWALL_ALLOWED):
    """The apps let in from the network (monet-secure firewall-allow keeps the list)."""
    try:
        names = json.loads(path.read_text())
    except (OSError, ValueError):
        return []
    return [name for name in FIREWALL_APPS if isinstance(names, list) and name in names]


def firewall_strict():
    """Whether only what Monet uses comes in: the firewall's default zone is Monet's
    (linux/firewalld/monet.xml). None when the firewall can't say."""
    zone = (run("firewall-cmd", "--get-default-zone") or "").strip()
    return zone == "monet" if zone else None


# A program that starts accepting connections ------------------------------------------
# As Windows asks the first time a program listens: while Monet's zone keeps the network out,
# a program of the person's that opens a port to other devices (a world they host, a server
# they started) is asked about once, in a notification. Allow lets that port in through
# monet-secure, which asks for an administrator, as Windows' shield does; Keep blocked is
# remembered too. Settings → Security lists both, each with its switch. TCP only: a UDP
# socket doesn't say whether it waits for others (the games Monet knows are on Settings' list).

LISTENING = CONFIG / "monet/listening.json"  # {"PROGRAM PORT": {"name", "port", "allowed"}}
LISTEN_EVERY = 5  # seconds between looks, and Monet's zone checked each minute
ZONE_FILES = (Path("/etc/firewalld/zones/monet.xml"), Path("/usr/lib/firewalld/zones/monet.xml"))
LOOPBACK = re.compile(r"(127\.|\[::1\]|\[::ffff:127\.)")


def secure_helper():
    """monet-secure as a module: what Settings → Security lets in, as it keeps it."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader("monet_secure", f"{LIBEXECDIR}/monet-secure")
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("monet_secure", loader))
    try:
        loader.exec_module(module)
    except (OSError, SyntaxError, ImportError):
        return None
    return module


def port_range(text):
    low, _, high = str(text).partition("-")
    try:
        return set(range(int(low), int(high or low) + 1))
    except ValueError:
        return set()


def let_in(zone_files=ZONE_FILES, secure=None):
    """The TCP ports the network reaches: Monet's zone's, and what Settings → Security lets in."""
    ports = set()
    for path in zone_files:
        try:
            zone = ET.parse(path).getroot()
        except (OSError, ET.ParseError):
            continue  # /etc's is root's alone; the image's is everyone's
        ports = set().union(*(port_range(p.get("port")) for p in zone.iter("port") if p.get("protocol") == "tcp"))
        break
    secure = secure or secure_helper()
    if secure:
        for name in secure.allowed():
            ports |= set().union(*(port_range(s[4:]) for s in secure.APPS[name] if s.startswith("tcp/")))
        ports |= {int(p["port"][4:]) for p in secure.allowed_ports()}
    return ports


def listening_now():
    """[(port, pid, process)] of the TCP ports this person's programs wait on for other devices
    (not for this PC alone). ss names the processes of the person's own sockets only."""
    found = []
    for line in (run("ss", "-Hltnp") or "").splitlines():
        fields = line.split()
        program = re.search(r'users:\(\("([^"]*)",pid=(\d+)', line)
        if len(fields) < 5 or not program:
            continue
        address, _, port = fields[3].rpartition(":")
        if port.isdigit() and not LOOPBACK.match(address) and "%lo" not in address:
            found.append((int(port), int(program[2]), program[1]))
    return found


def program_of(pid, process):
    """(key, name) of the program behind a process: its app menu entry when it's an app (a
    Flatpak's too, by its systemd unit), else its executable."""
    try:
        unit = Path(f"/proc/{pid}/cgroup").read_text().strip().rsplit("/", 1)[-1]
    except OSError:
        unit = ""
    app = app_of_unit(unit)
    entry = entry_by_id(app) if app else None
    if entry and entry.get("Name"):
        return app, local_name(entry)
    try:
        return os.readlink(f"/proc/{pid}/exe"), process
    except OSError:
        return process, process


def remember_listening(key, name, port, allowed, path=None):
    path = path or LISTENING
    known = read_json(path)
    known = known if isinstance(known, dict) else {}
    known[key] = {"name": name, "port": port, "allowed": allowed}
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(known, ensure_ascii=False) + "\n")


def listening_allow(name, port, on):
    """The port in or out again (monet-secure, which asks for an administrator)."""
    return ok("pkexec", f"{LIBEXECDIR}/monet-secure", "firewall-allow-port", " ".join(name.split())[:60] or "?",
              f"tcp/{port}", "on" if on else "off", timeout=300)


def ask_listening(key, name, port, lock=None):
    """The question, once: Allow or Keep blocked. Unanswered (the notification closed), it's
    asked again at the next sign-in."""
    # Critical, so it stays until it's answered, as Windows' question does.
    answer = (run("notify-send", "--app-name=Monet", "--icon=security-high", "--urgency=critical", f"--action=allow={tr('Allow')}",
                  f"--action=block={tr('Keep blocked')}", "--wait", tr("%1 wants to accept connections", name),
                  tr("From other devices on this network, on port %1. Monet's firewall keeps them out until you allow it.",
                     str(port)), timeout=24 * 3600) or "").strip()
    if answer not in ("allow", "block"):
        return None
    allowed = answer == "allow" and listening_allow(name, port, True)
    with lock or contextlib.nullcontext():
        remember_listening(key, name, port, allowed)
    return allowed


def listening_watch(every=LISTEN_EVERY, rounds=None):
    """monet-listening.service: each program and port asked about once, while Monet's zone is on."""
    if getpass.getuser() == "guest":
        return 0
    import threading
    lock, asked, checked, strict, open_ports = threading.Lock(), set(), -1e9, False, set()
    while rounds is None or rounds > 0:
        if time.monotonic() - checked > 60:
            checked, strict = time.monotonic(), firewall_strict() is True
            open_ports = let_in() if strict else set()
        if strict:
            with lock:
                known = read_json(LISTENING)
            for port, pid, process in listening_now():
                key, name = program_of(pid, process)
                key = f"{key} {port}"
                if port < 1024 or port in open_ports or key in asked or key in (known if isinstance(known, dict) else {}):
                    continue
                asked.add(key)
                threading.Thread(target=ask_listening, args=(key, name, port, lock), daemon=True).start()
        rounds = None if rounds is None else rounds - 1
        time.sleep(every)
    return 0


def listening_list(path=None, secure=None):
    """Settings' rows: each program asked about, whether its port is let in now, by name."""
    known = read_json(path or LISTENING)
    secure = secure or secure_helper()
    ports = {p["port"] for p in secure.allowed_ports()} if secure else set()
    rows = [{"key": key.encode().hex(), "name": str(v.get("name") or ""), "port": v.get("port"),
             "allowed": f"tcp/{v.get('port')}" in ports}
            for key, v in (known.items() if isinstance(known, dict) else []) if isinstance(v, dict)]
    return sorted(rows, key=lambda r: (r["name"].lower(), r["port"] or 0))


def update_waiting():
    """Whether an update is downloaded and used from the next restart."""
    try:
        status = json.loads(run("rpm-ostree", "status", "--json", timeout=30) or "{}")
    except ValueError:
        return False
    return any(d.get("staged") for d in status.get("deployments", []))


def security():
    backups = backup_state()
    return {
        "secureBoot": secure_boot(),
        "keyTrusted": key_trusted(),
        "encrypted": encrypted(),
        "firewall": firewall(),
        "firewallStrict": firewall_strict(),
        "allowed": firewall_allowed(),
        "listening": listening_list(),
        "autoUpdates": not Path("/var/lib/monet/auto-updates-off").exists(),
        "updateWaiting": update_waiting(),
        "versions": backups["versions"],
        "drive": backups["label"] if backups["drive"] else "",
    }


def firmware_setup():
    """Restarts into the PC's firmware settings (where Secure Boot is turned on), through
    KDE's restart question so open apps can save first."""
    if run("busctl", "--system", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
           "org.freedesktop.login1.Manager", "SetRebootToFirmwareSetup", "b", "true", timeout=10) is None:
        return {"ok": False}
    restart()
    return {"ok": True}


# Music ---------------------------------------------------------------------

def data_dirs():
    """XDG's data folders, nearest first (Flatpak's among them)."""
    home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    return [home] + [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]


def app_dirs():
    """Where the menu's apps are described, nearest first."""
    return [d / "applications" for d in data_dirs()]


def desktop_entry(text):
    """The [Desktop Entry] group of a .desktop file, as a dict."""
    entry, inside = {}, False
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            inside = line == "[Desktop Entry]"
        elif inside and "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            entry.setdefault(key.strip(), value.strip())
    return entry


def native_executable(path):
    """An explicitly selected native executable; registering it never runs it."""
    path = Path(path).absolute()
    if not path.is_file() or not os.access(path, os.X_OK):
        raise ValueError(tr("Choose an executable application file."))
    with path.open("rb") as stream:
        header = stream.read(4)
    if header != b"\x7fELF" and not header.startswith(b"#!"):
        raise ValueError(tr("Choose a Linux application or script. Windows programs use Run in Monet."))
    return path


def native_shortcut(path, name, apps=None):
    """Create one menu entry, without importing downloaded desktop commands or MIME defaults."""
    path = native_executable(path)
    name = name.strip()
    if not name or len(name) > 128 or any(ord(c) < 32 or ord(c) == 127 for c in name):
        raise ValueError(tr("Choose a short application name without line breaks."))
    apps = apps if apps is not None else DATA_HOME / "applications"
    apps.mkdir(parents=True, exist_ok=True)
    token = str(path).encode("utf-8").hex()
    import hashlib
    entry = apps / ("monet-local-" + hashlib.sha256(str(path).encode()).hexdigest()[:24] + ".desktop")
    icon = native_icon(path, apps.parent, entry.stem)
    # The path is data, not a shell command or a Desktop Entry field code.
    text = ("[Desktop Entry]\nType=Application\nName=" + name.replace("\\", "\\\\") + "\n"
            f'Exec="{LIBEXECDIR}/monet-quick" native-run {token}\n'
            f"Icon={icon}\nTerminal=false\nStartupNotify=false\nCategories=Utility;\nX-Monet=true\n")
    if entry.exists():
        if entry.read_text(encoding="utf-8") != text:
            raise FileExistsError(tr("A shortcut for this application already exists. Edit it in the application menu."))
        return entry
    # Exclusive creation preserves any existing personal menu entry.
    with entry.open("x", encoding="utf-8") as stream:
        stream.write(text)
    return entry


def native_icon(path, data_home, identity):
    """Keep a selected app's packaged icon, without importing its desktop command.

    Only inspect nearby standard package locations. Copy to a named theme icon so
    the menu, dock and Monet's frame service can all use it. No recursive scan.
    """
    roots = list(path.parents)[:4]
    for root in roots:
        if root in (Path.home(), Path("/")):
            break
        candidates = [("", path.with_suffix(ext)) for ext in (".png", ".svg", ".svgz")]
        app_dir = root / "share/applications"
        try:
            entries = sorted(app_dir.glob("*.desktop"))[:128]
            for desktop in entries:
                if desktop.stat().st_size > 65536 or not desktop.resolve().is_relative_to(root.resolve()):
                    continue
                fields = desktop_entry(desktop.read_text(encoding="utf-8", errors="replace"))
                command = shlex.split(fields.get("Exec", ""))
                if fields.get("Type") != "Application" or not command or Path(command[0]).name.casefold() != path.name.casefold():
                    continue
                name = fields.get("Icon", "")
                if Path(name).is_absolute():
                    candidates.append(("", Path(name)))
                elif ICON_NAME.fullmatch(name):
                    # Existing hand-painted icons take precedence over generated frames.
                    if any((base / "icons/Monet/apps/scalable" / (name + ".svg")).is_file()
                           for base in data_dirs() + [Path(DATADIR)]):
                        return name
                    for ext in (".png", ".svg", ".svgz"):
                        candidates.append((name, root / "share/pixmaps" / (name + ext)))
                        candidates.extend((name, item) for item in sorted(
                            (root / "share/icons/hicolor").glob("*/apps/" + name + ext))[:32])
        except (OSError, ValueError):
            continue
        for _, candidate in candidates:
            try:
                if not candidate.resolve().is_relative_to(root.resolve()) or candidate.stat().st_size > 8 * 1024 * 1024:
                    continue
                data = icon_data(candidate)
                if not data or not (framed_png(data) if candidate.suffix.lower() == ".png"
                                    else framed_svg(data.decode("utf-8", "replace"))):
                    continue
                ext = ".png" if candidate.suffix.lower() == ".png" else ".svg"
                target = data_home / "icons/hicolor" / ("256x256" if ext == ".png" else "scalable") / "apps" / (identity + ext)
                target.parent.mkdir(parents=True, exist_ok=True)
                if not target.exists():
                    with target.open("xb") as stream:
                        stream.write(data)
                return identity
            except (OSError, ValueError):
                continue
    return "application-x-executable"


def native_shortcut_dialog(path):
    try:
        executable = native_executable(path)
        name = run("kdialog", "--title", tr("Add to apps"), "--inputbox",
                   tr("Add this application to the menu. Keep its folder in place.\n\n%1\n\nName:", str(executable)),
                   executable.stem, timeout=600)
        if name is None:
            return False
        native_shortcut(executable, name)
    except (OSError, ValueError) as error:
        run("kdialog", "--title", tr("Add to apps"), "--error", tr(str(error)), timeout=600)
        return False
    run("kbuildsycoca6", "--noincremental", timeout=30)
    run("notify-send", "--app-name=Monet", "--icon=application-x-executable",
        tr("Added to apps"), name)
    return True


def native_run(token):
    try:
        executable = native_executable(unhex(token))
        subprocess.Popen([str(executable)], cwd=executable.parent, start_new_session=True)
        return True
    except (OSError, ValueError) as error:
        run("kdialog", "--title", tr("Application couldn't open"), "--error",
            tr("Check that the application folder is still in place, then add it to apps again.") + "\n\n" + str(error), timeout=600)
        return False


def music_apps(entries, default=""):
    """The apps that play music, from (file name, entry) pairs, nearest first: the
    nearest copy of an entry decides (a hidden local copy hides the app). The PC's
    default player first, then by name."""
    seen, apps = set(), []
    for app_id, entry in entries:
        if app_id in seen:
            continue
        seen.add(app_id)
        kinds = set(filter(None, entry.get("Categories", "").split(";")))
        if (entry.get("Type") == "Application" and entry.get("NoDisplay") != "true" and entry.get("Hidden") != "true"
                and "Audio" in kinds and kinds & {"Player", "Music"}):
            apps.append({"id": app_id, "name": entry.get("Name", app_id), "icon": entry.get("Icon", "")})
    apps.sort(key=lambda app: (app["id"] != default, app["name"].lower()))
    return apps


def menu_entries():
    """Every app entry, as (file name, entry) pairs, nearest first."""
    entries = []
    for folder in app_dirs():
        for path in sorted(folder.glob("*.desktop")) if folder.is_dir() else ():
            try:
                entries.append((path.name, desktop_entry(path.read_text(encoding="utf-8", errors="replace"))))
            except OSError:
                pass
    return entries


def music():
    """What Now Playing offers when nothing plays: the music apps, and the Store for more."""
    entries = menu_entries()
    default = (run("xdg-mime", "query", "default", "audio/mpeg") or "").strip()
    return {"apps": music_apps(entries, default), "store": store_entry()}


def store_entry():
    """The Store's menu entry (Monet's own; Bazaar or Discover before it), or ""."""
    stores = ("monet-store.desktop", "io.github.kolunmi.Bazaar.desktop", "org.kde.discover.desktop")
    return next((s for s in stores if any((folder / s).is_file() for folder in app_dirs())), "")


def launch(app_id):
    """Starts an app by its menu entry's file name, the way the menu would."""
    if not re.fullmatch(r"[\w.+-]+\.desktop", app_id):
        return False
    path = next((folder / app_id for folder in app_dirs() if (folder / app_id).is_file()), None)
    if path is None:
        return False
    for command in (["kioclient", "exec", str(path)], ["gio", "launch", str(path)], ["gtk-launch", app_id[:-8]]):
        if shutil.which(command[0]):
            subprocess.Popen(command, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    return False


def entry_by_id(app_id):
    """The nearest entry of that name, or None."""
    for folder in app_dirs():
        path = folder / app_id
        if path.is_file():
            try:
                return desktop_entry(path.read_text(encoding="utf-8", errors="replace"))
            except OSError:
                return None
    return None


# Frames ----------------------------------------------------------------------
# An app Monet hasn't painted gets its own icon on Monet's canvas, the paint's
# relief over both, in the account's own copy of the theme (found before the
# PC's). Made again at sign-in and as apps arrive (monet-frames.path).

FRAME_MARK = "Monet frame:"
FRAME_BOX = (26, 26, 76)  # where the app's icon sits on the canvas: x, y and size on the 128 grid
INHERITED = ("breeze", "hicolor")  # what Monet's index.theme inherits, nearest first
SVG_NS, XLINK = "http://www.w3.org/2000/svg", "http://www.w3.org/1999/xlink"
ICON_NAME = re.compile(r"[\w+-][\w.+-]*")
ROOT_ONLY = {"xmlns", "width", "height", "viewBox", "version", "baseProfile", "id", "x", "y", "transform",
             "preserveAspectRatio", "enable-background"}


def is_frame(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return FRAME_MARK in f.read(400)
    except OSError:
        return False


def painted_names():
    """The icon names Monet paints, wherever its theme is installed, frames aside."""
    names, home = set(), data_dirs()[0]
    for base in data_dirs():
        for folder, _, files in os.walk(base / "icons/Monet"):
            for f in files:
                if f.endswith(".svg") and not (base == home and is_frame(Path(folder) / f)):
                    names.add(f[:-4])
    return names


def icon_size(parts):
    """A theme folder's icon size (48, 128x128, 256x256@2, scalable), in pixels."""
    sizes = [512 if part == "scalable" else int(m[1]) * int(m[2] or 1)
             for part in parts if part == "scalable" or (m := re.fullmatch(r"(\d+)(?:x\d+)?(?:@(\d+)x?)?", part))]
    return max(sizes, default=0)


def icon_files(names):
    """Each name's icon files in the themes Monet inherits, then the pixmaps, as (rank, size, path)."""
    found = {}
    roots = [(rank, base / "icons" / theme) for rank, theme in enumerate(INHERITED) for base in data_dirs()]
    roots += [(len(INHERITED), base / "pixmaps") for base in data_dirs()]
    for rank, root in roots:
        for folder, _, files in os.walk(root):
            for f in files:
                stem, ext = os.path.splitext(f)
                if stem in names and ext.lower() in (".png", ".svg", ".svgz"):
                    size = icon_size(Path(folder).relative_to(root).parts)
                    found.setdefault(stem, []).append((rank, size, Path(folder) / f))
    return found


def own_icon(candidates):
    """The icon KDE would show, from the nearest theme that has it: a big PNG, else its SVG, else the biggest PNG."""
    if not candidates:
        return None
    nearest = min(rank for rank, _, _ in candidates)
    pngs = sorted((size, str(path)) for rank, size, path in candidates if rank == nearest and path.suffix.lower() == ".png")
    svgs = sorted((size, str(path)) for rank, size, path in candidates if rank == nearest and path.suffix.lower() in (".svg", ".svgz"))
    if pngs and (pngs[-1][0] >= 128 or not svgs):
        return Path(pngs[-1][1])
    return Path(svgs[-1][1]) if svgs else None


def placed(width, height):
    """Where a picture of that size goes in the frame, keeping its shape: x, y, scale."""
    x, y, size = FRAME_BOX
    k = size / max(width, height)
    return x + (size - width * k) / 2, y + (size - height * k) / 2, k


def framed_png(data):
    """A PNG icon as an image in the frame, or None."""
    if data[:8] != b"\x89PNG\r\n\x1a\n" or len(data) < 24:
        return None
    width, height = int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
    if not width or not height:
        return None
    x, y, k = placed(width, height)
    return (f'<image x="{x:.2f}" y="{y:.2f}" width="{width * k:.2f}" height="{height * k:.2f}" '
            f'xlink:href="data:image/png;base64,{base64.b64encode(data).decode()}"/>'), {}


def framed_svg(text):
    """An SVG icon drawn in the frame: what its root holds, in a group placed and scaled
    (Qt's SVG can't nest whole documents), and the namespaces it needs; or None."""
    root = re.search(r"<svg\b([^>]*?)(/?)>", text)
    end = text.rfind("</svg>")
    if "<!ENTITY" in text or not root or root[2] or end < root.end():
        return None
    attrs = dict(re.findall(r'([\w:.-]+)\s*=\s*"([^"]*)"', root[1]) + re.findall(r"([\w:.-]+)\s*=\s*'([^']*)'", root[1]))
    try:
        box = [float(v) for v in re.split(r"[\s,]+", attrs.get("viewBox", "").strip()) if v] or \
            [0, 0, float(attrs["width"].removesuffix("px")), float(attrs["height"].removesuffix("px"))]
    except (KeyError, ValueError):
        return None
    if len(box) != 4 or box[2] <= 0 or box[3] <= 0 or attrs.get("xmlns", SVG_NS) != SVG_NS:
        return None
    x, y, k = placed(box[2], box[3])
    shift = f" translate({-box[0]:g},{-box[1]:g})" if box[0] or box[1] else ""
    # What the root says about painting (fill, style, class) carries over to the group.
    kept = "".join(f' {key}="{value}"' for key, value in attrs.items() if ":" not in key and key not in ROOT_ONLY)
    spaces = {key[6:]: value for key, value in attrs.items() if key.startswith("xmlns:")}
    return (f'<g transform="translate({x:.3f},{y:.3f}) scale({k:.5f}){shift}"{kept}>'
            f"{text[root.end():end]}</g>"), spaces


def icon_data(path):
    """Bound compressed and plain icon reads; a broken icon mustn't break app search."""
    limit = 8 * 1024 * 1024
    try:
        with (gzip.open(path, "rb") if path.suffix.lower() == ".svgz" else path.open("rb")) as stream:
            data = stream.read(limit + 1)
        return data if len(data) <= limit else b""
    except (OSError, EOFError):
        return b""


def frame_svg(name, path, art):
    """The framed icon's SVG, or "" if the app's own can't be framed safely."""
    data = icon_data(path)
    if not data:
        return ""
    made = framed_png(data) if path.suffix.lower() == ".png" else framed_svg(data.decode("utf-8", "replace"))
    if not made or made[1].get("xlink", XLINK) != XLINK:
        return ""
    icon, spaces = made
    spaces["xlink"] = XLINK
    declared = "".join(f' xmlns:{key}="{value}"' for key, value in spaces.items())
    text = (f"<!-- {FRAME_MARK} {name}, its own icon on Monet's canvas. Made by monet-quick frames. -->\n"
            f'<svg xmlns="{SVG_NS}"{declared} viewBox="0 0 128 128">\n'
            f'  <image width="128" height="128" xlink:href="data:image/png;base64,{art[0]}"/>\n'
            f"  {icon}\n"
            f'  <image width="128" height="128" xlink:href="data:image/png;base64,{art[1]}"/>\n</svg>\n')
    try:
        ET.fromstring(text)  # whatever the app's SVG did that this can't carry shows up here
    except ET.ParseError:
        return ""
    return text


def frames():
    """Frames the menu's apps that Monet hasn't painted and takes away the frames no longer
    needed; KDE looks at its icons again if anything changed. Returns the framed names."""
    textures = Path(DATADIR) / "monet/textures"
    try:
        art = [base64.b64encode((textures / f"frame-{part}.png").read_bytes()).decode() for part in ("canvas", "relief")]
    except OSError:
        return []
    seen, names = set(), set()
    for app_id, entry in menu_entries():
        if app_id in seen:
            continue
        seen.add(app_id)
        icon = entry.get("Icon", "")
        if (entry.get("Type") == "Application" and entry.get("NoDisplay") != "true" and entry.get("Hidden") != "true"
                and ICON_NAME.fullmatch(icon)):
            names.add(icon)
    names -= painted_names()
    found = icon_files(names)
    out = data_dirs()[0] / "icons/Monet/apps/scalable"
    made, changed = [], False
    for name in sorted(names):
        path = own_icon(found.get(name))
        text = frame_svg(name, path, art) if path else ""
        if not text:
            continue
        made.append(name)
        target = out / f"{name}.svg"
        try:
            if not target.is_file() or target.read_text(encoding="utf-8") != text:
                out.mkdir(parents=True, exist_ok=True)
                target.write_text(text, encoding="utf-8")
                changed = True
        except OSError:
            pass
    for old in out.glob("*.svg") if out.is_dir() else ():
        if old.stem not in made and is_frame(old):
            old.unlink(missing_ok=True)
            changed = True
    if changed:
        run("dbus-send", "--session", "--type=signal", "/KIconLoader", "org.kde.KIconLoader.iconChanged", "int32:0")
    return made


# Zen -------------------------------------------------------------------------
# Zen, the browser, in Monet's look: share/monet/zen copied into each of its
# profiles' chrome/ folder and imported from userChrome.css and
# userContent.css, with the two prefs that takes. At sign-in and as Zen
# arrives or makes a profile (monet-zen.path); Zen shows it from its next start.

ZEN_ID = "app.zen_browser.zen"
ZEN_BEGIN, ZEN_END = "// Monet: begin (monet-quick zen writes this part)", "// Monet: end"
ZEN_PREFS = ('user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);',
             'user_pref("zen.urlbar.replace-newtab", false);  // a new tab opens on the painting',
             # Its welcome would offer a theme Monet's colors overrule, and Monet makes it the browser itself.
             'user_pref("zen.welcome-screen.seen", true);',
             'user_pref("browser.shell.checkDefaultBrowser", false);',
             # Nor Zen's own pages, opened as tabs: its welcome and privacy policy at the first start,
             # what's new after each update, and its Update Complete note (found in a test VM).
             'user_pref("startup.homepage_welcome_url", "");',
             'user_pref("startup.homepage_welcome_url.additional", "");',
             'user_pref("startup.homepage_override_url", "");',
             'user_pref("browser.startup.homepage_override.mstone", "ignore");',
             'user_pref("datareporting.policy.firstRunURL", "");',
             'user_pref("zen.updates.show-update-notification", false);')
ZEN_IMPORTS = {"userChrome.css": '@import url("monet/zen.css");', "userContent.css": '@import url("monet/newtab.css");'}


# Firefox's (so Zen's) profile for each installation, by an id for where it's installed: a hash of
# its folder in the Flatpak (/app/zen), so the same on every PC. Monet's profile is made that
# installation's before Zen first starts, so it starts in it, already dressed; else Zen makes a
# profile of its own and opens its welcome in it before Monet can dress it.
ZEN_INSTALL = "2953CB39A2589173"


def zen_root():
    return Path.home() / ".var/app" / ZEN_ID / ".zen"


def zen_profiles(root):
    """Zen's profile folders, from its profiles.ini. Before Zen has made one, Monet's
    own, as the default, which Zen takes on its first start already dressed."""
    ini, installs = root / "profiles.ini", root / "installs.ini"
    claim = f"[Install{ZEN_INSTALL}]\nDefault=monet.default\nLocked=1\n"
    try:
        if not ini.is_file():
            (root / "monet.default").mkdir(parents=True, exist_ok=True)
            ini.write_text("[Profile0]\nName=Monet\nIsRelative=1\nPath=monet.default\nDefault=1\n\n"
                           f"{claim}\n[General]\nStartWithLastProfile=1\nVersion=2\n")
            installs.write_text(claim.replace("[Install", "["))
        elif not installs.exists() and "[Install" not in ini.read_text(encoding="utf-8", errors="replace") \
                and (root / "monet.default").is_dir():
            # Monet's profile, made before (by an earlier Monet), and Zen not started yet.
            ini.write_text(ini.read_text(encoding="utf-8", errors="replace").rstrip("\n") + "\n\n" + claim)
            installs.write_text(claim.replace("[Install", "["))
        found = configparser.ConfigParser(interpolation=None, strict=False)
        found.read_string(ini.read_text(encoding="utf-8", errors="replace"))
    except (OSError, configparser.Error):
        return []
    folders = []
    for section in found.sections():
        path = found[section].get("Path")
        if section.startswith("Profile") and path:
            folder = root / path if found[section].get("IsRelative", "1") == "1" else Path(path)
            if folder.is_dir():
                folders.append(folder)
    return folders


def with_part(text, lines):
    """user.js with Monet's part (between its marks) as lines: replaced where it is, else added."""
    part = "\n".join([ZEN_BEGIN, *lines, ZEN_END]) + "\n"
    start = text.find(ZEN_BEGIN)
    stop = text.find(ZEN_END, start) if start >= 0 else -1
    if stop >= 0:
        return text[:start] + part + text[stop + len(ZEN_END):].removeprefix("\n")
    return text + ("\n" if text and not text.endswith("\n") else "") + part


def write_if_changed(path, data):
    if not path.is_file() or path.read_bytes() != data:
        path.write_bytes(data)


def zen():
    """Dresses Zen in Monet's look, once Zen is installed. Returns the profile folders dressed."""
    if not any((folder / f"{ZEN_ID}.desktop").is_file() for folder in app_dirs()):
        return []
    source = Path(DATADIR) / "monet/zen"
    try:
        files = {name: (source / name).read_bytes() for name in ("zen.css", "window-buttons.css", "mist.jpg", "smoke.jpg")}
        newtab = (source / "newtab.css").read_text(encoding="utf-8")
        for light in ("mist", "smoke"):
            data = base64.b64encode((source / f"newtab-{light}.jpg").read_bytes()).decode()
            newtab = newtab.replace(f'url("newtab-{light}.jpg")', f'url("data:image/jpeg;base64,{data}")')
    except OSError:
        return []
    files["newtab.css"] = newtab.encode()
    dressed = []
    for profile in zen_profiles(zen_root()):
        chrome = profile / "chrome"
        try:
            (chrome / "monet").mkdir(parents=True, exist_ok=True)
            for name, data in files.items():
                write_if_changed(chrome / "monet" / name, data)
            # An @import goes before anything else in a style sheet; what the person wrote stays below it.
            for name, line in ZEN_IMPORTS.items():
                sheet = chrome / name
                text = sheet.read_text(encoding="utf-8") if sheet.is_file() else ""
                if line not in text:
                    sheet.write_text(line + "\n" + text, encoding="utf-8")
            prefs = profile / "user.js"
            text = prefs.read_text(encoding="utf-8") if prefs.is_file() else ""
            write_if_changed(prefs, with_part(text, ZEN_PREFS).encode())
            bookmarks_for_zen(profile)
        except OSError:
            continue
        dressed.append(profile)
    return dressed


# Bookmarks from Windows' browsers: monet-windows-drive (root) keeps them for the person in one
# file, which a Zen profile that hasn't started yet takes in on its first start (Firefox imports a
# new profile's bookmarks.html in place of its own few); a Zen in use adds them with its Import.
WINDOWS_BOOKMARKS = DATA_HOME / "monet/windows-bookmarks.html"
WINDOWS_BOOKMARKS_SAID = DATA_HOME / "monet/windows-bookmarks.json"
ZEN_LIBRARY = "chrome://browser/content/places/places.xhtml"


def bookmarks_for_zen(profile, source=WINDOWS_BOOKMARKS):
    """Gives a Zen profile that hasn't started yet the bookmarks from Windows; a profile in use
    is never touched. Whether Zen takes them in by itself."""
    if (profile / "places.sqlite").exists() or not source.is_file():
        return False
    target = profile / "bookmarks.html"
    if not target.exists():
        target.write_bytes(source.read_bytes())
    return True


def zen_here():
    return any((folder / f"{ZEN_ID}.desktop").is_file() for folder in app_dirs())


def windows_browsers():
    """Settings' From Windows card: how many bookmarks came from which of Windows' browsers,
    whether Zen takes them in by itself ("waiting"), has to import them ("used") or isn't here
    ("none"), and the folder both sides have (for passwords exported in Windows)."""
    try:
        said = json.loads(WINDOWS_BOOKMARKS_SAID.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        said = {}
    if not isinstance(said, dict) or not WINDOWS_BOOKMARKS.is_file():
        said = {}
    # Never zen_profiles() unasked here: before Zen has a profile, it makes Monet's.
    choices = bookmarks_helper().profiles() if zen_here() else []
    profiles = [zen_root() / p["id"] for p in choices]
    zen = ("none" if not zen_here() else
           "used" if profiles and all((p / "places.sqlite").exists() for p in profiles) else "waiting")
    browsers = [b for b in said.get("browsers") or [] if isinstance(b, str)]
    count = said.get("count", 0)
    return {"count": count if type(count) is int and 0 <= count <= 1000000 else 0,
            "browsers": browsers, "zen": zen, "profiles": choices, "imports": bookmarks_helper().recent(),
            "shared": str(FILES) if FILES.is_dir() else ""}


def bookmarks_to_zen():
    """Older entry points now open the review before preparing an import."""
    open_settings("apps#bookmarks")
    return {"ok": True}


def bookmarks_helper():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader("monet_bookmarks", str(Path(__file__).with_name("monet-bookmarks")))
    module = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def bookmarks_action(action, payload):
    helper = bookmarks_helper()
    try:
        request = json.loads(unhex(payload))
        if not zen_here():
            return {"ok": False, "error": "browser"}
        if action == "preview":
            return helper.plan(request, WINDOWS_BOOKMARKS)[0]
        if action == "prepare":
            def launch(command):
                subprocess.Popen(command, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return helper.prepare(request, WINDOWS_BOOKMARKS, downloads_dir(), tr("Imported bookmarks"), launch)
        if action == "verify":
            return helper.verify(request.get("id") if isinstance(request, dict) else None)
    except helper.ImportError as error:
        return {"ok": False, "error": str(error)}
    except (ValueError, TypeError):
        return {"ok": False, "error": "request"}
    except OSError:
        return {"ok": False, "error": "storage"}
    return {"ok": False, "error": "request"}


def busjson(*args):
    """busctl's answer as JSON's data, or None."""
    out = run("busctl", "--json=short", *args, timeout=5)
    try:
        return json.loads(out)["data"] if out else None
    except (ValueError, KeyError, TypeError):
        return None


# Power & Sleep -------------------------------------------------------------
# PowerDevil keeps them in powerdevilrc: [AC], [Battery] and [LowBattery], each with
# [Display] and [SuspendAndShutdown]; times in seconds, actions as PowerDevil's numbers,
# and it rereads them when asked (refreshStatus). The power mode is the system's
# (power-profiles-daemon or tuned's stand-in for it), switched at once.

NO_ACTION, SLEEP, SHUT_DOWN, ASK, LOCK, SCREEN_OFF = 0, 1, 8, 16, 32, 64
BUTTON_ACTIONS = (ASK, SLEEP, SHUT_DOWN, NO_ACTION)
LID_ACTIONS = (SLEEP, LOCK, SCREEN_OFF, NO_ACTION)
SCREEN_TIMES = (120, 300, 600, 900, 1800, 3600, 0)
SLEEP_TIMES = (300, 600, 900, 1800, 3600, 7200, 0)  # on battery from 5 minutes, KDE's 10 among them
POWER_STATES = {"ac": ("AC", 600, 900), "battery": ("Battery", 300, 600)}  # group, screen off, sleep (KDE's)
PROFILE_SERVICES = (("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles"),
                    ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"))


def virtual_machine():
    return (run("systemd-detect-virt") or "none").strip() not in ("none", "")


def has_battery():
    return any(Path("/sys/class/power_supply").glob("BAT*"))


def has_lid():
    return any(Path("/proc/acpi/button/lid").glob("*/state"))


def power_mode():
    """(the mode now, the modes there are), or ("", []) without a power-profiles service."""
    for service, path in PROFILE_SERVICES:
        profiles = busjson("--system", "get-property", service, path, service, "Profiles")
        active = busjson("--system", "get-property", service, path, service, "ActiveProfile")
        if profiles is not None and active:
            names = [p.get("Profile", {}).get("data") for p in profiles]
            return active, [n for n in ("power-saver", "balanced", "performance") if n in names]
    return "", []


def power_state():
    virtual = virtual_machine()
    state = {"hasBattery": has_battery(), "hasLid": has_lid()}
    for name, (group, screen_default, sleep_default) in POWER_STATES.items():
        screen_on = kread("powerdevilrc", (group, "Display"), "TurnOffDisplayWhenIdle", "true") == "true"
        screen = kread("powerdevilrc", (group, "Display"), "TurnOffDisplayIdleTimeoutSec", str(screen_default))
        action = kread("powerdevilrc", (group, "SuspendAndShutdown"), "AutoSuspendAction", str(NO_ACTION if virtual else SLEEP))
        sleep = kread("powerdevilrc", (group, "SuspendAndShutdown"), "AutoSuspendIdleTimeoutSec", str(sleep_default))
        try:
            state[name] = {"screen": int(screen) if screen_on else 0, "sleep": int(sleep) if int(action) == SLEEP else 0}
        except ValueError:
            state[name] = {"screen": screen_default, "sleep": sleep_default}
    try:
        state["button"] = int(kread("powerdevilrc", ("AC", "SuspendAndShutdown"), "PowerButtonAction", str(ASK)))
        state["lidAction"] = int(kread("powerdevilrc", ("AC", "SuspendAndShutdown"), "LidAction",
                                       str(NO_ACTION if virtual else SLEEP)))
    except ValueError:
        state["button"], state["lidAction"] = ASK, SLEEP
    state["mode"], state["modes"] = power_mode()
    return state


def reload_power():
    busctl("call", "org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement",
           "org.kde.Solid.PowerManagement", "refreshStatus")


def set_power_time(name, what, seconds):
    """When the screen turns off, or the PC sleeps, plugged in or on battery (0 is never)."""
    group = POWER_STATES[name][0]
    if what == "screen":
        kwrite("powerdevilrc", (group, "Display"), "TurnOffDisplayWhenIdle", "true" if seconds else "false")
        kwrite("powerdevilrc", (group, "Display"), "DimDisplayWhenIdle", "true" if seconds else "false")
        if seconds:
            kwrite("powerdevilrc", (group, "Display"), "TurnOffDisplayIdleTimeoutSec", seconds)
            kwrite("powerdevilrc", (group, "Display"), "DimDisplayIdleTimeoutSec", max(30, seconds // 2))
    else:
        kwrite("powerdevilrc", (group, "SuspendAndShutdown"), "AutoSuspendAction", SLEEP if seconds else NO_ACTION)
        if seconds:
            kwrite("powerdevilrc", (group, "SuspendAndShutdown"), "AutoSuspendIdleTimeoutSec", seconds)
    reload_power()


def set_power_action(key, action):
    """What the power button or the lid does, the same plugged in, on battery and low."""
    for group in ("AC", "Battery", "LowBattery"):
        kwrite("powerdevilrc", (group, "SuspendAndShutdown"), key, action)
    reload_power()


def set_power_mode(mode):
    """Now, and kept when the PC is plugged in or unplugged."""
    for service, path in PROFILE_SERVICES:
        if run("busctl", "--system", "set-property", service, path, service, "ActiveProfile", "s", mode, timeout=10) is not None:
            break
    for group in ("AC", "Battery"):
        kwrite("powerdevilrc", (group, "Performance"), "PowerProfile", mode)
    reload_power()


# Mouse & Keyboard ----------------------------------------------------------
# KWin shows each input device on D-Bus and saves what's set there itself (kcminputrc).
# Mice and touchpads are set together, each kind as one. Layouts are kxkbrc's, which
# KWin watches.

KWIN_DEVICES = ("org.kde.KWin", "/org/kde/KWin/InputDevice")
INPUT_SETTINGS = {  # Monet's name: (KWin's property, D-Bus type, what says it can)
    "speed": ("pointerAcceleration", "d", "supportsPointerAcceleration"),
    "natural": ("naturalScroll", "b", "supportsNaturalScroll"),
    "left": ("leftHanded", "b", "supportsLeftHanded"),
    "tap": ("tapToClick", "b", "tapFingerCount"),
    "typing": ("disableWhileTyping", "b", "supportsDisableWhileTyping"),
}


def device_kind(props):
    """"touchpad", "mouse", or "" for keyboards and the rest."""
    if props.get("touchpad"):
        return "touchpad"
    if props.get("pointer") and props.get("supportsPointerAcceleration"):
        return "mouse"
    return ""


def input_devices():
    """{sysName: properties} for every input device KWin knows."""
    names = busjson("--user", "get-property", *KWIN_DEVICES, "org.kde.KWin.InputDeviceManager", "devicesSysNames") or []
    devices = {}
    for sys_name in names:
        if not re.fullmatch(r"[\w.-]+", sys_name):
            continue
        data = busjson("--user", "call", KWIN_DEVICES[0], f"{KWIN_DEVICES[1]}/{sys_name}",
                       "org.freedesktop.DBus.Properties", "GetAll", "s", "org.kde.KWin.InputDevice")
        if data:
            devices[sys_name] = {key: value.get("data") for key, value in data[0].items()}
    return devices


def pointer_state(devices):
    """Each kind as its first device has it: {"mouse": {...} or None, "touchpad": ...}."""
    state = {"mouse": None, "touchpad": None}
    for props in devices.values():
        kind = device_kind(props)
        if kind and state[kind] is None:
            entry = {}
            for name, (prop, _, can) in INPUT_SETTINGS.items():
                if props.get(can):
                    value = props.get(prop)
                    entry[name] = round(((value or 0) + 1) * 50) if name == "speed" else bool(value)
            state[kind] = entry
    return state


def set_pointer(kind, name, value):
    prop, kind_of, can = INPUT_SETTINGS[name]
    shown = str((value - 50) / 50) if name == "speed" else ("true" if value else "false")
    for sys_name, props in input_devices().items():
        if device_kind(props) == kind and props.get(can):
            busctl("set-property", KWIN_DEVICES[0], f"{KWIN_DEVICES[1]}/{sys_name}", "org.kde.KWin.InputDevice",
                   prop, kind_of, shown)


def known_layouts(text):
    """[(code, name)] from xkb's evdev.lst: the "! layout" section's lines."""
    layouts, inside = [], False
    for line in text.splitlines():
        if line.startswith("!"):
            inside = line.strip() == "! layout"
        elif inside and line.strip():
            code, _, name = line.strip().partition(" ")
            layouts.append((code, name.strip()))
    return layouts


def layout_names():
    try:
        return dict(known_layouts(Path("/usr/share/X11/xkb/rules/evdev.lst").read_text(encoding="utf-8")))
    except OSError:
        return {}


def keyboard_state():
    """The layouts in use, first the one typing starts with: [{code, name}], and if they're
    the system's (no list of the person's own yet)."""
    names = layout_names()
    chosen = [c for c in kread("kxkbrc", "Layout", "LayoutList").split(",") if c]
    system = not chosen
    if system:
        found = re.search(r"X11 Layout:\s*(\S+)", run("localectl", "status") or "")
        chosen = (found.group(1) if found else "us").split(",")
    return {"layouts": [{"code": c, "name": names.get(c, c)} for c in chosen], "system": system}


def set_layouts(codes):
    """Keeps each kept layout's variant; KWin rereads them as kxkbrc changes."""
    old = kread("kxkbrc", "Layout", "LayoutList").split(",")
    variants = kread("kxkbrc", "Layout", "VariantList").split(",")
    kept = dict(zip(old, variants + [""] * len(old)))
    kwrite("kxkbrc", "Layout", "VariantList", ",".join(kept.get(c, "") for c in codes))
    kwrite("kxkbrc", "Layout", "Use", "true")
    kwrite("kxkbrc", "Layout", "LayoutList", ",".join(codes))


# Notifications -------------------------------------------------------------
# plasmanotifyrc, which Plasma's notification server watches: Do Not Disturb's rules,
# where popups go and for how long, and each app that has sent one ([Applications]).

POPUP_PLACES = {"clock": "CloseToWidget", "topright": "TopRight", "topcenter": "TopCenter"}
POPUP_TIMES = (3, 5, 10)
QUIET_RULES = {  # Monet's name: (group, key, inverted)
    "mirrored": ("DoNotDisturb", "WhenScreensMirrored", False),
    "fullscreen": ("DoNotDisturb", "WhenFullscreen", False),
    "urgent": ("Notifications", "CriticalInDndMode", False),
}


def quiet_until(text):
    """KConfig's DateTime: six local fields, optionally followed by a time-zone ID."""
    try:
        fields = text.strip().split(",")
        if len(fields) not in (6, 7):
            return None
        seconds = float(fields[5])
        date = datetime.datetime(*(int(v) for v in fields[:5]), int(seconds),
                                 round((seconds % 1) * 1000000))
        if len(fields) == 7:
            zone = fields[6]
            offset = re.fullmatch(r"UTC([+-])(\d{2}):(\d{2})", zone)
            if offset:
                hours, minutes = int(offset[2]), int(offset[3])
                if hours > 23 or minutes > 59:
                    return None
                delta = datetime.timedelta(hours=hours, minutes=minutes)
                date = date.replace(tzinfo=datetime.timezone(delta if offset[1] == "+" else -delta))
            else:
                date = date.replace(tzinfo=ZoneInfo(zone))
        return date.timestamp()
    except (ValueError, OverflowError, OSError, ZoneInfoNotFoundError):
        return None


def quiet_state(text=None, now=None):
    if text is None:
        text = kread("plasmanotifyrc", "DoNotDisturb", "Until")
    end = quiet_until(text)
    active = end is not None and end > (time.time() if now is None else now)
    return {"quiet": active, "quietUntil": end if active else None,
            "quietIndefinite": active and end >= 4070908800}  # Monet's legacy 2099 sentinel


def set_quiet(mode):
    # A deliberate choice in Settings supersedes a timer's temporary quiet period.
    try:
        with quiet_lock():
            result = _set_quiet(mode)
            if result["ok"]:
                FOCUS_QUIET.unlink(missing_ok=True)
            return result
    except OSError:
        return {"ok": False, **quiet_state()}


def _set_quiet(mode):
    if mode not in ("on", "off", "hour", "four-hours", "tomorrow"):
        return {"ok": False, **quiet_state()}
    if mode == "off":
        value = ""
    elif mode == "on":
        value = "2099,12,31,23,59,0,UTC"
    else:
        now = time.time()
        if mode == "tomorrow":
            end = (datetime.datetime.fromtimestamp(now) + datetime.timedelta(days=1)).replace(
                hour=8, minute=0, second=0, microsecond=0).timestamp()
        else:
            # Plasma rechecks inhibition on minute boundaries, as its own duration menu does.
            end = int((now + (3600 if mode == "hour" else 14400)) // 60) * 60
        # Duration is elapsed time even across a daylight-saving transition.
        value = ",".join(str(v) for v in time.gmtime(end)[:6]) + ",UTC"
    return write_quiet(value)


def write_quiet(value):
    command = ["kwriteconfig6", "--notify", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until"]
    wrote = run(*command, *([value] if value else ["--delete"])) is not None
    actual = run("kreadconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until")
    matches = actual is not None and (not actual.strip() if not value else
                                     quiet_until(actual) is not None and quiet_until(actual) == quiet_until(value))
    return {"ok": wrote and matches, **quiet_state(actual or "")}


def notified_apps(text):
    """{desktop entry: shows popups} for each [Applications][…] group in plasmanotifyrc's text."""
    apps, current = {}, None
    for line in text.splitlines():
        line = line.strip()
        found = re.fullmatch(r"\[Applications\]\[([^\]]+)\]", line)
        if found:
            current = found.group(1)
            apps.setdefault(current, True)
        elif line.startswith("["):
            current = None
        elif current and line.startswith("ShowPopups="):
            apps[current] = line.split("=", 1)[1].strip() != "false"
    return apps


def notify_state():
    state = quiet_state()
    for name, (group, key, inverted) in QUIET_RULES.items():
        on = kread("plasmanotifyrc", group, key, "true") == "true"
        state[name] = on != inverted
    state["mirrored"] = state["mirrored"] and kread("plasmanotifyrc", "DoNotDisturb", "WhenScreenSharing", "true") == "true"
    place = kread("plasmanotifyrc", "Notifications", "PopupPosition", "CloseToWidget")
    state["place"] = next((k for k, v in POPUP_PLACES.items() if v == place), "clock")
    try:
        state["time"] = round(int(kread("plasmanotifyrc", "Notifications", "PopupTimeout", "5000")) / 1000)
    except ValueError:
        state["time"] = 5
    try:
        text = (CONFIG / "plasmanotifyrc").read_text(encoding="utf-8")
    except OSError:
        text = ""
    apps = []
    for app_id, popups in notified_apps(text).items():
        entry = entry_by_id(app_id + ".desktop")
        if entry and entry.get("NoDisplay") != "true":
            apps.append({"id": app_id, "name": entry.get("Name", app_id), "icon": entry.get("Icon", ""), "popups": popups})
    state["apps"] = sorted(apps, key=lambda app: app["name"].lower())
    return state


def change_notifications(command, args):
    """Return verified settings, including a partial result if one write was refused."""
    writes = []
    if command == "quiet" and len(args) == 1:
        result = set_quiet(args[0])
        return {"ok": result["ok"], "state": notify_state()}
    if command == "notify-rule" and len(args) == 2 and args[0] in QUIET_RULES and args[1] in ("on", "off"):
        group, key, inverted = QUIET_RULES[args[0]]
        value = "true" if (args[1] == "on") != inverted else "false"
        writes.append((group, key, value))
        if args[0] == "mirrored":
            writes.append(("DoNotDisturb", "WhenScreenSharing", value))
    elif command == "notify-place" and len(args) == 1 and args[0] in POPUP_PLACES:
        writes.append(("Notifications", "PopupPosition", POPUP_PLACES[args[0]]))
    elif command == "notify-time" and len(args) == 1 and args[0].isdigit() and int(args[0]) in POPUP_TIMES:
        writes.append(("Notifications", "PopupTimeout", str(int(args[0]) * 1000)))
    elif command == "notify-app" and len(args) == 2 and re.fullmatch(r"(?:[0-9a-f]{2})+", args[0]) and args[1] in ("on", "off"):
        app_id = unhex(args[0])
        if re.fullmatch(r"[\w.+-]+", app_id):
            writes.append((("Applications", app_id), "ShowPopups", "true" if args[1] == "on" else "false"))
    succeeded = bool(writes)
    for group, key, value in writes:
        wrote = kwrite("plasmanotifyrc", group, key, value)
        succeeded = wrote and kread("plasmanotifyrc", group, key, "__unavailable__") == value and succeeded
    return {"ok": succeeded, "state": notify_state()}


# Storage -------------------------------------------------------------------
# What fills the disk Monet is on, roughly: games, apps, your files, the system
# (the rest of what's used), and what can go: the Trash, Downloads.



def du(*paths):
    """Bytes under paths that exist, on the disk each is on (du -sx), or 0."""
    found = [str(p) for p in paths if Path(p).exists()]
    if not found:
        return 0
    out = run("du", "-s", "-x", "-B1", "-c", *found, timeout=300) or ""
    total = re.search(r"(?m)^(\d+)\s+total$", out)
    return int(total.group(1)) if total else 0


def storage_parts(total, free, home, games, apps, user_apps, trash):
    """The bar's parts, in bytes: games, apps, your files (home without games, apps and the
    Trash), the system (the rest of what's used) and free; never below nothing."""
    files = max(0, home - games - user_apps - trash)
    used = max(0, total - free)
    system = max(0, used - games - apps - user_apps - files - trash)
    return {"games": games, "apps": apps + user_apps, "files": files + trash, "system": system, "free": free}


def downloads_dir():
    """The Downloads folder as the account names it (xdg-user-dirs: "Hämtningar" in Swedish), else ~/Downloads."""
    try:
        found = re.search(r'^XDG_DOWNLOAD_DIR="([^"]*)"', (CONFIG / "user-dirs.dirs").read_text(encoding="utf-8"), re.M)
    except OSError:
        found = None
    path = Path(found.group(1).replace("$HOME", str(HOME))) if found else None
    return path if path and path.is_absolute() and path != HOME else HOME / "Downloads"


def storage_capacity():
    """Show free space immediately; folder breakdowns are a separate explicit scan."""
    disk = shutil.disk_usage(HOME)
    return dict(total=disk.total, free=disk.free, used=disk.used, measured=False, downloadsPath=str(downloads_dir()))


def storage():
    disk = shutil.disk_usage(HOME)
    games = du(DATA_HOME / "Steam/steamapps", HOME / "Games")
    trash = du(DATA_HOME / "Trash")
    parts = storage_parts(disk.total, disk.free, du(HOME), games, du("/var/lib/flatpak"),
                          du(DATA_HOME / "flatpak", HOME / ".var/app"), trash)
    downloads = downloads_dir()
    return dict(parts, total=disk.total, trash=trash, downloads=du(downloads), downloadsPath=str(downloads), measured=True)


def empty_trash():
    """Asked for, and confirmed, in Settings: the Trash emptied for good."""
    for command in (["gio", "trash", "--empty"], ["ktrash6", "--empty"]):
        if shutil.which(command[0]):
            return run(*command, timeout=600) is not None
    return False


# Lock & Privacy --------------------------------------------------------------
# When the screen locks and whether waking asks for the password (KDE's screen
# locker, kscreenlockerrc, told to read it again), and whether Files and the
# menu remember what you opened (KDE's activity manager), with forgetting it.

LOCK_TIMES = (1, 5, 15, 30, 0)  # minutes away; 0 is never
SCORING = "Plugin-org.kde.ActivityManager.Resources.Scoring"


def fingerprint_state(listed=None):
    """None without a fingerprint reader; else whether a finger of yours is set up.
    listed: `fprintd-list YOU` (in English), as fprintd says it."""
    if listed is None:
        if not shutil.which("fprintd-list"):
            return None
        try:
            done = subprocess.run(["fprintd-list", getpass.getuser()], capture_output=True, text=True, timeout=10,
                                  env=dict(os.environ, LANGUAGE="C", LC_ALL="C.UTF-8"))
        except (OSError, subprocess.TimeoutExpired):
            return None
        listed = done.stdout + done.stderr
    if "No devices available" in listed or "Using device" not in listed:
        return None
    return {"enrolled": bool(re.search(r"^\s*-\s*#\d+:", listed, re.M))}


def privacy_state():
    try:
        minutes = int(kread("kscreenlockerrc", "Daemon", "Timeout", "5") or 5)
    except ValueError:
        minutes = 5
    return {"lockAfter": minutes if kread("kscreenlockerrc", "Daemon", "Autolock", "true") != "false" else 0,
            "lockOnResume": kread("kscreenlockerrc", "Daemon", "LockOnResume", "true") != "false",
            # KDE's 0 remembers everything, 1 only some apps, 2 nothing.
            "remember": kread("kactivitymanagerd-pluginsrc", SCORING, "what-to-remember", "0") != "2",
            "fingerprint": fingerprint_state()}


def reload_locker():
    busctl("call", "org.kde.screensaver", "/ScreenSaver", "org.kde.screensaver", "configure")


def set_lock_after(minutes):
    kwrite("kscreenlockerrc", "Daemon", "Autolock", "true" if minutes else "false")
    if minutes:
        kwrite("kscreenlockerrc", "Daemon", "Timeout", str(minutes))
    reload_locker()


def forget_recent():
    """Asked for, and confirmed, in Settings: what Files and the menu remember you opened, forgotten."""
    busctl("call", "org.kde.ActivityManager", "/ActivityManager/Resources/Scoring",
           "org.kde.ActivityManager.ResourcesScoring", "DeleteRecentStats", "sis", "", "0", "everything")
    (DATA_HOME / "recently-used.xbel").unlink(missing_ok=True)  # GTK apps keep their own list


# Phone -----------------------------------------------------------------------
# Your phone through KDE Connect (its app on the phone, on the same Wi-Fi): the phones
# near and the ones paired, their battery, and pairing, ringing, sending a file and texts.

# Settings passes the id on a command line: a phone with any other kind of id is left out.
PHONE_LISTED = re.compile(r"^- (.+): ([\w-]+)(?: on (.{1,1024}) via (.{1,256}))? \(([^()\r\n]{1,64})\)$")


def phones(listed=None, battery=None):
    """[{id, name, paired, near, battery, charging}], or None when KDE Connect isn't here.
    listed: `kdeconnect-cli --list-devices` (in English, whatever the session's language)."""
    queried = listed is None
    if queried:
        if not shutil.which("kdeconnect-cli"):
            return None
        done = subprocess.run(["kdeconnect-cli", "--list-devices"], capture_output=True, text=True, timeout=10,
                              env=dict(os.environ, LANGUAGE="C", LC_ALL="C.UTF-8"))
        done.check_returncode()
        if not done.stdout.strip() and done.stderr.strip() != "0 devices found":
            raise ValueError("KDE Connect did not return a device list")
        listed = done.stdout
    found = []
    for line in listed.splitlines():
        match = PHONE_LISTED.match(line.strip())
        if match and any(value is not None and (value != value.strip() or not value.isprintable())
                         for value in match.group(3, 4)):
            match = None
        if not match:
            if queried and line.strip() and not re.fullmatch(r"\d+ devices found", line.strip()):
                raise ValueError("KDE Connect returned an unreadable device list")
            continue
        name, ident, _addresses, _providers, state = match.groups()
        state = re.findall(r"\b\w+\b", state)
        paired, near = "paired" in state, "reachable" in state
        charge, charging = (battery or phone_battery)(ident) if paired and near else (None, None)
        found.append({"id": ident, "name": name, "paired": paired, "near": near, "battery": charge,
                      "charging": charging})
    if queried and not found and listed.strip() and listed.strip() != "0 devices found":
        raise ValueError("KDE Connect returned no readable devices")
    return found


def phone_battery(ident):
    """(percent, charging) as the phone tells KDE Connect, or (None, None)."""
    path = f"/modules/kdeconnect/devices/{ident}/battery"
    said = [busctl("get-property", "org.kde.kdeconnect", path, "org.kde.kdeconnect.device.battery", key) or ""
            for key in ("charge", "isCharging")]
    charge = re.fullmatch(r"i (-?\d+)", said[0].strip())
    return (int(charge.group(1)) if charge and 0 <= int(charge.group(1)) <= 100 else None,
            {"b true": True, "b false": False}.get(said[1].strip()))


def phone_send(ident):
    """Pick one file; CLI success is dispatch, not a delivery receipt."""
    try:
        picker = subprocess.run(["kdialog", "--getopenfilename", str(Path.home()), "--title", tr("Send to your phone")],
                                capture_output=True, timeout=3600)
    except (OSError, subprocess.SubprocessError):
        return {"state": "failed"}
    if picker.returncode == 1:
        return {"state": "canceled"}
    # kdialog adds one newline; spaces and newlines belonging to the filename stay intact.
    picked = os.fsdecode(picker.stdout.removesuffix(b"\n"))
    if picker.returncode != 0 or not picked:
        return {"state": "failed"}
    return {"state": "dispatched" if run("kdeconnect-cli", "--share", picked, "-d", ident, timeout=60) is not None
            else "failed"}


# Printers --------------------------------------------------------------------
# CUPS's printers (the ones added, and the ones it finds on the network by
# itself), which is the default, and what's waiting. The default is each
# person's own (lpoptions), so choosing it needs no password.

def lp(*args):
    """A CUPS tool's output in English, so it can be read, or ""."""
    if not shutil.which(args[0]):
        return ""
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=10, env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return out.stdout


def printers_from(found, states, default, queue):
    """The printers, from what lpstat -e, -p, -d and -o said."""
    status = {}
    for line in states.splitlines():
        m = re.match(r"printer (\S+) (?:is )?(idle|now printing|disabled)", line)
        if m:
            status[m[1]] = {"idle": "ready", "now printing": "printing", "disabled": "off"}[m[2]]
    chosen = re.search(r"system default destination: (\S+)", default)
    waiting = {}
    for line in queue.splitlines():
        if line.split():
            name = line.split()[0].rsplit("-", 1)[0]
            waiting[name] = waiting.get(name, 0) + 1
    names = list(dict.fromkeys(found.split() + list(status)))
    return [{"name": n, "label": n.replace("_", " "), "state": status.get(n, "ready"), "jobs": waiting.get(n, 0),
             "default": bool(chosen) and chosen[1] == n} for n in names]


def printers():
    if not shutil.which("lpstat"):
        return {"printers": [], "cups": False}
    return {"printers": printers_from(lp("lpstat", "-e"), lp("lpstat", "-p"), lp("lpstat", "-d"), lp("lpstat", "-o")),
            "cups": True}


# What's new ------------------------------------------------------------------
# The release notes come with Monet (tools/package.sh): their newest "### New in"
# section is what Settings → Updates shows, and what monet-session offers once
# after a new Monet starts.

def whats_new(text):
    """The newest "### New in X: headline" section: its version, headline, and each
    highlight's bold title with its first sentence."""
    found = re.search(r"(?m)^### New in ([\w.]+)(?::\s*(.+))?$", text)
    if not found:
        return {}
    body = text[found.end():]
    after = re.search(r"(?m)^#{1,3} ", body)
    body = body[:after.start()] if after else body
    items = []
    for bullet in re.finditer(r"(?ms)^- \*\*(.+?)\*\*(.*?)(?=^- |^\S|\Z)", body):
        # Up to its own list, if it has one; then its first sentence.
        words = " ".join(line.strip() for line in re.split(r"\n\s+- ", bullet[2])[0].splitlines() if line.strip())
        sentence = re.match(r"(.+?[.!?])(?=\s|$)", words)
        said = sentence[1] if sentence else re.sub(r":$", ".", words)  # "...no longer open KDE's settings:" + its list
        if said:  # not "**What you saw in 0.9.0, fixed:**", only a list
            items.append({"title": bullet[1].strip().rstrip(".:"), "text": said})
    headline = (found[2] or "").strip()
    return {"version": found[1], "headline": headline[:1].upper() + headline[1:], "items": items[:8]}


def whats_new_here():
    try:
        return whats_new((Path(DATADIR) / "monet/release-notes.md").read_text(encoding="utf-8"))
    except OSError:
        return {}


# Games & Controllers ---------------------------------------------------------
# The controllers connected (the kernel's joysticks, with the battery a wireless
# one reports), MangoHud's performance overlay over games (MANGOHUD=1 for the
# session, from the next sign-in, in Monet's colors unless you've made your own),
# and where games are kept (Steam's libraries, and ~/Games for Heroic and Lutris).

OVERLAY = CONFIG / "environment.d/monet-mangohud.conf"
MANGOHUD_CONF = CONFIG / "MangoHud/MangoHud.conf"
MONETS_MANGOHUD = """\
# Monet's colors for the performance overlay (Monet Settings, Games & Controllers).
# Right Shift+F12 hides and shows it while you play. Monet never changes this file again.
fps
frametime
gpu_stats
cpu_stats
ram
position=top-left
round_corners=10
font_size=20
background_color=242321
background_alpha=0.55
text_color=ECE8E1
gpu_color=4DB4A0
cpu_color=E39B3D
ram_color=9C7BC0
frametime_color=4DB4A0
"""


def controller(device):
    """A joystick's input device (resolved): its name, and its controller's battery, if it reports one."""
    owner = device.parent.parent  # inputN sits in its controller's input/ folder
    name = read_text(device / "name")
    if not name:
        return None
    battery, charging = None, False
    for supply in sorted(owner.glob("power_supply/*")) + sorted(owner.parent.glob("power_supply/*")):
        level = read_text(supply / "capacity")
        if level.isdigit():
            battery, charging = int(level), read_text(supply / "status") == "Charging"
            break
    # Bluetooth HID devices are named 0005:vendor:product.n, USB ones 0003:...
    return {"name": name, "battery": battery, "charging": charging, "wireless": owner.name.startswith("0005:"),
            "owner": str(owner)}


def joystick(js, udev=Path("/run/udev/data")):
    """Whether udev agrees that a kernel joystick is one: the kernel calls any absolute pointer one
    (found by the test bench: a VM's mouse; drawing tablets too). Without udev's word, it is."""
    said = read_text(udev / f"c{read_text(js / 'dev')}").split()
    return not said or "E:ID_INPUT_JOYSTICK=1" in said


def controllers():
    found = {}
    for js in sorted(Path("/sys/class/input").glob("js*")):
        pad = controller((js / "device").resolve()) if joystick(js) else None
        if pad and pad["owner"] not in found:  # one controller can show up as more than one joystick
            found[pad["owner"]] = pad
    return [{k: v for k, v in pad.items() if k != "owner"} for pad in found.values()]


def vdf(text):
    """Valve's KeyValues text (Steam's libraryfolders.vdf), as nested dicts."""
    root, stack, key = {}, [], None
    node = root
    for quoted, brace in re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text):
        if brace == "{":
            child = {}
            node[key or ""] = child
            stack.append(node)
            node, key = child, None
        elif brace == "}":
            node, key = (stack.pop() if stack else root), None
        elif key is None:
            key = quoted.replace("\\\\", "\\")
        else:
            node[key], key = quoted.replace("\\\\", "\\"), None
    return root


def disk_name(path):
    """The name of the disk a folder is on, as its mount point calls it ("" for the PC's own)."""
    path = Path(path)
    while not os.path.ismount(path) and path != path.parent:
        path = path.parent
    return "" if path in (Path("/"), Path("/var"), Path("/home"), Path("/var/home")) else path.name


def game_libraries():
    """Where games are kept: each Steam library (its games, their size, the room left
    on its disk), then ~/Games, where Heroic and Lutris put theirs."""
    found, seen = [], set()
    for steam in (DATA_HOME / "Steam", HOME / ".steam/steam"):
        try:
            text = (steam / "steamapps/libraryfolders.vdf").read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for entry in vdf(text).get("libraryfolders", {}).values():
            if not isinstance(entry, dict) or not entry.get("path"):
                continue
            path = Path(entry["path"])
            if str(path.resolve()) in seen:
                continue
            seen.add(str(path.resolve()))
            apps = entry.get("apps") if isinstance(entry.get("apps"), dict) else {}
            sizes = [int(v) for v in apps.values() if str(v).isdigit()]
            try:
                free = shutil.disk_usage(path).free
            except OSError:
                free = None
            disk = disk_name(path)
            name = tr("Windows games") if path == SHARED else tr("Steam on %1", disk) if disk else "Steam"
            found.append({"name": name, "path": str(path / "steamapps/common"), "shared": path == SHARED,
                          "games": len(sizes), "size": sum(sizes), "free": free})
    games = HOME / "Games"
    if games.is_dir():
        found.append({"name": tr("Games folder"), "path": str(games), "shared": False,
                      "games": sum(1 for p in games.iterdir() if p.is_dir() and not p.name.startswith(".")),
                      "size": du(games), "free": shutil.disk_usage(games).free})
    return found


def gaming_state():
    libraries = game_libraries()
    return {"controllers": controllers(),
            "overlay": OVERLAY.is_file() if shutil.which("mangohud") else None,
            "replay": replay_on() if shutil.which("flatpak") else None,
            "pair": bool(shutil.which("bluedevil-wizard")),
            # Windows' Games folder has its own card.
            "libraries": [found for found in libraries if not found["shared"]],
            "shared": shared_info(libraries)}


# The last 30 seconds (Games & Controllers): GPU Screen Recorder keeps them in memory
# (NVIDIA's, AMD's or Intel's video encoder, so games hardly notice) while
# monet-replay.service runs; Windows+Alt+G, as Xbox Game Bar has it, saves them to Videos.

REPLAY_APP = "com.dec05eba.gpu_screen_recorder"
REPLAY_UNIT = "monet-replay.service"


def replay_on():
    return ok("systemctl", "--user", "--quiet", "is-enabled", REPLAY_UNIT)


def set_replay(on):
    """On: GPU Screen Recorder from Flathub first, if it isn't here (Monet's polkit lets an
    administrator install apps), then the service; off: the service stops."""
    if not on:
        run("systemctl", "--user", "disable", "--now", REPLAY_UNIT)
        return True
    if run("flatpak", "info", REPLAY_APP) is None:
        run("flatpak", "install", "--system", "--noninteractive", "-y", "flathub", REPLAY_APP, timeout=1800)
        if run("flatpak", "info", REPLAY_APP) is None:
            return False
    return ok("systemctl", "--user", "enable", "--now", REPLAY_UNIT)


def videos_folder():
    return Path((run("xdg-user-dir", "VIDEOS") or "").strip() or Path.home() / "Videos")


def replay_run():
    """monet-replay.service: the recorder, keeping the last 30 seconds of the screen and its
    sound. The screen comes through KDE's screen-sharing question, asked once, then kept."""
    folder = videos_folder()
    folder.mkdir(parents=True, exist_ok=True)
    os.execvp("flatpak", ["flatpak", "run", "--command=gpu-screen-recorder", REPLAY_APP, "-w", "portal",
                          "-restore-portal-session", "yes", "-f", "60", "-r", "30", "-c", "mp4",
                          "-a", "default_output", "-o", str(folder)])


def replay_save():
    """Windows+Alt+G: the recorder saves what it keeps (SIGUSR1 to it alone; its flatpak
    and sandbox would stop on that signal), and a note says where."""
    if not replay_on():
        open_settings("games")
        return
    found = 0
    for comm in Path("/proc").glob("[0-9]*/comm"):
        try:
            # The name as the kernel keeps it: its first 15 letters.
            if comm.read_text().strip() == "gpu-screen-reco" and comm.parent.stat().st_uid == os.getuid():
                os.kill(int(comm.parent.name), signal.SIGUSR1)
                found += 1
        except (OSError, ValueError):
            continue
    if found and shutil.which("notify-send"):
        answer = run("notify-send", "--app-name=Monet", "--icon=media-record", f"--action=open={tr('Show')}", "--wait",
                     tr("Saved the last 30 seconds"), tr("In Videos."), timeout=600)
        if (answer or "").strip() == "open":
            show_in_files(videos_folder())


def set_overlay(on):
    if not on:
        OVERLAY.unlink(missing_ok=True)
        return
    OVERLAY.parent.mkdir(parents=True, exist_ok=True)
    OVERLAY.write_text("# The performance overlay over games (Monet Settings, Games & Controllers).\nMANGOHUD=1\n")
    if not MANGOHUD_CONF.exists():
        MANGOHUD_CONF.parent.mkdir(parents=True, exist_ok=True)
        MANGOHUD_CONF.write_text(MONETS_MANGOHUD)


# Recently played (the desktop widget): the Steam games played last, newest
# first, with their cover from Steam's own picture cache.

STEAM_ROOTS = (DATA_HOME / "Steam", HOME / ".steam/steam", HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam")
NOT_GAMES = re.compile(r"(Proton\b|Steam Linux Runtime|Steamworks Common|Steam Runtime)", re.I)


def pick(tree, *keys):
    """tree[k1][k2]..., the keys in any case (Steam's files differ in theirs), or {}."""
    for key in keys:
        if not isinstance(tree, dict):
            return {}
        tree = next((v for k, v in tree.items() if k.lower() == key.lower()), {})
    return tree


def steam_libraries(steam):
    """The folders holding Steam's games (each with its steamapps): every library it lists, or itself."""
    try:
        listed = vdf((steam / "steamapps/libraryfolders.vdf").read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return [steam]
    paths = [Path(e["path"]) for e in pick(listed, "libraryfolders").values() if isinstance(e, dict) and e.get("path")]
    return paths or [steam]


def steam_stats(steam):
    """({appid: when it was last played (Unix time)}, {appid: minutes played}), from each Steam
    account on the PC (its localconfig.vdf: Steam keeps both there, for every PC played on)."""
    last, minutes = {}, {}
    for config in steam.glob("userdata/*/config/localconfig.vdf"):
        try:
            tree = vdf(config.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
        for appid, info in pick(tree, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps").items():
            if not appid.isdigit() or not isinstance(info, dict):
                continue
            when, played = str(info.get("LastPlayed", "")), str(info.get("Playtime", ""))
            if when.isdigit():
                last[appid] = max(last.get(appid, 0), int(when))
            if played.isdigit():
                minutes[appid] = max(minutes.get(appid, 0), int(played))
    return last, minutes


def last_played(steam):
    """{appid: when it was last played (Unix time)}, from each Steam account on the PC."""
    return steam_stats(steam)[0]


def steam_cached(steam, appid, *names):
    """The first of the game's pictures (by name) in Steam's picture cache, as a file URL, or ""."""
    cache = steam / "appcache/librarycache"
    for name in names:
        # Older Steam keeps appid_name.jpg; newer, appid/name.jpg (sometimes a folder deeper).
        for path in [cache / f"{appid}_{name}"] + sorted((cache / appid).glob(f"**/{name}")):
            if path.is_file():
                return path.as_uri()
    return ""


STEAM_TALLS = ("library_600x900.jpg", "library_600x900_2x.jpg")


def steam_cover(steam, appid):
    """The game's tall cover (or its banner) from Steam's picture cache, as a file URL, or ""."""
    return steam_cached(steam, appid, *STEAM_TALLS, "header.jpg")


def steam_games():
    """(Steam's folder, appid, name, its manifest) of each Steam game installed here."""
    for steam in STEAM_ROOTS:
        if not (steam / "steamapps").is_dir():
            continue
        for library in steam_libraries(steam):
            for manifest in sorted((library / "steamapps").glob("appmanifest_*.acf")):
                try:
                    state = pick(vdf(manifest.read_text(encoding="utf-8", errors="replace")), "AppState")
                except OSError:
                    continue
                appid, name = str(state.get("appid", "")), str(state.get("name", ""))
                if appid.isdigit() and name and not NOT_GAMES.match(name):
                    yield steam, appid, name, state


STEAM_TALL = "https://cdn.cloudflare.steamstatic.com/steam/apps/{}/library_600x900.jpg"
STEAM_HERO = "https://cdn.cloudflare.steamstatic.com/steam/apps/{}/library_hero.jpg"


def when_played(text):
    """Unix time from Heroic's lastPlayed (an ISO date, or a number), or 0."""
    import datetime
    if isinstance(text, (int, float)):
        return int(text / 1000 if text > 1e11 else text)
    try:
        return int(datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


def played(limit=8, heroic_roots=None, lutris_roots=None, windows_played=None):
    """[{id, name, last, art, play, windows}]: the games played most recently, newest first:
    Steam's, Heroic's and Lutris' here, and the ones Monet sent to Windows. `play` starts one
    here (monet-quick play); `windows` is one played in Windows last, for `monet play`."""
    games, times = {}, {}

    def offer(key, entry):
        if entry["last"] and (key not in games or games[key]["last"] < entry["last"]):
            games[key] = dict(entry, key=key)  # key: its id in the Games gallery

    for steam, appid, name, state in steam_games():
        if steam not in times:
            times[steam] = steam_stats(steam)
        own = str(state.get("LastPlayed", ""))
        last = max(int(own) if own.isdigit() else 0, times[steam][0].get(appid, 0))
        offer(f"steam:{appid}", {"id": appid, "name": name, "last": last, "art": steam_cover(steam, appid),
                                 "play": appid, "windows": "", "minutes": times[steam][1].get(appid, 0)})
    for root in HEROIC_ROOTS if heroic_roots is None else heroic_roots:
        stamps = read_json(root / "store/timestamp.json")
        if not isinstance(stamps, dict):
            continue
        for g in heroic_games((root,)):
            stamp = stamps.get(g["app"])
            last = when_played(stamp.get("lastPlayed")) if isinstance(stamp, dict) else 0
            # Heroic counts minutes.
            total = stamp.get("totalPlayed") if isinstance(stamp, dict) else 0
            offer(f"{HEROIC_STORES[g['runner']]}:{g['app']}", {"id": f"heroic:{g['runner']}:{g['app']}", "name": g["title"],
                                                               "last": last, "art": g["art"],
                                                               "play": f"heroic:{g['runner']}:{g['app']}", "windows": "",
                                                               "minutes": int(total) if isinstance(total, (int, float)) else 0})
    for root in LUTRIS_ROOTS if lutris_roots is None else lutris_roots:
        import sqlite3
        db = root / "pga.db"
        if not db.is_file():
            continue
        try:
            conn = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True, timeout=2)
            try:
                rows = conn.execute("SELECT id, name, slug, lastplayed, playtime FROM games "
                                    "WHERE installed = 1 AND runner != 'steam'").fetchall()
            finally:
                conn.close()
        except sqlite3.Error:
            continue
        for game_id, name, slug, last, hours in rows:
            art = root / "coverart" / f"{slug}.jpg"
            if isinstance(game_id, int) and name and isinstance(last, int):
                # Lutris counts hours.
                offer(f"lutris:{game_id}", {"id": f"lutris:{game_id}", "name": " ".join(str(name).split()), "last": last,
                                            "art": art.as_uri() if re.fullmatch(APP, str(slug)) and art.is_file() else "",
                                            "play": f"lutris:{game_id}", "windows": "",
                                            "minutes": round(hours * 60) if isinstance(hours, (int, float)) else 0})
    trips = read_json(PLAYED_WINDOWS) if windows_played is None else windows_played
    if isinstance(trips, dict) and trips:
        known = {g["id"]: g for g in windows_games(WINDOWS_GAMES)}
        for wid, last in trips.items():
            store, _, key = str(wid).partition(":")
            if WINDOWS_ID.fullmatch(str(wid)) and isinstance(last, int) and wid in known:
                # Played in Windows: how long, as Monet Bridge measured it there.
                offer(wid, {"id": wid, "name": known[wid]["name"], "last": last,
                            "art": STEAM_TALL.format(key) if store == "steam" else "", "play": "", "windows": wid,
                            "minutes": known[wid].get("minutes", 0)})
    return sorted(games.values(), key=lambda game: -game["last"])[:limit]


# Which games need Windows ------------------------------------------------------
# From AreWeAntiCheatYet (areweanticheatyet.com, MIT): the games with anti-cheat,
# and whether it lets them run on Linux. Fetched at most every three days, keeping
# only each Steam id and a word: Supported and Running play here; Broken, Denied and
# Planned need Windows. Games it doesn't list mostly have no anti-cheat: no mark.

ANTICHEAT_URL = "https://raw.githubusercontent.com/AreWeAntiCheatYet/AreWeAntiCheatYet/HEAD/games.json"
ANTICHEAT = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "monet" / "anticheat.json"
PLAYS_HERE = {"Supported", "Running"}
NEEDS_WINDOWS = {"Broken", "Denied", "Planned"}
WINDOWS_GAMES = (Path("/var/lib/monet/games.json"), Path(DATADIR) / "monet/windows-games.json",
                 CONFIG / "monet/windows-games.json")


def anticheat_marks(games):
    """{steam appid: "here" or "windows"} from AreWeAntiCheatYet's list."""
    marks = {}
    for game in games if isinstance(games, list) else []:
        if not isinstance(game, dict) or game.get("status") not in PLAYS_HERE | NEEDS_WINDOWS:
            continue
        mark = "here" if game["status"] in PLAYS_HERE else "windows"
        ids = game.get("storeIds") if isinstance(game.get("storeIds"), dict) else {}
        steam, epic = str(ids.get("steam") or ""), ids.get("epic")
        if steam.isdigit():
            marks[steam] = mark
        # Epic's games by their namespace, which Heroic's library knows too.
        if isinstance(epic, dict) and epic.get("namespace"):
            marks["epic/" + str(epic["namespace"])] = mark
    return marks


def anticheat(fetch=False):
    """The marks, from the copy kept here; a copy older than three days is used all the same
    and fetched again in the background, so nothing waits on the internet but the first time."""
    try:
        kept = json.loads(ANTICHEAT.read_text())
        if not fetch and time.time() - ANTICHEAT.stat().st_mtime < 3 * 86400:
            return kept
    except (OSError, ValueError):
        kept = {}
    if kept and not fetch:
        try:
            os.utime(ANTICHEAT)  # one fetch at a time; a failed one tries again in three days
        except OSError:
            pass
        subprocess.Popen([f"{LIBEXECDIR}/monet-quick", "anticheat-refresh"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return kept
    try:
        import urllib.request
        with urllib.request.urlopen(ANTICHEAT_URL, timeout=20) as answer:
            marks = anticheat_marks(json.loads(answer.read().decode("utf-8")))
    except (OSError, ValueError):
        return kept
    if marks:
        ANTICHEAT.parent.mkdir(parents=True, exist_ok=True)
        ANTICHEAT.write_text(json.dumps(marks))
    return marks or kept


# From ProtonDB (protondb.com): what players report about each Steam game under Proton, summed
# up as a tier. One it rates borked, by its recent reports too, plays on Windows as an
# anti-cheat one does (AreWeAntiCheatYet's word wins where it has one). Asked only about the
# Steam games installed here, each at most once a week, in the background.

PROTONDB_URL = "https://www.protondb.com/api/v1/reports/summaries/{}.json"
PROTONDB = ANTICHEAT.parent / "protondb.json"   # {appid: [tier, recent tier, when asked]}
PROTONDB_LOCK = ANTICHEAT.parent / "protondb.lock"
PROTONDB_FRESH = 7 * 86400


def protondb_kept():
    try:
        kept = json.loads(PROTONDB.read_text())
    except (OSError, ValueError):
        return {}
    return kept if isinstance(kept, dict) else {}


def proton_marks(kept):
    """{appid: "windows"} for the games players report don't run in Monet, lately too."""
    return {appid: "windows" for appid, said in kept.items()
            if isinstance(said, list) and len(said) == 3 and said[0] == said[1] == "borked"}


def windows_build(steam, state):
    """Whether Steam here keeps a game's Windows build (a program for Windows in its folder),
    which it runs through Proton. A game with a Linux build of its own runs that instead, and
    players' Proton reports don't speak for it."""
    folder = str(state.get("installdir", ""))
    if not folder or "/" in folder or folder.startswith("."):
        return False
    for library in steam_libraries(steam):
        game = library / "steamapps/common" / folder
        if game.is_dir():
            return any(next(game.glob(pattern), None) for pattern in ("*.exe", "*/*.exe", "*/*/*.exe", "*/*/*/*.exe"))
    return False


def proton_reports(found=None):
    """proton_marks for the Steam games here that Steam runs through Proton."""
    marks = proton_marks(protondb_kept())
    if not marks:
        return {}
    found = list(steam_games()) if found is None else found
    return {appid: marks[appid] for steam, appid, _, state in found if appid in marks and windows_build(steam, state)}


def protondb_stale(appids, kept, now=None):
    """The games not asked about this week."""
    now = time.time() if now is None else now
    return sorted(a for a in appids if not (isinstance(kept.get(a), list) and len(kept[a]) == 3
                                          and isinstance(kept[a][2], (int, float)) and now - kept[a][2] < PROTONDB_FRESH))


def protondb_summary(appid):
    """ProtonDB's summary of one game: {} when nobody reported on it, None when it couldn't be asked."""
    import urllib.error
    import urllib.request
    request = urllib.request.Request(PROTONDB_URL.format(appid), headers={"User-Agent": "Monet"})
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            summary = json.loads(answer.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        return {} if e.code == 404 else None
    except (OSError, ValueError):
        return None
    return summary if isinstance(summary, dict) else None


def protondb_refresh(appids, ask=protondb_summary, limit=60):
    """Asks ProtonDB about the games not asked about this week (one run at a time)."""
    import fcntl
    PROTONDB.parent.mkdir(parents=True, exist_ok=True)
    with open(PROTONDB_LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        kept, asked = protondb_kept(), 0
        for appid in protondb_stale(appids, kept)[:limit]:
            summary = ask(appid)
            if summary is None:
                break  # offline, or ProtonDB is busy: next time
            kept[appid] = [str(summary.get("tier") or ""), str(summary.get("trendingTier") or summary.get("tier") or ""),
                           int(time.time())]
            asked += 1
        if asked:
            temp = PROTONDB.with_suffix(".tmp")
            temp.write_text(json.dumps(kept))
            temp.replace(PROTONDB)
        return asked


# As monet-core's is_valid_id: only these reach `monet play`.
WINDOWS_ID = re.compile(r"(?:steam|epic|riot|gog|battlenet|ubisoft|rockstar|ea|custom):(?!\.)[A-Za-z0-9._-]{1,64}")


def windows_games(files=WINDOWS_GAMES):
    """[{id, name}] of the games Play on Windows offers: what Windows has, and the extras.
    None for a guest (monet-guest), who sees nothing of Windows."""
    if getpass.getuser() == "guest":
        return []
    found = {}
    for f in files:
        try:
            games = json.loads(f.read_text(encoding="utf-8")).get("games", [])
        except (OSError, ValueError, AttributeError):
            continue
        for g in games if isinstance(games, list) else []:
            name = " ".join(str(g.get("name", "")).split()) if isinstance(g, dict) else ""
            if name and WINDOWS_ID.fullmatch(str(g.get("id", ""))):
                # Where a launcher in Windows may ask for it, once (shown, never run).
                locate = str(g.get("locate") or "")
                locate = locate if len(locate) <= 260 and locate.isprintable() else ""
                played = g.get("minutes")
                found.setdefault(g["id"], {"id": g["id"], "name": name, "locate": locate,
                                           "minutes": played if isinstance(played, int) and played > 0 else 0})
    return list(found.values())


def windows_steam_ids(files=WINDOWS_GAMES):
    """The Steam ids of the games Play on Windows offers."""
    return {g["id"][6:] for g in windows_games(files) if g["id"].startswith("steam:")}


def game_marks(marks=None, here=None, windows=None, shared=None):
    """{"marks": {appid: "here" or "windows"} for the games on either side, "blocked": the
    games installed here that need Windows, [{id, name, onWindows, shared}]}: shared, in the
    Games folder Windows plays from too."""
    marks = {**proton_reports(), **anticheat()} if marks is None else marks
    here = {appid: name for _, appid, name, _ in steam_games()} if here is None else here
    shared = shared_steam_ids() if shared is None else shared
    windows = (windows_steam_ids() if windows is None else windows) | shared
    return {"marks": {a: m for a, m in marks.items() if a in here or a in windows},
            "blocked": [{"id": a, "name": n, "onWindows": a in windows, "shared": a in shared}
                        for a, n in sorted(here.items(), key=lambda item: item[1].lower()) if marks.get(a) == "windows"]}


# Windows' Games folder ------------------------------------------------------------
# Install a game once: Windows' drive keeps a Games folder that Steam uses on both sides,
# shared here at /run/media/Windows games by monet-windows-drive whenever the drive is safe
# to write. Steam here gets it as one of its libraries, and the games in it run with Proton,
# so Steam here keeps Windows' build of each (the one Windows plays) and never swaps in a
# Linux one. Steam writes its files back as it quits, so they change only while it's closed.

SHARED = Path("/run/media/Windows games")
SHARED_STATE = Path("/run/monet/windows-drive.json")
# Windows' folder for files on both sides (C:\Shared with Monet), shared with the Games folder.
FILES = Path("/run/media/Shared with Windows")
OWN_STEAM = DATA_HOME / "Steam"
PROTON = "proton_experimental"
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def shared_state():
    """What monet-windows-drive found at this start: {"state": "open", ...} when the folder is here."""
    try:
        found = json.loads(SHARED_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return found if isinstance(found, dict) else {}


def shared_here(folder=SHARED):
    return shared_state().get("state") == "open" and (folder / "steamapps").is_dir()


def shared_steam_ids(folder=SHARED):
    """The Steam games in Windows' Games folder (each has its appmanifest there)."""
    found = set()
    try:
        for manifest in (folder / "steamapps").glob("appmanifest_*.acf"):
            appid = manifest.name[len("appmanifest_"):-len(".acf")]
            if appid.isdigit():
                found.add(appid)
    except OSError:
        pass
    return found


def vdf_quote(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def vdf_lines(entries, depth):
    """Valve's KeyValues text for entries ({key: text, or {...}}), depth tabs in, as Steam writes it."""
    pad, text = "\t" * depth, ""
    for key, value in entries.items():
        if isinstance(value, dict):
            text += f"{pad}{vdf_quote(key)}\n{pad}{{\n{vdf_lines(value, depth + 1)}{pad}}}\n"
        else:
            text += f"{pad}{vdf_quote(key)}\t\t{vdf_quote(str(value))}\n"
    return text


def vdf_block(text, keys):
    """(start, end) of what's inside the braces of the block at keys (in any case), or None."""
    want, path, key = [k.lower() for k in keys], [], None
    tokens = list(VDF_TOKEN.finditer(text))
    for i, token in enumerate(tokens):
        quoted, brace = token.groups()
        if brace == "{":
            path.append((key or "").lower())
            key = None
            if path == want:
                depth = 0
                for later in tokens[i + 1:]:
                    if later.group(2) == "{":
                        depth += 1
                    elif later.group(2) == "}":
                        if depth == 0:
                            return token.end(), later.start()
                        depth -= 1
                return None
        elif brace == "}":
            path = path[:-1]
            key = None
        elif key is None:
            key = quoted
        else:
            key = None
    return None


def vdf_children(text, keys):
    """The names in the block at keys (lowercased), or None when there's no such block."""
    span = vdf_block(text, keys)
    if span is None:
        return None
    found, key, depth = set(), None, 0
    for token in VDF_TOKEN.finditer(text, span[0], span[1]):
        quoted, brace = token.groups()
        if brace == "{":
            if depth == 0 and key is not None:
                found.add(key.lower())
            depth, key = depth + 1, None
        elif brace == "}":
            depth, key = depth - 1, None
        elif depth == 0:
            if key is None:
                key = quoted
            else:
                found.add(key.lower())
                key = None
    return found


def vdf_insert(text, keys, body):
    """text with body (whole lines of KeyValues) at the end of the block at keys, or None."""
    span = vdf_block(text, keys)
    if span is None:
        return None
    line = text.rfind("\n", 0, span[1]) + 1
    at = line if line > span[0] and not text[line:span[1]].strip() else span[1]
    if not text[:at].endswith("\n"):
        body = "\n" + body
    return text[:at] + body + text[at:]


def write_steam_file(path, text):
    """Replaces one of Steam's files in one step, keeping how it was before Monet's first change."""
    before = path.with_name(path.name + ".before-monet")
    if not before.exists():
        shutil.copy2(path, before)
    temp = path.with_name(path.name + ".monet")
    temp.write_text(text, encoding="utf-8")
    os.replace(temp, path)


def steam_running():
    return run("pgrep", "-u", str(os.getuid()), "-x", "steam") is not None


def share_with_steam(steam=OWN_STEAM, folder=SHARED):
    """Windows' Games folder as a library of Steam here, and Proton for each game in it that
    has no compatibility tool chosen yet. Steam must be closed. "added", "ok" or "no-steam"."""
    lists = [steam / "steamapps/libraryfolders.vdf", steam / "config/libraryfolders.vdf"]
    if not lists[0].is_file():
        return "no-steam"  # Steam hasn't started here yet: next time
    if not os.access(folder / "steamapps", os.W_OK):
        return "not-yours"  # the PC's first person's (monet-windows-drive)
    try:
        mark = vdf((folder / "libraryfolder.vdf").read_text(encoding="utf-8", errors="replace"))
    except OSError:
        mark = {}
    contentid = str(pick(mark, "libraryfolder").get("contentid") or "0")
    added = False
    for path in lists:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        listed = pick(vdf(text), "libraryfolders")
        if any(isinstance(e, dict) and Path(e.get("path") or "/") == folder for e in listed.values()):
            continue
        number = str(max((int(k) for k in listed if k.isdigit()), default=-1) + 1)
        entry = {number: {"path": str(folder), "label": "", "contentid": contentid, "totalsize": "0",
                          "update_clean_bytes_tally": "0", "time_last_update_verified": "0", "apps": {}}}
        changed = vdf_insert(text, ["libraryfolders"], vdf_lines(entry, 1))
        if changed:
            write_steam_file(path, changed)
            added = True
    config = steam / "config/config.vdf"
    keys = ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"]
    try:
        text = config.read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    mapped = vdf_children(text, keys)
    if mapped is None and text:
        text = vdf_insert(text, keys[:-1], vdf_lines({"CompatToolMapping": {}}, 4)) or ""
        mapped = vdf_children(text, keys)
    missing = sorted(shared_steam_ids(folder) - (mapped or set()), key=int)
    if missing and mapped is not None:
        tools = {appid: {"name": PROTON, "config": "", "priority": "250"} for appid in missing}
        changed = vdf_insert(text, keys, vdf_lines(tools, 5))
        if changed:
            write_steam_file(config, changed)
    return "added" if added else "ok"


def steam_share(now=False):
    """At sign-in (or Settings' Add to Steam, now): Windows' Games folder for Steam here.
    Now closes Steam first and starts it again after."""
    if not shared_here():
        return "not-shared"
    running = steam_running()
    if running and not now:
        return "steam-running"
    if running:
        run("steam", "-shutdown", timeout=30)
        for _ in range(60):
            if not steam_running():
                break
            time.sleep(0.5)
        else:
            return "steam-running"
    done = share_with_steam()
    if running and shutil.which("steam"):
        subprocess.Popen(["steam", "-silent"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return done


def epic_share(roots=None, folder=SHARED):
    """Each Epic game legendary (Heroic's) installed in Windows' Games folder, made ready for
    Epic's own launcher in Windows as legendary's EGL sync leaves one: the install's manifest
    and its .mancpn in the game's .egstore, and a note for Monet Bridge in
    Games/.monet/epic/APP.json, from which Bridge writes the launcher's .item. Notes for games
    no longer there go. The app names."""
    import uuid
    roots = [r / "legendaryConfig/legendary" for r in HEROIC_ROOTS] + [CONFIG / "legendary"] if roots is None else roots
    notes = folder / ".monet/epic"
    done, looked = [], False
    for root in roots:
        installed = read_json(root / "installed.json")
        looked = looked or isinstance(installed, dict)
        for app, info in installed.items() if isinstance(installed, dict) else []:
            path = Path(str(info.get("install_path") or "")) if isinstance(info, dict) else Path()
            if (not isinstance(info, dict) or info.get("is_dlc") or not re.fullmatch(APP, app) or not under(path, folder)
                    or not str(info.get("platform") or "Windows").startswith("Win") or app in done):
                continue
            meta = pick(read_json(root / "metadata" / f"{app}.json") or {}, "metadata")
            manifest = root / "manifests" / f"{app}.manifest"
            if not (manifest.is_file() and meta.get("id") and meta.get("namespace") and path.is_dir()):
                continue
            old = read_json(notes / f"{app}.json") or {}
            guid = str(old.get("guid") or info.get("egl_guid") or "").upper()
            guid = guid if re.fullmatch(r"[0-9A-F]{32}", guid) else uuid.uuid4().hex.upper()
            tags = info.get("install_tags") if isinstance(info.get("install_tags"), list) else []
            urls = info.get("base_urls") if isinstance(info.get("base_urls"), list) else []
            note = {"guid": guid, "folder": path.relative_to(folder).as_posix(), "AppName": app,
                    "DisplayName": " ".join(str(info.get("title") or app).split()),
                    "CatalogItemId": str(meta["id"]), "CatalogNamespace": str(meta["namespace"]),
                    "AppVersionString": str(info.get("version") or ""), "BaseURLs": [str(u) for u in urls],
                    "InstallSize": int(info.get("install_size") or 0), "InstallTags": [str(x) for x in tags],
                    "LaunchCommand": str(info.get("launch_parameters") or ""),
                    "LaunchExecutable": str(info.get("executable") or ""),
                    "MandatoryAppFolderName": str(pick(meta, "customAttributes", "FolderName").get("value") or ""),
                    "OwnershipToken": bool(info.get("requires_ot")), "bCanRunOffline": bool(info.get("can_run_offline", True))}
            try:
                egstore = path / ".egstore"
                egstore.mkdir(exist_ok=True)
                data, kept = manifest.read_bytes(), egstore / f"{guid}.manifest"
                if not kept.is_file() or kept.read_bytes() != data:
                    kept.write_bytes(data)
                (egstore / f"{guid}.mancpn").write_text(json.dumps(
                    {"AppName": app, "CatalogItemId": note["CatalogItemId"], "CatalogNamespace": note["CatalogNamespace"],
                     "FormatVersion": 0}, indent=4, sort_keys=True), encoding="utf-8")
                if note != old:
                    notes.mkdir(parents=True, exist_ok=True)
                    (notes / f"{app}.json").write_text(json.dumps(note, indent=1) + "\n", encoding="utf-8")
            except OSError:
                continue
            done.append(app)
    # Only when legendary's list was read: a list that couldn't be read says nothing was removed.
    for stale in notes.glob("*.json") if looked and notes.is_dir() else []:
        if stale.stem not in done:
            stale.unlink(missing_ok=True)
    return done


def shared_info(libraries=None):
    """Settings' card for Windows' Games folder: {state, steam (a library of Steam here),
    mine (theirs to install in), games, size, free, path}."""
    state = shared_state().get("state", "")
    if state != "open":
        # A BitLocker drive opened with its recovery key, Monet Bridge on its way in.
        return {"state": state, "unlocked": bool(shared_state().get("unlocked")),
                "handover": bool(shared_state().get("handover"))}
    libraries = game_libraries() if libraries is None else libraries
    listed = next((found for found in libraries if found["shared"]), {})
    try:
        free = shutil.disk_usage(SHARED).free
    except OSError:
        free = None
    return {"state": state, "steam": bool(listed), "mine": os.access(SHARED / "steamapps", os.W_OK),
            "games": listed.get("games", 0), "size": listed.get("size", 0), "free": free, "path": str(SHARED),
            "heroic": heroic_here(), "hint": not SHARED_HINT_OFF.exists(),
            # The folder for files on both sides, when it's there for this account.
            "files": str(FILES) if FILES.is_dir() and os.access(FILES, os.W_OK) else "",
            # Battle.net's, Ubisoft Connect's and the EA app's Wine prefixes here (Settings' Get or Open).
            "battlenet": launcher_here("battlenet"), "ubisoft": launcher_here("ubisoft"), "ea": launcher_here("ea")}


# The Games gallery's note about Windows games, until it's added to Steam or put away.
SHARED_HINT_OFF = CONFIG / "monet/shared-hint-off"


# One library ------------------------------------------------------------------
# Every game in one list: Steam's, Heroic's and Lutris' installed here (Heroic brings
# Epic through legendary, GOG, Amazon through nile, and games added by hand), and the ones
# Play on Windows offers. A game on both sides is one game (Epic's have the same app
# name in Heroic and in Windows). It plays on Monet when it's installed here and its
# anti-cheat doesn't want Windows; otherwise on Windows.

HEROIC_ROOTS = (CONFIG / "heroic", HOME / ".var/app/com.heroicgameslauncher.hgl/config/heroic")
HEROIC_STORES = {"legendary": "epic", "gog": "gog", "nile": "amazon", "sideload": "heroic"}
HEROIC_APP = "com.heroicgameslauncher.hgl"


def heroic_here():
    """Whether Heroic is on this PC: used, or installed (Flathub's, or a package)."""
    return (any(root.is_dir() for root in HEROIC_ROOTS) or shutil.which("heroic") is not None
            or any((apps / HEROIC_APP).is_dir() for apps in (Path("/var/lib/flatpak/app"), DATA_HOME / "flatpak/app")))


def get_flatpak(app):
    """An app from Flathub (Monet's polkit lets an administrator install apps), opened.
    Whether it's here."""
    if run("flatpak", "info", app) is None:
        run("flatpak", "install", "--system", "--noninteractive", "-y", "flathub", app, timeout=1800)
        if run("flatpak", "info", app) is None:
            return False
    subprocess.Popen(["flatpak", "run", app], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def get_heroic():
    """Settings' Get Heroic: the launcher for Epic, GOG and Amazon games, opened to sign in."""
    return get_flatpak(HEROIC_APP)


# About → Command-line tools: the system is read-only, so they go in a container (Distrobox,
# which the system has); BoxBuddy makes one and opens a terminal in it.
TOOLS_APP = "io.github.dvlv.boxbuddyrs"
# What a game may be called on `monet-quick play`'s command line and in heroic://.
APP = r"(?!\.)[A-Za-z0-9._-]{1,120}"
PLAYABLE = re.compile(rf"(?:steam:)?(\d+)|heroic:(legendary|gog|nile|sideload):({APP})|lutris:(\d+)")
# Any game in the library: its store, then its own id there.
GAME_ID = re.compile(rf"[a-z]{{2,12}}:{APP}")
LUTRIS_ROOTS = (DATA_HOME / "lutris", HOME / ".var/app/net.lutris.Lutris/data/lutris")
LUTRIS_APP = "net.lutris.Lutris"
STEAM_ART = "https://cdn.cloudflare.steamstatic.com/steam/apps/{}/header.jpg"


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def listed(tree, key=None):
    """The dicts in tree[key] (or in tree itself, a list)."""
    found = tree.get(key) if isinstance(tree, dict) and key else tree
    return [e for e in found if isinstance(e, dict)] if isinstance(found, list) else []


def under(path, folder):
    """Whether path is in folder."""
    try:
        return bool(str(path)) and Path(path).is_relative_to(folder)
    except (TypeError, ValueError):
        return False


def heroic_games(roots=HEROIC_ROOTS, shared=SHARED, covers=None):
    """[{runner, app, title, art, namespace, shared}] of each game Heroic installed here, from its
    own files: what's installed per store (and where: in Windows' Games folder, shared), and the
    titles and covers from its library caches. covers, when given, gets the cover of every game
    in those caches, installed or not, by (store, app): the Epic games Windows has too."""
    found = {}
    for root in roots:
        cache = {(runner, str(e.get("app_name", ""))): e
                 for runner, name, key in (("legendary", "legendary_library", "library"),
                                           ("gog", "gog_library", "games"), ("nile", "nile_library", "library"))
                 for e in listed(read_json(root / f"store_cache/{name}.json"), key)}
        if covers is not None:
            covers.update({(HEROIC_STORES[runner], app): (str(e.get("art_cover") or ""), web(e.get("art_square")))
                           for (runner, app), e in cache.items() if str(e.get("art_cover") or "").startswith("https://")})
        installed = []
        legendary = read_json(root / "legendaryConfig/legendary/installed.json")
        for app, info in legendary.items() if isinstance(legendary, dict) else []:
            if isinstance(info, dict) and not info.get("is_dlc"):
                installed.append(("legendary", app, info.get("title"), info.get("install_path"), info.get("install_size")))
        installed += [("gog", str(e.get("appName", "")), None, e.get("install_path"), e.get("install_size"))
                      for e in listed(read_json(root / "gog_store/installed.json"), "installed") if not e.get("is_dlc")]
        installed += [("nile", str(e.get("id", "")), None, e.get("path"), e.get("size"))
                      for e in listed(read_json(root / "nile_config/nile/installed.json"))]
        for e in listed(read_json(root / "sideload_apps/library.json"), "games"):
            if e.get("is_installed", True):
                cache[("sideload", str(e.get("app_name", "")))] = e
                installed.append(("sideload", str(e.get("app_name", "")), None, None, None))
        for runner, app, title, path, size in installed:
            info = cache.get((runner, app), {})
            title = " ".join(str(info.get("title") or title or "").split())
            art = str(info.get("art_cover") or "")
            namespace = info.get("namespace")
            if runner == "legendary" and not namespace and re.fullmatch(APP, app):
                # Not in Heroic's library cache (yet): legendary's own metadata knows it.
                meta = read_json(root / f"legendaryConfig/legendary/metadata/{app}.json") or {}
                namespace = pick(meta, "metadata").get("namespace")
            if re.fullmatch(APP, app) and title and title != "???":
                found[(runner, app)] = {"runner": runner, "app": app, "title": title,
                                        "art": art if art.startswith("https://") else "",
                                        "tall": web(info.get("art_square")), "hero": web(info.get("art_background")),
                                        "size": byte_size(size),
                                        "namespace": str(namespace or ""),
                                        # Epic's launcher and GOG's own files play these in Windows too.
                                        "shared": runner in ("legendary", "gog") and under(path, shared)}
    return list(found.values())


def web(address):
    """A picture's address from a launcher's cache, when it's on the web, else ""."""
    return str(address) if str(address or "").startswith("https://") else ""


def byte_size(value):
    """Bytes from a launcher's install size: a number, or text like "12.4 GiB"; 0 when unknown."""
    if isinstance(value, int) and not isinstance(value, bool):
        return max(value, 0)
    m = re.fullmatch(r"\s*([\d.]+)\s*([KMGT]?)i?B\s*", str(value or ""), re.I)
    try:
        return int(float(m.group(1)) * 1024 ** "BKMGT".index(m.group(2).upper() or "B")) if m else 0
    except ValueError:
        return 0


def lutris_games(roots=LUTRIS_ROOTS):
    """[{id, title, art}] of each game Lutris installed here (its pga.db, read-only), but not
    the ones it plays through Steam, which Steam lists itself; its banner as the cover."""
    import sqlite3
    found = {}
    for root in roots:
        db = root / "pga.db"
        if not db.is_file():
            continue
        try:
            conn = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True, timeout=2)
            try:
                rows = conn.execute("SELECT id, name, slug, runner FROM games WHERE installed = 1").fetchall()
            finally:
                conn.close()
        except sqlite3.Error:
            continue
        for game_id, name, slug, runner in rows:
            name, slug = " ".join(str(name or "").split()), str(slug or "")
            if not isinstance(game_id, int) or not name or runner == "steam":
                continue
            banner, cover = root / "banners" / f"{slug}.jpg", root / "coverart" / f"{slug}.jpg"
            art = banner.as_uri() if re.fullmatch(APP, slug) and banner.is_file() else ""
            tall = cover.as_uri() if re.fullmatch(APP, slug) and cover.is_file() else ""
            found.setdefault(game_id, {"id": game_id, "title": name, "art": art, "tall": tall})
    return list(found.values())


def steam_progress(state):
    """How far Steam is with a game it's downloading or updating (its appmanifest's AppState),
    in percent, or None when it's ready to play."""
    flags = int(state.get("StateFlags", 4)) if str(state.get("StateFlags", 4)).isdigit() else 4
    if flags & 4 and not flags & (256 | 1024):
        return None
    done, total = (str(state.get(k, "")) for k in ("BytesDownloaded", "BytesToDownload"))
    return min(99, int(done) * 100 // int(total)) if done.isdigit() and total.isdigit() and int(total) else 0


RECENT = 30 * 86400  # played within it: first in the gallery
FAVORITES = CONFIG / "monet/favorite-games.json"


def favorites():
    """The ids of the games marked as favorites in Games, as a set."""
    found = read_json(FAVORITES)
    return {g for g in found if isinstance(g, str) and GAME_ID.fullmatch(g)} if isinstance(found, list) else set()


def favorite(game, on):
    """Marks a game as a favorite in Games, or not."""
    if not GAME_ID.fullmatch(game):
        raise SystemExit(f"not a game: {game}")
    chosen = favorites() - {game} | ({game} if on else set())
    FAVORITES.parent.mkdir(parents=True, exist_ok=True)
    temp = FAVORITES.with_suffix(".new")
    temp.write_text(json.dumps(sorted(chosen)), encoding="utf-8")
    temp.replace(FAVORITES)


def library(marks=None, steam=None, heroic=None, windows=None, shared=None, movable=None, lutris=None, progress=None,
            reports=None, lasts=None, now=None, minutes=None, liked=None, sizes=None, roots=None):
    """[{id, name, store, plays, why, here, windows, shared, move, progress, art}], by name:
    `plays` is "monet" or "windows", `why` what sends one installed here to Windows ("anticheat",
    or "reports": players report it doesn't run here), `here` starts it in Monet (`monet-quick
    play`), `windows` is its id for `monet play` ("" while Windows hasn't got it), `shared` says
    it's in Windows' Games folder, one copy that both sides play, `move` that it needs Windows
    and Steam here can move it there (movable: Steam here has that folder), and `progress` how
    far Steam is with downloading it (percent; null when it's ready). For the Games window: `last`
    (when it was last played, Unix time; lasts), `minutes` played (on both sides), `size` on disk
    in bytes (0 when unknown), `favorite`, and `tall` and `hero`, its tall cover and its wide
    picture ("" when there's none). The games played lately (within RECENT) come first, newest
    first; then the rest by name."""
    marks = anticheat() if marks is None else marks
    if steam is None:
        found = list(steam_games())
        steam = {appid: name for _, appid, name, _ in found}
        progress = {appid: steam_progress(state) for _, appid, _, state in found}
        sizes = {appid: int(state["SizeOnDisk"]) for _, appid, _, state in found if str(state.get("SizeOnDisk", "")).isdigit()}
        roots = {appid: root for root, appid, _, _ in found}
        reports = proton_reports(found) if reports is None else reports
    progress, reports, sizes, roots = progress or {}, reports or {}, sizes or {}, roots or {}
    covers = {}
    heroic = heroic_games(covers=covers) if heroic is None else heroic
    if windows is None:
        windows = windows_games()
        # Battle.net's and EA's games in the shared Games folder, before Windows lists them itself.
        windows += [g for g in shared_battlenet() + shared_ea() if g["id"] not in {w["id"] for w in windows}]
    lutris = lutris_games() if lutris is None else lutris
    shared = shared_steam_ids() if shared is None else shared
    movable = (shared_here() and SHARED in steam_libraries(OWN_STEAM)) if movable is None else movable
    games = {}
    for appid, name in steam.items():
        root = roots.get(appid)
        games[f"steam:{appid}"] = {"name": name, "store": "steam", "here": f"steam:{appid}",
                                   "art": STEAM_ART.format(appid), "mark": marks.get(appid) or reports.get(appid),
                                   "why": "anticheat" if marks.get(appid) else "reports", "progress": progress.get(appid),
                                   "size": sizes.get(appid, 0),
                                   "tall": (root and steam_cached(root, appid, *STEAM_TALLS)) or STEAM_TALL.format(appid),
                                   "hero": (root and steam_cached(root, appid, "library_hero.jpg")) or STEAM_HERO.format(appid)}
        if appid in shared:
            # Windows' Steam plays it from the same folder (Monet Bridge adds it there).
            games[f"steam:{appid}"].update(windows=f"steam:{appid}", shared=True)
    for g in heroic:
        store = HEROIC_STORES[g["runner"]]
        games.setdefault(f"{store}:{g['app']}", {"name": g["title"], "store": store, "here": f"heroic:{g['runner']}:{g['app']}",
                                                 "art": g["art"], "mark": marks.get("epic/" + g["namespace"]),
                                                 "tall": g.get("tall", ""), "hero": g.get("hero", ""), "size": g.get("size", 0)})
        if g.get("shared"):
            # Monet Bridge hands it to Windows from the same folder.
            games[f"{store}:{g['app']}"].update(windows=f"{store}:{g['app']}", shared=True)
    for g in lutris:
        games[f"lutris:{g['id']}"] = {"name": g["title"], "store": "lutris", "here": f"lutris:{g['id']}",
                                      "art": g["art"], "mark": None, "tall": g.get("tall", "")}
    for g in windows:
        store, _, key = g["id"].partition(":")
        steam_id = key if store == "steam" else None
        art, tall = covers.get((store, key), ("", ""))
        games.setdefault(g["id"], {"name": g["name"], "store": store, "here": "",
                                   "art": STEAM_ART.format(key) if steam_id else art,
                                   "tall": STEAM_TALL.format(key) if steam_id else tall,
                                   "hero": STEAM_HERO.format(key) if steam_id else "",
                                   "mark": marks.get(steam_id)})
        games[g["id"]]["windows"] = g["id"]
        games[g["id"]]["locate"] = g.get("locate", "")
        games[g["id"]]["windows_minutes"] = g.get("minutes", 0)
    lasts, now = lasts or {}, time.time() if now is None else now
    minutes, liked = minutes or {}, favorites() if liked is None else liked

    def played_for(key, g):
        # Steam counts an account's time on every PC, Windows' too; anything else, each side its own.
        here, there = minutes.get(key, 0), g.get("windows_minutes", 0)
        return max(here, there) if g["store"] == "steam" else here + there

    def order(game):
        last = lasts.get(game["id"], 0)
        return (0, -last, "") if now - last < RECENT else (1, 0, game["name"].lower())

    return sorted(({"id": key, "name": g["name"], "store": g["store"],
                    "plays": "monet" if g["here"] and g["mark"] != "windows" else "windows",
                    "why": g.get("why", "anticheat") if g["here"] and g["mark"] == "windows" else "",
                    "here": g["here"], "windows": g.get("windows", ""), "shared": g.get("shared", False),
                    "move": movable and g["store"] == "steam" and g["mark"] == "windows" and not g.get("windows"),
                    "progress": g.get("progress"), "locate": g.get("locate", ""), "art": g["art"],
                    "last": lasts.get(key, 0), "minutes": played_for(key, g), "size": g.get("size", 0),
                    "favorite": key in liked, "tall": g.get("tall", ""), "hero": g.get("hero", "")}
                   for key, g in games.items()), key=order)


def steam_page(appid, what="page"):
    """The game's page in Steam's library, where Properties moves it to another folder; or
    Steam's own question about uninstalling it."""
    url = f"steam://uninstall/{appid}" if what == "uninstall" else f"steam://nav/games/details/{appid}"
    for command in (["steam"], ["xdg-open"]):
        if shutil.which(command[0]):
            subprocess.Popen(command + [url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


def play(game):
    """Starts a game installed here (PLAYABLE): Steam's the way Steam's own Play does, Heroic's
    and Lutris' the way their own shortcuts do. Without their windows where they allow it, so
    the game seems to start from Games: Steam stays in the tray (-silent) if it wasn't running,
    and Heroic starts the game without its window (--no-gui)."""
    appid, runner, app, lutris = PLAYABLE.fullmatch(game).groups()
    if appid:
        url, commands = f"steam://rungameid/{appid}", (["steam", "-silent"], ["flatpak", "run", "com.valvesoftware.Steam", "-silent"],
                                                        ["xdg-open"])
    elif lutris:
        url, commands = f"lutris:rungameid/{lutris}", (["lutris"], ["flatpak", "run", "net.lutris.Lutris"], ["xdg-open"])
    else:
        flatpak = [["flatpak", "run", HEROIC_APP, "--no-gui"]] if shutil.which("flatpak") and run("flatpak", "info", HEROIC_APP) is not None else []
        url, commands = f"heroic://launch?appName={app}&runner={runner}", (["heroic", "--no-gui"], *flatpak, ["xdg-open"])
    for command in commands:
        if shutil.which(command[0]):
            subprocess.Popen(command + [url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


# Windows programs ----------------------------------------------------------------
# A Windows program or installer opened in Files (an .exe or .msi): Monet's sheet (Quick
# Settings shows it) asks whether to run it here, through Proton as Windows games run here
# (umu-launcher, in a Windows of Monet's own for programs), or to open it in Windows, which
# gets it through the folder for files on both sides (C:\Shared with Monet) and opens it as you. What an
# installer put in the Start menu comes into Monet's app menu.

PROGRAM_TYPES = {".exe", ".msi"}
PROGRAM_PENDING = RUNTIME / "monet-program.json"
PROGRAMS_PREFIX = DATA_HOME / "monet/windows-programs"
# Where Windows programs keep their Start menu (Proton's own user is steamuser).
START_MENUS = ("drive_c/ProgramData/Microsoft/Windows/Start Menu/Programs",
               "drive_c/users/steamuser/AppData/Roaming/Microsoft/Windows/Start Menu/Programs")
PROGRAM_ENTRY = "monet-program-{}.desktop"


def program_slug(name):
    """The name as Monet Bridge's parse::slug makes it: lowercase letters, digits and dashes."""
    out = ""
    for c in name:
        if c.isascii() and c.isalnum():
            out += c.lower()
        elif out and not out.endswith("-"):
            out += "-"
    return out.rstrip("-")[:64]


def doorbell(words):
    """Rings Quick Settings' doorbell (monet-quick listen). Whether anyone answered."""
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK) if FIFO.is_fifo() else None
    except OSError:
        fd = None
    if fd is None:
        return False
    with os.fdopen(fd, "w") as bell:
        bell.write(words.strip() + "\n")
    return True


def windows_program(path):
    """Files' double-click on a Windows program: Monet's sheet asks where to open it. With no
    Quick Settings to ask (it isn't on the panel), it runs here."""
    found = Path(path).absolute()
    if not found.is_file() or found.suffix.lower() not in PROGRAM_TYPES:
        return False
    PROGRAM_PENDING.write_text(json.dumps({"path": str(found)}))
    if not doorbell("program"):
        program_here(str(found))
    return True


def program_info(pending=None, files=FILES):
    """The sheet's program: {path, name, installer, size, here (Monet can run it), windows (the
    shared Games folder can take it: "ok", or why not)}. Or a Windows app from the app menu:
    {app (its id), name, icon, windows: "ok"}."""
    try:
        asked = json.loads((pending or PROGRAM_PENDING).read_text())
        if APP_ID.fullmatch(str(asked.get("app"))):
            return {"app": asked["app"], "name": str(asked.get("name") or ""), "icon": str(asked.get("icon") or ""),
                    "here": False, "windows": "ok"}
        found = Path(asked["path"])
        size = found.stat().st_size
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}
    shared = shared_info([])
    state, mine = shared.get("state", ""), shared.get("mine") is True
    windows = ("no-windows" if state in ("", "no-windows", "no-bridge", "no-person")
               else "closed" if state != "open" or mine and not os.access(files, os.W_OK)
               else "not-yours" if not mine
               else "full" if not under(found, files) and (shared.get("free") or 0) < size + (1 << 28)
               else "ok")
    lower = found.name.lower()
    return {"path": str(found), "name": found.name, "size": size,
            "installer": found.suffix.lower() == ".msi" or any(w in lower for w in ("setup", "install")),
            "here": bool(shutil.which("umu-run")), "windows": windows}


def steam_proton(roots=STEAM_ROOTS):
    """The Proton Steam here keeps (Experimental first, else the newest), so programs need no
    download of their own; None for umu's own."""
    found = []
    for steam in roots:
        for library in steam_libraries(steam) if (steam / "steamapps").is_dir() else []:
            found += [p for p in (library / "steamapps/common").glob("Proton*") if (p / "proton").is_file()]
    experimental = [p for p in found if "experimental" in p.name.lower()]
    numbered = sorted((p for p in found if re.fullmatch(r"Proton [\d.]+", p.name)),
                      key=lambda p: [int(n) for n in re.findall(r"\d+", p.name)])
    return (experimental or numbered[-1:] or [None])[0]


def program_here(path):
    """Run in Monet: in a unit of its own, so it keeps going after Files or Settings close."""
    command = [f"{LIBEXECDIR}/monet-quick", "program-proton", path.encode().hex()]
    if not ok("systemd-run", "--user", "--collect", "--quiet", f"--unit=monet-program-{time.time_ns()}",
              f"--description={Path(path).name}", *command):
        subprocess.Popen(command, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def program_proton(path):
    """Runs a Windows program through Proton (umu-run) in Monet's Windows for programs, then
    brings what it put in the Start menu into the app menu."""
    found = Path(path)
    env = dict(os.environ, WINEPREFIX=str(PROGRAMS_PREFIX), GAMEID="0")
    proton = steam_proton()
    if proton:
        env["PROTONPATH"] = str(proton)
    if not (DATA_HOME / "umu").is_dir() and shutil.which("notify-send"):
        # The first time: umu fetches the runtime (and Proton, where Steam has none) first.
        subprocess.Popen(["notify-send", "--app-name=Monet", "--icon=monet-windows", tr("Getting ready for Windows programs"),
                          tr("The first time takes a few minutes. %1 opens by itself when it's ready.", found.name)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    PROGRAMS_PREFIX.parent.mkdir(parents=True, exist_ok=True)
    args = ["msiexec", "/i", str(found)] if found.suffix.lower() == ".msi" else [str(found)]
    try:
        subprocess.run(["umu-run", *args], env=env, cwd=found.parent)
    except OSError:
        return 1
    program_menu()
    return 0


def lnk_target(data):
    """The program a Windows shortcut (.lnk) leads to, as Windows writes it ("C:\\..."), from its
    LinkInfo (as Wine's installers write them); "" for any other shortcut."""
    if len(data) < 0x4C or data[:4] != b"\x4c\x00\x00\x00":
        return ""
    word = lambda at, n=4: int.from_bytes(data[at:at + n], "little")
    flags, at = word(0x14), 0x4C
    if flags & 0x01:  # HasLinkTargetIDList: skip it
        at += 2 + word(at, 2)
    if not flags & 0x02 or at + 0x1C > len(data):  # HasLinkInfo
        return ""
    header, info_flags = word(at + 4), word(at + 8)
    if not info_flags & 0x01:  # VolumeIDAndLocalBasePath
        return ""
    try:
        if header >= 0x24:
            start = at + word(at + 0x1C)
            end = start
            while end + 1 < len(data) and data[end:end + 2] != b"\0\0":
                end += 2
            return data[start:end].decode("utf-16-le")
        start = at + word(at + 0x10)
        return data[start:data.index(b"\0", start)].decode("cp1252")
    except (ValueError, UnicodeDecodeError):
        return ""


def program_menu(prefix=PROGRAMS_PREFIX, apps=DATA_HOME / "applications"):
    """Each program a Windows installer put in the Start menu, as an entry in Monet's app menu
    (uninstallers and help files left out); entries whose program is gone, gone too. How many."""
    wanted = {}
    for menu in START_MENUS:
        for link in sorted((prefix / menu).rglob("*.lnk")) if (prefix / menu).is_dir() else []:
            target = lnk_target(link.read_bytes()).replace("\\", "/")
            if not re.match(r"^[A-Za-z]:/", target) or not target.lower().endswith(".exe"):
                continue
            program = prefix / f"drive_{target[0].lower()}" / target[3:]
            name = " ".join(link.stem.split())
            if (program.is_file() and name and not re.search(r"uninstall|unins\d*\.exe$", f"{name} {target}", re.I)
                    and program_slug(name)):
                wanted[PROGRAM_ENTRY.format(program_slug(name))] = (name, program)
    apps.mkdir(parents=True, exist_ok=True)
    for entry in apps.glob(PROGRAM_ENTRY.format("*")):
        if entry.name not in wanted:
            entry.unlink()
    for entry, (name, program) in wanted.items():
        text = ("[Desktop Entry]\nType=Application\nName=" + name.replace("\n", " ") + "\n"
                + f"Comment={tr('A Windows program')}\n"
                + f"Exec={LIBEXECDIR}/monet-quick program-start {str(program).encode().hex()}\n"
                + "Icon=application-x-ms-dos-executable\nCategories=X-Monet-Windows-Programs;\n")
        if not (apps / entry).is_file() or (apps / entry).read_text() != text:
            (apps / entry).write_text(text)
    return len(wanted)


def program_id(path, files):
    """A program's id for `monet play`: its place in the folder for files on both sides, as Monet
    Bridge names it there (parse::slug of the path under C:\\Shared with Monet)."""
    return "program:" + program_slug(Path(path).relative_to(files).as_posix())


def program_windows(path, files=FILES):
    """Open in Windows: the program in the folder for files on both sides (C:\\Shared with Monet,
    where it stays for later), copied there unless it's there already, for Monet Bridge to open
    as you when Windows starts. Its id for `monet play`, or None when Windows can't get it."""
    found = Path(path).absolute()
    if not files.is_dir() or not os.access(files, os.W_OK):
        return None
    if under(found, files):
        return program_id(found, files)  # saved there: nothing to copy
    stem, suffix = found.stem, found.suffix
    taken = {program_id(p, files) for p in files.iterdir() if p.is_file()}
    for n in range(1, 100):
        target = files / (found.name if n == 1 else f"{stem} ({n}){suffix}")
        if target.exists():
            if target.stat().st_size == found.stat().st_size and same_file(found, target):
                return program_id(target, files)  # sent before
            continue
        if program_id(target, files) in taken:
            continue  # each one's id is its own
        part = files / f".{target.name}.part"
        try:
            shutil.copyfile(found, part)
            part.replace(target)
        except OSError:
            part.unlink(missing_ok=True)
            return None
        return program_id(target, files)
    return None


# The person's Windows apps -----------------------------------------------------
# What their Start menu in Windows has (monet-windows-drive lists it when Windows' drive opens,
# with each app's own icon in their icon theme), as entries in Monet's app menu and its search:
# each opens in Windows, asked first on Monet's sheet (Quick Settings' doorbell, as programs
# are), and Monet Bridge opens the same shortcut there. An app Monet has itself stays Monet's.

WINDOWS_APPS = DATA_HOME / "monet/windows-apps.json"
APP_ENTRY = "monet-windows-app-{}.desktop"
APP_ID = re.compile(r"app:[a-z0-9-]{1,64}")
# Where in the app menu: by the name, as the usual ones go; the rest are utilities.
APP_KINDS = ((re.compile(r"word|excel|powerpoint|outlook|onenote|access|publisher|teams|acrobat|office|visio|project", re.I),
              "Office;"),
             (re.compile(r"photoshop|illustrator|lightroom|indesign|affinity|corel|fusion|autocad|sketchup|figma|aseprite|"
                         r"substance|zbrush|3ds max|maya|cinema 4d|rhino", re.I), "Graphics;"),
             (re.compile(r"premiere|after effects|audition|vegas|resolve|ableton|fl studio|cubase|reaper|itunes|"
                         r"media encoder|capcut", re.I), "AudioVideo;"))


def windows_apps_menu(listed=WINDOWS_APPS, apps=DATA_HOME / "applications"):
    """Each of the person's Windows apps as an entry in Monet's app menu, unless Monet has it
    too; entries of apps no longer there, gone. How many."""
    if getpass.getuser() == "guest":
        return 0
    try:
        found = json.loads(listed.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 0  # never listed: Windows' drive hasn't been open yet
    mine = APP_ENTRY.format("")[:-len(".desktop")]
    here = {entry.get("Name", "").lower() for name, entry in menu_entries()
            if not name.startswith((mine, "monet-game-", "monet-program-")) and entry.get("NoDisplay") != "true"}
    wanted = {}
    for app in found if isinstance(found, list) else []:
        if not isinstance(app, dict) or not APP_ID.fullmatch(str(app.get("id"))):
            continue
        name = " ".join(str(app.get("name") or "").split())[:80]
        if not name or name.lower() in here:
            continue
        slug = app["id"][len("app:"):]
        kind = next((k for pattern, k in APP_KINDS if pattern.search(name)), "Utility;")
        wanted[APP_ENTRY.format(slug)] = (
            "[Desktop Entry]\nType=Application\nName=" + name + "\n"
            + f"Comment={tr('Opens in Windows')}\n"
            + "Keywords=Windows;\nStartupNotify=false\n"  # the sheet comes, not a window of its own
            + f"Exec={LIBEXECDIR}/monet-quick windows-app {app['id']}\n"
            + f"Icon={mine + slug if app.get('icon') is True else 'monet-windows'}\n"
            + f"Categories={kind}X-Monet-Windows-Apps;\nX-Monet-Windows-App={app['id']}\n")
    apps.mkdir(parents=True, exist_ok=True)
    for entry in apps.glob(APP_ENTRY.format("*")):
        if entry.name not in wanted:
            entry.unlink()
    for entry, text in wanted.items():
        if not (apps / entry).is_file() or (apps / entry).read_text(encoding="utf-8") != text:
            (apps / entry).write_text(text, encoding="utf-8")
    return len(wanted)


def windows_app(app_id, apps=DATA_HOME / "applications"):
    """An app menu entry of a Windows app: Monet's sheet asks before the restart. With no Quick
    Settings to ask (it isn't on the panel), Monet's own question does."""
    entry = apps / APP_ENTRY.format(app_id[len("app:"):])
    if not APP_ID.fullmatch(app_id) or not entry.is_file():
        return False
    found = desktop_entry(entry.read_text(encoding="utf-8", errors="replace"))
    PROGRAM_PENDING.write_text(json.dumps({"app": app_id, "name": found.get("Name", ""), "icon": found.get("Icon", "")}))
    if not doorbell("program"):
        subprocess.Popen([f"{BINDIR}/monet", "play", app_id, "--confirm"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


# Files' place for the folder for files on both sides, while it's there (KDE's places list,
# where Files and every file dialog read it); gone again when Windows' drive isn't open.
PLACES = DATA_HOME / "user-places.xbel"
PLACE_ID = "monet-shared-with-windows"


def files_place(here, places=PLACES, files=FILES, place_id=PLACE_ID, title=None, icon="folder-publicshare"):
    """Adds the place (here) or takes it away: the folder shared with Windows, or another of
    Monet's (OneDrive). Only to a list KDE made already: one that's missing gets KDE's own
    places first."""
    try:
        text = places.read_text(encoding="utf-8")
    except OSError:
        return False
    import html
    from urllib.parse import quote
    has = f"<ID>{place_id}</ID>" in text
    if here and not has and "</xbel>" in text:
        entry = (f' <bookmark href="file://{quote(files.as_posix())}">\n'
                 f'  <title>{html.escape(title or tr("Shared with Windows"))}</title>\n'
                 '  <info>\n'
                 '   <metadata owner="http://freedesktop.org">\n'
                 f'    <bookmark:icon name="{icon}"/>\n'
                 '   </metadata>\n'
                 '   <metadata owner="http://www.kde.org">\n'
                 f'    <ID>{place_id}</ID>\n'
                 '    <isSystemItem>false</isSystemItem>\n'
                 '   </metadata>\n'
                 '  </info>\n'
                 ' </bookmark>\n')
        text = text.replace("</xbel>", entry + "</xbel>", 1)
    elif not here and has:
        text = re.sub(rf"[ \t]*<bookmark [^>]*>(?:(?!</bookmark>).)*<ID>{place_id}</ID>.*?</bookmark>\n?", "", text, flags=re.S)
    else:
        return False
    write_places(text, places)
    return True


# OneDrive ---------------------------------------------------------------------
# A place in Files: rclone (in the image) mounts the account at ~/OneDrive while you're signed
# in (monet-onedrive.service), each file coming down as it's opened and kept a while. Connecting
# signs in with Microsoft in the browser once (rclone's own sign-in); its other questions take
# their defaults (the account's own drive, personal or work).
ONEDRIVE = "OneDrive"
ONEDRIVE_DIR = HOME / "OneDrive"
ONEDRIVE_PLACE = "monet-onedrive"


def onedrive_remotes():
    return (run("rclone", "listremotes") or "").split() if shutil.which("rclone") else []


def onedrive_state():
    """Settings' OneDrive card: {here (rclone is), connected, mounted, path, used, total}."""
    state = {"here": shutil.which("rclone") is not None, "connected": f"{ONEDRIVE}:" in onedrive_remotes(),
             "mounted": os.path.ismount(ONEDRIVE_DIR), "path": str(ONEDRIVE_DIR)}
    if state["connected"] and state["mounted"]:
        try:
            about = json.loads(run("rclone", "about", f"{ONEDRIVE}:", "--json", timeout=20) or "{}")
        except ValueError:
            about = {}
        state.update(used=about.get("used"), total=about.get("total"))
    return state


def onedrive_answer(option):
    """rclone's question answered: its own default, the browser for signing in."""
    if option.get("Name") == "config_is_local":
        return "true"
    default = option.get("Default")
    return "true" if default is True else "false" if default is False else "" if default is None else str(default)


def onedrive_connect(ask=None):
    """Signs in to OneDrive in the browser, then mounts it at ~/OneDrive, from now on at every
    sign-in, with a place in Files. Whether it's connected."""
    ask = ask or (lambda args: run(*args, timeout=900))  # the browser's sign-in waits for you
    if not shutil.which("rclone"):
        return False
    args = ["rclone", "config", "create", ONEDRIVE, "onedrive", "--non-interactive"]
    signed_in = False
    for _ in range(12):
        try:
            step = json.loads(ask(args) or "{}")
        except ValueError:
            break
        # A step that answers nothing (rclone stopped: Cancel, or the browser's sign-in left
        # unfinished) or an error ends it, as does the last step, whose State is empty.
        if not isinstance(step, dict) or step.get("Error") or "State" not in step:
            break
        if not step["State"]:
            signed_in = True
            break
        args = ["rclone", "config", "update", ONEDRIVE, "--continue", "--state", step["State"],
                "--result", onedrive_answer(step.get("Option") or {}), "--non-interactive"]
    if not signed_in or f"{ONEDRIVE}:" not in onedrive_remotes():
        if f"{ONEDRIVE}:" in onedrive_remotes():
            run("rclone", "config", "delete", ONEDRIVE)  # what rclone kept of an unfinished sign-in
        return False
    ONEDRIVE_DIR.mkdir(exist_ok=True)
    run("systemctl", "--user", "enable", "--now", "monet-onedrive.service", timeout=120)
    files_place(True, files=ONEDRIVE_DIR, place_id=ONEDRIVE_PLACE, title="OneDrive", icon="folder-cloud")
    return True


def onedrive_cancel():
    """Settings' Cancel while the browser's sign-in waits: rclone stops, and onedrive_connect,
    still waiting for it, says it didn't connect."""
    return ok("pkill", "-u", getpass.getuser(), "-f", f"^rclone config (create|update) {ONEDRIVE} ")


def onedrive_disconnect():
    """Settings' Disconnect: off this PC (the files stay in OneDrive), its place gone too."""
    run("systemctl", "--user", "disable", "--now", "monet-onedrive.service", timeout=120)
    run("rclone", "config", "delete", ONEDRIVE)
    files_place(False, files=ONEDRIVE_DIR, place_id=ONEDRIVE_PLACE)
    try:
        ONEDRIVE_DIR.rmdir()  # only the empty folder it was mounted on
    except OSError:
        pass
    return f"{ONEDRIVE}:" not in onedrive_remotes()


def write_places(text, places=PLACES):
    temp = places.with_suffix(".monet")
    temp.write_text(text, encoding="utf-8")
    temp.replace(places)


# The system's own root: read-only and always full, so Files listed it under Devices as a drive
# with no name and a red bar, read as "my disk is full" (found in the test VM). Hidden the way
# Files' own Hide does it. (Monet's disk itself is out of Devices by 90-monet-system.rules.)
SYSTEM_ROOT_UDI = "/org/kde/fstab/overlay/"


def hide_system_root(places=PLACES):
    """Once: an entry KDE made for it already (someone showed it again) is left as it is."""
    try:
        text = places.read_text(encoding="utf-8")
    except OSError:
        return False
    if f"<UDI>{SYSTEM_ROOT_UDI}</UDI>" in text or "</xbel>" not in text:
        return False
    entry = (' <bookmark href="">\n'
             '  <title>/</title>\n'
             '  <info>\n'
             '   <metadata owner="http://www.kde.org">\n'
             f'    <UDI>{SYSTEM_ROOT_UDI}</UDI>\n'
             '    <isSystemItem>true</isSystemItem>\n'
             '    <IsHidden>true</IsHidden>\n'
             '   </metadata>\n'
             '  </info>\n'
             ' </bookmark>\n')
    write_places(text.replace("</xbel>", entry + "</xbel>", 1), places)
    return True


def same_file(a, b):
    import filecmp
    try:
        return filecmp.cmp(a, b, shallow=False)
    except OSError:
        return False


# Launchers fetched in Monet ------------------------------------------------------
# A game in Windows' Games folder whose launcher Windows hasn't got (Epic's, Ubisoft Connect,
# Battle.net): Monet fetches the launcher's installer there while you're in Monet, so Windows
# installs it on the first trip with nothing to download (Monet Bridge checks it's signed by
# its maker first, Install-Launcher.ps1). Once Windows has the launcher, the installer goes.

INSTALLERS = {
    "epic": ("EpicGamesLauncherInstaller.msi",
             "https://launcher-public-service-prod06.ol.epicgames.com/launcher/api/installer/download/EpicGamesLauncherInstaller.msi"),
    "ubisoft": ("UbisoftConnectInstaller.exe", "https://static3.cdn.ubi.com/orbit/launcher_installer/UbisoftConnectInstaller.exe"),
    "battlenet": ("Battle.net-Setup.exe",
                  "https://downloader.battle.net/download/getInstallerForGame?os=win&gameProgram=BATTLENET_APP&version=Live"),
    "ea": ("EAappInstaller.exe", "https://origin-a.akamaihd.net/EA-Desktop-Client-Download/installer-releases/EAappInstaller.exe"),
    # Not a launcher: Discord, for whoever uses it here, so a call carries on in Windows (Bridge
    # installs it on the trip to sign in to launchers, and Windows starts it at sign-in after).
    "discord": ("DiscordSetup.exe",
                "https://discord.com/api/downloads/distributions/app/installers/latest?channel=stable&platform=win&arch=x64"),
}
# Discord's apps here: someone who uses either wants it in Windows too.
DISCORD_APPS = ("com.discordapp.Discord", "dev.vencord.Vesktop")
INSTALLER_FRESH = 60 * 86400  # an older one is fetched again (they update themselves after, too)


def battlenet_folders(shared=SHARED):
    """The Battle.net games in Windows' Games folder (each has its .build.info), a folder or two in."""
    found = []
    for pattern in ("*/.build.info", "*/*/.build.info"):
        try:
            found += [p.parent for p in shared.glob(pattern) if p.is_file() and not p.parent.name.startswith(".")]
        except OSError:
            pass
    return found


# Battle.net's games, as Monet Bridge knows them (parse.rs' BATTLENET, which a test keeps the
# same): the uid Battle.net's agent writes beside each game, and the code it starts it by.
BATTLENET = {
    "wow": "WoW", "diablo3": "D3", "s2": "S2", "s1": "S1", "hs_beta": "WTCG", "heroes": "Hero",
    "prometheus": "Pro", "viper": "VIPR", "odin": "ODIN", "w3": "W3", "lazarus": "LAZR", "zeus": "ZEUS",
    "wlby": "WLBY", "osi": "OSI", "rtro": "RTRO", "fore": "FORE", "anbs": "ANBS", "auks": "AUKS",
    "fen": "Fen", "d1": "D1", "w1r": "W1R", "w2r": "W2R", "w1": "W1", "w2": "W2", "gryphon": "GRY",
    "aris": "ARIS", "scorpio": "SCOR", "arkansas": "ARK", "libra": "LBRA", "pinta": "PNTA", "aqua": "AQUA",
}


def battlenet_code(uid):
    """The code a game's uid starts it by (as Bridge's battlenet_code): its own, or a longer
    spelling of it, the longest that fits; never a variant (wow_classic)."""
    uid = uid.lower()
    fits = [known for known in BATTLENET if uid.startswith(known) and not uid[len(known):].startswith("_")]
    return BATTLENET[max(fits, key=len)] if fits else None


def build_info_product(text):
    """The game's uid from a Battle.net game folder's .build.info (its Product column, active row)."""
    lines = [line for line in text.splitlines() if line.strip() and not line.startswith("#")]
    if not lines:
        return None
    header = [column.split("!")[0].strip().lower() for column in lines[0].split("|")]
    if "product" not in header:
        return None
    rows = [line.split("|") for line in lines[1:]]
    active = header.index("active") if "active" in header else None
    row = next((r for r in rows if active is not None and len(r) > active and r[active] == "1"), rows[0] if rows else None)
    uid = row[header.index("product")].strip() if row and len(row) > header.index("product") else ""
    return uid if re.fullmatch(r"\w+", uid) else None


def shared_battlenet(shared=SHARED):
    """[{id, name, locate}] of the Battle.net games in the shared Games folder, for the gallery
    before Windows lists them itself: where Windows' Battle.net may ask to locate each, once."""
    found = {}
    for folder in battlenet_folders(shared):
        try:
            code = battlenet_code(build_info_product((folder / ".build.info").read_text(encoding="utf-8", errors="replace")) or "")
        except OSError:
            continue
        if code:
            place = "\\".join(folder.relative_to(shared).parts)
            found.setdefault(f"battlenet:{code}", {"id": f"battlenet:{code}", "name": folder.name, "locate": f"C:\\Games\\{place}"})
    return list(found.values())


def ea_game(text):
    """(offer ids, title) from an EA game's __Installer/installerdata.xml, as Monet Bridge reads
    it (parse.rs' ea_game): the ids the EA app starts it by, its English title when it has one."""
    ids = re.search(r"<contentIDs>(.*?)</contentIDs>", text, re.S)
    offers = [i.strip() for i in re.findall(r"<contentID>(.*?)</contentID>", ids.group(1), re.S)] if ids else []
    if not offers or not all(re.fullmatch(r"(?!\.)[A-Za-z0-9._-]{1,48}", i) for i in offers):
        return None
    titles = re.findall(r"<gameTitle([^>]*)>(.*?)</gameTitle>", text, re.S)
    title = next((name for attrs, name in titles if '"en_US"' in attrs), titles[0][1] if titles else "")
    return offers, " ".join(html.unescape(title).split())


def shared_ea(shared=SHARED):
    """[{id, name, locate}] of the EA games the EA app in Monet put in the shared Games folder,
    for the gallery before Windows lists them: the EA app there has no Locate, so it's told to
    install the game where it is (C:\\Games), and finds it there."""
    found = {}
    for xml in sorted(shared.glob("*/__Installer/installerdata.xml")) if shared.is_dir() else []:
        try:
            text = xml.read_bytes()[:1 << 20]
        except OSError:
            continue
        game = ea_game(text.decode("utf-16" if text.startswith(b"\xff\xfe") else "utf-8-sig", errors="replace"))
        if game:
            offers, title = game
            found.setdefault(f"ea:{offers[0]}", {"id": f"ea:{offers[0]}", "name": title or xml.parent.parent.name,
                                                 "locate": "C:\\Games"})
    return [g for g in found.values() if WINDOWS_ID.fullmatch(g["id"])]


def needed_launchers(shared=SHARED):
    """The launchers the games in Windows' Games folder need there."""
    needed = set()
    for key, notes in (("epic", ".monet/epic"), ("ubisoft", ".monet/ubisoft")):
        if any((shared / notes).glob("*.json")):
            needed.add(key)
    if battlenet_folders(shared):
        needed.add("battlenet")
    if shared_ea(shared):
        needed.add("ea")
    if any(run("flatpak", "info", app) is not None for app in DISCORD_APPS):
        needed.add("discord")
    return needed


def download(url, target):
    """url into target, whole or not at all. Whether it's there."""
    import urllib.request
    part = target.with_name(f".{target.name}.part")
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "Monet"})
        with urllib.request.urlopen(request, timeout=60) as answer, open(part, "wb") as out:
            shutil.copyfileobj(answer, out, 1 << 20)
        if part.stat().st_size < 1 << 20:
            raise OSError("too small to be an installer")
        part.replace(target)
        return True
    except (OSError, ValueError):
        part.unlink(missing_ok=True)
        return False


def fetch_launchers(have, needed, folder, fetch=download, now=None):
    """Fetches the installers of the needed launchers Windows hasn't got, and lets go of those
    it has. What it fetched."""
    now = time.time() if now is None else now
    fetched = []
    for key, (file, url) in INSTALLERS.items():
        target = folder / file
        if key in have:
            target.unlink(missing_ok=True)
        elif key in needed and not (target.is_file() and now - target.stat().st_mtime < INSTALLER_FRESH):
            folder.mkdir(parents=True, exist_ok=True)
            if fetch(url, target):
                fetched.append(key)
    return fetched


# Battle.net's and Ubisoft's games, installed once ---------------------------------
# Their launchers run in Monet through Lutris (Wine). In each Wine prefix here, drive W: is
# Windows' Games folder, so a game installed on W: is in C:\Games for Windows too, with
# nothing to download there. Windows' Battle.net finds one the first time it's asked to play
# it (Locate the game; Monet Bridge lists them by their .build.info); Ubisoft Connect's are
# noted (Games\.monet\ubisoft) for Monet Bridge to hand to Ubisoft Connect in Windows.

WINE_DRIVE = "w:"
WINE_ROOTS = (HOME / "Games",)
SEE_SHARED = CONFIG / "monet/flatpaks-see-shared"  # a flag for each app let see it
# Lutris' installers (lutris.net) for the launchers it runs here, and the folder each gets in ~/Games.
LUTRIS_SLUGS = {"battlenet": "battlenet", "ubisoft": "ubisoft-connect", "ea": "ea-app"}


def wine_prefixes(roots=WINE_ROOTS):
    """The Wine prefixes here (Lutris and Heroic keep theirs in ~/Games), a folder or two in."""
    found = []
    for root in roots:
        for pattern in ("*/dosdevices", "*/*/dosdevices"):
            try:
                found += [d.parent for d in root.glob(pattern) if (d.parent / "drive_c").is_dir()]
            except OSError:
                pass
    return found


def map_wine_drive(prefix, shared=SHARED):
    """Drive W: in a Wine prefix: Windows' Games folder. A W: someone made stays theirs."""
    link = prefix / "dosdevices" / WINE_DRIVE
    if os.path.lexists(link):
        return False
    try:
        os.symlink(shared, link)
    except OSError:
        return False
    return True


def ubisoft_installs(system_reg):
    """{id: install folder} from a Wine prefix's registry (system.reg): what Ubisoft Connect in it installed."""
    found, current = {}, None
    for line in system_reg.splitlines():
        if line.startswith("["):
            m = re.match(r"\[Software\\\\(?:Wow6432Node\\\\)?Ubisoft\\\\Launcher\\\\Installs\\\\(\d{1,12})\]", line, re.I)
            current = m.group(1) if m else None
        elif current:
            m = re.match(r'^"InstallDir"="(.*)"$', line)
            if m:
                found[current] = m.group(1).replace("\\\\", "\\")
    return found


def ubisoft_share(prefixes, shared=SHARED):
    """Notes for Monet Bridge (Games/.monet/ubisoft/ID.json: its folder in Games) for each game
    Ubisoft Connect installed on W:; notes for games no longer there go. The ids noted."""
    notes = shared / ".monet/ubisoft"
    wanted = {}
    for prefix in prefixes:
        try:
            installs = ubisoft_installs((prefix / "system.reg").read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
        for game, place in installs.items():
            m = re.match(r"^[wW]:[\\/]+(.+?)[\\/]*$", place)
            folder = m.group(1).replace("\\", "/") if m else ""
            if folder and ".." not in folder.split("/") and (shared / folder).is_dir():
                wanted[game] = folder
    if not wanted and not notes.is_dir():
        return []
    notes.mkdir(parents=True, exist_ok=True)
    for note in notes.glob("*.json"):
        if note.stem not in wanted:
            note.unlink()
    for game, folder in wanted.items():
        text = json.dumps({"id": game, "folder": folder})
        if not (notes / f"{game}.json").is_file() or (notes / f"{game}.json").read_text() != text:
            (notes / f"{game}.json").write_text(text)
    return sorted(wanted)


def flatpaks_see_shared(apps=(LUTRIS_APP, HEROIC_APP), shared=SHARED, flags=SEE_SHARED):
    """Lutris and Heroic from Flathub see Windows' Games folder (their sandbox doesn't, else),
    so a game installs there; once for each, once it's here. The apps let see it."""
    if not shutil.which("flatpak"):
        return []
    done = []
    for app in apps:
        if not (flags / app).exists() and run("flatpak", "info", app) is not None \
                and run("flatpak", "override", "--user", f"--filesystem={shared}", app) is not None:
            flags.mkdir(parents=True, exist_ok=True)
            (flags / app).write_text("")
            done.append(app)
    return done


def lutris_command():
    """How Lutris starts here: its own, or Flathub's (fetched first, as Get Heroic does)."""
    if shutil.which("lutris"):
        return ["lutris"]
    if run("flatpak", "info", LUTRIS_APP) is None:
        run("flatpak", "install", "--system", "--noninteractive", "-y", "flathub", LUTRIS_APP, timeout=1800)
        if run("flatpak", "info", LUTRIS_APP) is None:
            return None
    return ["flatpak", "run", LUTRIS_APP]


def launcher_here(key, roots=WINE_ROOTS):
    """Whether Battle.net's, Ubisoft Connect's or the EA app's Wine prefix is here (where Lutris
    installs it)."""
    return any((root / LUTRIS_SLUGS[key] / "drive_c").is_dir() for root in roots)


def get_launcher(key):
    """Settings' Get Battle.net / Ubisoft Connect: Lutris (Flathub's, when there's none) installs
    it here with its own installer, and Monet gives it drive W: (Windows' Games folder) as soon
    as its Wine prefix is there; once it's here, it opens. Whether Lutris started."""
    command = lutris_command()
    if not command:
        return False
    flatpaks_see_shared()
    slug = LUTRIS_SLUGS[key]
    url = f"lutris:rungame/{slug}" if launcher_here(key) else f"lutris:{slug}"
    subprocess.Popen(command + [url], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen([f"{LIBEXECDIR}/monet-quick", "wine-watch"], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def wine_watch(minutes=30, every=10, sleep=time.sleep):
    """While a launcher installs (Get Battle.net, say): drive W: for each Wine prefix as it
    appears, and Ubisoft's games noted, for a while."""
    for _ in range(minutes * 60 // every):
        if shared_here():
            prefixes = wine_prefixes()
            for prefix in prefixes:
                map_wine_drive(prefix)
            ubisoft_share(prefixes)
        sleep(every)


# Day notes: one note a day, shared by the Calendar widget and the bar's clock (a
# note written in one shows in the other), kept for the account in
# ~/.local/share/monet/notes.json as {"2026-10-23": "…"}.

NOTES = DATA_HOME / "monet/notes.json"
DAY = re.compile(r"\d{4}-\d{2}-\d{2}")
NOTE_REPEATS = ("daily", "weekly", "monthly", "yearly")


def valid_note_day(day):
    import datetime
    try:
        return bool(DAY.fullmatch(str(day))) and datetime.date.fromisoformat(day).isoformat() == day
    except (ValueError, TypeError):
        return False


def notes(strict=False):
    try:
        raw = NOTES.read_bytes()
        if len(raw) > 2 * 1024 * 1024: raise ValueError("Notes file is too large")
        found = json.loads(raw)
        if not isinstance(found, dict): raise ValueError("Invalid notes file")
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        if strict: raise
        return {}
    def valid(value):
        return (isinstance(value, str) and value.strip()) or (
            isinstance(value, dict) and value.get("repeat") in NOTE_REPEATS
            and isinstance(value.get("text"), str) and value["text"].strip())
    if strict and any(not valid_note_day(day) or not valid(value) for day, value in found.items()):
        raise ValueError("Invalid note in notes file")
    return {day: value for day, value in found.items() if valid_note_day(day) and valid(value)}


@contextlib.contextmanager
def note_lock():
    import fcntl
    NOTES.parent.mkdir(parents=True, exist_ok=True)
    with NOTES.with_suffix(".lock").open("a") as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def save_notes(found):
    import tempfile
    raw = json.dumps(found, ensure_ascii=False, sort_keys=True, indent=1).encode()
    if len(raw) > 2 * 1024 * 1024: raise ValueError("Notes file is too large")
    fd, name = tempfile.mkstemp(prefix=".notes-", dir=NOTES.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
        os.replace(name, NOTES)
    finally:
        Path(name).unlink(missing_ok=True)


def note_source(found, day):
    import datetime
    if day in found: return day
    def occurs(start, repeat):
        if start > day: return False
        if repeat == "daily": return True
        if repeat == "weekly":
            return (datetime.date.fromisoformat(day) - datetime.date.fromisoformat(start)).days % 7 == 0
        if repeat == "monthly": return start[8:] == day[8:]
        return repeat == "yearly" and start[5:] == day[5:]
    matches = [key for key, value in found.items() if isinstance(value, dict)
               and occurs(key, value.get("repeat"))]
    return max(matches) if matches else day


def set_note(day, text, repeat=None):
    if not valid_note_day(day) or repeat not in (None, "none", *NOTE_REPEATS) or len(text) > 65536:
        raise ValueError("Invalid note")
    with note_lock():
        found = notes(strict=True)
        source = note_source(found, day)
        if repeat is None:
            repeat = found[source]["repeat"] if isinstance(found.get(source), dict) else "none"
        if not text.strip():
            found.pop(source, None)
        elif repeat in NOTE_REPEATS:
            previous = found.get(source)
            if not isinstance(previous, dict) or previous.get("repeat") != repeat:
                found.pop(source, None)
                source = day
            found[source] = {"text": text, "repeat": repeat}
        else:
            found.pop(source, None)
            found[day] = text
        save_notes(found)


def merge_notes(more):
    """Import legacy notes without replacing current or recurring notes."""
    with note_lock():
        found = notes(strict=True)
        for day, text in (more if isinstance(more, dict) else {}).items():
            if valid_note_day(day) and isinstance(text, str) and text.strip() and note_source(found, day) not in found:
                found[day] = text
        save_notes(found)


# The timer (the desktop widget) rings: its words, said by the widget in your
# language, as a notification, and the sound theme's alarm.

def sound(name):
    """The file of a sound in the account's sound theme (KDE's Sounds setting), else in Monet's or Ocean's."""
    themes = [kread("kdeglobals", "Sounds", "Theme"), "monet", "ocean", "freedesktop"]
    for theme in filter(None, themes):
        for folder in data_dirs():
            for ext in ("oga", "ogg", "wav"):
                path = folder / "sounds" / theme / "stereo" / f"{name}.{ext}"
                if path.is_file():
                    return path
    return None


def ring(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "--app-name=Monet", "--icon=monet-timer", "--urgency=critical", title, body],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    alarm = sound("alarm-clock-elapsed")
    player = next((p for p in ("pw-play", "paplay") if shutil.which(p)), None)
    if alarm and player:
        subprocess.Popen([player, str(alarm)], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# Crashes ---------------------------------------------------------------------
# When an app closes unexpectedly, a short note says so and offers to open it
# again, instead of KDE's crash reporter (which Bazzite leaves out). Every crash
# goes to systemd-coredump; monet-crash@.service starts beside each one, as root,
# finds it in the journal and, when it was a person's app, hands it to their
# session, where the note shows.

def app_of_unit(unit):
    """The menu entry an app's systemd unit is named after (app-[launcher-]ID@RANDOM.service or
    app-[launcher-]ID-RANDOM.scope, the ID's own dashes written \\x2d), or ""."""
    found = re.fullmatch(r"app-(?:[^-@]+-)?([^-@]+)(?:@[^@]*\.service|\.service|-[^-@]+\.scope)", unit)
    return re.sub(r"\\x([0-9a-f]{2})", lambda m: chr(int(m[1], 16)), found[1]) + ".desktop" if found else ""


def local_name(entry):
    """An entry's Name in the session's language (Name[pt_BR], then Name[pt]), else its Name."""
    lang = next(filter(None, map(os.environ.get, ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"))), "")
    lang = re.split(r"[.@:]", lang)[0]
    return entry.get(f"Name[{lang}]") or entry.get(f"Name[{lang.split('_')[0]}]") or entry.get("Name", "")


def crash(instance, boot):
    """As root, beside systemd-coredump@INSTANCE: if what crashed was a person's app, tells their session."""
    for _ in range(280):  # the dump reaches the journal once it's stored; monet-crash@ gives it 5 minutes
        found = run("journalctl", "--output=json", "--output-fields=COREDUMP_EXE,COREDUMP_UID,COREDUMP_USER_UNIT",
                    "SYSLOG_IDENTIFIER=systemd-coredump", f"_SYSTEMD_UNIT=systemd-coredump@{instance}.service",
                    f"_BOOT_ID={boot}")
        dumps = (json.loads(line) for line in (found or "").splitlines() if line.startswith("{"))
        dump = next((d for d in dumps if d.get("COREDUMP_EXE")), None)
        if dump:
            break
        time.sleep(1)
    else:
        return
    uid, unit = str(dump.get("COREDUMP_UID", "")), str(dump.get("COREDUMP_USER_UNIT", ""))
    if not (uid.isdigit() and 1000 <= int(uid) < 60000 and app_of_unit(unit)):
        return
    person = (run("id", "-nu", uid) or "").strip()
    if person:
        # KillMode=process: what "Open it again" starts outlives the note.
        run("systemd-run", "--user", f"--machine={person}@.host", "--quiet", "--collect", "--property=KillMode=process",
            f"{LIBEXECDIR}/monet-quick", "crashed", unit.encode().hex())


def crashed(unit):
    """In the person's session: the app is gone, so say so and offer to open it again. Nothing when
    it's still open (only a part of it crashed, as a browser's tab or a game under Steam does) or
    isn't in the menu."""
    app = app_of_unit(unit)
    entry = entry_by_id(app) if app else None
    if not entry or "true" in (entry.get("NoDisplay"), entry.get("Hidden")):
        return
    for _ in range(20):
        if not ok("systemctl", "--user", "--quiet", "is-active", unit):
            break
        time.sleep(0.25)
    else:
        return
    answer = run("notify-send", "--app-name=Monet", f"--icon={entry.get('Icon') or 'monet'}",
                 f"--action=open={tr('Open it again')}", "--wait", tr("%1 closed unexpectedly", local_name(entry)),
                 timeout=600)
    if (answer or "").strip() == "open":
        launch(app)


# Accessibility -------------------------------------------------------------
# The size of everything (each screen's scale, kscreen-doctor), the pointer's size
# (kcminputrc, as KDE's page sets it), motion (KDE's animation speed, which Monet's
# own pieces follow too), the screen reader (Orca, when it's there) and the magnifier (KWin's Zoom).

SCALES = (100, 125, 150, 175, 200)
CURSOR_SIZES = (24, 36, 48)
MONETS_MOTION = "0.8"  # Monet's look: a touch quicker than KDE's


def screens():
    """[(name, scale)] of the screens in use, or []."""
    try:
        outputs = json.loads(run("kscreen-doctor", "-j") or "{}").get("outputs", [])
    except ValueError:
        return []
    return [(o.get("name", ""), o.get("scale", 1)) for o in outputs if o.get("enabled") and o.get("name")]


def display_sizes():
    """Read real per-output scale and pixel density; never infer scale from resolution alone."""
    try:
        outputs = json.loads(run("kscreen-doctor", "-j") or "{}").get("outputs", [])
    except (ValueError, AttributeError):
        return []
    shown = []
    for output in outputs:
        try:
            name = output.get("name", "")
            if not output.get("enabled") or not isinstance(name, str) or not re.fullmatch(r"[\w.-]+", name):
                continue
            scale = float(output.get("scale", 1))
            size, mm = output.get("size", {}), output.get("sizeMM", {})
            width, height = int(size.get("width", 0)), int(size.get("height", 0))
            mm_width, mm_height = float(mm.get("width", 0)), float(mm.get("height", 0))
            dpi = min(width * 25.4 / mm_width, height * 25.4 / mm_height) if mm_width >= 3 and mm_height >= 3 else 0
            if not 0.5 <= scale <= 5 or width < 0 or height < 0:
                continue
            shown.append(dict(name=name, scale=round(scale * 100), width=width, height=height,
                              highDensity=dpi >= 180, densityKnown=dpi > 0))
        except (TypeError, ValueError, OverflowError, AttributeError):
            continue
    return shown


def initial_display_sizes():
    """One first-sign-in default for new image accounts, never an upgrade migration.

    The image's /etc/skel marker is absent from existing accounts. Only replace
    an unscaled, lower-density starting screen where at least 800 logical pixels
    remain on each axis. Keep KWin's higher scales and unknown-size displays.
    """
    pending = CONFIG / "monet/display-defaults-pending"
    if not pending.is_file():
        return {"ok": True, "changed": []}
    shown = display_sizes()
    if not shown:
        return {"ok": False, "changed": []}
    # Consume before applying: never replay a default over a later personal choice.
    pending.unlink()
    changed, success = [], True
    for screen in shown:
        if (screen["scale"] == 100 and screen["densityKnown"] and not screen["highDensity"]
                and min(screen["width"], screen["height"]) >= 1000):
            result = set_scale(125, screen["name"])
            success = success and result["ok"]
            if result["ok"]:
                changed.append(screen["name"])
    return {"ok": success, "changed": changed}


def access_state():
    shown = screens()
    try:
        cursor = int(kread("kcminputrc", "Mouse", "cursorSize", "24") or 24)
    except ValueError:
        cursor = 24
    return {
        # One size only when every screen agrees: a docked laptop keeps its own (Settings hides the row).
        "scale": round(shown[0][1] * 100) if shown and len({scale for _, scale in shown}) == 1 else None,
        "cursor": cursor,
        "reduced": kread("kdeglobals", "KDE", "AnimationDurationFactor", MONETS_MOTION) in ("0", "0.0"),
        "reader": kread("kaccessrc", "ScreenReader", "Enabled", "false") == "true" if shutil.which("orca") else None,
        "zoom": zoom_on(),
    }


def zoom_on():
    """Whether KWin's magnifier (its Zoom effect) is on, or None when KWin can't say."""
    out = busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "isEffectLoaded", "s", "zoom") or ""
    return {"b true": True, "b false": False}.get(out.strip())


def set_zoom(on):
    """The magnifier: Windows key and + or − zooms the screen in and out (KWin's own shortcuts)."""
    kwrite("kwinrc", "Plugins", "zoomEnabled", "true" if on else "false")
    busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "loadEffect" if on else "unloadEffect", "s", "zoom")


def coordinate(text, degrees):
    """ISO 6709 as zone1970.tab has it ("+5920", "+01803", "-332200") in degrees."""
    sign = -1 if text[0] == "-" else 1
    d, rest = int(text[1:1 + degrees]), text[1 + degrees:]
    m, s = int(rest[:2] or 0), int(rest[2:4] or 0)
    return sign * (d + m / 60 + s / 3600)


def place(appletsrc=None, zone_tab=Path("/usr/share/zoneinfo/zone1970.tab"), zone=None):
    """Roughly where this PC is, for The Hours' sunrise and weather: the Weather widget's
    place, else its time zone's city. "59.33,18.07", or "" when neither is known."""
    if appletsrc is None:
        try:
            shared = json.loads((CONFIG / "monet/weather.json").read_text())
            if shared.get("place"):
                return f"{float(shared['latitude']):.2f},{float(shared['longitude']):.2f}"
        except (OSError, ValueError, KeyError):
            pass
    found = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        found.read_string((appletsrc or CONFIG / "plasma-org.kde.plasma.desktop-appletsrc").read_text())
    except (OSError, configparser.Error):
        pass
    # KDE's nested groups ("[Containments][1][Applets][23]") read as "Containments][1][Applets][23".
    for section in found.sections():
        if found[section].get("plugin") == "org.monet.weather":
            inner = section + "][Configuration][General"
            general = found[inner] if found.has_section(inner) else {}
            try:
                return f"{float(general['latitude']):.2f},{float(general['longitude']):.2f}"
            except (KeyError, ValueError):
                pass
    if zone is None:
        try:
            zone = os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
        except (OSError, IndexError):
            zone = ""
    try:
        for line in zone_tab.read_text().splitlines():
            fields = line.split("\t")
            if len(fields) >= 3 and fields[2] == zone:
                found = re.fullmatch(r"([+-]\d{4,6})([+-]\d{5,7})", fields[1])
                if found:
                    return f"{coordinate(found.group(1), 2):.2f},{coordinate(found.group(2), 3):.2f}"
    except OSError:
        pass
    return ""


FOCUS_QUIET = CONFIG / "monet/focus-quiet.json"


@contextlib.contextmanager
def quiet_lock():
    import fcntl
    FOCUS_QUIET.parent.mkdir(parents=True, exist_ok=True)
    with FOCUS_QUIET.with_suffix(".lock").open("a") as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def save_focus_quiet(state):
    import tempfile
    fd, name = tempfile.mkstemp(prefix=".focus-", dir=FOCUS_QUIET.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(state, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, FOCUS_QUIET)
    finally:
        Path(name).unlink(missing_ok=True)


def focus_quiet(end=None, owner="default"):
    """A timer borrows quiet time; only undo the value it still owns.

    The record survives a Plasma restart. Each widget owns one deadline, so stopping
    one cannot end another's quiet period. Explicit Settings changes revoke ownership;
    changes made in other apps are detected by comparing the actual setting.
    """
    if not re.fullmatch(r"default|[0-9]{1,10}", owner) or (end is not None and (
            type(end) is not int or not time.time() < end <= time.time() + 7 * 86400)):
        return {"ok": False, "remaining": 0}
    try:
        with quiet_lock():
            current = run("kreadconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until")
            if current is None:
                return {"ok": False, "remaining": 0}
            current = current.strip()
            state = None
            try:
                if FOCUS_QUIET.stat().st_size <= 32768:
                    saved = json.loads(FOCUS_QUIET.read_text())
                    if (isinstance(saved, dict) and saved.get("v") == 1
                            and all(isinstance(saved.get(k), str) and len(saved[k]) < 256 for k in ("previous", "written"))
                            and isinstance(saved.get("timers"), dict) and len(saved["timers"]) <= 64
                            and all(re.fullmatch(r"default|[0-9]{1,10}", key) and type(value) is int
                                    for key, value in saved["timers"].items())):
                        state = saved
            except (OSError, ValueError):
                pass
            # Never restore a stale record over a newer manual choice.
            if state and current != state["written"]:
                FOCUS_QUIET.unlink(missing_ok=True)
                state = None
            original_state = state.copy() if state else None
            if not state:
                if end is None:
                    return {"ok": True, "remaining": 0}
                state = {"v": 1, "previous": current, "written": current, "timers": {}}
            now = time.time()
            timers = {key: value for key, value in state["timers"].items() if value > now}
            if end is None:
                timers.pop(owner, None)
            else:
                if owner not in timers and len(timers) >= 64:
                    return {"ok": False, "remaining": len(timers)}
                timers[owner] = end
            latest = max(timers.values(), default=0)
            previous_end = quiet_until(state["previous"]) or 0
            value = (",".join(str(v) for v in time.gmtime(latest)[:6]) + ",UTC"
                     if latest > previous_end else state["previous"])
            # Persist ownership before changing the setting, so a killed helper can be
            # safely finished later. A failed write cannot claim a different live value.
            state.update(written=value, timers=timers)
            save_focus_quiet(state)
            result = {"ok": True} if current == value else write_quiet(value)
            if not result["ok"]:
                actual = run("kreadconfig6", "--file", "plasmanotifyrc", "--group", "DoNotDisturb", "--key", "Until")
                if actual is not None and actual.strip() == current:
                    # A rejected second timer must not discard the first timer's
                    # ownership. Keep its record when the setting never changed.
                    if original_state:
                        save_focus_quiet(original_state)
                    else:
                        FOCUS_QUIET.unlink(missing_ok=True)
            if result["ok"] and not timers:
                FOCUS_QUIET.unlink(missing_ok=True)
            return {"ok": result["ok"], "remaining": len(timers)}
    except (OSError, ValueError, OverflowError):
        return {"ok": False, "remaining": 0}


def focus(end=None, owner="default"):
    """Plein-air focus (the Timer): notifications quiet until it ends, and The Hours going
    through a whole day meanwhile. end: when it ends (Unix seconds), or None when it's over."""
    result = focus_quiet(end, owner)
    if not result["ok"]:
        return result
    if end:
        run(f"{LIBEXECDIR}/monet-light", "focus", f"{int(time.time())},{int(end)}", timeout=30)
    elif not result["remaining"]:
        run(f"{LIBEXECDIR}/monet-light", "focus", "", timeout=30)
    return result


def screen_features(outputs=None):
    """The screens that can show HDR, or keep pace with a game (variable refresh rate):
    [{name, hdr, vrr}], each None where the screen can't. kscreen-doctor lists "hdr"
    and "vrrPolicy" (0 never, 1 always, 2 automatic) only for screens that can."""
    if outputs is None:
        try:
            outputs = json.loads(run("kscreen-doctor", "-j") or "{}").get("outputs", [])
        except ValueError:
            outputs = []
    found = []
    for o in outputs:
        if not o.get("enabled") or not o.get("name") or ("hdr" not in o and "vrrPolicy" not in o):
            continue
        found.append({"name": o["name"], "hdr": bool(o["hdr"]) if "hdr" in o else None,
                      "vrr": o["vrrPolicy"] != 0 if "vrrPolicy" in o else None})
    return found


def set_screen_feature(name, what, on):
    """HDR on or off; the refresh rate keeping pace with games (automatic, as KDE has it) or never."""
    if re.fullmatch(r"[\w.-]+", name):
        value = ("enable" if on else "disable") if what == "hdr" else ("automatic" if on else "never")
        run("kscreen-doctor", f"output.{name}.{'hdr' if what == 'hdr' else 'vrrpolicy'}.{value}", timeout=30)


def fit_bars():
    # Only Monet's three bottom islands on the same screen are coordinated.
    # First measure their natural content width, then constrain the centre to
    # the free interval. Panel lengths and offsets use logical pixels.
    select = """
var groups={};
panels().forEach(function(p){
 if(p.location!=="bottom") return;
 var types=p.widgets().map(function(w){return w.type});
 var role=types.indexOf("org.monet.menu")>=0 ? "left" :
          types.indexOf("org.monet.quick")>=0 ? "right" :
          types.indexOf("org.kde.plasma.icontasks")>=0 ? "middle" : "";
 if(role) { if(!groups[p.screen]) groups[p.screen]={}; groups[p.screen][role]=p; }
});
"""
    def script(body):
        return run("busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                   "org.kde.PlasmaShell", "evaluateScript", "s", select + body, timeout=5)
    script("""Object.keys(groups).forEach(function(id){var g=groups[id];
 if(g.left && g.middle && g.right) g.middle.lengthMode="fit"; });""")
    time.sleep(0.2)
    script("""Object.keys(groups).forEach(function(id){
 var g=groups[id]; if(!g.left || !g.middle || !g.right) return;
 var width=screenGeometry(Number(id)).width, gap=16;
 var available=Math.max(80,width-g.left.length-g.right.length-4*gap);
 var length=Math.min(g.middle.length,available);
 var start=Math.max(g.left.length+2*gap,Math.min((width-length)/2,width-g.right.length-2*gap-length));
 g.left.offset=gap; g.right.offset=gap;
 g.middle.alignment="left"; g.middle.offset=Math.round(start);
 g.middle.minimumLength=Math.round(length); g.middle.maximumLength=Math.round(length);
 g.middle.lengthMode="custom"; g.middle.length=Math.round(length);
});""")


def set_scale(percent, name=None):
    """Change only the selected screen; confirm what the compositor actually accepted."""
    before = display_sizes()
    if name is None and len(before) == 1:
        name = before[0]["name"]
    selected = next((screen for screen in before if screen["name"] == name), None)
    if percent not in SCALES or selected is None:
        return {"ok": False, "displays": before, "error": tr("Choose a connected screen and a supported size.")}
    result = run("kscreen-doctor", f"output.{name}.scale.{percent / 100:g}", timeout=30)
    after = display_sizes()
    accepted = result is not None and any(screen["name"] == name and screen["scale"] == percent for screen in after)
    return {"ok": accepted, "displays": after,
            "error": "" if accepted else tr("The screen size couldn't be changed. Check the display connection and try again.")}


def set_cursor_size(size):
    kwrite("kcminputrc", "Mouse", "cursorSize", size)
    # KDE's "the cursor changed" (KGlobalSettings' CursorChanged), which KWin and apps follow.
    run("dbus-send", "--session", "--type=signal", "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
        "int32:5", "int32:0")


def set_reader(on):
    kwrite("kaccessrc", "ScreenReader", "Enabled", "true" if on else "false")
    if on:
        subprocess.Popen(["orca", "--replace"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        run("pkill", "-x", "orca")


# Default Apps --------------------------------------------------------------
# What opens what: the [Default Applications] of the person's mimeapps.list, which KDE
# and everyone else read. A category's first type says which apps can take it.

DEFAULT_KINDS = {
    "browser": ("x-scheme-handler/https", "x-scheme-handler/http", "text/html"),
    "mail": ("x-scheme-handler/mailto",),
    "files": ("inode/directory",),
    "music": ("audio/mpeg", "audio/flac", "audio/ogg", "audio/x-vorbis+ogg", "audio/x-opus+ogg", "audio/x-wav",
              "audio/mp4", "audio/aac"),
    "video": ("video/mp4", "video/x-matroska", "video/webm", "video/quicktime", "video/x-msvideo", "video/mpeg"),
    "photos": ("image/jpeg", "image/png", "image/gif", "image/webp", "image/heif", "image/avif", "image/tiff",
               "image/bmp"),
    "pdf": ("application/pdf",),
    "text": ("text/plain", "text/markdown"),
}
MIMEAPPS = CONFIG / "mimeapps.list"


def takers(entries, kind):
    """The shown apps that open a kind's first type, nearest copy deciding: [{id, name, icon}]."""
    first = DEFAULT_KINDS[kind][0]

    def program(entry):  # what it starts, without the file it's given
        return re.sub(r"\s+%[a-zA-Z]", "", entry.get("Exec", "")).strip()

    # Types an app opens through a hidden entry of its own for one kind of file, which starts the
    # same program (Okular, Documents, keeps PDFs in okularApplication_pdf.desktop: found by the test
    # bench); not its catch-alls (all the pictures it can show), which would offer it for photos.
    hidden = {}
    for _, entry in entries:
        types = set(filter(None, entry.get("MimeType", "").split(";")))
        if entry.get("NoDisplay") == "true" and entry.get("Hidden") != "true" and program(entry) and len(types) <= 4:
            hidden.setdefault(program(entry), set()).update(types)
    seen, apps = set(), []
    for app_id, entry in entries:
        if app_id in seen:
            continue
        seen.add(app_id)
        types = set(filter(None, entry.get("MimeType", "").split(";"))) | hidden.get(program(entry), set())
        if (entry.get("Type") == "Application" and entry.get("NoDisplay") != "true" and entry.get("Hidden") != "true"
                and first in types):
            apps.append({"id": app_id, "name": entry.get("Name", app_id), "icon": entry.get("Icon", ""),
                         "types": [t for t in DEFAULT_KINDS[kind] if t in types]})
    return sorted(apps, key=lambda app: app["name"].lower())


def with_defaults(text, chosen):
    """mimeapps.list's text with {type: app} set under [Default Applications], the rest kept."""
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if line.strip() == "[Default Applications]"), None)
    if start is None:
        lines += ([""] if lines and lines[-1].strip() else []) + ["[Default Applications]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    body = [line for line in lines[start + 1:end] if line.split("=", 1)[0].strip() not in chosen]
    while body and not body[-1].strip():
        body.pop()
    body += [f"{mime}={app};" for mime, app in chosen.items()]
    tail = lines[end:]
    return "\n".join(lines[:start + 1] + body + ([""] if tail else []) + tail) + "\n"


def defaults_state():
    entries, store = menu_entries(), store_entry()
    kinds = []
    for kind, types in DEFAULT_KINDS.items():
        current = (run("xdg-mime", "query", "default", types[0]) or "").strip()
        apps = [{k: a[k] for k in ("id", "name", "icon")} for a in takers(entries, kind)]
        # Nothing to open it with: the Store, to find something.
        kinds.append({"id": kind, "current": current, "apps": apps, "store": "" if apps else store})
    return kinds


def set_default(kind, app_id):
    app = next((a for a in takers(menu_entries(), kind) if a["id"] == app_id), None)
    if app is None:
        return
    try:
        text = MIMEAPPS.read_text(encoding="utf-8")
    except OSError:
        text = ""
    MIMEAPPS.parent.mkdir(parents=True, exist_ok=True)
    MIMEAPPS.write_text(with_defaults(text, {mime: app_id for mime in app["types"]}), encoding="utf-8")
    if kind == "browser":
        kwrite("kdeglobals", "General", "BrowserApplication", app_id)
    # KDE answers "what opens this" from its cache: rebuilt in the background.
    if shutil.which("kbuildsycoca6"):
        subprocess.Popen(["kbuildsycoca6"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def plasma_script(script):
    return busctl("call", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "evaluateScript", "s", script)



def set_dodge(on):
    """The bar's islands, all three alike: out of the way when a window comes over them, or
    in view over windows ("windows go below"). Never "always shown": Plasma gives each such
    panel room of its own and KWin stacks those rooms, so islands stood a bar's height above
    each other (found by the test bench), and the middle one alone sat flat on the edge."""
    return plasma_script("panels().filter(function (p) { return p.location === 'bottom' })"
                         ".forEach(function (p) { p.hiding = '%s' })" % ("dodgewindows" if on else "windowsgobelow")) is not None


def set_snap(on):
    """Settings' Snap layouts: Monet Snap's layouts, edges and Snap Assist, or, off, KWin's own
    edges and top (half the screen, the whole screen) and nothing more. Monet Snap itself stays:
    it also keeps the bar's islands on one row while widgets are edited."""
    results = [kwrite("kwinrc", "Script-monet-snap", "Snapping", "true" if on else "false"),
               kwrite("kwinrc", "Windows", "ElectricBorderMaximize", "false" if on else "true"),
               kwrite("kwinrc", "Windows", "ElectricBorderTiling", "false" if on else "true"),
               busctl("call", "org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")]
    return all(results[:3]) and results[3] is not None


def look_reset():
    applied = run(f"{LIBEXECDIR}/monet-look", "--reset", timeout=300) is not None
    painted = run(f"{LIBEXECDIR}/monet-light", "paint", "wall", timeout=60) is not None
    values = prefs()
    dodge = set_dodge(values["dodge"])
    snap = set_snap(values["snap"])
    return {"done": applied and painted and dodge and snap}


def set_placard(show):
    if show:
        plasma_script(
            'desktops().forEach(function (d) {'
            '  if (d.widgets("org.monet.placard").length === 0)'
            '    d.addWidget("org.monet.placard", gridUnit * 3, gridUnit * 3, gridUnit * 24, gridUnit * 12);'
            '})')
    else:
        plasma_script(
            'desktops().forEach(function (d) {'
            '  d.widgets("org.monet.placard").forEach(function (w) { w.remove(); });'
            '})')


# Date & Time ---------------------------------------------------------------

# ClockFormat.qml watches the saved locale; Plasma also exports it at the next sign-in.
TIME_LOCALE = ("--file", "plasma-localerc", "--group", "Formats", "--key", "LC_TIME")


def clock(show):
    """The time zone and whether the time sets itself, from `timedatectl show`, and the locale
    the clocks follow, beside the region's own."""
    values = dict(line.split("=", 1) for line in show.splitlines() if "=" in line)
    region = kread("plasma-localerc", "Formats", "LANG") or os.environ.get("LANG") or "en_US.UTF-8"
    return {
        "zone": values.get("Timezone", ""),
        "ntp": values.get("NTP") == "yes" if values.get("CanNTP") == "yes" else None,
        "locale": kread("plasma-localerc", "Formats", "LC_TIME") or region,
        "region": region,
    }


def zones():
    return (run("timedatectl", "list-timezones") or "").split()


# Accounts ------------------------------------------------------------------

def accounts_call(path, interface, method, *args):
    """A method of AccountsService, on the system bus: its first answer."""
    out = run("busctl", "--json=short", "call", "org.freedesktop.Accounts", path, interface, method, *args)
    try:
        return json.loads(out)["data"][0]
    except (TypeError, ValueError, KeyError, IndexError):
        return None


def your_account():
    return accounts_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "FindUserById", "x", str(os.getuid()))


def person(found, uid):
    """Someone, from AccountsService's properties of a user."""
    def get(key):
        return (found.get(key) or {}).get("data")
    login, picture = get("UserName") or "", get("IconFile") or ""
    return {"login": login, "name": (get("RealName") or "").strip() or login,
            "picture": picture if os.path.isfile(picture) else "",
            "admin": get("AccountType") == 1, "you": get("Uid") == uid, "guest": login == "guest"}


def accounts():
    """You first, then the other people on this PC, A to Z."""
    yours = your_account()
    paths = accounts_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "ListCachedUsers") or []
    people = []
    for path in dict.fromkeys(([yours] if yours else []) + paths):
        found = accounts_call(path, "org.freedesktop.DBus.Properties", "GetAll", "s", "org.freedesktop.Accounts.User")
        if found:
            people.append(person(found, os.getuid()))
    return sorted(people, key=lambda p: (not p["you"], p["name"].lower()))


def guest_state():
    """{"on": whether the Guest account is there (monet-guest)}."""
    try:
        found = json.loads(run(f"{LIBEXECDIR}/monet-guest", "status") or "{}")
    except ValueError:
        found = {}
    return {"on": found.get("on") is True}


def set_name(name):
    name = name.strip()
    # The password file keeps it, where ':' and ',' separate things.
    if not 0 < len(name) <= 64 or re.search(r"[:,\x00-\x1f\x7f]", name):
        return False
    yours = your_account()
    return bool(yours) and run("busctl", "call", "org.freedesktop.Accounts", yours, "org.freedesktop.Accounts.User",
                               "SetRealName", "s", name, timeout=120) is not None


# A password comes here on a command line, which anyone on the PC can read, so Monet Settings
# first asks for a one-time pad (over its own pipe) and sends the password sealed with it.
def make_pad():
    PAD.unlink(missing_ok=True)
    pad = os.urandom(256)
    with os.fdopen(os.open(PAD, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
        f.write(pad)
    return pad.hex()


def take_pad():
    """The pad, once: it's gone as soon as it's read."""
    try:
        with os.fdopen(os.open(PAD, os.O_RDONLY | os.O_NOFOLLOW), "rb") as f:
            return f.read()
    except OSError:
        return b""
    finally:
        PAD.unlink(missing_ok=True)


def unlock_windows(sealed):
    """Settings' recovery key for Windows' BitLocker drive, sealed with the pad: root's
    monet-windows-drive opens the drive with it (given on its stdin, never a command line) and
    keeps it sealed for every start. {"result": "open" | "bad-key" | "wrong-key" | "failed", "state"}."""
    key = unseal(sealed, take_pad())
    if not key:
        return {"result": "bad-key"}
    try:
        done = subprocess.run(["pkexec", f"{LIBEXECDIR}/monet-windows-drive", "unlock"], input=key,
                              capture_output=True, text=True, timeout=900)
        found = json.loads(done.stdout.strip().splitlines()[-1])
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        return {"result": "failed"}
    return found if isinstance(found, dict) else {"result": "failed"}


def unseal(sealed, pad):
    """Monet Settings' hex, each byte XORed with the pad's; None if the pad is too short."""
    data = bytes.fromhex(sealed)
    return bytes(a ^ b for a, b in zip(data, pad)).decode("utf-8", "replace") if len(data) <= len(pad) else None


def change_password(old, new):
    """Changes your password with passwd, answering it in a terminal of its own as GNOME's
    settings do, so passwd checks the old one, and that the new one is good enough."""
    import pty
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.execvpe("passwd", ["passwd"], dict(os.environ, LC_ALL="C"))
        finally:
            os._exit(127)
    said, answered, news = "", 0, 0
    while select.select([fd], [], [], 60)[0]:
        try:
            chunk = os.read(fd, 1024)
        except OSError:  # passwd is done, and its terminal with it
            break
        if not chunk:
            break
        said += chunk.decode("utf-8", "replace")
        asked = said[answered:].rstrip()
        if not asked.lower().endswith("password:"):
            continue
        if re.search(r"current|old", asked.rsplit("\n", 1)[-1], re.I):
            answer = old
        elif news < 2:
            answer, news = new, news + 1
        else:
            break  # it asks for a new one again: that one wasn't good enough
        os.write(fd, answer.encode() + b"\n")
        answered = len(said)
    os.close(fd)  # hangs up on passwd, if it's still asking
    _, code = os.waitpid(pid, 0)
    if os.waitstatus_to_exitcode(code) == 0:
        return {"ok": True}
    bad = re.search(r"BAD PASSWORD: (.+)", said)
    if bad:
        return {"ok": False, "message": bad.group(1).strip() + "."}
    wrong = re.search(r"manipulation error|Authentication failure", said)
    return {"ok": False, "message": "That isn't your current password." if wrong
            else last_line(said) or "Monet couldn't change your password."}


# About this PC -------------------------------------------------------------

def read_text(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def about():
    def first(path, key):
        try:
            for line in Path(path).read_text().splitlines():
                if line.startswith(key):
                    return line.split(":", 1)[1].strip()
        except OSError:
            pass
        return ""

    gpus = []
    for line in (run("lspci", "-mm") or "").splitlines():
        if '"VGA compatible controller"' in line or '"3D controller"' in line:
            fields = re.findall(r'"([^"]*)"', line)
            if len(fields) >= 3:
                vendor = fields[1].split()[0].replace("Advanced", "AMD")
                model = re.search(r"\[(.+)\]", fields[2])
                gpus.append(f"{vendor} {model.group(1) if model else fields[2]}")
    mem = first("/proc/meminfo", "MemTotal")
    memory = f"{round(int(mem.split()[0]) / 1024 / 1024)} GB" if mem else ""
    disk = shutil.disk_usage(Path.home())
    status = run(f"{BINDIR}/monet") or ""
    windows = re.search(r"Windows\s+(.+)", status)
    version = (run(f"{BINDIR}/monet", "version") or "").split()
    return {
        "monet": version[-1] if version else "",
        "processor": re.sub(r"\s+", " ", first("/proc/cpuinfo", "model name")),
        "graphics": ", ".join(gpus),
        "memory": memory,
        "storage": tr("%1 GB free of %2 GB", disk.free // 10**9, disk.total // 10**9),
        "windows": windows.group(1).strip() if windows else "",
        "notice": read_text(Path("/var/lib/monet/switch-notice")),
        "setup": read_text(Path("/var/lib/monet/windows-setup")),
        "autoUpdates": not Path("/var/lib/monet/auto-updates-off").exists(),
    }


