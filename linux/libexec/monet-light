#!/usr/bin/env bash
# Monet's light: mist while it's light out, smoke after dark.
#
#   monet-light                       apply the chosen light (at sign-in, and when the hour turns)
#   monet-light set hours|mist|smoke  choose: follow the hours, or keep one
#   monet-light paint                 the chosen light again, and the painting that goes with it
#   monet-light sync                  KDE's Light or Dark was picked: keep Mist or Smoke
#   monet-light focus [START,END]     plein-air focus: a whole day on the painting from START to END
#                                     (Unix seconds); nothing when it's over
#
# Panels and KDE apps change right away. Apps that use the glass app style
# (Files, Kate, ...) change the next time they open.
set -u

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATADIR="@DATADIR@"
LIBEXECDIR="@LIBEXECDIR@"
CHOICE="$CONFIG/monet/light"
# Same hours as the wallpaper: dawn and midday are light, dusk and night dark.
DAY_FROM=5
DAY_UNTIL=17
# KDE's global themes for Monet's two lights (its Light and Dark buttons).
MIST_THEME=org.monet.desktop
SMOKE_THEME=org.monet.smoke.desktop

choice() {
    case "$(cat "$CHOICE" 2>/dev/null)" in
        mist) echo mist ;;
        smoke) echo smoke ;;
        *) echo hours ;;
    esac
}

now() {
    local chosen hour
    chosen="$(choice)"
    if [ "$chosen" != hours ]; then
        echo "$chosen"
        return
    fi
    hour=$((10#$(date +%H)))
    if [ "$hour" -ge "$DAY_FROM" ] && [ "$hour" -lt "$DAY_UNTIL" ]; then
        echo mist
    else
        echo smoke
    fi
}

# Glass can be turned off in Monet Settings (Light & Wallpaper). Until it's
# chosen there, it's off when nothing but the processor draws the screen (a
# virtual machine, or a graphics driver that didn't load): blurring there
# makes everything lag.
glass() {
    local prefs="$CONFIG/monet/prefs.json"
    if grep -q '"glass": false' "$prefs" 2>/dev/null; then
        echo off
    elif grep -q '"glass": true' "$prefs" 2>/dev/null || ! drawn_by_processor; then
        echo on
    else
        echo off
    fi
}

drawn_by_processor() {
    busctl --user call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null |
        grep -q -E 'OpenGL renderer string: (llvmpipe|softpipe)|Compositing Type: QPainter'
}

# So can The Hours: then the painting stays instead of drifting with the day.
drifts() {
    grep -q '"hours": false' "$CONFIG/monet/prefs.json" 2>/dev/null && echo off || echo on
}

# The painting that goes with the light: drifting through the lights it
# allows (mist keeps to dawn and day, smoke to dusk and night), or the one it
# stays on. The wallpaper's lights start at 5, 10, 17 and 21.
painting() {
    local chosen hour
    chosen="$(choice)"
    if [ "$(drifts)" = on ]; then
        echo "$chosen"
        return
    fi
    case "$chosen" in
        mist) echo day ;;
        smoke) echo night ;;
        *)
            hour=$((10#$(date +%H)))
            if [ "$hour" -ge "$DAY_FROM" ] && [ "$hour" -lt 10 ]; then
                echo dawn
            elif [ "$hour" -ge 10 ] && [ "$hour" -lt "$DAY_UNTIL" ]; then
                echo day
            elif [ "$hour" -ge "$DAY_UNTIL" ] && [ "$hour" -lt 21 ]; then
                echo dusk
            else
                echo night
            fi
            ;;
    esac
}

# Which of Monet's series is on the wall (Monet Settings, Light & Wallpaper):
# The Hours, Water Lilies, Haystacks or The Magpie, each in the same four lights, or one
# for each season, as Monet painted them (seasons).
series() {
    case "$(sed -n 's/.*"series": *"\([a-z]*\)".*/\1/p' "$CONFIG/monet/prefs.json" 2>/dev/null)" in
        lilies) echo lilies ;;
        haystacks) echo haystacks ;;
        magpie) echo magpie ;;
        seasons) season_series ;;
        *) echo hours ;;
    esac
}

# The Hours in spring, Water Lilies in summer, Haystacks in autumn, The Magpie
# in winter; south of the equator (a place whose latitude is below zero) half
# a year on.
season_series() {
    local month
    month=$((10#$(date +%m)))
    case "$(place)" in -*) month=$(( (month + 5) % 12 + 1 )) ;; esac
    case "$month" in
        6|7|8) echo lilies ;;
        9|10|11) echo haystacks ;;
        12|1|2) echo magpie ;;
        *) echo hours ;;
    esac
}

# Where the PC is, for The Hours' sunrise and sunset and its weather ("59.33,18.07").
place() {
    "$LIBEXECDIR/monet-quick" place 2>/dev/null | grep -E '^-?[0-9.]+,-?[0-9.]+$' || true
}

# Whether the weather shows on the painting (Light & Wallpaper): on until turned off.
weather() {
    grep -q '"weather": false' "$CONFIG/monet/prefs.json" 2>/dev/null && echo false || echo true
}

# On every screen's desktop and on the lock screen.
paint() {
    local name set where sky
    name="$(painting)"
    set="$(series)"
    where="$(place)"
    sky="$(weather)"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Painting "$name"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Series "$set"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Place "$where"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Weather "$sky"
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "
        desktops().forEach(function (d) {
            if (d.wallpaperPlugin !== 'org.monet.hours') return;
            d.currentConfigGroup = ['Wallpaper', 'org.monet.hours', 'General'];
            d.writeConfig('Painting', '$name');
            d.writeConfig('Series', '$set');
            d.writeConfig('Place', '$where');
            d.writeConfig('Weather', $sky);
            d.reloadConfig();
        });
        desktops().forEach(function (d) {
            d.widgets('org.monet.placard').forEach(function (w) {
                w.currentConfigGroup = ['General'];
                w.writeConfig('Series', '$set');
            });
        })" >/dev/null 2>&1
}

# One change at a time: quick hours-mist-smoke taps repaint once each, in
# order, and sync waits until a change in progress has finished.
lock() {
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/monet-light.lock"
    flock 9
}

apply() {
    local light scheme kvantum style theme current
    light="$(now)"
    if [ "$light" = mist ]; then
        scheme=MonetLight kvantum=Monet theme=$MIST_THEME
    else
        scheme=MonetDark kvantum=MonetDark theme=$SMOKE_THEME
    fi
    style=monet
    # Monet's desktop widgets look for glass-off: without it they frost the
    # painting live, which is the heaviest thing on an old PC's screen.
    if [ "$(glass)" = off ]; then
        kvantum="${kvantum}Solid" style=monet-solid
        mkdir -p "$CONFIG/monet" && : > "$CONFIG/monet/glass-off"
    else
        rm -f "$CONFIG/monet/glass-off"
    fi

    # KDE's settings show Light or Dark to match (first, so sync sees it).
    current="$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)"
    case "$current" in
        ""|"$MIST_THEME"|"$SMOKE_THEME")
            [ "$current" = "$theme" ] || kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$theme"
            ;;
    esac

    # Only change what's Monet's: someone who picked their own colors keeps them.
    current="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null)"
    case "$current" in
        ""|MonetLight|MonetDark)
            if [ "$current" != "$scheme" ] && command -v plasma-apply-colorscheme >/dev/null; then
                plasma-apply-colorscheme "$scheme" >/dev/null 2>&1
            fi
            ;;
    esac

    current="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)"
    case "$current" in
        ""|monet|monet-solid)
            if [ "$current" != "$style" ] && command -v plasma-apply-desktoptheme >/dev/null; then
                plasma-apply-desktoptheme "$style" >/dev/null 2>&1
            fi
            ;;
    esac

    local kvconfig="$CONFIG/Kvantum/kvantum.kvconfig"
    current="$(kreadconfig6 --file "$kvconfig" --group General --key theme 2>/dev/null)"
    case "$current" in
        ""|Monet|MonetDark|MonetSolid|MonetDarkSolid)
            if [ "$current" != "$kvantum" ]; then
                mkdir -p "$CONFIG/Kvantum"
                kwriteconfig6 --file "$kvconfig" --group General --key theme "$kvantum"
            fi
            ;;
    esac

    # Window frames, mist or smoke, glass or solid.
    local frame=__aurorae__svg__Monet
    [ "$light" = smoke ] && frame="${frame}Smoke"
    [ "$style" = monet-solid ] && frame="${frame}Solid"
    current="$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null)"
    case "$current" in
        __aurorae__svg__Monet*)
            if [ "$current" != "$frame" ]; then
                kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$frame"
                busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1
            fi
            ;;
    esac

    local profile="${XDG_DATA_HOME:-$HOME/.local/share}/konsole/Monet.profile"
    if [ -f "$profile" ] && [ "$(kreadconfig6 --file "$profile" --group Appearance --key ColorScheme 2>/dev/null)" != "${kvantum%Solid}" ]; then
        kwriteconfig6 --file "$profile" --group Appearance --key ColorScheme "${kvantum%Solid}"
    fi

    # GTK apps (Flatpak ones too: monet-look lets them read these) in the
    # same light. KDE's own gtk.css, only its colors.css import, becomes
    # Monet's (which imports it too); a gtk.css someone wrote is left alone.
    local gtk=light version src dir
    case "$kvantum" in *Dark*) gtk=dark ;; esac
    for version in 3.0 4.0; do
        src="$DATADIR/monet/gtk/gtk-$version/$gtk.css"
        dir="$CONFIG/gtk-$version"
        [ -f "$src" ] || continue
        if [ ! -s "$dir/gtk.css" ] || head -1 "$dir/gtk.css" | grep -q '^/\* Monet:' ||
            ! grep -qv -e '^[[:space:]]*$' -e "^@import 'colors.css';\$" "$dir/gtk.css"; then
            cmp -s "$src" "$dir/gtk.css" || { mkdir -p "$dir" && cp "$src" "$dir/gtk.css"; }
        fi
    done
}

# Someone picked Light or Dark in KDE's settings (or a Monet global theme):
# that's a choice of Mist or Smoke, so keep it instead of following the hours.
sync() {
    local picked
    # KDE's Automatic is Monet's Follow the hours, and only Monet switches.
    if [ "$(kreadconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel 2>/dev/null)" = true ]; then
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false
        mkdir -p "$(dirname "$CHOICE")"
        echo hours > "$CHOICE"
        apply
        paint
        return 0
    fi
    case "$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)" in
        "$MIST_THEME") picked=mist ;;
        "$SMOKE_THEME") picked=smoke ;;
        *) return 0 ;;
    esac
    # Monet set it itself a moment ago: nothing was picked.
    [ "$picked" = "$(now)" ] && return 0
    mkdir -p "$(dirname "$CHOICE")"
    echo "$picked" > "$CHOICE"
    apply
    paint
}

# Plein-air focus (the Timer): The Hours goes from dawn to night between the two
# times, so the light shows the time passing without a clock.
focus() {
    case "$1" in
        ""|[0-9]*,[0-9]*) ;;
        *) return 1 ;;
    esac
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "
        desktops().forEach(function (d) {
            if (d.wallpaperPlugin !== 'org.monet.hours') return;
            d.currentConfigGroup = ['Wallpaper', 'org.monet.hours', 'General'];
            d.writeConfig('Focus', '$1');
            d.reloadConfig();
        })" >/dev/null 2>&1
}

case "${1:-apply}" in
    focus)
        focus "${2:-}"
        ;;
    apply)
        lock
        apply
        ;;
    set)
        case "${2:-}" in
            hours|mist|smoke) ;;
            *) echo "Choose hours, mist or smoke." >&2; exit 1 ;;
        esac
        lock
        mkdir -p "$(dirname "$CHOICE")"
        echo "$2" > "$CHOICE"
        apply
        paint
        ;;
    paint)
        lock
        apply
        paint
        ;;
    sync)
        lock
        sync
        ;;
    get)
        echo "$(choice) $(now)"
        ;;
    *)
        sed -n '2,10p' "$0"
        exit 1
        ;;
esac
