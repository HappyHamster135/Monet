#!/usr/bin/env bash
# Monet's light: mist while it's light out, smoke after dark.
#
#   monet-light                       apply the chosen light (at sign-in, and when the hour turns)
#   monet-light set hours|mist|smoke  choose: follow the hours, or keep one
#   monet-light paint [wall]          the chosen light again, and the painting that goes with it
#                                     (wall: Monet's wallpaper back where another one replaced it)
#   monet-light sync                  KDE's Light or Dark was picked: keep Mist or Smoke
#   monet-light focus [START,END]     plein-air focus: a whole day on the painting from START to END
#                                     (Unix seconds); nothing when it's over
#
# Panels and open KDE/Kvantum windows change together after the settings are written.
set -u

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATADIR="@DATADIR@"
LIBEXECDIR="@LIBEXECDIR@"
CHOICE="$CONFIG/monet/light"
# Fallback hours when this PC has neither a weather place nor a time-zone city.
DAY_FROM=5
DAY_UNTIL=17
# KDE's global themes for Monet's two lights (its Light and Dark buttons).
MIST_THEME=org.monet.desktop
SMOKE_THEME=org.monet.smoke.desktop

choice() {
    case "$(cat "$CHOICE" 2>/dev/null)" in
        mist) echo mist ;;
        smoke) echo smoke ;;
        *) echo hours ;;
    esac
}

now() {
    local chosen hour
    chosen="$(choice)"
    if [ "$chosen" != hours ]; then
        echo "$chosen"
        return
    fi
    if [ -x "$LIBEXECDIR/monet-daylight" ]; then
        "$LIBEXECDIR/monet-daylight"
        return
    fi
    hour=$((10#$(date +%H)))
    if [ "$hour" -ge "$DAY_FROM" ] && [ "$hour" -lt "$DAY_UNTIL" ]; then
        echo mist
    else
        echo smoke
    fi
}

# The glass, as Monet Settings' Glass slider has it (Light & Wallpaper): clear,
# frosted, matte or solid (0.9.3 kept true or false). Until it's chosen there,
# solid when nothing but the processor draws the screen (a virtual machine, or a
# graphics driver that didn't load): blurring there makes everything lag.
glass() {
    case "$(sed -n 's/.*"glass": *"\{0,1\}\([a-z]*\).*/\1/p' "$CONFIG/monet/prefs.json" 2>/dev/null)" in
        clear|true) echo clear ;;
        frosted) echo frosted ;;
        matte) echo matte ;;
        solid|false) echo solid ;;
        *) if drawn_by_processor; then echo solid; else echo clear; fi ;;
    esac
}

# A setting from the person's own file: ini FILE GROUP... KEY (a name in ~/.config, or a path).
# kreadconfig6 took a fifth of a second each, and Mist to Smoke read a dozen (found by the test
# bench); Monet's own defaults in /etc/xdg read as nothing, which apply() takes as Monet's.
ini() {
    local file="$1" key="${!#}" header="" group
    shift
    for group in "${@:1:$#-1}"; do header="$header[$group]"; done
    case "$file" in /*) ;; *) file="$CONFIG/$file" ;; esac
    awk -v h="$header" -v k="$key" '
        /^\[/ { inside = ($0 == h); next }
        inside { i = index($0, "="); if (i > 1 && substr($0, 1, i - 1) == k) v = substr($0, i + 1) }
        END { printf "%s", v }' "$file" 2>/dev/null
}

# Monet's glass app style (Kvantum), if KDE took it away: applying a global theme (KDE's Light
# and Dark buttons) put Qt's plain Windows style in every window and menu, and nothing brought
# Monet's back (found by the owner). A style set in someone's own file stays theirs.
keep_app_style() {
    [ -n "$(ini kdeglobals KDE widgetStyle)" ] && return 0
    [ "$(ini kdedefaults/kdeglobals KDE widgetStyle)" = kvantum ] && return 0
    local plugin here=no
    for plugin in /usr/lib*/qt6/plugins/styles/libkvantum.so /usr/lib*/*/qt6/plugins/styles/libkvantum.so; do
        [ -e "$plugin" ] && here=yes
    done
    [ "$here" = yes ] || return 0
    kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle kvantum
    # Open windows take it at once: KDE's own notice that the style changed (StyleChanged).
    busctl --user emit /KGlobalSettings org.kde.KGlobalSettings notifyChange ii 2 0 >/dev/null 2>&1
}

drawn_by_processor() {
    busctl --user call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null |
        grep -q -E 'OpenGL renderer string: (llvmpipe|softpipe)|Compositing Type: QPainter'
}

# So can The Hours: then the painting stays instead of drifting with the day.
drifts() {
    grep -q '"hours": false' "$CONFIG/monet/prefs.json" 2>/dev/null && echo off || echo on
}

# The painting: through the whole day, dawn to night, whatever Mist or Smoke the colors keep
# (people wanted the day and the seasons on the wall with the colors they picked; Mist kept
# to dawn and day before, Smoke to dusk and night), or, when it stays, the light that goes
# with them. The wallpaper's lights start at 5, 10, 17 and 21.
painting() {
    local chosen hour
    chosen="$(choice)"
    if [ "$(drifts)" = on ]; then
        echo hours
        return
    fi
    case "$chosen" in
        mist) echo day ;;
        smoke) echo night ;;
        *)
            hour=$((10#$(date +%H)))
            if [ "$hour" -ge "$DAY_FROM" ] && [ "$hour" -lt 10 ]; then
                echo dawn
            elif [ "$hour" -ge 10 ] && [ "$hour" -lt "$DAY_UNTIL" ]; then
                echo day
            elif [ "$hour" -ge "$DAY_UNTIL" ] && [ "$hour" -lt 21 ]; then
                echo dusk
            else
                echo night
            fi
            ;;
    esac
}

# Which of Monet's series is on the wall (Monet Settings, Light & Wallpaper):
# The Hours, Water Lilies, Haystacks or The Magpie, each in the same four lights, one
# for each season, as Monet painted them (seasons), or a photo of yours, painted in the
# same four lights (monet-paint), while it's there.
PHOTO="${XDG_DATA_HOME:-$HOME/.local/share}/monet/paintings/photo"
series() {
    case "$(sed -n 's/.*"series": *"\([a-z]*\)".*/\1/p' "$CONFIG/monet/prefs.json" 2>/dev/null)" in
        lilies) echo lilies ;;
        haystacks) echo haystacks ;;
        magpie) echo magpie ;;
        seasons) season_series ;;
        photo) if [ -f "$PHOTO/night.jpg" ]; then echo photo; else echo hours; fi ;;
        *) echo hours ;;
    esac
}

# The Hours in spring, Water Lilies in summer, Haystacks in autumn, The Magpie
# in winter; south of the equator (a place whose latitude is below zero) half
# a year on.
season_series() {
    local month
    month=$((10#$(date +%m)))
    case "$(place)" in -*) month=$(( (month + 5) % 12 + 1 )) ;; esac
    case "$month" in
        6|7|8) echo lilies ;;
        9|10|11) echo haystacks ;;
        12|1|2) echo magpie ;;
        *) echo hours ;;
    esac
}

# Where the PC is, for The Hours' sunrise and sunset and its weather ("59.33,18.07").
place() {
    "$LIBEXECDIR/monet-quick" place 2>/dev/null | grep -E '^-?[0-9.]+,-?[0-9.]+$' || true
}

# Whether the weather shows on the painting (Light & Wallpaper): on until turned off.
weather() {
    grep -q '"weather": false' "$CONFIG/monet/prefs.json" 2>/dev/null && echo false || echo true
}

# On every screen's desktop and on the lock screen. Only when something about it changed
# since this Plasma last had it: reloading it held up the bar and Settings for two seconds at
# every Mist and Smoke (found by the test bench).
# Asked for the painting by name (Settings' Light & Wallpaper, "Put back"), a desktop that wears
# another wallpaper since (picked in KDE's dialog) gets Monet's again: choosing one did nothing.
paint() {
    local wall="${1:-}" name set where sky said these
    name="$(painting)"
    set="$(series)"
    where="$(place)"
    sky="$(weather)"
    said="${XDG_RUNTIME_DIR:-/tmp}/monet-painted"
    these="$(pgrep -o -x plasmashell) $name $set $where $sky"
    [ "$wall" != wall ] && [ "$(cat "$said" 2>/dev/null)" = "$these" ] && return 0
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Painting "$name"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Series "$set"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Place "$where"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key Weather "$sky"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.monet.hours \
        --group General --key PhotoFolder "file://$PHOTO/"
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "
        desktops().forEach(function (d) {
            if (d.wallpaperPlugin !== 'org.monet.hours') {
                if ('$wall' !== 'wall') return;
                d.wallpaperPlugin = 'org.monet.hours';
            }
            d.currentConfigGroup = ['Wallpaper', 'org.monet.hours', 'General'];
            d.writeConfig('Painting', '$name');
            d.writeConfig('Series', '$set');
            d.writeConfig('Place', '$where');
            d.writeConfig('Weather', $sky);
            d.writeConfig('PhotoFolder', 'file://$PHOTO/');
            d.reloadConfig();
        });
        desktops().forEach(function (d) {
            d.widgets('org.monet.placard').forEach(function (w) {
                w.currentConfigGroup = ['General'];
                w.writeConfig('Series', '$set');
            });
        })" >/dev/null 2>&1 && printf '%s' "$these" >"$said"
}

# One change at a time: quick hours-mist-smoke taps repaint once each, in
# order, and sync waits until a change in progress has finished.
lock() {
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/monet-light.lock"
    flock 9
}

apply() {
    local light scheme kvantum style theme current
    keep_app_style
    light="$(now)"
    if [ "$light" = mist ]; then
        scheme=MonetLight kvantum=Monet theme=$MIST_THEME
    else
        scheme=MonetDark kvantum=MonetDark theme=$SMOKE_THEME
    fi
    style=monet
    local level flag strength=3 noise=0
    level="$(glass)"
    case "$level" in
        matte) kvantum="${kvantum}Matte" style=monet-matte strength=12 noise=5 ;;
        frosted) strength=8 noise=3 ;;
        solid) kvantum="${kvantum}Solid" style=monet-solid ;;
    esac
    # Monet's desktop widgets look for these: with glass-off they don't frost the
    # painting live, the heaviest thing on an old PC's screen; frosted and matte
    # soften it more and wash more over it. Only what changed, so they don't flicker.
    mkdir -p "$CONFIG/monet"
    for flag in off frosted matte; do
        case "$level/$flag" in
            solid/off|frosted/frosted|matte/matte) [ -e "$CONFIG/monet/glass-$flag" ] || : > "$CONFIG/monet/glass-$flag" ;;
            *) rm -f "$CONFIG/monet/glass-$flag" ;;
        esac
    done
    # KWin's blur behind the panels, popovers and see-through windows: clear as Apple's glass
    # (the strokes still show, about as softened as through the desktop widgets), or frosted
    # and matte with a fine grain, as etched glass has.
    if [ "$(ini kwinrc Effect-blur BlurStrength)" != "$strength" ] ||
        [ "$(ini kwinrc Effect-blur NoiseStrength)" != "$noise" ]; then
        kwriteconfig6 --file kwinrc --group Effect-blur --key BlurStrength "$strength"
        kwriteconfig6 --file kwinrc --group Effect-blur --key NoiseStrength "$noise"
        busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects reconfigureEffect s blur >/dev/null 2>&1
    fi
    # And the blur there at all: KWin may leave it out until it starts again, and the glass
    # is then as clear as a window (found by the test bench).
    [ "$level" = solid ] || busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects loadEffect s blur >/dev/null 2>&1

    # KDE's settings show Light or Dark to match (first, so sync sees it).
    current="$(ini kdeglobals KDE LookAndFeelPackage)"
    case "$current" in
        ""|"$MIST_THEME"|"$SMOKE_THEME")
            [ "$current" = "$theme" ] || kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$theme"
            ;;
    esac

    # Only change what's Monet's: someone who picked their own colors keeps them.
    current="$(ini kdeglobals General ColorScheme)"
    case "$current" in
        ""|MonetLight|MonetDark)
            # (Each tool below takes a moment to start, so the colors, the app style, the
            # frames and the terminal change side by side, and apply waits for them all.)
            if [ "$current" != "$scheme" ] && command -v plasma-apply-colorscheme >/dev/null; then
                plasma-apply-colorscheme "$scheme" >/dev/null 2>&1 &
            fi
            ;;
    esac

    current="$(ini plasmarc Theme name)"
    case "$current" in
        ""|monet|monet-matte|monet-solid)
            if [ "$current" != "$style" ] && command -v plasma-apply-desktoptheme >/dev/null; then
                plasma-apply-desktoptheme "$style" >/dev/null 2>&1
            fi
            ;;
    esac

    local kvconfig="$CONFIG/Kvantum/kvantum.kvconfig"
    current="$(ini "$kvconfig" General theme)"
    case "$current" in
        ""|Monet|MonetDark|MonetMatte|MonetDarkMatte|MonetSolid|MonetDarkSolid)
            if [ "$current" != "$kvantum" ]; then
                mkdir -p "$CONFIG/Kvantum"
                kwriteconfig6 --file "$kvconfig" --group General --key theme "$kvantum" &
            fi
            ;;
    esac

    # Window frames, mist or smoke, glass, matte or solid.
    local frame=__aurorae__svg__Monet
    [ "$light" = smoke ] && frame="${frame}Smoke"
    [ "$style" = monet-solid ] && frame="${frame}Solid"
    [ "$style" = monet-matte ] && frame="${frame}Matte"
    current="$(ini kwinrc org.kde.kdecoration2 theme)"
    case "$current" in
        __aurorae__svg__Monet*)
            if [ "$current" != "$frame" ]; then
                { kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "$frame"
                  busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1; } &
            fi
            ;;
    esac

    local profile="${XDG_DATA_HOME:-$HOME/.local/share}/konsole/Monet.profile" colors="${kvantum%Solid}"
    colors="${colors%Matte}"
    if [ -f "$profile" ]; then
        current="$(ini "$profile" Appearance ColorScheme)"
        case "$current" in
            ""|Monet|MonetDark) [ "$current" = "$colors" ] || kwriteconfig6 --file "$profile" --group Appearance --key ColorScheme "$colors" & ;;
        esac
    fi

    # GTK apps (Flatpak ones too: monet-look lets them read these) in the
    # same light. KDE's own gtk.css, only its imports (its colors, and for
    # GTK 4 its window shape), becomes Monet's (which imports them too); a
    # gtk.css someone wrote is left alone.
    local gtk=light version src dir written digest owned
    case "$kvantum" in *Dark*) gtk=dark ;; esac
    for version in 3.0 4.0; do
        src="$DATADIR/monet/gtk/gtk-$version/$gtk.css"
        dir="$CONFIG/gtk-$version"
        [ -f "$src" ] || continue
        written="$CONFIG/monet/gtk-$version-written"
        digest="$(sha256sum "$dir/gtk.css" 2>/dev/null | cut -d ' ' -f 1)"
        owned=no
        if [ -n "$digest" ] && { [ "$digest" = "$(cat "$written" 2>/dev/null)" ] ||
            cmp -s "$dir/gtk.css" "$DATADIR/monet/gtk/gtk-$version/light.css" ||
            cmp -s "$dir/gtk.css" "$DATADIR/monet/gtk/gtk-$version/dark.css"; }; then owned=yes; fi
        # A Monet header alone is not proof: someone may have added their own CSS.
        if [ ! -e "$dir/gtk.css" ] || [ "$owned" = yes ] || {
            grep -q "^@import 'colors.css';\$" "$dir/gtk.css" &&
            ! grep -qv -e '^[[:space:]]*$' -e "^@import 'colors.css';\$" -e "^@import 'kde_window_geometry.css';\$" "$dir/gtk.css"; }; then
            [ -L "$dir/gtk.css" ] && continue
            if cmp -s "$src" "$dir/gtk.css" || { mkdir -p "$dir" && cp "$src" "$dir/gtk.css"; }; then
                mkdir -p "$CONFIG/monet"
                sha256sum "$src" | cut -d ' ' -f 1 > "$written.tmp" && mv -f "$written.tmp" "$written"
            fi
        fi
    done
    wait
    # Plasma 6.7 ignores a StyleChanged notice when the style name is unchanged.
    # Kvantum's two supported styles recreate it on Mist/Smoke transitions, after
    # the palette and theme writes finish. Explicit non-Monet themes stay theirs.
    case "$(ini "$kvconfig" General theme)" in
        Monet|MonetDark|MonetMatte|MonetDarkMatte|MonetSolid|MonetDarkSolid)
            local app_style=kvantum
            [ "$light" = smoke ] && app_style=kvantum-dark
            current="$(ini kdeglobals KDE widgetStyle)"
            case "$current" in
                ""|kvantum|Kvantum|kvantum-dark)
                    if [ "$current" != "$app_style" ]; then
                        kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle "$app_style" &&
                            busctl --user emit /KGlobalSettings org.kde.KGlobalSettings notifyChange ii 2 0 >/dev/null 2>&1
                    fi
                    ;;
            esac
            ;;
    esac
}

# Someone picked Light or Dark in KDE's settings (or a Monet global theme):
# that's a choice of Mist or Smoke, so keep it instead of following the hours.
sync() {
    local picked
    # Whatever KDE's buttons picked, the glass app style stays.
    keep_app_style
    # KDE's Automatic is Monet's Follow the hours, and only Monet switches.
    if [ "$(ini kdeglobals KDE AutomaticLookAndFeel)" = true ]; then
        kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel false
        mkdir -p "$(dirname "$CHOICE")"
        echo hours > "$CHOICE"
        apply
        paint
        return 0
    fi
    case "$(ini kdeglobals KDE LookAndFeelPackage)" in
        "$MIST_THEME") picked=mist ;;
        "$SMOKE_THEME") picked=smoke ;;
        *) return 0 ;;
    esac
    # Monet set it itself a moment ago: nothing was picked.
    [ "$picked" = "$(now)" ] && return 0
    mkdir -p "$(dirname "$CHOICE")"
    echo "$picked" > "$CHOICE"
    apply
    paint
}

# Plein-air focus (the Timer): The Hours goes from dawn to night between the two
# times, so the light shows the time passing without a clock.
focus() {
    case "$1" in
        ""|[0-9]*,[0-9]*) ;;
        *) return 1 ;;
    esac
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "
        desktops().forEach(function (d) {
            if (d.wallpaperPlugin !== 'org.monet.hours') return;
            d.currentConfigGroup = ['Wallpaper', 'org.monet.hours', 'General'];
            d.writeConfig('Focus', '$1');
            d.reloadConfig();
        })" >/dev/null 2>&1
}

case "${1:-apply}" in
    auto)
        # The timer does almost no work between transitions. Manual choices and
        # custom color schemes stay untouched; full theme application runs only
        # when the sun crosses the horizon.
        [ "$(choice)" = hours ] || exit 0
        lock
        case "$(now)/$(ini kdeglobals General ColorScheme)" in
            mist/MonetDark|smoke/MonetLight) apply ;;
        esac
        ;;
    focus)
        focus "${2:-}"
        ;;
    apply)
        lock
        apply
        ;;
    set)
        case "${2:-}" in
            hours|mist|smoke) ;;
            *) echo "Choose hours, mist or smoke." >&2; exit 1 ;;
        esac
        lock
        mkdir -p "$(dirname "$CHOICE")"
        echo "$2" > "$CHOICE"
        apply
        paint
        ;;
    paint)
        lock
        apply
        paint "${2:-}"
        ;;
    sync)
        lock
        sync
        ;;
    get)
        echo "$(choice) $(now)"
        ;;
    *)
        sed -n '2,10p' "$0"
        exit 1
        ;;
esac
