#!/usr/bin/python3
"""On-demand Files actions. No index, background service or downloaded-code execution."""
import gettext
import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys
import time
import uuid

DATADIR = "@DATADIR@"
WORDS = gettext.translation("monet", localedir=f"{DATADIR}/locale", fallback=True)


def tr(text, *args):
    text = WORDS.gettext(text)
    for number, value in reversed(list(enumerate(args, 1))):
        text = text.replace(f"%{number}", str(value))
    return text


def drive_space(path):
    """The selected filesystem's capacity, not a recursive folder-size calculation."""
    path = Path(path).resolve(strict=True)
    info = os.statvfs(path)
    return dict(path=str(path), total=info.f_blocks * info.f_frsize,
                used=(info.f_blocks - info.f_bfree) * info.f_frsize,
                free=info.f_bavail * info.f_frsize,
                reserved=max(0, info.f_bfree - info.f_bavail) * info.f_frsize,
                readonly=bool(info.f_flag & os.ST_RDONLY))


def scan_apps(folder, max_entries=6000, max_depth=6, seconds=2.0):
    """Bounded breadth-first search. Desktop commands are naming hints, never executed.

    Follow file links only within the selected folder; never traverse directory links.
    Deduplicate wrapper links, favour launchers over their bundled helper processes.
    """
    root = Path(folder).resolve(strict=True)
    if not root.is_dir():
        raise ValueError(tr("Choose a folder to search."))
    deadline = time.monotonic() + seconds
    pending, candidates, hints = [(root, 0)], [], {}
    seen, limited, unreadable = 0, False, False
    skipped = {".git", ".cache", ".venv", "node_modules", "__pycache__"}
    while pending and seen < max_entries and time.monotonic() < deadline:
        directory, depth = pending.pop(0)
        try:
            with os.scandir(directory) as entries:
                for entry in entries:
                    if seen >= max_entries or time.monotonic() >= deadline:
                        limited = True
                        break
                    seen += 1
                    path = Path(entry.path)
                    if entry.is_dir(follow_symlinks=False):
                        if entry.name in skipped:
                            continue
                        if depth < max_depth:
                            pending.append((path, depth + 1))
                        else:
                            limited = True
                        continue
                    # stat follows a file link, but resolved containment is checked first.
                    try:
                        resolved = path.resolve(strict=True)
                        if not resolved.is_relative_to(root) or not stat.S_ISREG(resolved.stat().st_mode):
                            continue
                        suffix = path.suffix.lower()
                        executable = os.access(path, os.X_OK)
                        if suffix == ".desktop":
                            if path.stat().st_size > 65536:
                                continue
                            fields, inside = {}, False
                            for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                                if line.startswith("["):
                                    inside = line == "[Desktop Entry]"
                                elif inside and "=" in line:
                                    key, value = line.split("=", 1)
                                    fields.setdefault(key, value)
                            command = shlex.split(fields.get("Exec", ""))
                            if fields.get("Type") == "Application" and command and fields.get("Name"):
                                # A basename can identify the app, but no arguments, shell
                                # expressions, MIME handlers or permissions are imported.
                                hints[Path(command[0]).name.casefold()] = fields["Name"][:128]
                            continue
                        if not executable and suffix not in {".exe", ".msi", ".appimage"}:
                            continue
                        if ".so" in path.name or path.name.startswith("."):
                            continue
                        with path.open("rb") as stream:
                            header = stream.read(4)
                        if suffix == ".exe" and header[:2] == b"MZ" or suffix == ".msi" and header == b"\xd0\xcf\x11\xe0":
                            kind = "windows"
                        elif header == b"\x7fELF" or header[:2] == b"#!":
                            kind = "native" if executable else "permission"
                        else:
                            continue
                        candidates.append(dict(path=str(path), target=str(resolved), name=path.name,
                                               relative=str(path.relative_to(root)), kind=kind))
                    except (OSError, ValueError, RuntimeError):
                        unreadable = True
        except OSError:
            unreadable = True
    limited = limited or bool(pending)
    for candidate in candidates:
        path = Path(candidate["path"])
        hint = hints.get(path.name.casefold())
        candidate["name"] = hint or path.stem
        candidate["score"] = (100 if hint else 0) + (40 if path.parent.name == "bin" else 0)
        candidate["score"] += 20 if path.parent == root else 0
        if any(word in path.name.casefold() for word in ("crashpad", "chrome-sandbox", "uninstall", "unins0")):
            candidate["score"] -= 100
    candidates.sort(key=lambda item: (-item["score"], item["name"].casefold(), item["relative"]))
    unique = {}
    recommended_names = set()
    for candidate in candidates:
        unique.setdefault(candidate.pop("target"), candidate)
    items = list(unique.values())
    for item in items:
        name = item["name"].casefold()
        item["recommended"] = item["score"] >= 100 and name not in recommended_names
        if item["recommended"]: recommended_names.add(name)
    return dict(items=items[:100], limited=limited or len(items) > 100, unreadable=unreadable, visited=seen)


def quick_helper():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader("monet_quick", str(Path(__file__).resolve().with_name("monet-quick")))
    quick = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(quick)
    return quick


def archive_name(path):
    """A suggested name without touching the archive's filesystem."""
    name = Path(path).name
    for suffix in ('.tar.gz', '.tar.bz2', '.tar.xz', '.tar.zst', '.tar.lz', '.tar.lzma',
                   '.rpm', '.tgz', '.tbz2', '.txz', '.zip', '.tar', '.7z', '.rar', '.gz', '.bz2', '.xz', '.zst'):
        if name.lower().endswith(suffix):
            name = name[:-len(suffix)]
            break
    if not name or name in {'.', '..'}:
        name = tr("Extracted files")
    return name


def archive_destination(path, parent=None):
    """Suggest an unused folder, without creating or replacing anything."""
    path = Path(path).resolve(strict=True)
    if not path.is_file():
        raise ValueError(tr("Choose an archive to extract."))
    name = archive_name(path)
    for index in range(1, 1001):
        candidate = Path(parent or path.parent) / (name if index == 1 else f'{name} ({index})')
        if not candidate.exists() and not candidate.is_symlink():
            return candidate
    raise ValueError(tr("Choose another folder for the extracted files."))


def file_jobs_module():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader('monet_file_jobs', str(Path(__file__).resolve().with_name('monet-file-jobs')))
    module = module_from_spec(spec_from_loader(loader.name, loader)); loader.exec_module(module)
    return module


def extraction_task(request, emit):
    """Run filesystem preparation/extraction only in the disposable worker.

    Standard output is a bounded JSON-lines protocol. Ark keeps its own native
    password/error dialogs; its output cannot be mistaken for protocol messages.
    The GUI can stop this process group even during a slow filesystem lookup.
    """
    if (not isinstance(request, dict) or request.get('action') not in {'info', 'extract'}
            or not isinstance(request.get('source'), str) or len(request['source']) > 8192
            or not Path(request['source']).is_absolute()):
        raise ValueError(tr("Choose an archive to extract."))
    source = Path(request['source']).resolve(strict=True)
    if not source.is_file():
        raise ValueError(tr("Choose an archive to extract."))
    if request['action'] == 'info':
        parent = source.parent if request.get('findApps') else quick_helper().desktop_dir()
        if not request.get('findApps'): parent.mkdir(parents=True, exist_ok=True)
        emit(dict(state='info', source=str(source), destination=str(archive_destination(source, parent))))
        return
    raw = request.get('destination')
    if not isinstance(raw, str) or not 1 <= len(raw) <= 8192 or not Path(raw).is_absolute():
        raise ValueError(tr("Choose a full path for a new folder."))
    target = Path(raw)
    if request.get('dropped'):
        if not target.is_dir(): raise ValueError(tr("Drop a destination folder, not a file."))
        target = archive_destination(source, target)
    if target.name in {'', '.', '..'}:
        raise ValueError(tr("Choose a full path for a new folder."))
    target = target.parent.resolve(strict=True) / target.name
    if request.get('background'):
        queue = file_jobs_module().Queue()
        job = queue.submit(source, target, token=request.get('token'))
        emit(dict(state='prepared', destination=job['destination'], identity=job['destinationIdentity']))
        try: queue.launch(job['token'])
        except OSError:
            queue.change(job['token'], state='failed', error=tr("Extraction could not start. Retry uses a new folder."))
            raise
        emit(dict(state='queued', destination=job['destination'], identity=job['destinationIdentity']))
        return
    target.mkdir(mode=0o755)  # Atomic reservation; never reuse an existing folder.
    info = target.lstat()
    if not stat.S_ISDIR(info.st_mode):
        raise ValueError(tr("The extraction folder changed or its drive disconnected. Choose a new folder and retry."))
    identity = (info.st_dev, info.st_ino)
    def same_folder():
        try:
            current = target.lstat()
            return stat.S_ISDIR(current.st_mode) and (current.st_dev, current.st_ino) == identity
        except OSError: return False
    emit(dict(state='prepared', destination=str(target), identity=identity))
    try:
        # Inherit the worker's private process group so cancellation also stops
        # extractor descendants. Durable queue jobs deliberately detach instead.
        result = subprocess.run(['ark', '--batch', '--destination', str(target), str(source)], cwd=target,
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            if not same_folder():
                raise ValueError(tr("The extraction folder changed or its drive disconnected. Choose a new folder and retry."))
            emit(dict(state='done', destination=str(target), identity=identity))
            return
        error = (tr("Extraction cancelled. Partial files were kept; retry in a new folder.") if result.returncode == 130 else
                 tr("Extraction did not finish. You can inspect any extracted files in Files, or retry in a new folder."))
    except OSError as problem:
        error = tr("Extraction did not finish. You can inspect any extracted files in Files, or retry in a new folder.") + '\n' + str(problem)
    available = same_folder()
    if available:
        try: target.rmdir(); available = False  # Removes only an empty, unchanged reservation.
        except OSError: pass
    emit(dict(state='failed', error=error, destination=str(target) if available else '', identity=identity))


def cancel_extraction_submission(token):
    """Called after the submitting process exits, never on the GUI thread."""
    if not re.fullmatch(r'[a-f0-9]{32}', token): raise ValueError('Invalid transfer')
    queue = file_jobs_module().Queue()
    try:
        with queue.lock(token, worker=True, blocking=False):
            job = queue.read(token)
            if job['state'] == 'queued':
                queue.change(token, state='cancelled', command='')
                return
    except BlockingIOError: pass
    except FileNotFoundError: return  # Cancelled before the submission committed.
    try: queue.control(token, 'cancel')
    except (FileNotFoundError, ValueError): pass


def make_extract_dialog(path, find_apps=True, background=False):
    from PySide6.QtCore import QEvent, QProcess, QTimer, Qt
    from PySide6.QtGui import QIcon
    from PySide6.QtWidgets import (QApplication, QDialog, QDialogButtonBox, QFileDialog, QFormLayout,
                                  QFrame, QLabel, QLayout, QLineEdit, QProgressBar, QPushButton,
                                  QScrollArea, QStyle, QVBoxLayout, QWidget)
    # No source/destination stat, resolve, mkdir or cleanup runs in this process.
    source = Path(os.path.abspath(os.fspath(path)))
    helper = os.path.abspath(__file__)
    class ExtractDialog(QDialog):
        def __init__(self):
            super().__init__()
            self.buttons = None
            self.details = None
            self.drop = None
            self.observed_screen = None
            self.fit_timer = QTimer(self); self.fit_timer.setSingleShot(True)
            self.fit_timer.timeout.connect(self.fit_screen)
            self.focus_timer = QTimer(self); self.focus_timer.setSingleShot(True)
            self.focus_timer.timeout.connect(self.reveal_focus)
            QApplication.instance().focusChanged.connect(self.queue_reveal)

        def queue_reveal(self, *args):
            self.focus_timer.start(0)

        def reveal_focus(self):
            focus = QApplication.focusWidget()
            if self.isVisible() and self.details is not None and focus is not None and self.details.isAncestorOf(focus):
                self.details.ensureWidgetVisible(focus)

        def watch_screen(self, screen):
            if self.observed_screen is not None:
                try: self.observed_screen.availableGeometryChanged.disconnect(self.queue_fit)
                except (RuntimeError, TypeError): pass
            self.observed_screen = screen
            if screen is not None: screen.availableGeometryChanged.connect(self.queue_fit)
            self.queue_fit()

        def queue_fit(self, *args):
            self.fit_timer.start(0)

        def fit_screen(self):
            if self.buttons is None or self.isMinimized() or self.isMaximized() or self.isFullScreen(): return
            area = self.screen().availableGeometry()
            if area.isEmpty(): return
            width = max(1, area.width() - 32); height = max(1, area.height() - 48)
            if self.drop is not None: self.drop.setMinimumHeight(64 if min(self.height(), height) < 400 else 100)
            # Preserve full native button captions. A narrow dialog uses a
            # vertical button box; only the details above it scroll.
            spacing = max(12, self.style().pixelMetric(QStyle.PM_LayoutHorizontalSpacing))
            buttons = self.buttons.buttons()
            row_width = sum(button.sizeHint().width() for button in buttons) + spacing * (len(buttons) + 1)
            self.buttons.setOrientation(Qt.Vertical if row_width > min(self.width(), width) - 40 else Qt.Horizontal)
            self.setMaximumSize(width, height)
            self.resize(min(self.width(), width), min(self.height(), height))

        def changeEvent(self, event):
            super().changeEvent(event)
            if hasattr(self, 'fit_timer') and event.type() in (QEvent.FontChange, QEvent.StyleChange):
                self.queue_fit()

        def showEvent(self, event):
            if self.observed_screen is None:
                self.windowHandle().screenChanged.connect(self.watch_screen)
                self.watch_screen(self.screen())
            self.fit_screen()
            super().showEvent(event)

        def resizeEvent(self, event):
            super().resizeEvent(event)
            self.queue_fit()

    dialog = ExtractDialog(); dialog.setWindowTitle(tr("Extract and find applications") if find_apps else tr("Extract archive"))
    dialog.setWindowIcon(QIcon.fromTheme("package-x-generic")); dialog.resize(620, 400)
    dialog.extracted = None
    outer = QVBoxLayout(dialog); outer.setContentsMargins(20, 20, 20, 20); outer.setSpacing(12)
    outer.setSizeConstraint(QLayout.SetNoConstraint)
    class DetailsArea(QScrollArea):
        def wheelEvent(self, event):
            # Native Widgets handles detents; keep precise touchpad pixels too.
            # A manual scroll cancels a queued focus reveal.
            dialog.focus_timer.stop()
            pixels = event.pixelDelta()
            if not pixels.isNull():
                bar = self.verticalScrollBar() if pixels.y() else self.horizontalScrollBar()
                bar.setValue(bar.value() - (pixels.y() if pixels.y() else pixels.x()))
                event.accept()
            elif event.angleDelta().isNull() and event.phase() != Qt.NoScrollPhase:
                event.accept()
            else: super().wheelEvent(event)

    scroll = DetailsArea(); dialog.details = scroll
    scroll.setObjectName('extractDetails'); scroll.setWidgetResizable(True)
    scroll.setFrameShape(QFrame.NoFrame); outer.addWidget(scroll, 1)
    body = QWidget(); scroll.setWidget(body)
    layout = QVBoxLayout(body); layout.setContentsMargins(0, 0, 0, 0); layout.setSpacing(12)
    for text in ((tr("Extract into a new folder, then choose which application to add to the menu.") if find_apps
                  else tr("Choose where to put the extracted files. A new folder keeps them together.")), str(source)):
        label = QLabel(text); label.setTextFormat(Qt.PlainText); label.setWordWrap(True); layout.addWidget(label)

    class FolderDrop(QFrame):
        def folder(self, event):
            urls = event.mimeData().urls()
            if len(urls) == 1 and urls[0].isLocalFile():
                return urls[0].toLocalFile()
            return None

        def dragEnterEvent(self, event):
            # Directory validation happens in the worker after a drop. A local
            # URL alone cannot tell us its type without touching a slow mount.
            if worker.state() == QProcess.NotRunning and self.folder(event) is not None:
                event.acceptProposedAction()

        def dropEvent(self, event):
            folder = self.folder(event)
            if worker.state() == QProcess.NotRunning and folder is not None:
                event.acceptProposedAction()
                start(folder)

    drop = FolderDrop(); drop.setObjectName('extractDropTarget'); drop.setAcceptDrops(True)
    drop.setFrameShape(QFrame.StyledPanel); drop.setMinimumHeight(100)
    drop_layout = QVBoxLayout(drop)
    hint = QLabel(tr('Drop a destination folder here to extract'))
    hint.setAlignment(Qt.AlignCenter); hint.setWordWrap(True); drop_layout.addWidget(hint)
    drop.setAccessibleName(hint.text()); outer.insertWidget(0, drop); dialog.drop = drop
    form = QFormLayout(); layout.addLayout(form)
    destination = QLineEdit(); destination.setObjectName("extractDestination")
    form.addRow(tr("Extract to:"), destination)
    browse = QPushButton(tr("Choose location…")); layout.addWidget(browse)
    progress = QProgressBar(); progress.setObjectName('extractPreparationProgress'); progress.setRange(0, 0)
    progress.setAccessibleName(tr("Preparing extraction")); layout.addWidget(progress)
    status = QLabel(); status.setObjectName("extractStatus"); status.setTextFormat(Qt.PlainText)
    status.setWordWrap(True); layout.addWidget(status)
    buttons = QDialogButtonBox(QDialogButtonBox.Cancel)
    extract = buttons.addButton(tr("Extract and find applications") if find_apps else tr("Extract"), QDialogButtonBox.AcceptRole)
    extract.setObjectName("extractApps"); extract.setDefault(True)
    show = buttons.addButton(tr("Open folder"), QDialogButtonBox.ActionRole)
    show.setEnabled(False); show.setObjectName("showExtracted")
    outer.addWidget(buttons); dialog.buttons = buttons
    worker = QProcess(dialog); worker.setObjectName("archiveExtractor")
    worker.setUnixProcessParameters(QProcess.UnixProcessFlag.CreateNewSession)
    folder = None
    cancelled = False
    cleanup_started = False
    submission = ''
    submission_environment = None
    response = None
    pending = bytearray()

    def busy(active):
        extract.setEnabled(not active); destination.setEnabled(not active); browse.setEnabled(not active)
        drop.setEnabled(not active); progress.setVisible(active)
        if not active: extract.setDefault(True)

    def choose():
        parent = QFileDialog.getExistingDirectory(dialog, tr("Choose location…"), str(Path(destination.text()).parent))
        if parent:
            destination.setText(str(Path(parent) / archive_name(source)))
    browse.clicked.connect(choose)

    def read():
        nonlocal pending, response, folder
        pending.extend(bytes(worker.readAllStandardOutput()))
        if len(pending) > 65536:
            response = dict(state='failed', error=tr("Extraction did not finish. Try again."))
            worker.kill(); return
        while b'\n' in pending:
            line, _, rest = pending.partition(b'\n'); pending = bytearray(rest)
            try:
                value = json.loads(line)
                if not isinstance(value, dict) or value.get('state') not in {'info','prepared','queued','done','failed'}:
                    raise ValueError('Invalid extraction response')
                target = value.get('destination', '')
                if not isinstance(target, str) or len(target) > 8192 or target and not Path(target).is_absolute():
                    raise ValueError('Invalid extraction destination')
            except (ValueError, UnicodeError):
                response = dict(state='failed', error=tr("Extraction did not finish. Try again.")); worker.kill(); return
            if value['state'] == 'prepared':
                folder = Path(target); destination.setText(target); show.setEnabled(True)
                status.setText(tr("Starting extraction…") if background else tr("Extracting… You may be asked for an archive password."))
            else: response = value
    worker.readyReadStandardOutput.connect(read)
    worker.readyReadStandardError.connect(worker.readAllStandardError)

    def cancel_submission():
        nonlocal cleanup_started
        if not submission or cleanup_started: return
        cleanup_started = True
        # The submitting child has exited before this cancellation helper runs.
        # A late committed job cannot escape cancellation or be created afterward.
        try:
            subprocess.Popen([sys.executable, helper, '--extract-cancel', submission], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             env=submission_environment)
        except OSError: pass

    def finished(code, state):
        nonlocal folder
        read()
        if cancelled:
            cancel_submission(); return
        busy(False)
        value = response or {}
        if code != 0 or state != QProcess.NormalExit:
            value = dict(state='failed', error=tr("Extraction did not finish. Try again."))
        if value.get('state') == 'info':
            destination.setText(value['destination']); status.clear()
        elif value.get('state') in {'done','queued'}:
            dialog.extracted = Path(value['destination']); dialog.accept()
        else:
            folder = Path(value['destination']) if value.get('destination') else None
            show.setEnabled(folder is not None)
            status.setText(value.get('error') or tr("Extraction did not finish. Try again."))
    worker.finished.connect(finished)
    def failed_to_start(error):
        if error != QProcess.FailedToStart: return
        if cancelled: cancel_submission(); return
        busy(False)
        status.setText(tr("Extraction did not finish. Try again.") + '\n' + worker.errorString())
    worker.errorOccurred.connect(failed_to_start)

    def run(request):
        nonlocal response, pending
        response = None; pending = bytearray(); show.setEnabled(False); busy(True)
        payload = json.dumps(request, ensure_ascii=True).encode().hex()
        worker.start(sys.executable, [helper, '--extract-worker', payload])

    def start(dropped=None):
        nonlocal submission, submission_environment, cleanup_started, folder
        if worker.state() != QProcess.NotRunning or cancelled: return
        folder = None
        submission = uuid.uuid4().hex if background else ''
        submission_environment = dict(os.environ); cleanup_started = False
        request = dict(action='extract', source=str(source), destination=dropped or destination.text(),
                       dropped=bool(dropped), background=background, token=submission)
        status.setText(tr("Preparing extraction… You can cancel while the folder is checked."))
        run(request)
    buttons.accepted.connect(lambda: start())
    # QDialog's default Extract button handles Return/Enter. Starting directly
    # from returnPressed too disables that button before the same key reaches
    # QDialog, which can then activate Cancel instead.

    def reveal():
        if folder is not None:
            try: subprocess.Popen(["dolphin", str(folder)], start_new_session=True)
            except OSError as error: status.setText(tr("Couldn't open Files") + "\n" + str(error))
    show.clicked.connect(reveal)

    def cancel():
        nonlocal cancelled
        cancelled = True
        if worker.state() != QProcess.NotRunning:
            pid = worker.processId()
            if pid:
                try: os.killpg(pid, signal.SIGKILL)
                except ProcessLookupError: pass
            worker.kill()
        else: cancel_submission()
        # No waiting, stat or rmdir here: even cancellation stays responsive if
        # the destination has stopped answering. Existing/partial files stay.
    dialog.rejected.connect(cancel)
    buttons.rejected.connect(dialog.reject)
    status.setText(tr("Checking archive…"))
    run(dict(action='info', source=str(source), findApps=find_apps))
    return dialog


def make_shortcut_dialog(path, name=None, parent=None):
    from PySide6.QtCore import Qt
    from PySide6.QtGui import QIcon
    from PySide6.QtWidgets import (QCheckBox, QDialog, QDialogButtonBox, QFormLayout,
                                  QLabel, QLineEdit, QVBoxLayout, QWidget)
    quick = quick_helper()
    path = quick.native_executable(path)
    dialog = QDialog(parent)
    dialog.setWindowTitle(tr("Add to apps"))
    dialog.setWindowIcon(QIcon.fromTheme("application-x-executable"))
    dialog.resize(540, 240)
    dialog.saved_name = ""
    layout = QVBoxLayout(dialog)
    layout.setContentsMargins(20, 20, 20, 20)
    layout.setSpacing(12)
    note = QLabel(tr("Keep the application folder in place.") + "\n\n" + str(path))
    note.setTextFormat(Qt.PlainText); note.setWordWrap(True)
    note.setTextInteractionFlags(Qt.TextSelectableByMouse); layout.addWidget(note)
    form = QFormLayout(); layout.addLayout(form)
    title = QLineEdit(name or path.stem); title.setObjectName("shortcutName")
    form.addRow(tr("Name:"), title)
    advanced = QCheckBox(tr("Launch options")); advanced.setObjectName("launchOptions")
    layout.addWidget(advanced)
    options_box = QWidget(); options_layout = QVBoxLayout(options_box)
    options_layout.setContentsMargins(0, 0, 0, 0)
    arguments = QLineEdit(); arguments.setObjectName("shortcutArguments")
    arguments.setAccessibleName(tr("Launch options")); arguments.setMaxLength(8192)
    options_layout.addWidget(arguments)
    hint = QLabel(tr('Separate options with spaces. Put quotes around values containing spaces.'))
    hint.setWordWrap(True); options_layout.addWidget(hint)
    options_box.hide(); layout.addWidget(options_box)
    advanced.toggled.connect(options_box.setVisible)
    error = QLabel(); error.setObjectName("shortcutError"); error.setTextFormat(Qt.PlainText)
    error.setWordWrap(True); error.hide(); layout.addWidget(error)
    buttons = QDialogButtonBox(QDialogButtonBox.Cancel)
    add = buttons.addButton(tr("Add to apps"), QDialogButtonBox.AcceptRole)
    add.setObjectName("saveShortcut"); add.setDefault(True)
    buttons.rejected.connect(dialog.reject); layout.addWidget(buttons)

    def save():
        if dialog.saved_name:
            return
        try:
            quick.native_shortcut(path, title.text(), arguments=arguments.text() if advanced.isChecked() else "")
        except (OSError, ValueError) as problem:
            error.setText(str(problem)); error.show()
            return
        dialog.saved_name = title.text().strip()
        dialog.accept()
    buttons.accepted.connect(save)
    title.returnPressed.connect(save)
    arguments.returnPressed.connect(save)
    title.selectAll(); title.setFocus()
    return dialog


def make_dialog(mode, path):
    # Qt is loaded only for the short-lived window, never by the scan worker.
    from PySide6.QtCore import QProcess, QTimer, Qt
    from PySide6.QtGui import QIcon
    from PySide6.QtWidgets import (QCheckBox, QDialog, QDialogButtonBox, QFormLayout,
                                  QLabel, QLineEdit, QMessageBox, QProgressBar,
                                  QTreeWidget, QTreeWidgetItem, QVBoxLayout)

    dialog = QDialog()
    dialog.setWindowTitle(tr("Drive space") if mode == "space" else tr("Find applications"))
    dialog.setWindowIcon(QIcon.fromTheme("drive-harddisk" if mode == "space" else "system-file-manager"))
    dialog.resize(560 if mode == "space" else 780, 330 if mode == "space" else 460)
    layout = QVBoxLayout(dialog)
    layout.setContentsMargins(20, 20, 20, 20)
    layout.setSpacing(12)

    def label(text):
        widget = QLabel(text)
        widget.setTextFormat(Qt.PlainText)
        widget.setWordWrap(True)
        widget.setTextInteractionFlags(Qt.TextSelectableByMouse)
        layout.addWidget(widget)
        return widget

    if mode == "space":
        label(tr("Space on the drive containing this folder"))
        location = label(str(Path(path).absolute()))
        bar = QProgressBar(); bar.setObjectName("driveUsage"); layout.addWidget(bar)
        form = QFormLayout(); layout.addLayout(form)
        values = {}
        for key, name in (("free", tr("Available")), ("used", tr("Used")), ("total", tr("Capacity")), ("reserved", tr("Reserved"))):
            value = QLabel(); value.setObjectName("space_" + key)
            values[key] = value; form.addRow(name, value)
        state = label("")
        buttons = QDialogButtonBox(QDialogButtonBox.Close)
        refresh = buttons.addButton(tr("Refresh"), QDialogButtonBox.ActionRole)
        refresh.setObjectName("refreshSpace")
        buttons.rejected.connect(dialog.reject); layout.addWidget(buttons)

        def measure():
            try:
                result = drive_space(path)
                location.setText(result["path"])
                for key, value in values.items():
                    value.setText(tr("%1 GiB", f'{result[key] / 2**30:,.1f}'))
                    value.setToolTip(tr("%1 bytes", f'{result[key]:,}'))
                percent = round(100 * (result["total"] - result["free"]) / max(1, result["total"]))
                bar.setValue(percent); bar.setFormat(tr("%1% occupied", percent))
                state.setText(tr("This drive is read-only.") if result["readonly"] else tr("Available space can be used by your account."))
            except OSError as error:
                bar.setValue(0)
                for value in values.values(): value.setText("—")
                state.setText(tr("The drive is unavailable. Reconnect it and try again.") + "\n" + str(error))
        refresh.clicked.connect(measure)
        measure()
        return dialog

    label(tr("Find an app inside an extracted download, then add it to the menu or show its file."))
    label(str(Path(path).absolute()))
    search = QLineEdit(); search.setPlaceholderText(tr("Filter applications…")); search.setObjectName("filterApps")
    layout.addWidget(search)
    tree = QTreeWidget(); tree.setObjectName("foundApps"); tree.setRootIsDecorated(False)
    tree.setHeaderLabels([tr("Application"), tr("Type"), tr("Location")]); layout.addWidget(tree, 1)
    tree.setColumnWidth(0, 170); tree.setColumnWidth(1, 150)
    helpers = QCheckBox(tr("Show helper executables")); helpers.setObjectName("showHelpers")
    helpers.hide(); layout.addWidget(helpers)
    status = label(tr("Searching this folder…")); status.setObjectName("scanStatus")
    buttons = QDialogButtonBox(QDialogButtonBox.Close)
    add = buttons.addButton(tr("Add to apps…"), QDialogButtonBox.ActionRole); add.setObjectName("addApp")
    show = buttons.addButton(tr("Show in Files"), QDialogButtonBox.ActionRole); show.setObjectName("showApp")
    buttons.rejected.connect(dialog.reject); layout.addWidget(buttons)
    add.setEnabled(False); show.setEnabled(False)

    def selected():
        item = tree.currentItem()
        return item.data(0, Qt.UserRole) if item and not item.isHidden() else None

    def changed():
        item = selected()
        add.setEnabled(bool(item and item["kind"] == "native"))
        show.setEnabled(bool(item))
        show.setToolTip(item["path"] if item else "")
        add.setToolTip(tr("Windows programs use Run in Monet in Files.") if item and item["kind"] == "windows"
                       else tr("Use Properties → Permissions to allow this application to run.") if item and item["kind"] == "permission" else "")
    tree.currentItemChanged.connect(changed)

    def filtered(text):
        for index in range(tree.topLevelItemCount()):
            item = tree.topLevelItem(index)
            detail = item.data(0, Qt.UserRole)
            item.setHidden((helpers.isVisible() and not helpers.isChecked() and not detail["recommended"])
                           or text.casefold() not in " ".join(item.text(i) for i in range(3)).casefold())
        changed()
    search.textChanged.connect(filtered)
    helpers.toggled.connect(lambda _: filtered(search.text()))

    def reveal():
        item = selected()
        if item:
            try:
                subprocess.Popen(["dolphin", "--select", item["path"]], start_new_session=True)
            except OSError as error:
                QMessageBox.warning(dialog, tr("Couldn't open Files"), str(error))
    show.clicked.connect(reveal)
    tree.itemDoubleClicked.connect(reveal)

    def register():
        item = selected()
        if not item or item["kind"] != "native": return
        try:
            editor = make_shortcut_dialog(item["path"], item["name"], dialog)
            accepted = editor.exec() == QDialog.Accepted
            editor.deleteLater()
            if not accepted: return
            # KDE's file watcher rebuilds incrementally; do not block the dialog on a full cache rebuild.
            status.setText(tr("%1 was added to your application menu.", editor.saved_name))
        except (OSError, ValueError) as error:
            QMessageBox.warning(dialog, tr("Couldn't add application"), str(error))
    add.clicked.connect(register)

    worker = QProcess(dialog); worker.setObjectName("appScanner")
    names = {"native": tr("Linux application"), "windows": tr("Windows program"), "permission": tr("Needs permission")}

    def finished(code, _status):
        if code != 0:
            status.setText(tr("Couldn't search this folder. Check that it is available and readable."))
            return
        try:
            result = json.loads(bytes(worker.readAllStandardOutput()))
            for app in result["items"]:
                item = QTreeWidgetItem([app["name"], names[app["kind"]], app["relative"]])
                item.setData(0, Qt.UserRole, app); item.setToolTip(2, app["path"])
                item.setIcon(0, QIcon.fromTheme("application-x-executable")); tree.addTopLevelItem(item)
            helpers.setVisible(any(item["recommended"] for item in result["items"]))
            if tree.topLevelItemCount(): tree.setCurrentItem(tree.topLevelItem(0))
            text = tr("Choose an application. Double-click shows its file without running it.") if result["items"] else tr("No applications found. Extract archives first, or open a folder closer to the application.")
            if result["limited"]: text += "\n" + tr("Search limit reached. Open a more specific folder to find more applications.")
            if result["unreadable"]: text += "\n" + tr("Some files could not be read.")
            status.setText(text); filtered(search.text())
        except (ValueError, KeyError):
            status.setText(tr("Couldn't read the application search results."))
    worker.finished.connect(finished)
    worker.errorOccurred.connect(lambda _: status.setText(tr("Couldn't start the application search.")))
    dialog.finished.connect(worker.kill)
    QTimer.singleShot(0, lambda: worker.start(sys.executable, [str(Path(__file__).resolve()), "--scan", str(Path(path).absolute())]))
    return dialog


def main():
    if len(sys.argv) == 3 and sys.argv[1] == '--open-folder':
        # Compatibility path for generic Linux installs without the native
        # module. Inspect local paths in this child, never in the Plasma GUI.
        from urllib.parse import urlsplit, unquote_to_bytes
        try:
            if len(sys.argv[2]) > 131072: raise ValueError(tr("This transfer has no folder to open."))
            request = json.loads(bytes.fromhex(sys.argv[2])); url = request.get('url')
            if not isinstance(url, str) or len(url) > 32768 or '\x00' in url: raise ValueError(tr("This transfer has no folder to open."))
            parts = urlsplit(url)
            if parts.scheme not in {'file','sftp','smb','ftp','ftps','fish','nfs','mtp','afc','webdav','webdavs','desktop','remote','network'}:
                raise ValueError(tr("This transfer has no folder to open."))
            directory = bool(request.get('directory'))
            if parts.scheme == 'file' and parts.netloc in {'','localhost'}:
                path = Path(os.fsdecode(unquote_to_bytes(parts.path)))
                if not path.is_absolute(): raise ValueError(tr("This transfer has no folder to open."))
                info = path.stat()
                if directory and not stat.S_ISDIR(info.st_mode):
                    raise ValueError(tr("This destination is no longer a folder. Choose it again in Files."))
                directory = stat.S_ISDIR(info.st_mode)
            subprocess.Popen(['dolphin', *([] if directory else ['--select']), url], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(json.dumps(dict(ok=True))); return 0
        except (OSError, ValueError, AttributeError) as error:
            print(json.dumps(dict(ok=False, error=str(error)))); return 1
    if len(sys.argv) == 3 and sys.argv[1] == '--extract-cancel':
        cancel_extraction_submission(sys.argv[2]); return 0
    if len(sys.argv) == 3 and sys.argv[1] == '--extract-worker':
        def emit(value): print(json.dumps(value, ensure_ascii=True), flush=True)
        try:
            if len(sys.argv[2]) > 131072: raise ValueError('Invalid extraction request')
            extraction_task(json.loads(bytes.fromhex(sys.argv[2])), emit)
        except FileExistsError:
            emit(dict(state='failed', error=tr("That folder already exists. Choose a new folder to keep its files unchanged.")))
        except (OSError, ValueError, RuntimeError) as error:
            emit(dict(state='failed', error=str(error)[:8192]))
        return 0
    if len(sys.argv) != 3 or sys.argv[1] not in {"space", "apps", "add", "extract", "unpack", "downloads", "--scan", "--space"}:
        return 2
    mode, path = sys.argv[1:]
    if mode in {"--scan", "--space"}:
        try:
            print(json.dumps(drive_space(path) if mode == "--space" else scan_apps(path), ensure_ascii=False))
            return 0
        except (OSError, ValueError, RuntimeError) as error:
            print(str(error), file=sys.stderr)
            return 1
    from PySide6.QtWidgets import QApplication
    app = QApplication(sys.argv[:1]); app.setApplicationName("monet-files-tools")
    app.setApplicationDisplayName(tr("Files")); app.setDesktopFileName("org.kde.dolphin")
    if mode == 'downloads':
        from PySide6.QtWidgets import QMessageBox
        try:
            target = quick_helper().set_download_path(path)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            QMessageBox.warning(None, tr("Couldn't change download path"), str(error))
            return 1
        QMessageBox.information(None, tr('Download path changed'),
            tr('New downloads will be saved to %1. Restart Browser to use the new location there.', target))
        return 0
    if mode in {"extract", "unpack"}:
        try:
            dialog = make_extract_dialog(path, find_apps=mode == 'extract', background=mode == 'unpack')
        except (OSError, ValueError) as error:
            from PySide6.QtWidgets import QMessageBox
            QMessageBox.warning(None, tr("Couldn't extract archive"), str(error))
            return 1
        if not dialog.exec():
            return 1
        if mode == 'unpack':
            try:
                subprocess.Popen(['@BINDIR@/monet-files', 'transfers'], start_new_session=True)
            except OSError:
                from PySide6.QtWidgets import QMessageBox
                QMessageBox.information(None, tr('Extraction started'), tr('Files opens the result when extraction finishes.'))
            return 0
        path, mode = dialog.extracted, "apps"
        dialog.deleteLater()
    if mode == "add":
        try:
            dialog = make_shortcut_dialog(path)
        except (OSError, ValueError) as error:
            print(str(error), file=sys.stderr)
            return 1
        if dialog.exec():
            print(dialog.saved_name)
            return 0
        return 1
    dialog = make_dialog(mode, path)
    dialog.exec()
    return 0


if __name__ == "__main__":
    sys.exit(main())
