[%General]
author=Monet
comment=Monet's glass for Qt apps: see-through windows with the painting behind them.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=false
mirror_doc_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
scroll_width=10
scroll_arrows=false
scroll_min_extent=36
transient_scrollbar=true
transient_groove=false
slider_width=4
slider_handle_width=18
slider_handle_length=18
center_toolbar_handle=true
check_size=18
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx,obs,haruna,mpv,krita,blender,steam
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
toolbar_interior_spacing=4
combo_as_lineedit=false
combo_menu=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
spin_button_width=18
joined_inactive_tabs=false
remove_extra_frames=true
layout_spacing=6
layout_margin=9
submenu_overlap=0
submenu_delay=250
tooltip_delay=-1
animate_states=true
dark_titlebar=false
hide_combo_checkboxes=true
no_window_pattern=false
reduce_window_opacity=0
reduce_menu_opacity=0
respect_DE=true
scrollbar_in_view=true
tree_branch_line=false
no_inactiveness=false

[GeneralColors]
window.color=#F3F1EC
inactive.window.color=#F3F1EC
base.color=#FBFAF7
inactive.base.color=#FBFAF7
alt.base.color=#F5F3EF
inactive.alt.base.color=#F5F3EF
button.color=#F7F5F1
light.color=#FFFFFF
mid.light.color=#E6E3DD
dark.color=#B9B4AB
mid.color=#D6D2CB
highlight.color=#D3E1DC
inactive.highlight.color=#D3E1DC
tooltip.base.color=#1C1B19
text.color=#1C1B19
inactive.text.color=#1C1B19
window.text.color=#1C1B19
inactive.window.text.color=#1C1B19
button.text.color=#1C1B19
disabled.text.color=#A39D94
tooltip.text.color=#F3F1EC
highlight.text.color=#1F5249
inactive.highlight.text.color=#1F5249
link.color=#357F72
link.visited.color=#8E7CC3
progress.indicator.text.color=#1C1B19

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=60
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
middle_click_scroll=false
no_selection_tint=true
transparent_arrow_button=true
kcapacitybar_as_progressbar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
indicator.size=12
indicator.element=arrow
text.normal.color=#1C1B19
text.focus.color=#1C1B19
text.press.color=#1C1B19
text.toggle.color=#FFFFFF
text.disabled.color=#A39D94
text.shadow=0
text.margin=1
text.iconspacing=6
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_width=+0.5font
min_height=+0.4font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.toggle.color=#1C1B19

[ToolbarButton]
inherits=PanelButtonTool
text.toggle.color=#1C1B19

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color=#1C1B19

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color=#1C1B19

[Focus]
inherits=PanelButtonCommand
frame=false
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4

[ToolboxTab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
text.normal.color=#6B665E
text.focus.color=#1C1B19
text.toggle.color=#1C1B19
text.margin.left=12
text.margin.right=12
text.margin.top=4
text.margin.bottom=4
min_width=+2font
min_height=+0.6font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#6B665E
text.bold=false
text.toggle.color=#1C1B19

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.bold=false
text.normal.color=#1C1B19
text.focus.color=#1C1B19

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.toggle.color=#1F5249
text.press.color=#1F5249
min_height=+0.5font

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.margin.top=0
text.margin.bottom=0
text.margin.left=5
text.margin.right=5
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=4
text.margin.right=4
text.toggle.color=#1C1B19

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.shadow=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12
text.bold=true
text.margin=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
interior=true
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.normal.color=#F3F1EC
text.margin=2

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window

[Dialog]
interior=true
interior.element=dialog
