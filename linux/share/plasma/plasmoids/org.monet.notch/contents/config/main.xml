<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="tabs" type="String"><default>music,activity,time,calendar,notes</default></entry>
        <entry name="wide" type="Bool"><default>false</default></entry>
        <entry name="gestures" type="Bool"><default>true</default></entry>
        <entry name="levels" type="Bool"><default>false</default></entry>
        <entry name="previews" type="Bool"><default>false</default></entry>
        <entry name="companion" type="Bool"><default>false</default></entry>
        <entry name="companionStyle" type="String"><default>soft</default></entry>
        <entry name="companionShape" type="String"><default>round</default></entry>
        <entry name="companionColor" type="String"><default>mint</default></entry>
        <entry name="companionSide" type="String"><default>left</default></entry>
        <entry name="companionVisits" type="String"><default>normal</default></entry>
        <entry name="companionReactions" type="String"><default>on</default></entry>
        <entry name="companionRest" type="String"><default>show</default></entry>
        <entry name="alerts" type="Bool"><default>true</default></entry>
        <entry name="warnedDevices" type="String"><default>{}</default></entry>
        <entry name="deadline" type="String"><default></default></entry>
        <entry name="timerPaused" type="Double"><default>0</default></entry>
        <entry name="focusRound" type="Int"><default>0</default></entry>
        <entry name="timerMinutes" type="Int"><default>25</default><min>1</min><max>1440</max></entry>
        <entry name="focusSessions" type="Int"><default>1</default><min>1</min><max>24</max></entry>
        <entry name="shortBreakMinutes" type="Int"><default>5</default><min>1</min><max>1440</max></entry>
        <entry name="longBreakMinutes" type="Int"><default>15</default><min>1</min><max>1440</max></entry>
        <entry name="longBreakEvery" type="Int"><default>4</default><min>1</min><max>24</max></entry>
        <entry name="focus" type="Bool"><default>false</default></entry>
        <entry name="watchStart" type="String"><default></default></entry>
        <entry name="watchElapsed" type="Double"><default>0</default></entry>
    </group>
</kcfg>
