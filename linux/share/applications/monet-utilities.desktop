[Desktop Entry]
Type=Application
Name=Monet Utilities
Comment=Keep files close, capture your screen and find desktop tools
Icon=applications-utilities
Exec=@LIBEXECDIR@/monet-utilities
Categories=Utility;
Keywords=toolbox;toolkit;notch;
Keywords[sv]=verktygslåda;verktyg;notch;
StartupNotify=true
SingleMainWindow=true
Actions=Search;QuickPanel;Shelf;Scratchpad;Wheel;Microphone;Output;Color;

[Desktop Action Search]
X-KDE-Shortcuts=Meta+Alt+Space
Name=Find a tool
Name[sv]=Hitta ett verktyg
Icon=system-search
Exec=krunner --runner monet-utilities "tools "

[Desktop Action QuickPanel]
Name=Quick Panel
Name[sv]=Snabbpanel
Icon=view-grid
Exec=@LIBEXECDIR@/monet-utilities quick-panel

[Desktop Action Shelf]
Name=File shelf
Icon=folder-favorites
Exec=@LIBEXECDIR@/monet-utilities shelf

[Desktop Action Scratchpad]
Name=Scratchpad
Icon=accessories-text-editor
Exec=@LIBEXECDIR@/monet-utilities notes

[Desktop Action Wheel]
Name=Favorite actions wheel
Icon=view-more
Exec=@LIBEXECDIR@/monet-utilities wheel

[Desktop Action Microphone]
Name=Mute or unmute microphone
Icon=audio-input-microphone
Exec=wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

[Desktop Action Output]
Name=Cycle sound output
Icon=audio-card
Exec=@LIBEXECDIR@/monet-quick cycle-output notify

[Desktop Action Color]
Name=Pick a screen color
Icon=color-picker
Exec=@LIBEXECDIR@/monet-utilities color
