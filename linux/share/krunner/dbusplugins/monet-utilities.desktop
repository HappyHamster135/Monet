[Desktop Entry]
Type=Service
Name=Monet Utilities
Name[sv]=Monet-verktyg
Comment=Find tools and favorite actions
Comment[sv]=Hitta verktyg och favoritåtgärder
Icon=applications-utilities
X-KDE-PluginInfo-Name=monet-utilities
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.monet.ToolSearch
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=3
X-Plasma-Runner-Syntaxes=tools,tools :q:,snippet: :q:,clip: :q:,emoji: :q:,menu: :q:,script: :q:
X-Plasma-Runner-Syntax-Descriptions=Show favorite tools,Find a Monet tool,Copy a saved snippet,Copy text from clipboard history,Find an emoji,Find a command in the active app,Run a saved script
X-Plasma-Runner-Syntaxes[sv]=tools,tools :q:,textsnutt: :q:,urklipp: :q:,emoji: :q:,meny: :q:,skript: :q:
X-Plasma-Runner-Syntax-Descriptions[sv]=Visa favoritverktyg,Hitta ett Monet-verktyg,Kopiera en sparad textsnutt,Kopiera text från urklippshistoriken,Hitta en emoji,Hitta ett kommando i den aktiva appen,Kör ett sparat skript
