[Icon Theme]
Name=Monet
Comment=Painted marks for Monet's own apps, painted folders, Breeze for everything else
Inherits=breeze,hicolor
Example=folder
DisplayDepth=32
Directories=apps/scalable,places/scalable

[apps/scalable]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[places/scalable]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
