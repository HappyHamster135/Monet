[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-7z-compressed;
Actions=extract
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-Monet=true

[Desktop Action extract]
Name=Extract and find applications…
Icon=package-x-generic
Exec=@LIBEXECDIR@/monet-files-tools extract %f
