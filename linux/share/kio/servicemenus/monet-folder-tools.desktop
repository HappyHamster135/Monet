[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=apps;space;downloads;
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-Priority=TopLevel
X-Monet=true

[Desktop Action apps]
Name=Find applications…
Icon=system-search
Exec=@LIBEXECDIR@/monet-files-tools apps %f

[Desktop Action space]
Name=Drive space…
Icon=drive-harddisk
Exec=@LIBEXECDIR@/monet-files-tools space %f

[Desktop Action downloads]
Name=Set as download path
Icon=folder-download
Exec=@LIBEXECDIR@/monet-files-tools downloads %f
