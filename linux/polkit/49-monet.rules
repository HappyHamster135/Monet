// Monet: switching to Windows is one click, like restarting.
// The switch entry point only accepts a game, task and return checkpoint.
polkit.addRule(function(action, subject) {
    var program = action.lookup("program");
    if (action.id == "org.freedesktop.policykit.exec" && program &&
        ["@SWITCH@", "@REAL_SWITCH@"].indexOf(program) >= 0 &&
        subject.local && subject.active && subject.user != "guest") {
        return polkit.Result.YES;
    }
});

// A guest's things go when they sign out: they can't keep their session running after it.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.login1.set-self-linger" && subject.user == "guest") {
        return polkit.Result.NO;
    }
});
