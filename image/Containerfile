# Monet OS: Bazzite (KDE Plasma) with Monet built in, including the Windows
# half that Monet copies into Windows by itself. Two of it, from Bazzite's two
# desktops: NVIDIA's open drivers (GTX 16, RTX 20 and newer: monet), and AMD's
# and Intel's (Mesa, which also drives older NVIDIA cards: monet-amd). Monet
# Setup picks by the PC's graphics.
#
#   podman build -f image/Containerfile -t monet .
#   podman build -f image/Containerfile --build-arg BASE=ghcr.io/ublue-os/bazzite:stable -t monet-amd .

ARG BASE=ghcr.io/ublue-os/bazzite-nvidia-open:stable

FROM docker.io/library/rust:1 AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends mingw-w64 cmake qt6-base-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN rustup toolchain install \
 && rustup target add x86_64-unknown-linux-musl x86_64-pc-windows-gnu \
 && cargo build --release -p monet --target x86_64-unknown-linux-musl \
 && cargo build --release -p monet-bridge --target x86_64-pc-windows-gnu \
 && tools/package.sh linux target/x86_64-unknown-linux-musl/release/monet /out \
        target/x86_64-pc-windows-gnu/release/monet-bridge.exe

# Monet's password prompt: KDE's polkit agent built with Monet's page, against
# the same Plasma as below. If it can't be built, the image keeps KDE's prompt.
FROM ${BASE} AS password
COPY image/password /src/password
RUN mkdir -p /out && { sh /src/password/build.sh /out || rm -rf /out/*; }

FROM ${BASE} AS runtime
# Tools for installing Windows from Monet: splitting Windows' install image
# (wimlib), formatting its partition (ntfsprogs), and boot entries; ntfs-3g's
# probe, which says when Windows' drive is safe to write (its Games folder for
# Steam on both sides); NumPy and Pillow, with which monet-paint paints your photo;
# rsync for the copies on a backup drive; Qt for Python, which Games and the Store are
# written in, as Monet Setup is, and the Store's way to Flatpak (PyGObject). Then the look:
# Kvantum draws Monet's glass app windows, Inter is the reading font, and
# Plymouth's script plugin plays Monet's boot screen; umu-launcher runs Windows programs
# opened in Files through Proton, as Windows games run.
# cryptsetup and tpm2-tss unlock a disk Monet Setup encrypted, with the PC's security chip.
# Carlito and Caladea are as wide as Calibri and Cambria, so Word and PowerPoint files keep their
# lines and pages in the office apps (the image has Liberation for Arial, Times and Courier).
# rclone puts OneDrive in Files (Settings → Storage → OneDrive).
RUN dnf5 -y install wimlib-utils ntfsprogs ntfs-3g dosfstools efibootmgr python3 python3-numpy python3-pillow rsync \
    python3-pyside6 python3-gobject at-spi2-core lz4-libs binutils \
    cryptsetup tpm2-tss rclone \
 && dnf5 -y install --skip-unavailable kvantum rsms-inter-fonts plymouth-plugin-script umu-launcher \
    google-carlito-fonts google-crosextra-caladea-fonts \
 && dnf5 clean all
# The everyday apps, built in rather than downloaded: Photos, Documents, Video,
# Music, Calculator and Archives. Built against the Plasma already here they
# take tens of megabytes (from Flathub they'd bring KDE's runtime, about a
# gigabyte), wear Monet's glass app style, and are there at the first sign-in.
# With them, Files shows pictures of what's in PDFs and videos. No skipping:
# if one can't be installed, the build stops and says which.
RUN dnf5 -y install gwenview okular haruna elisa-player kcalc ark \
        kdegraphics-thumbnailers ffmpegthumbs \
 && dnf5 clean all
# Screenshot's Extract Text (copy the text in a picture, on the PC) reads every
# language Monet speaks: Bazzite has fifteen of them; these are the rest.
RUN dnf5 -y install --skip-unavailable tesseract-langpack-ara tesseract-langpack-dan tesseract-langpack-fin \
        tesseract-langpack-heb tesseract-langpack-hin tesseract-langpack-hun tesseract-langpack-ind \
        tesseract-langpack-kor tesseract-langpack-nor tesseract-langpack-ron tesseract-langpack-swe \
        tesseract-langpack-tha tesseract-langpack-ukr tesseract-langpack-vie \
 && dnf5 clean all
# A fingerprint reader unlocks the screen and answers administrator prompts once a
# finger is set up (Settings → Lock & Privacy). fprintd is Bazzite's already, but
# its sign-in settings leave the fingerprint step out; Bluefin turns it on the same
# way. (The sign-in screen, Plasma Login Manager, can't take a finger yet.)
RUN dnf5 -y install fprintd-pam && dnf5 clean all \
 && { authselect enable-feature with-fingerprint || { echo "fingerprint left off: authselect refused" >&2; authselect current; }; }

# Native build headers require matching util-linux and Brotli libraries. Update the shipped
# runtime first, so adding development packages cannot silently change its ABI.
RUN dnf5 -y upgrade libblkid libmount libuuid libbrotli && dnf5 clean all

# Build the native notification applet against the fully assembled runtime.
# Development packages stay in this stage; a mismatch fails rather than shipping
# a plugin built against libraries absent from the actual image.
FROM runtime AS notifications
COPY image/notifications /src/notifications
RUN sh /src/notifications/build.sh /out

FROM runtime AS editor-recovery
COPY image/editor-recovery /src/editor-recovery
RUN sh /src/editor-recovery/build.sh /out

FROM runtime AS files-recovery
COPY image/files-recovery /src/files-recovery
RUN sh /src/files-recovery/build.sh /out

FROM runtime AS pdf-recovery
COPY image/pdf-recovery /src/pdf-recovery
RUN sh /src/pdf-recovery/build.sh /out

FROM runtime AS window-identity
COPY image/window-identity /src/window-identity
COPY LICENSE /src/window-identity/LICENSE
RUN sh /src/window-identity/build.sh /out

FROM runtime
# Keep version-only changes out of the native library build caches.
ARG VERSION=dev
LABEL org.opencontainers.image.version="${VERSION}" version="${VERSION}" org.opencontainers.image.title="Monet"
COPY --from=pdf-recovery /out /tmp/monet-pdf-recovery
RUN python3 /tmp/monet-pdf-recovery/bundle.py install /tmp/monet-pdf-recovery \
 && rm -rf /tmp/monet-pdf-recovery
COPY --from=files-recovery /out /tmp/monet-files-recovery
RUN python3 /tmp/monet-files-recovery/bundle.py install /tmp/monet-files-recovery \
 && rm -rf /tmp/monet-files-recovery
COPY --from=window-identity /out /tmp/monet-window-identity
RUN python3 /tmp/monet-window-identity/bundle.py install /tmp/monet-window-identity \
 && rm -rf /tmp/monet-window-identity
COPY --from=editor-recovery /out /tmp/monet-editor-recovery
RUN python3 /tmp/monet-editor-recovery/bundle.py install /tmp/monet-editor-recovery \
 && rm -rf /tmp/monet-editor-recovery
COPY --from=notifications /out /tmp/monet-notifications
RUN python3 /tmp/monet-notifications/bundle.py install /tmp/monet-notifications \
 && rm -rf /tmp/monet-notifications
COPY --from=build /out /tmp/monet
COPY --from=password /out /tmp/monet/password
# Monet's boot screen, the same as Monet Setup's: the harbor at dawn with the
# sun breathing, instead of Bazzite's. It lives in the initramfs, so that's
# rebuilt the way Bazzite builds it, with what unlocks an encrypted disk by
# itself (the TPM's libraries, which systemd-cryptsetup asks for there).
COPY image/setup/files/usr/share/plymouth/themes/monet /usr/share/plymouth/themes/monet
RUN /tmp/monet/install.sh --image \
 && rm -rf /tmp/monet \
 && plymouth-set-default-theme monet \
 && kernel="$(dnf5 repoquery --installed --queryformat='%{evr}.%{arch}' kernel)" \
 && dracut --no-hostonly --kver "$kernel" --reproducible --zstd --add ostree --add fido2 --add tpm2-tss -f "/usr/lib/modules/$kernel/initramfs.img" \
 && chmod 0600 "/usr/lib/modules/$kernel/initramfs.img" \
 && ostree container commit
