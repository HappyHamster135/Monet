# Monet OS: Bazzite (KDE Plasma) with Monet built in, including the Windows
# half that Monet copies into Windows by itself. Two of it, from Bazzite's two
# desktops: NVIDIA's open drivers (GTX 16, RTX 20 and newer: monet), and AMD's
# and Intel's (Mesa, which also drives older NVIDIA cards: monet-amd). Monet
# Setup picks by the PC's graphics.
#
#   podman build -f image/Containerfile -t monet .
#   podman build -f image/Containerfile --build-arg BASE=ghcr.io/ublue-os/bazzite:stable -t monet-amd .

ARG BASE=ghcr.io/ublue-os/bazzite-nvidia-open:stable

FROM docker.io/library/rust:1 AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends mingw-w64 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN rustup toolchain install \
 && rustup target add x86_64-unknown-linux-musl x86_64-pc-windows-gnu \
 && cargo build --release -p monet --target x86_64-unknown-linux-musl \
 && cargo build --release -p monet-bridge --target x86_64-pc-windows-gnu \
 && tools/package.sh linux target/x86_64-unknown-linux-musl/release/monet /out \
        target/x86_64-pc-windows-gnu/release/monet-bridge.exe

# Monet's password prompt: KDE's polkit agent built with Monet's page, against
# the same Plasma as below. If it can't be built, the image keeps KDE's prompt.
FROM ${BASE} AS password
COPY image/password /src/password
RUN mkdir -p /out && { sh /src/password/build.sh /out || rm -rf /out/*; }

FROM ${BASE}
# Monet's own version, which updates show ("Monet 0.9.0 is ready"), not Bazzite's.
ARG VERSION=dev
LABEL org.opencontainers.image.version="${VERSION}" version="${VERSION}" org.opencontainers.image.title="Monet"
# Tools for installing Windows from Monet: splitting Windows' install image
# (wimlib), formatting its partition (ntfsprogs), and boot entries; rsync for
# the copies on a backup drive. Then the look: Kvantum draws Monet's glass app
# windows, Inter is the reading font, and Plymouth's script plugin plays
# Monet's boot screen.
# cryptsetup and tpm2-tss unlock a disk Monet Setup encrypted, with the PC's security chip.
RUN dnf5 -y install wimlib-utils ntfsprogs dosfstools efibootmgr python3 rsync cryptsetup tpm2-tss \
 && dnf5 -y install --skip-unavailable kvantum rsms-inter-fonts plymouth-plugin-script \
 && dnf5 clean all
# The everyday apps, built in rather than downloaded: Photos, Documents, Video,
# Music, Calculator and Archives. Built against the Plasma already here they
# take tens of megabytes (from Flathub they'd bring KDE's runtime, about a
# gigabyte), wear Monet's glass app style, and are there at the first sign-in.
# With them, Files shows pictures of what's in PDFs and videos. No skipping:
# if one can't be installed, the build stops and says which.
RUN dnf5 -y install gwenview okular haruna elisa-player kcalc ark \
        kdegraphics-thumbnailers ffmpegthumbs \
 && dnf5 clean all
COPY --from=build /out /tmp/monet
COPY --from=password /out /tmp/monet/password
# Monet's boot screen, the same as Monet Setup's: the harbor at dawn with the
# sun breathing, instead of Bazzite's. It lives in the initramfs, so that's
# rebuilt the way Bazzite builds it, with what unlocks an encrypted disk by
# itself (the TPM's libraries, which systemd-cryptsetup asks for there).
COPY image/setup/files/usr/share/plymouth/themes/monet /usr/share/plymouth/themes/monet
RUN /tmp/monet/install.sh --image \
 && rm -rf /tmp/monet \
 && plymouth-set-default-theme monet \
 && kernel="$(dnf5 repoquery --installed --queryformat='%{evr}.%{arch}' kernel)" \
 && dracut --no-hostonly --kver "$kernel" --reproducible --zstd --add ostree --add fido2 --add tpm2-tss -f "/usr/lib/modules/$kernel/initramfs.img" \
 && chmod 0600 "/usr/lib/modules/$kernel/initramfs.img" \
 && ostree container commit
