# Monet OS: Bazzite (KDE Plasma) with Monet built in, including the Windows
# half that Monet copies into Windows by itself. Two of it, from Bazzite's two
# desktops: NVIDIA's open drivers (GTX 16, RTX 20 and newer: monet), and AMD's
# and Intel's (Mesa, which also drives older NVIDIA cards: monet-amd). Monet
# Setup picks by the PC's graphics.
#
#   podman build -f image/Containerfile -t monet .
#   podman build -f image/Containerfile --build-arg BASE=ghcr.io/ublue-os/bazzite:stable -t monet-amd .

ARG BASE=ghcr.io/ublue-os/bazzite-nvidia-open:stable

FROM docker.io/library/rust:1 AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends mingw-w64 cmake qt6-base-dev python3 innoextract ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN rustup toolchain install \
 && rustup target add x86_64-unknown-linux-musl x86_64-pc-windows-gnu \
 && cargo build --release -p monet --target x86_64-unknown-linux-musl \
 && cargo build --release -p monet-bridge -p monet-setup-check --target x86_64-pc-windows-gnu \
 && MONET_PACKAGE_FOR_IMAGE=1 tools/package.sh linux target/x86_64-unknown-linux-musl/release/monet /out \
        target/x86_64-pc-windows-gnu/release/monet-bridge.exe \
        target/x86_64-pc-windows-gnu/release/monet-setup-check.exe \
 && python3 tools/prepare-windows-repair.py --drivers-only --output /out/share/monet/windows-drivers/lenovo-21hl \
        --innoextract /usr/bin/innoextract --cache /tmp/monet-driver-downloads \
 && rm -rf /tmp/monet-driver-downloads

FROM ${BASE} AS runtime
RUN dnf -y install filelight flatpak-libs && dnf clean all
# Tools for installing Windows from Monet: splitting Windows' install image
# (wimlib), formatting its partition (ntfsprogs), and boot entries; ntfs-3g's
# probe, which says when Windows' drive is safe to write (its Games folder for
# Steam on both sides); NumPy and Pillow, with which monet-paint paints your photo;
# rsync for the copies on a backup drive; Qt for Python, which Games and the Store are
# written in, as Monet Setup is, and the Store's way to Flatpak (PyGObject). Then the look:
# Kvantum draws Monet's glass app windows, Inter is the reading font, and
# Plymouth's script plugin plays Monet's boot screen; umu-launcher runs Windows programs
# opened in Files through Proton, as Windows games run.
# cryptsetup and tpm2-tss unlock a disk Monet Setup encrypted, with the PC's security chip.
# Carlito and Caladea are as wide as Calibri and Cambria, so Word and PowerPoint files keep their
# lines and pages in the office apps (the image has Liberation for Arial, Times and Courier).
# rclone puts OneDrive in Files (Settings → Storage → OneDrive).
RUN dnf5 -y install wimlib-utils ntfsprogs ntfs-3g dosfstools exfatprogs e2fsprogs udisks2 efibootmgr python3 python3-numpy python3-pillow rsync \
    python3-pyside6 python3-pynacl python3-dbus python3-gobject at-spi2-core lz4-libs binutils \
    cryptsetup tpm2-tss rclone procps-ng kvantum \
 && dnf5 -y install --skip-unavailable rsms-inter-fonts plymouth-plugin-script umu-launcher \
    google-carlito-fonts google-crosextra-caladea-fonts \
 && dnf5 clean all
# The everyday apps, built in rather than downloaded: Photos, Documents, Video,
# Music, Calculator and Archives. Built against the Plasma already here they
# take tens of megabytes (from Flathub they'd bring KDE's runtime, about a
# gigabyte), wear Monet's glass app style, and are there at the first sign-in.
# With them, Files shows pictures of what's in PDFs and videos. No skipping:
# if one can't be installed, the build stops and says which.
RUN dnf5 -y install gwenview okular haruna elisa-player kcalc ark 7zip \
        kdegraphics-thumbnailers ffmpegthumbs \
 && dnf5 clean all
# Screenshot's Extract Text (copy the text in a picture, on the PC) reads every
# language Monet speaks: Bazzite has fifteen of them; these are the rest.
RUN dnf5 -y install --skip-unavailable tesseract-langpack-ara tesseract-langpack-dan tesseract-langpack-fin \
        tesseract-langpack-heb tesseract-langpack-hin tesseract-langpack-hun tesseract-langpack-ind \
        tesseract-langpack-kor tesseract-langpack-nor tesseract-langpack-ron tesseract-langpack-swe \
        tesseract-langpack-tha tesseract-langpack-ukr tesseract-langpack-vie \
 && dnf5 clean all
# A fingerprint reader unlocks the screen and answers administrator prompts once a
# finger is set up (Settings → Lock & Privacy). fprintd is Bazzite's already, but
# its sign-in settings leave the fingerprint step out; Bluefin turns it on the same
# way. (The sign-in screen, Plasma Login Manager, can't take a finger yet.)
RUN dnf5 -y install fprintd-pam && dnf5 clean all \
 && { authselect enable-feature with-fingerprint || { echo "fingerprint left off: authselect refused" >&2; authselect current; }; }

# A stable base can lag the repository's native development headers. Upgrade
# the actual desktop dependency closure in the shipped runtime first. Every
# native stage still verifies that installing headers leaves this ABI unchanged.
RUN --mount=type=bind,source=image,target=/tmp/monet-native-runtime,ro \
    python3 /tmp/monet-native-runtime/refresh-native-runtime.py --upgrade \
 && dnf5 clean all

# Build the password prompt against that same aligned runtime too.
FROM runtime AS password
COPY image/password /src/password
RUN mkdir -p /out && { sh /src/password/build.sh /out || rm -rf /out/*; }

# Build the native notification applet against the fully assembled runtime.
# Development packages stay in this stage; a mismatch fails rather than shipping
# a plugin built against libraries absent from the actual image.
FROM runtime AS notifications
COPY image/notifications /src/notifications
RUN sh /src/notifications/build.sh /out

FROM runtime AS wallet
COPY image/wallet /src/wallet
COPY image/download-source-rpm.py /src/wallet/download-source-rpm.py
RUN sh /src/wallet/build.sh /out

FROM runtime AS dock
COPY image/dock /src/dock
RUN sh /src/dock/build.sh /out

FROM runtime AS editor-recovery
COPY image/editor-recovery /src/editor-recovery
RUN sh /src/editor-recovery/build.sh /out

FROM runtime AS task-manager
COPY image/task-manager /src/task-manager
COPY image/download-source-rpm.py /src/task-manager/download-source-rpm.py
RUN sh /src/task-manager/build.sh /out

FROM runtime AS login
COPY image/login /src/login
COPY image/download-source-rpm.py /src/login/download-source-rpm.py
RUN sh /src/login/build.sh /out

FROM runtime AS session
COPY image/session /src/session
COPY image/download-source-rpm.py /src/session/download-source-rpm.py
RUN sh /src/session/build.sh /out

FROM runtime AS files-recovery
COPY image/files-recovery /src/files-recovery
COPY image/download-source-rpm.py /src/files-recovery/download-source-rpm.py
RUN sh /src/files-recovery/build.sh /out

FROM runtime AS archive-recovery
COPY image/archive-recovery /src/archive-recovery
COPY image/download-source-rpm.py /src/archive-recovery/download-source-rpm.py
RUN sh /src/archive-recovery/build.sh /out

FROM runtime AS activity
COPY image/activity /src/activity
COPY LICENSE /src/activity/LICENSE
RUN sh /src/activity/build.sh /out

FROM runtime AS launcher
COPY image/launcher /src/launcher
COPY LICENSE /src/launcher/LICENSE
RUN sh /src/launcher/build.sh /out

# Task Manager's Graphics column: each program's share of the graphics card.
FROM runtime AS graphics
COPY image/graphics /src/graphics
COPY LICENSE /src/graphics/LICENSE
RUN sh /src/graphics/build.sh /out

FROM runtime AS pdf-recovery
COPY image/pdf-recovery /src/pdf-recovery
COPY image/download-source-rpm.py /src/pdf-recovery/download-source-rpm.py
RUN sh /src/pdf-recovery/build.sh /out

FROM runtime AS window-identity
COPY image/window-identity /src/window-identity
COPY LICENSE /src/window-identity/LICENSE
RUN sh /src/window-identity/build.sh /out

FROM runtime
RUN dnf5 -y install python3-pulsectl libcanberra-gtk3 && dnf5 clean all
# Keep common contractions and multi-error typos ahead of unrelated words in
# native spelling menus. Apps with their own dictionaries remain app-managed.
RUN dnf5 -y install hunspell-en-US hunspell-en-GB hunspell-en-CA hunspell-en-AU kf6-sonnet-hunspell \
 && dnf5 clean all
COPY image/spelling /tmp/monet-spelling
RUN python3 /tmp/monet-spelling/patch.py && rm -rf /tmp/monet-spelling
COPY --from=wallet /out/ /usr/
# Keep version-only changes out of the native library build caches.
ARG VERSION=dev
LABEL org.opencontainers.image.version="${VERSION}" version="${VERSION}" org.opencontainers.image.title="Monet"
RUN --mount=type=bind,from=pdf-recovery,source=/out,target=/tmp/monet-pdf-recovery,ro \
    python3 /tmp/monet-pdf-recovery/bundle.py install /tmp/monet-pdf-recovery
RUN --mount=type=bind,from=task-manager,source=/out,target=/tmp/monet-task-manager,ro \
    python3 /tmp/monet-task-manager/bundle.py install /tmp/monet-task-manager

RUN --mount=type=bind,from=login,source=/out,target=/tmp/monet-login,ro \
    python3 /tmp/monet-login/bundle.py install /tmp/monet-login
RUN --mount=type=bind,from=session,source=/out,target=/tmp/monet-session,ro \
    python3 /tmp/monet-session/bundle.py install /tmp/monet-session

RUN --mount=type=bind,from=files-recovery,source=/out,target=/tmp/monet-files-recovery,ro \
    python3 /tmp/monet-files-recovery/bundle.py install /tmp/monet-files-recovery \
 && mkdir -p /usr/share/monet && touch /usr/share/monet/files-free-space-v1
RUN --mount=type=bind,from=archive-recovery,source=/out,target=/tmp/monet-archive-recovery,ro \
    python3 /tmp/monet-archive-recovery/bundle.py install /tmp/monet-archive-recovery
RUN --mount=type=bind,from=activity,source=/out,target=/tmp/monet-activity,ro \
    python3 /tmp/monet-activity/bundle.py install /tmp/monet-activity
RUN --mount=type=bind,from=launcher,source=/out,target=/tmp/monet-launcher,ro \
    python3 /tmp/monet-launcher/bundle.py install /tmp/monet-launcher
RUN --mount=type=bind,from=graphics,source=/out,target=/tmp/monet-graphics,ro \
    python3 /tmp/monet-graphics/bundle.py install /tmp/monet-graphics
RUN --mount=type=bind,from=window-identity,source=/out,target=/tmp/monet-window-identity,ro \
    python3 /tmp/monet-window-identity/bundle.py install /tmp/monet-window-identity
RUN --mount=type=bind,from=editor-recovery,source=/out,target=/tmp/monet-editor-recovery,ro \
    python3 /tmp/monet-editor-recovery/bundle.py install /tmp/monet-editor-recovery
RUN --mount=type=bind,from=notifications,source=/out,target=/tmp/monet-notifications,ro \
    python3 /tmp/monet-notifications/bundle.py install /tmp/monet-notifications
RUN --mount=type=bind,from=dock,source=/out,target=/tmp/monet-dock,ro \
    python3 /tmp/monet-dock/bundle.py install /tmp/monet-dock
# Monet's dark boot/power screen, shared with Setup: no bright wallpaper at
# shutdown, restart or the next boot. It lives in the initramfs, so that's
# rebuilt the way Bazzite builds it, with what unlocks an encrypted disk by
# itself (the TPM's libraries, which systemd-cryptsetup asks for there).
COPY image/setup/files/usr/share/plymouth/themes/monet /usr/share/plymouth/themes/monet
COPY image/finish-image.sh /tmp/monet-finish-image
COPY image/boot /tmp/monet-boot-build
COPY image/patch-shell-profiles.py /tmp/monet-shell-profiles.py
# Stage outputs are temporary inputs. Copying them in their own layers would
# ship those copies alongside the installed files even after deleting them.
# /mnt can point into the unpopulated /var tree during an atomic image build.
# Use /tmp, as the native bundle mounts above do.
RUN --mount=type=bind,from=build,source=/out,target=/tmp/monet-build-package,ro \
    --mount=type=bind,from=password,source=/out,target=/tmp/monet-build-password,ro \
    --mount=type=bind,from=dock,source=/usr/lib64/qt6/libexec/qmlcachegen,target=/tmp/monet-qmlcachegen,ro \
    --mount=type=bind,source=image/precompile-qml.py,target=/tmp/monet-precompile-qml.py,ro \
    --mount=type=bind,source=image/nvidia-flatpak,target=/tmp/monet-nvidia-flatpak,ro \
    --mount=type=bind,source=image/install-update-trust.py,target=/tmp/monet-install-update-trust.py,ro \
    --mount=type=bind,source=image/monet-update.pub,target=/tmp/monet-update.pub,ro \
    install -d /tmp/monet/password \
 && cp -a /tmp/monet-build-package/. /tmp/monet/ \
 && cp -a /tmp/monet-build-password/. /tmp/monet/password/ \
 && /tmp/monet/install.sh --image \
 && rm -rf /tmp/monet \
 && python3 /tmp/monet-shell-profiles.py /etc/profile.d \
 && rm /tmp/monet-shell-profiles.py \
 && plymouth-set-default-theme monet \
 && bash /tmp/monet-nvidia-flatpak/install.sh \
 && python3 /tmp/monet-boot-build/prepare.py / \
 && bash /tmp/monet-finish-image \
 && rm /tmp/monet-finish-image \
 && rm -rf /tmp/monet-boot-build \
 && python3 /tmp/monet-install-update-trust.py /tmp/monet-update.pub \
 && python3 /tmp/monet-precompile-qml.py --compiler /tmp/monet-qmlcachegen \
 && bootc container lint
