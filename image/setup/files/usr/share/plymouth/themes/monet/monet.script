// A dark handoff in every mode, including the next boot after a restart.
// Do not decode or display the wallpaper: Plymouth has no session night-light
// transform, so the painting can flash at full brightness during the handoff.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
// Keep a sprite even when it has no image: Plymouth's script renderer needs
// one to draw the background on Fedora.
back = Sprite();
if (Plymouth.GetMode() == "boot") {
    // A small static wordmark gives boot feedback without lighting the screen.
    name = Image.Text("Monet", 0.45, 0.45, 0.45, 1, "Sans 20");
    brand = Sprite(name);
    brand.SetX(Window.GetX() + (Window.GetWidth() - name.GetWidth()) / 2);
    brand.SetY(Window.GetY() + Window.GetHeight() * 0.42);
}

// A line of white text, centered at height y (a fraction of the screen).
fun line(text, y, font, alpha) {
    image = Image.Text(text, 1, 1, 1, alpha, font);
    sprite = Sprite(image);
    sprite.SetX(Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2);
    sprite.SetY(Window.GetY() + Window.GetHeight() * y);
    sprite.SetZ(20);
    return sprite;
}

// An encrypted disk asks for its password: the question, and a dot per letter typed.
fun password(prompt, bullets) {
    global.question = line(prompt, 0.58, "Sans 16", 1);
    dots = "";
    for (i = 0; i < bullets; i++)
        dots = dots + "•";
    global.typed = line(dots + " ", 0.63, "Sans 24", 1);
}
Plymouth.SetDisplayPasswordFunction(password);

fun question(prompt, entry) {
    global.question = line(prompt, 0.58, "Sans 16", 1);
    global.typed = line(entry + " ", 0.63, "Sans 18", 1);
}
Plymouth.SetDisplayQuestionFunction(question);

fun normal() {
    global.question = NULL;
    global.typed = NULL;
}
Plymouth.SetDisplayNormalFunction(normal);

fun message(text) {
    mode = Plymouth.GetMode();
    if (mode == "reboot" || mode == "shutdown") return;
    global.note = line(text, 0.9, "Sans 12", 0.85);
}
Plymouth.SetMessageFunction(message);
