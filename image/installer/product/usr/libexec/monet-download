#!/usr/bin/python3
"""The screens the installer shows of its own: while it downloads Monet, and
the one thing to know before restarting.

    monet-download STATUS.json
    monet-download --before-restart

The kickstart's %pre-install downloads Monet (several GB) while the installer
itself only says "Running pre-installation scripts". This window covers it
with what is actually happening, and closes when STATUS.json says "done",
disappears, or the download script is gone.

At the very end, --before-restart tells people about the blue screen at the
first start, where Monet's key is trusted once: easy to skip by accident, and
then Secure Boot refuses Monet. It closes with "Got it".

Best effort: if it can't open, the install goes on regardless.
"""

import json
import os
import sys


def screen_env():
    """The installer's screen, from the nearest parent process that has one."""
    pid = os.getpid()
    for _ in range(12):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = dict(item.split("=", 1) for item in f.read().decode(errors="replace").split("\0") if "=" in item)
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return {}
        if env.get("WAYLAND_DISPLAY") or env.get("DISPLAY"):
            return {k: env[k] for k in ("WAYLAND_DISPLAY", "DISPLAY", "XDG_RUNTIME_DIR", "XAUTHORITY") if k in env}
    return {}


# Started from a %post script, which doesn't know the screen: find it before GTK starts.
if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
    os.environ.update(screen_env())

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

PIXMAPS = "/usr/share/anaconda/pixmaps"
CSS = b"""
window { background-color: #FBFAF7; background-image: url("%s/monet-page.png");
         background-size: 100%% auto; background-position: 50%% 100%%; background-repeat: no-repeat; }
.title { font-family: "Fraunces 72pt SuperSoft", "Fraunces", serif; font-weight: 300; font-size: 44px; color: #1C1B19; }
.line { font-family: "Inter", sans-serif; font-size: 16px; color: #1C1B19; }
.note { font-family: "Inter", sans-serif; font-size: 13px; color: #6B6862; }
progressbar trough { background-image: none; background-color: rgba(28, 27, 25, 0.08); border: none;
                     border-radius: 4px; min-height: 8px; }
progressbar progress { background-image: none; background-color: #357F72; border: none;
                       border-radius: 4px; min-height: 8px; }
.step { font-family: "Inter", sans-serif; font-size: 17px; color: #1C1B19; }
button.go { background-image: none; background-color: #F2552C; color: #FFFFFF; border: none; box-shadow: none;
            border-radius: 23px; min-height: 46px; padding: 0 30px; font-family: "Inter", sans-serif;
            font-size: 16px; font-weight: 600; }
button.go:hover { background-color: #FF6A42; }
""" % PIXMAPS.encode()

# The first start, in the words of the firmware's blue screen. The kickstart's
# "mokutil --timeout -1" skips its "Press any key": it opens on Continue boot.
BEFORE_RESTART = (
    "One more thing",
    "The first time it starts, a blue screen asks to trust Monet, just once. Use the arrow keys and Enter:",
    ["Choose Enroll MOK, then Continue, then Yes.", "Type monetsetup and press Enter.", "Choose Reboot."],
    "It opens on Continue boot. Don't choose that: it skips this, and then Monet can't start. "
    "Take out the USB stick when you restart.",
)


def gb(n):
    return f"{n / 1e9:.1f}"


def describe(status):
    """The two lines under the title, from the download script's status."""
    got, total, eta = status.get("got", 0), status.get("total") or 0, status.get("eta")
    if status.get("note"):
        line = status["note"]
    elif total:
        line = f"{gb(min(got, total))} of {gb(total)} GB"
        if eta and eta > 0:
            minutes = max(1, round(eta / 60))
            line += " · about 1 minute left" if minutes == 1 else f" · about {minutes} minutes left"
    else:
        line = f"{gb(got)} GB so far"
    fraction = min(got / total, 0.99) if total else None
    return line, fraction


class Window(Gtk.Window):
    def __init__(self, path):
        super().__init__(title="Downloading Monet")
        self.path, self.parent_pid, self.missing = path, os.getppid(), 0
        self.set_decorated(False)
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor:
            area = monitor.get_geometry()
            self.set_default_size(area.width, area.height)
        self.fullscreen()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, halign=Gtk.Align.CENTER,
                      valign=Gtk.Align.CENTER, margin_bottom=160)
        box.set_size_request(560, -1)
        try:
            mark = GdkPixbuf.Pixbuf.new_from_file_at_size(f"{PIXMAPS}/monet-mark.png", 72, 72)
            logo = Gtk.Image.new_from_pixbuf(mark)
            logo.set_halign(Gtk.Align.START)
            logo.set_margin_bottom(6)
            box.pack_start(logo, False, False, 0)
        except GLib.Error:
            pass
        self.title = Gtk.Label(label="Downloading Monet", xalign=0)
        self.title.get_style_context().add_class("title")
        self.line = Gtk.Label(label="Starting the download", xalign=0)
        self.line.get_style_context().add_class("line")
        self.bar = Gtk.ProgressBar()
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=60,
                         label="The longest part of the install. If the connection drops, "
                               "Monet picks up where it stopped.")
        note.get_style_context().add_class("note")
        for widget in (self.title, self.line, self.bar, note):
            box.pack_start(widget, False, False, 0)
        self.add(box)
        GLib.timeout_add(1000, self.tick)
        GLib.timeout_add(150, self.pulse)
        self.fraction = None
        self.tick()

    def pulse(self):
        if self.fraction is None:
            self.bar.pulse()
        return True

    def tick(self):
        try:
            with open(self.path) as f:
                status = json.load(f)
            self.missing = 0
        except (OSError, ValueError):
            status = None
            self.missing += 1
        gone = os.getppid() != self.parent_pid
        if gone or self.missing > 10 or (status or {}).get("done"):
            Gtk.main_quit()
            return False
        if status:
            line, self.fraction = describe(status)
            self.line.set_text(line)
            if self.fraction is not None:
                self.bar.set_fraction(self.fraction)
        return True


class BeforeRestart(Gtk.Window):
    """The blue screen, explained before it comes, over the installer's last page until "Got it"."""

    def __init__(self):
        super().__init__(title="Before you restart")
        self.set_decorated(False)
        self.fullscreen()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        title, intro, steps, note = BEFORE_RESTART
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, halign=Gtk.Align.CENTER,
                      valign=Gtk.Align.CENTER, margin_bottom=160)
        box.set_size_request(560, -1)
        labels = [(title, "title"), (intro, "line")] + [(f"{n}.  {s}", "step") for n, s in enumerate(steps, 1)] \
            + [(note, "note")]
        for text, kind in labels:
            label = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=60)
            label.get_style_context().add_class(kind)
            box.pack_start(label, False, False, 0)
        done = Gtk.Button(label="Got it", halign=Gtk.Align.START, margin_top=10)
        done.get_style_context().add_class("go")
        done.connect("clicked", lambda *_: Gtk.main_quit())
        box.pack_start(done, False, False, 0)
        self.add(box)


def main():
    if sys.argv[1:] == ["--before-restart"]:
        window = BeforeRestart()
        window.connect("destroy", Gtk.main_quit)
        window.show_all()
        window.present()
        Gtk.main()
        return
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    window = Window(sys.argv[1])
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    window.present()
    Gtk.main()


if __name__ == "__main__":
    main()
