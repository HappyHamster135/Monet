# Fedora supplies mutually compatible Qt/PySide/KDE packages for desktop tests.
# No host desktop, user data, system bus or block devices are mounted here.
ARG FEDORA_RELEASE=45
FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE} AS desktop-runtime
RUN dnf -y install python3 python3-pyside6 python3-gobject python3-dbus python3-pynacl \
    python3-numpy python3-pillow python3-evdev grub2-tools gtk3 gtk4 nodejs nodejs-npm dbus-daemon dbus-tools \
    plasma-workspace plasma-desktop plasma-systemmonitor plasma-pa plasma-nm kwin-wayland \
    kf6-kirigami kf6-kconfig plasma-integration kvantum rsms-inter-fonts \
    pipewire pipewire-pulseaudio pipewire-utils pulseaudio-utils wireplumber python3-pulsectl \
    util-linux procps-ng ntfsprogs dosfstools wimlib-utils cryptsetup openssl \
    diffutils findutils which git dolphin baloo-widgets ark 7zip \
    hunspell-en-US hunspell-en-GB hunspell-en-CA hunspell-en-AU kf6-sonnet-hunspell \
    gstreamer1-plugins-good gstreamer1-plugins-bad-free \
    xorg-x11-server-Xvfb mesa-dri-drivers libglvnd-glx libXtst fontconfig \
 && dnf clean all
# Match the shipped desktop's encoders, including H.264 export. Fedora's
# codec-limited libraries cannot exercise the actual recording/media tools.
RUN dnf -y install "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
 && dnf -y install ffmpeg --allowerasing \
 && dnf clean all
COPY tests/install-electron-runtime.py /tmp/install-electron-runtime.py
RUN python3 /tmp/install-electron-runtime.py /opt/monet-test-electron \
 && rm /tmp/install-electron-runtime.py
ENV MONET_ELECTRON_BINARY=/opt/monet-test-electron/electron
COPY linux/share/monet/app-integration/electron/package*.json /opt/monet-electron-client/
RUN cd /opt/monet-electron-client && npm ci --ignore-scripts --omit=optional --no-fund --no-audit --cache=/tmp/monet-npm-cache \
 && rm -rf /tmp/monet-npm-cache
RUN dnf -y install xdotool && dnf clean all
ENV MONET_TEST_ELECTRON_DBUS=/opt/monet-electron-client/node_modules/dbus-next
# Only the disposable container opts in to deliberately filling its tmpfs.
ENV MONET_TEST_ARCHIVE_TMPFS=/dev/shm
WORKDIR /src

FROM docker.io/library/rust:1 AS measurements
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN rustup toolchain install \
 && cargo build --locked --release -p monet --bin monet-measure

FROM desktop-runtime AS wallet
COPY image/wallet /src/wallet
COPY image/download-source-rpm.py /src/wallet/download-source-rpm.py
RUN sh /src/wallet/build.sh /out

FROM desktop-runtime AS archive-recovery
COPY image/archive-recovery /src/archive-recovery
COPY image/download-source-rpm.py /src/archive-recovery/download-source-rpm.py
RUN sh /src/archive-recovery/build.sh /out

FROM desktop-runtime AS activity
COPY image/activity /src/activity
COPY LICENSE /src/activity/LICENSE
RUN MONET_ACTIVITY_TESTING=1 sh /src/activity/build.sh /out

FROM desktop-runtime AS launcher
COPY image/launcher /src/launcher
COPY LICENSE /src/launcher/LICENSE
RUN MONET_LAUNCHER_TESTING=1 sh /src/launcher/build.sh /out

FROM desktop-runtime AS graphics
COPY image/graphics /src/graphics
COPY LICENSE /src/graphics/LICENSE
RUN MONET_GRAPHICS_TESTING=1 sh /src/graphics/build.sh /out

FROM desktop-runtime AS dock
COPY image/dock /src/dock
COPY tests/native/dock-launch /src/dock-launch
COPY tests/native/dock-hover /src/dock-hover
RUN sh /src/dock/build.sh /out \
 && cmake -S /src/dock-launch -B /tmp/dock-launch -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /tmp/dock-launch --parallel 2 \
 && mkdir -p /out/tests \
 && cp /tmp/dock-launch/dock-launch /out/tests/ \
 && cmake -S /src/dock-hover -B /tmp/dock-hover -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /tmp/dock-hover --parallel 2 \
 && cp /tmp/dock-hover/dock-hover /out/tests/

FROM desktop-runtime AS window-identity
COPY image/window-identity /src/window-identity
COPY LICENSE /src/window-identity/LICENSE
RUN sh /src/window-identity/build.sh /out

FROM desktop-runtime AS task-manager
COPY image/task-manager /src/task-manager
COPY image/download-source-rpm.py /src/task-manager/download-source-rpm.py
RUN sh /src/task-manager/build.sh /out

FROM dock AS quick-options-test
COPY tests/native/quick-options /src/quick-options-test
RUN cmake -S /src/quick-options-test -B /tmp/quick-options-test -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /tmp/quick-options-test --parallel 1 \
 && cp /tmp/quick-options-test/quick-options-test /out/quick-options-test

FROM desktop-runtime
COPY --from=measurements /src/target/release/monet-measure /opt/monet-test-measure/monet-measure
ENV MONET_TEST_MEASURE=/opt/monet-test-measure/monet-measure
COPY --from=wallet /out/ /usr/
COPY tools/agenda-requirements.txt /tmp/agenda-requirements.txt
RUN dnf -y install python3-pip && dnf clean all \
 && python3 -m pip install --no-deps --require-hashes --only-binary=:all: --prefix=/usr/local -r /tmp/agenda-requirements.txt
RUN dnf -y install binutils kf6-bluez-qt bluedevil spectacle filelight flatpak-libs python3-pyatspi at-spi2-core && dnf clean all
COPY --from=archive-recovery /out /tmp/monet-archive-recovery
RUN python3 /tmp/monet-archive-recovery/bundle.py install /tmp/monet-archive-recovery \
 && rm -rf /tmp/monet-archive-recovery
COPY --from=activity /out /tmp/monet-activity
RUN python3 /tmp/monet-activity/bundle.py install /tmp/monet-activity \
 && mkdir -p /opt/monet-test-activity \
 && cp /tmp/monet-activity/tests/* /opt/monet-test-activity/ \
 && rm -rf /tmp/monet-activity
ENV MONET_ACTIVITY_FIXTURE=/opt/monet-test-activity/activity-test
COPY --from=launcher /out /tmp/monet-launcher
RUN python3 /tmp/monet-launcher/bundle.py install /tmp/monet-launcher \
 && mkdir -p /opt/monet-test-launcher \
 && cp /tmp/monet-launcher/tests/* /opt/monet-test-launcher/ \
 && rm -rf /tmp/monet-launcher
ENV MONET_LAUNCHER_FIXTURE=/opt/monet-test-launcher/launcher-test
COPY --from=graphics /out /tmp/monet-graphics
RUN python3 /tmp/monet-graphics/bundle.py install /tmp/monet-graphics \
 && mkdir -p /opt/monet-test-graphics \
 && cp /tmp/monet-graphics/tests/* /opt/monet-test-graphics/ \
 && rm -rf /tmp/monet-graphics
ENV MONET_GRAPHICS_FIXTURE=/opt/monet-test-graphics/graphics-column-test
COPY --from=dock /out /tmp/monet-dock
RUN python3 /tmp/monet-dock/bundle.py install /tmp/monet-dock \
 && mkdir -p /opt/monet-test-dock \
 && cp -a /tmp/monet-dock/tests/. /opt/monet-test-dock/ \
 && rm -rf /tmp/monet-dock
ENV MONET_DOCK_LAUNCH_FIXTURE=/opt/monet-test-dock/dock-launch
ENV MONET_DOCK_AUDIO_QML=/opt/monet-test-dock/audio
ENV MONET_DOCK_HOVER_FIXTURE=/opt/monet-test-dock/dock-hover
COPY --from=quick-options-test /out/quick-options-test /opt/monet-test-quick/quick-options-test
ENV MONET_QUICK_FIXTURE=/opt/monet-test-quick/quick-options-test
COPY --from=window-identity /out /tmp/monet-window-identity
RUN python3 /tmp/monet-window-identity/bundle.py install /tmp/monet-window-identity \
 && rm -rf /tmp/monet-window-identity
ENV MONET_TITLE_NATIVE=1
COPY --from=task-manager /out /tmp/monet-task-manager
RUN python3 /tmp/monet-task-manager/bundle.py install /tmp/monet-task-manager \
 && rm -rf /tmp/monet-task-manager
ENV MONET_TASK_MANAGER_NATIVE=1
# Match the bytecode compiler to the native Qt runtime, without shipping headers.
COPY --from=dock /usr/lib64/qt6/libexec/qmlcachegen /usr/local/bin/monet-test-qmlcachegen
CMD ["python3", "tools/test.py", "--require-desktop"]
