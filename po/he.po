msgstr "הדיסק הזה קטן מדי בשביל Monet (צריך 70 GB)."

#: setup/monet_setup/app.py:602
msgid "%1 of %2 GB"
msgstr "%1 מתוך %2 GB"

#: setup/monet_setup/app.py:623
