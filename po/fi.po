#: crates/monet-bridge/src/bridge.rs:1440 crates/monet-bridge/src/cover.rs:303
msgid "Your PC restarts in Monet in %1 s."
msgstr "Tietokone käynnistyy uudelleen Monet'hen %1 s:n kuluttua."

#: crates/monet-bridge/src/bridge.rs:1441
msgid "Click Cancel to stay in Windows."
msgstr "Jos haluat jäädä Windowsiin, napsauta Peruuta."

#: crates/monet-bridge/src/bridge.rs:1723
msgid "Downloading %1 from %2"
msgstr "Ladataan %1 palvelusta %2"

#: crates/monet-bridge/src/bridge.rs:1724
msgid "Checking that %1 made it"
msgstr "Tarkistetaan, että tekijä on %1"

#: crates/monet-bridge/src/bridge.rs:1725
msgid "%1's installer is open"
msgstr "Asennusohjelma on auki: %1"

#: crates/monet-bridge/src/bridge.rs:1760
msgid ""
"%1 couldn't be downloaded. Check the internet connection, then try again from Games in Monet."
msgstr ""
"%1 ei latautunut. Tarkista internetyhteys ja yritä sitten uudelleen Monet'n Pelit-sovelluksesta."

#: crates/monet-bridge/src/bridge.rs:1761
msgid ""
"Windows couldn't confirm that %1 made its installer, so Monet didn't run it."
msgstr ""
"Windows ei voinut vahvistaa, että asennusohjelman tekijä on %1, joten Monet ei suorittanut sitä."

#: crates/monet-bridge/src/bridge.rs:1762
msgid ""
"%1 wasn't installed. You can try again from Games in Monet whenever you like."
msgstr ""
"%1 ei asentunut. Voit yrittää uudelleen Monet'n Pelit-sovelluksesta milloin haluat."

#: crates/monet-bridge/src/bridge.rs:1827
msgid "%1 isn't set up in Windows. Set it up from Games in Monet."
msgstr ""
"%1 ei ole käytössä Windowsissa. Ota se käyttöön Monet'n Pelit-sovelluksesta."

#: crates/monet-bridge/src/bridge.rs:1905
msgid "Windows Update: downloading"
msgstr "Windows Update: ladataan"

#: crates/monet-bridge/src/bridge.rs:1906
