msgid "Reset at restart"
msgstr "Palauta uudelleenkäynnistyksessä"

#: linux/share/monet/settings-app/MonetSettings.qml:6903
msgid "Reset"
msgstr "Palauta"

#: linux/share/monet/settings-app/MonetSettings.qml:6916
