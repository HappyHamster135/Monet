msgid ""
"Windows wasn't found on this PC. Install Windows first, then try again."
msgstr ""
"Tästä tietokoneesta ei löytynyt Windowsia. Asenna ensin Windows ja yritä sitten uudelleen."

#: crates/monet/src/main.rs:295
msgid "Not found"
msgstr "Ei löytynyt"

#: crates/monet/src/main.rs:297
msgid "Unavailable (not a UEFI system)"
msgstr "Ei käytettävissä (ei UEFI-järjestelmä)"

