#: linux/share/monet/settings-app/MonetSettings.qml:5867
msgid "No printers yet"
msgstr "Ei vielä tulostimia"

#: linux/share/monet/settings-app/MonetSettings.qml:5868
msgid ""
"Turn it on and join it to your Wi-Fi: Monet finds most printers by itself"
msgstr ""
"Kytke tulostin päälle ja yhdistä se Wi-Fi-verkkoosi: Monet löytää useimmat tulostimet itse"

#: linux/share/monet/settings-app/MonetSettings.qml:5871
