msgstr "เสียบสาย หรือจับคู่ผ่าน Bluetooth"

#: linux/share/monet/settings-app/MonetSettings.qml:6481
msgid "Pair…"
msgstr "จับคู่…"

#: linux/share/monet/settings-app/MonetSettings.qml:6486
