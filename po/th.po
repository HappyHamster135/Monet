msgstr "กำลังติดตั้ง…"

#: linux/share/monet/settings-app/MonetSettings.qml:8775
msgid "Try setup again"
msgstr "ลองติดตั้งอีกครั้ง"

#: linux/share/monet/settings-app/MonetSettings.qml:8776
msgid "Retry download"
msgstr "ลองดาวน์โหลดอีกครั้ง"

