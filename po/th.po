msgid "Choose ISO…"
msgstr "เลือก ISO…"

#: linux/share/monet/settings-app/MonetSettings.qml:8790
msgid "Change ISO…"
msgstr "เปลี่ยน ISO…"

#: linux/share/monet/settings-app/MonetSettings.qml:8797
msgid "Prepare Windows"
msgstr "เตรียม Windows"

#: linux/share/monet/settings-app/MonetSettings.qml:8798
msgid "Administrator access is required to prepare the reserved space."
msgstr "ต้องใช้สิทธิ์ผู้ดูแลระบบเพื่อเตรียมพื้นที่ที่สงวนไว้"

#: linux/share/monet/settings-app/MonetSettings.qml:8811
msgid "Need an ISO?"
msgstr "ต้องการ ISO ไหม?"

