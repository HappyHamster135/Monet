msgstr "Przygotowywanie systemu Windows"

#: linux/share/monet/settings-app/MonetSettings.qml:6367
msgid "Windows is ready to install"
msgstr "Windows jest gotowy do instalacji"

#: linux/share/monet/settings-app/MonetSettings.qml:6368
msgid "No Windows on this PC"
msgstr "Na tym komputerze nie ma Windows"

#: linux/share/monet/settings-app/MonetSettings.qml:6369 crates/monet/src/main.rs:811
