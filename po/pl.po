msgstr "Wysyłaj pliki na telefon"

#: setup/monet_setup/app.py:47
msgid "Epic and GOG games"
msgstr "Gry z Epic i GOG"

#: setup/monet_setup/app.py:49
msgid "Record and stream games"
msgstr "Nagrywaj i streamuj gry"

#: setup/monet_setup/app.py:50
msgid "Paint and draw"
msgstr "Maluj i rysuj"

#: setup/monet_setup/app.py:57
