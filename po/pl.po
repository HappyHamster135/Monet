msgid "Sign in to your game launchers?"
msgstr "Zalogować się do launcherów gier?"

#: linux/share/monet/settings-app/MonetSettings.qml:6363 crates/monet/src/main.rs:336
msgid "Update Windows games?"
msgstr "Zaktualizować gry na Windows?"

#: linux/share/monet/settings-app/MonetSettings.qml:6365
msgid "The last trip didn't reach Windows"
msgstr "Ostatnie przejście do systemu Windows się nie udało"

#: linux/share/monet/settings-app/MonetSettings.qml:6366 linux/libexec/monet-prepare-windows:575 crates/monet/src/main.rs:896
