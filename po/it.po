#: linux/share/monet/settings-app/MonetSettings.qml:7171 linux/share/monet/settings-app/MonetSettings.qml:7817 linux/share/monet/settings-app/MonetSettings.qml:8139
#: linux/share/monet/store-app/AppPage.qml:201 linux/share/monet/store-app/Home.qml:217 setup/qml/Main.qml:232
msgid "Install"
msgstr "Installa"

