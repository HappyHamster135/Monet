msgid "Installing…"
msgstr "Instalando…"

#: linux/share/monet/settings-app/MonetSettings.qml:6224 linux/share/monet/settings-app/MonetSettings.qml:6733 linux/share/monet/settings-app/MonetSettings.qml:6872
#: linux/share/monet/settings-app/MonetSettings.qml:6923 linux/share/monet/settings-app/MonetSettings.qml:6988
msgid "Restart now"
msgstr "Reiniciar agora"

#: linux/share/monet/settings-app/MonetSettings.qml:6226 linux/share/monet/settings-app/MonetSettings.qml:6732 linux/share/monet/settings-app/MonetSettings.qml:6990
#: linux/share/monet/store-app/AppPage.qml:202 linux/share/monet/store-app/Home.qml:210 setup/qml/Main.qml:232
msgid "Install"
msgstr "Instalar"

#: linux/share/monet/settings-app/MonetSettings.qml:6236
msgid "Off: a file deleted or changed by mistake can't be brought back."
msgstr ""
"Desligado: um arquivo apagado ou alterado por engano não pode ser recuperado."

#: linux/share/monet/settings-app/MonetSettings.qml:6237
msgid "Earlier versions of your files every hour, and copies on %1."
