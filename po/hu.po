#: crates/monet-usb/src/gui.rs:363 crates/monet-usb/src/gui.rs:406
msgid ""
"Monet couldn't be downloaded. Check the internet connection, then try again: it picks up where it stopped."
msgstr ""
"A Monet letöltése nem sikerült. Ellenőrizd az internetkapcsolatot, majd próbáld újra: ott folytatódik, ahol abbamaradt."

#: crates/monet-usb/src/gui.rs:389
msgid "Downloading Monet · %1 of %2 GB"
msgstr "A Monet letöltése · %1 / %2 GB"

#: crates/monet-usb/src/gui.rs:391
