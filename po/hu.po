msgid "Sign in to your game launchers?"
msgstr "Bejelentkezel a játékindítóidba?"

#: linux/share/monet/settings-app/MonetSettings.qml:6363 crates/monet/src/main.rs:336
msgid "Update Windows games?"
msgstr "Frissíted a Windows-játékokat?"

#: linux/share/monet/settings-app/MonetSettings.qml:6365
msgid "The last trip didn't reach Windows"
msgstr "A legutóbbi út nem ért el a Windowsig"

#: linux/share/monet/settings-app/MonetSettings.qml:6366 linux/libexec/monet-prepare-windows:575 crates/monet/src/main.rs:896
msgid "Getting Windows ready"
msgstr "A Windows előkészítése"

#: linux/share/monet/settings-app/MonetSettings.qml:6367
msgid "Windows is ready to install"
msgstr "A Windows telepítésre kész"

#: linux/share/monet/settings-app/MonetSettings.qml:6368
msgid "No Windows on this PC"
msgstr "Ezen a gépen nincs Windows"

#: linux/share/monet/settings-app/MonetSettings.qml:6369 crates/monet/src/main.rs:811
msgid "Windows is ready"
msgstr "A Windows készen áll"

