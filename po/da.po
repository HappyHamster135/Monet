#: setup/qml/Main.qml:383
msgid "Who's using this PC?"
msgstr "Hvem bruger denne pc?"

#: setup/qml/Main.qml:384
msgid "This is your account in Monet and in Windows."
msgstr "Det er din konto i både Monet og Windows."

#: setup/qml/Main.qml:387
msgid "Name"
msgstr "Navn"

#: setup/qml/Main.qml:391
msgid "You sign in as %1"
msgstr "Du logger ind som %1"

#: setup/qml/Main.qml:397
